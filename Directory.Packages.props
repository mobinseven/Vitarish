    <PackageVersion Include="Finbuckle.MultiTenant.EntityFrameworkCore" Version="9.*" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.*" />
    <PackageVersion Include="Google.Cloud.Speech.V2" Version="1.6.*" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.*" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.*" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.*" />
    <PackageVersion Include="Injectio" Version="5.0.0" />
    <PackageVersion Include="MailKit" Version="4.*" />
    <PackageVersion Include="MediatR" Version="14.0.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client.Core" Version="10.0.*" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.*" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.*" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.*" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
