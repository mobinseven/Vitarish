    <PackageVersion Include="MimeTypesMap" Version="1.*" />
    <PackageVersion Include="MudBlazor" Version="9.*" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Npgsql" Version="10.0.*" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
    <PackageVersion Include="OllamaSharp.ModelContextProtocol" Version="5.4.*" />
    <PackageVersion Include="OpenAI" Version="2.11.*" />
