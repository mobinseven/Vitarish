@page "/"

@using MudBlazor
@using Vitarish.Accounts.Interface.Components.Base

<MudStack Spacing="3">
    <MudText Typo="Typo.h5">UI Preview Host</MudText>
    <MudText Typo="Typo.body1">
        This preview uses lightweight authentication and stubbed services so the UI can render
        without IdentityServer, Redis, or SQL dependencies.
    </MudText>
    <Countdown Duration="TimeSpan.FromMinutes(1)" AutoStart="false" ShowControls="true" />

    <MudDivider Class="my-2" />

    <MudText Typo="Typo.h6">Accounts components</MudText>

    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.subtitle2">Account</MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string" Href="/components/accounts/account/culture-selector">Culture selector</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/email-change-form">Email change form</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/email-login-form">Email login form</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/email-verification-send">Email verification send</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/email-verification-verify">Email verification verify</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/password-change-form">Password change form</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/password-login-form">Password login form</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/phone-change-form">Phone change form</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/phone-login-form">Phone login form</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/phone-verification-send">Phone verification send</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/phone-verification-verify">Phone verification verify</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/profile-editor">Profile editor</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/status-message">Status message</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/tenants-widget">Tenants widget</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/webauthn-interop">WebAuthn interop</MudListItem>
                <MudListItem T="string" Href="/components/accounts/account/webauthn-login-form">WebAuthn login form</MudListItem>
            </MudList>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.subtitle2">Admin</MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string" Href="/components/accounts/admin/claims-edit">Claims edit</MudListItem>
                <MudListItem T="string" Href="/components/accounts/admin/role-claims-dialog">Role claims dialog</MudListItem>
                <MudListItem T="string" Href="/components/accounts/admin/role-editor">Role editor</MudListItem>
                <MudListItem T="string" Href="/components/accounts/admin/roles-manager">Roles manager</MudListItem>
                <MudListItem T="string" Href="/components/accounts/admin/user-role-assignment-dialog">User role assignment dialog</MudListItem>
                <MudListItem T="string" Href="/components/accounts/admin/user-role-assignments">User role assignments</MudListItem>
            </MudList>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.subtitle2">Base</MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string" Href="/components/accounts/base/account-layout">Account layout</MudListItem>
                <MudListItem T="string" Href="/components/accounts/base/countdown">Countdown</MudListItem>
                <MudListItem T="string" Href="/components/accounts/base/main-layout">Main layout</MudListItem>
            </MudList>
        </MudItem>
    </MudGrid>
</MudStack>
