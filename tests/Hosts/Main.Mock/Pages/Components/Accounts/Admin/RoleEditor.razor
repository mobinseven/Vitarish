@page "/components/accounts/admin/role-editor"

<MudStack Spacing="2">
    <MudText Typo="Typo.h6">Role editor</MudText>
    <RoleEditor Roles="Roles" @bind-Read="Read" @bind-Write="Write" />
</MudStack>

@code {
    private IEnumerable<string> Roles { get; } =
    [
        "Tenant.Read",
        "Tenant.Write",
        "Tenant.Admin"
    ];

    private string? Read { get; set; } = "Tenant.Read";
    private string? Write { get; set; } = "Tenant.Write";
}
