@inherits AppointmentsBase


@if(Plugin is null)
{
    @if(IsAdmin)
    {
        <Stack>
            <AppointmentFilters @bind-Descriptor="Descriptor" />
        </Stack>
    }
    @if(appointments.Count == 0)
    {
        <Stack>
            <StackButton OnClick="ReloadRequired" Label="@Localizer["NoItems", Localizer["Appointment"]]" HelperText="@Localizer["NoItemsHelp", Localizer["Appointment"]]" EndIcon="fa-regular fa-refresh">
                @Localizer["Reload"]
            </StackButton>
        </Stack>
    }
    else
    {
        <Stack>
            @foreach(var appointment in appointments)
            {
                <StackButton OnClick="() => OnClicked.InvokeAsync(appointment.Id)"
                             Label="@appointment.ScheduledAt.ToString("g")"
                             HighlightString="@SearchString">
                    <AppointmentStatusBadge Status="appointment.Status" />
                </StackButton>
            }
        </Stack>
    }
}
else
{
    @Plugin.Render(new AppointmentsGridPluginContext(OnClicked, OnAdd))
}
