@inherits AppointmentsBase

@if (Appointment is null) { return; }

<Stack>
    <StackField Label="@Appointment.ScheduledAt.ToString("g")" HelperText="@Localizer["Appointment"]">
        <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer[Appointment.Status.ToString()]</MudText>
        @if (!string.IsNullOrWhiteSpace(Appointment.Notes))
        {
            <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Appointment.Notes</MudText>
        }
    </StackField>
    @if (AdminMode)
    {
        <StackButton OnClick="OnEdit"
                     EndIcon="fa-regular fa-pencil"
                     Label="@Localizer["EditItem", Localizer["Appointment"]]" />
        <StackButton OnClick="OnDeleted"
                     Color="Color.Error"
                     EndIcon="fa-regular fa-calendar-xmark"
                     Label="@Localizer["DeleteItem", Localizer["Appointment"]]" />
    }
</Stack>
