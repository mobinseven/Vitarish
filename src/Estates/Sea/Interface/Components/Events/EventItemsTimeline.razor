@inherits EventsBase

<Stack>
    <StackField Label="@Localizer["Attachments"]" Align="Align.Center" />
    @foreach(var item in items)
    {
        @if(!string.IsNullOrWhiteSpace(item.Placeholder))
        {
            <StackField Label="@item.Placeholder" AdornmentIcon="fa-regular fa-circle-notch fa-spin" />
        }
        else
        {
            @item.Content
        }
    }
    @if(CanWrite)
    {
        <EventItemsInput Project="Project" Procedure="Procedure" Event="Event" OnCreated="ReloadRequired" />
    }

</Stack>
