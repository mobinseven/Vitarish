@inherits EventsBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackTextField Label="@Localizer["Title"]" @bind-Value="EventWrite.Title" />
            <StackTextField Label="@Localizer["Description"]" @bind-Value="EventWrite.Description" />
        </Stack>
        <Stack>
            <StackButton Color="Color.Primary" OnClick="SaveAsync" Label="@Localizer["Save"]" EndIcon="fa-regular fa-save" />
            <StackButton EndIcon="fa-regular fa-xmark" Label="@Localizer["Cancel"]" OnClick="Cancel" />
        </Stack>
    </DialogContent>
</MudDialog>
