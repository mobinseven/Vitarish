@inherits EventsBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="EventWrite.Title" Variant=Variant.Outlined Label="@Localizer["Title"]" Immediate />
            <MudTextField @bind-Value="EventWrite.Description" Variant=Variant.Outlined Label="@Localizer["Description"]" AutoGrow />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Close"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@Localizer["Save"]</MudButton>
    </DialogActions>
</MudDialog>
