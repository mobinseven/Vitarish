@inherits ProceduresBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackField Label="@Localizer["AddItem", Localizer["Procedure"]]" />
            <ProcedureTemplatesBrowser @bind-Value="templateProcedure" />
            <StackTextField @bind-Value="ProcedureWriteDto.Name" Label="@Localizer["NameItem", Localizer["Procedure"]]" />
        </Stack>
        <Stack>
            <StackButton Color="Color.Primary" OnClick="SaveAsync" Label="@Localizer["Confirm"]" EndIcon="fa-regular fa-check" />
            <StackButton OnClick="Cancel" Label="@Localizer["Cancel"]" EndIcon="fa-regular fa-xmark" />
        </Stack>
    </DialogContent>
</MudDialog>
