@inherits ProceduresBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackButton Label="@Localizer["SelectItem", Localizer["TemplateItem", Localizer["Procedure"]]]" OnClick="SelectTemplateAsync">
                @if(templateProcedure is not null)
                {
                    <Chip Color="Color.Primary">@templateProcedure.Name</Chip>
                }
            </StackButton>
            <StackTextField @bind-Value="name" Label="@Localizer["NameItem", Localizer["Procedure"]]" />
        </Stack>
        <Stack>
            <StackButton Color="Color.Primary" OnClick="SaveAsync" Label="@Localizer["Confirm"]" EndIcon="fa-regular fa-check" />
            <StackButton OnClick="Cancel" Label="@Localizer["Cancel"]" EndIcon="fa-regular fa-xmark" />
        </Stack>
    </DialogContent>
</MudDialog>
