@inherits ProceduresBase

<Stack>
    <StackField Label="@Localizer["Procedures"]" />
    @foreach(var procedure in procedures)
    {
        <StackButton Label="@procedure.Name" OnClick="@(() => OnClicked.InvokeAsync(procedure.Id))">
            <StatsDisplay Stats="procedure.Stats ?? new StatsReadDto()" />
        </StackButton>
    }

    @if(AdminMode)
    {
        <StackButton OnClick="@(() => AddProcedure())"
                     Color="Color.Primary"
                     StartIcon="fa-regular fa-file-plus"
                     Label="@Localizer["AddItem", Localizer["Procedure"]]" />
    }
</Stack>
