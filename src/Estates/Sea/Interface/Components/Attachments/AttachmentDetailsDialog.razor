@inherits SeaCommonBase
<MudDialog>
    <DialogContent>
        @if(editing)
        {
            <Stack>
                <StackTextField Label="@Localizer["Attachment"]" @bind-Value="editContent" AutoGrow Immediate />
                <StackButton EndIcon="fa-regular fa-save" Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" />
                <StackButton EndIcon="fa-regular fa-xmark" Label="@Localizer["Cancel"]" OnClick="CancelEdit" />
            </Stack>
        }
        else
        {
            <Stack>
                @if(Attachment.ContentType.StartsWith("text"))
                {
                    <StackField Color="Color" Label="@Attachment.Content" HelperText="@GetUserFullNameById(Attachment.CreatedBy)" />
                }
                else
                {
                    <StackField Color="Color" HelperText="@GetUserFullNameById(Attachment.CreatedBy)">
                        @if(Attachment.ContentType.StartsWith("image"))
                        {
                            @if(FileId != Guid.Empty)
                            {
                                <Vitarish.Files.Interface.Components.FileImage FileId="@FileId" Type="@Attachment.ContentType" />
                            }
                            else
                            {
                                <ImageElement Src="@Attachment.Content" Type="@Attachment.ContentType" />
                            }
                        }
                        @if(Attachment.ContentType.StartsWith("video"))
                        {
                            @if(FileId != Guid.Empty)
                            {
                                <Vitarish.Files.Interface.Components.FileVideo FileId="@FileId" Type="@Attachment.ContentType" />
                            }
                            else
                            {
                                <VideoElement Src="@Attachment.Content" Type="@Attachment.ContentType" />
                            }
                        }
                    </StackField>
                }
                @if(readers.Count > 0)
                {
                    <StackExpandable StartIcon="fa-regular fa-check-double" Label="@Localizer["SeenBy", Localizer["PersonCount", readers.Count]]">
                        @foreach(var reader in GetReaders())
                        {
                            <MudText Typo="Typo.caption">@reader</MudText>
                        }
                    </StackExpandable>
                }
                <StackExpandable Label="@Localizer["Details"]">
                    <StackField Label="@Localizer["CreatedAt"]" HelperText="@Attachment.CreatedAt.DateTime.ToShortDateString()" />
                    @if(Attachment.UpdatedAt is not null)
                    {
                        <StackField Label="@Localizer["UpdatedAt"]" HelperText="@Attachment.UpdatedAt.Value.DateTime.ToShortDateString()" />
                    }
                    <StackField Label="@Localizer["ContentType"]" HelperText="@Attachment.ContentType" />
                </StackExpandable>
            </Stack>
            <Stack>
                @if(CanEdit && Attachment.ContentType.StartsWith("text"))
                {
                    <StackButton EndIcon="fa-regular fa-edit" Label="@Localizer["Edit"]" OnClick="StartEdit" />
                }
                @if(CanDelete)
                {
                    <StackButton EndIcon="fa-regular fa-trash" Label="@Localizer["DeleteItem", Localizer["Attachment"]]" OnClick="DeleteAttachment" Color="Color.Error" />
                }
                <StackButton EndIcon="fa-regular fa-xmark" Label="@Localizer["Close"]" OnClick="Close" />
            </Stack>
        }
    </DialogContent>
</MudDialog>
