@inherits SeaCommonBase

<StackField HelperText="@GetUserFullNameById(Attachment.CreatedBy)" AdornmentIcon="@Icon(Attachment.ContentType)" Color="Color" OnAdornmentClick="() => ShowDetails()" Align="Align.Start">
    @if(Attachment.ContentType.StartsWith("image") || Attachment.ContentType.StartsWith("video"))
    {
        <Chip Color="Color" Style="@($"white-space: pre-wrap;height:auto; overflow: auto; background-image: url('{Attachment.ContentThumbnail}'); background-size: cover;")">
            <MudImage Src="@Attachment.ContentThumbnail" Width="100" Style="opacity:0;" @onclick="() => ShowDetails()" />
        </Chip>
    }
    @if(Attachment.ContentType.StartsWith("text"))
    {
        <TextChip Text="@Attachment.Content" />
    }
</StackField>
