@inherits RemindersBase

<MudDialog>
    <DialogContent>

        <Stack>
            <StackField Label="@Localizer["Kind"]">
                <MudRadioGroup T="ReminderKind" @bind-Value=kind>
                    <MudRadio T="ReminderKind" Value="ReminderKind.Sms" Label="@Localizer["Sms"]" />
                    <MudRadio T="ReminderKind" Value="ReminderKind.Email" Label="@Localizer["Email"]" />
                </MudRadioGroup>
            </StackField>
            <StackField Label="@Localizer["Date"]">
                <MudDatePicker PickerVariant="PickerVariant.Inline" @bind-Date="remindDate" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
            </StackField>
            <StackField Label="@Localizer["Time"]">
                <MudTimePicker PickerVariant="PickerVariant.Inline" @bind-Time="remindTime" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
            </StackField>
            <StackButton Label="@Localizer["Recipients"]" OnClick="AddRecipientAsync">
                @foreach(var recipients in recipients)
                {
                    <MudChip Color=Color.Primary T="string">@recipients.Recipient</MudChip>
                }
            </StackButton>
        </Stack>

        <Stack>
            <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" Disabled="recipients.Count == 0" EndIcon="fa-regular fa-save" />
            <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" EndIcon="fa-regular fa-xmark" />
        </Stack>

    </DialogContent>
</MudDialog>
