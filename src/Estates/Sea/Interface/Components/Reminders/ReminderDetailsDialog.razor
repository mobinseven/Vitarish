@inherits RemindersBase

<MudDialog>
    <DialogContent>

        <Stack>
            <StackField Label="@($"{Localizer["Creator"]}: {GetUserFullNameById(Reminder.CreatedBy)}")" />
            <StackField Label="@($"{Localizer["Recipient"]}: {GetUserFullNameById(Reminder.RecipientUserId)}")" />
            <StackField Label="@($"{Localizer["RemindAt"]}: {Reminder.RemindAt.ToLocalTime().DateTime.ToShortDateString()} {Reminder.CreatedAt.ToLocalTime().DateTime.ToShortTimeString()}")" />
            <StackField Label="@($"{Localizer["SentAt"]}: {SentAtText()}")" />
        </Stack>

        <Stack>
            @if(CanDelete)
            {
                <StackButton Label="@Localizer["DeleteItem", Localizer["Reminder"]]" OnClick="DeleteAsync" EndIcon="fa-regular fa-trash" Color="Color.Error" />
            }
            <StackButton Label="@Localizer["Close"]" OnClick="Close" EndIcon="fa-regular fa-xmark" />
        </Stack>

    </DialogContent>
</MudDialog>
