@inherits SeaCommonBase

<MudDialog>
    <DialogContent>
        <div>
            <MudStack Row Justify="Justify.Center">
                <MudIcon Icon="@Icon" Size="Size.Large" />
            </MudStack>
            <MudSimpleTable Elevation="0">
                <tbody>
                    <tr><td>@Localizer["Events"]</td><td>@Stats.Events</td></tr>
                    <tr><td>@Localizer["Committed"]</td><td>@Stats.CommittedEvents</td></tr>
                    <tr><td>@Localizer["Attachments"]</td><td>@Stats.EventItems</td></tr>
                    <tr><td>@Localizer["NewItems"]</td><td>@Stats.NewItems</td></tr>
                </tbody>
            </MudSimpleTable>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Close"]</MudButton>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!; 
    [Parameter, EditorRequired] public StatsReadDto Stats { get; set; }
    [Parameter, EditorRequired] public string Icon { get; set; }

    private void Cancel() => MudDialog.Cancel();

}
