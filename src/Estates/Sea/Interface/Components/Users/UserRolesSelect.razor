@inherits UsersBase

<MudTable Items="@roles" Dense="true" Elevation="0" Breakpoint=Breakpoint.None HorizontalScrollbar=false ContainerStyle="overflow-y: unset;" ContainerClass="pa-1">
    <HeaderContent>
        <MudTh>@Localizer["Role"]</MudTh>
        <MudTh>
            <MudCheckBox T="bool?" TriState="true" Value="@selectAllRead" ValueChanged="@((bool? b) => OnSelectAllChanged(RoleType.Read, b))" Label="@Localizer["Read"]" />
        </MudTh>
        <MudTh>
            <MudCheckBox T="bool?" TriState="true" Value="@selectAllWrite" ValueChanged="@((bool? b) => OnSelectAllChanged(RoleType.Write, b))" Label="@Localizer["Write"]" />
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@Localizer["Role"]">@context.Name</MudTd>
        <MudTd DataLabel="@Localizer["Reader"]">
            <MudCheckBox T="bool" Value="@IsAssigned(context.Id, RoleType.Read)" ValueChanged="@((bool b) => OnRoleChanged(context.Id, RoleType.Read, b))" />
        </MudTd>
        <MudTd DataLabel="@Localizer["Writer"]">
            <MudCheckBox T="bool" Value="@IsAssigned(context.Id, RoleType.Write)" ValueChanged="@((bool b) => OnRoleChanged(context.Id, RoleType.Write, b))" />
        </MudTd>
    </RowTemplate>
</MudTable>
