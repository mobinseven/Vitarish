@inherits ProjectEditForm


@if(projectWriteDto is null)
{
    return;
}
<Stack>
    @if(TemplateMode)
    {
        <StackTextField @bind-Value="projectWriteDto.LastName"
                        Required
                        Label="@Localizer["Title"]" />

        <StackTextField @bind-Value="projectWriteDto.ClinicalNotes"
                        Lines="4"
                        Label="@Localizer["Description"]" />
    }
    else
    {
        <StackTextField @bind-Value="projectWriteDto.FirstName"
                        Label="@Localizer["FirstName"]" />

        <StackTextField @bind-Value="projectWriteDto.LastName"
                        DebounceInterval="500"
                        Required
                        Label="@Localizer["LastName"]" />

        <StackField>
            <MudDatePicker @bind-Date="projectWriteDto.DateOfBirth"
                           Variant="Variant.Filled"
                           DateFormat="dd/MM/yyyy"
                           Label="@Localizer["DateOfBirth"]" />
        </StackField>

        <StackField>
            <MudDatePicker @bind-Date="projectWriteDto.DateOfSurgery"
                           Variant="Variant.Filled"
                           DateFormat="dd/MM/yyyy"
                           Label="@Localizer["DateOf", Localizer["Surgery"]]" />
        </StackField>

        <StackField>
            <MudRadioGroup T="Gender"
                           @bind-Value="projectWriteDto.Gender">
                <MudRadio Value="@Gender.Female">@Localizer["Female"]</MudRadio>
                <MudRadio Value="@Gender.Male">@Localizer["Male"]</MudRadio>
            </MudRadioGroup>
        </StackField>

        <StackTextField @bind-Value="projectWriteDto.ClinicalNotes"
                        Lines="4"
                        Label="@Localizer["Notes"]" />

        <StackExpandable Label="@Localizer["ClinicalData"]">
            <MudTextField @bind-Value="projectWriteDto.PlaceOfBirth"
                          Label="@Localizer["PlaceOfBirth"]" />
            <MudTextField @bind-Value="projectWriteDto.Email"
                          Label="@Localizer["Email"]"
                          InputType="InputType.Email" />
            <MudTextField @bind-Value="projectWriteDto.Phone"
                          Label="@Localizer["Phone"]"
                          InputType="InputType.Telephone" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="projectWriteDto.InsuranceProvider"
                          Label="@Localizer["InsuranceProvider"]" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="projectWriteDto.VisitReason"
                          Label="@Localizer["VisitReason"]" />
            <MudTextField @bind-Value="projectWriteDto.Allergies"
                          Label="@Localizer["Allergies"]" />
            <MudTextField @bind-Value="projectWriteDto.CurrentMedications"
                          Label="@Localizer["CurrentMedications"]" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="projectWriteDto.EmergencyContactName"
                          Label="@Localizer["EmergencyContactName"]" />
            <MudTextField @bind-Value="projectWriteDto.EmergencyContactPhone"
                          Label="@Localizer["EmergencyContactPhone"]" />
        </StackExpandable>
    }
    <StackButton Label="@Localizer["Save"]" EndIcon="fa-regular fa-save" Color="Color.Primary" OnClick="SaveAsync" />
    @if(OnCancel.HasDelegate)
    {
        <StackButton Label="@Localizer["Cancel"]" EndIcon="fa-regular fa-xmark" OnClick="() => OnCancel.InvokeAsync()" />
    }
</Stack>

    @code {
    private ClinicProjectWriteDto projectWriteDto = new();
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if(Project is not null)
        {
            projectWriteDto = ClinicProjectWriteDto.ToWrite(Project)!;
        }

        if(Project is not null && string.IsNullOrWhiteSpace(projectWriteDto.LastName))
        {
            projectWriteDto.LastName = Project.Name;
        }
        StateHasChanged();
    }

    protected override async Task SaveAsync()
    {
        projectWriteDto.Name = $"{projectWriteDto.FirstName} {projectWriteDto.LastName}".TrimEnd(' ', ',');
        if(string.IsNullOrWhiteSpace(projectWriteDto.Name))
        {
            await DialogService.ShowMessageBox(null, Localizer["RequiredItem", Localizer["LastName"]]);
            return;
        }
        if(Project is null)
        {
            var created = await ProjectsService.AddAsync(projectWriteDto, CancellationToken.None).EnsureValueAsync();
            await OnCreate.InvokeAsync(created.Id);
        }
        else
        {
            await ProjectsService.UpdateAsync(projectWriteDto, CancellationToken.None);
            await OnUpdate.InvokeAsync(Project.Id);
        }
    }
}
