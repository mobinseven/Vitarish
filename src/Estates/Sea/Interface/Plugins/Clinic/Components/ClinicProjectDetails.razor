@inherits ProjectDetails

<Stack>
    <StackField Label="@Project.Name">
        @if(!string.IsNullOrWhiteSpace(Project.Description))
        {
            <MudText HtmlTag="p" Typo="Typo.caption" Class="py-3">@Project.Description</MudText>
        }
        @if(project is not null)
        {
            @if(!string.IsNullOrWhiteSpace(project.ClinicalNotes))
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-3">@Localizer["ClinicalNotes"]: @project.ClinicalNotes</MudText>
            }
            @if(project.DateOfSurgery.HasValue)
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-3">@Localizer["DateOf", Localizer["Surgery"]]: @project.DateOfSurgery.Value.ToShortDateString()</MudText>
            }
        }
    </StackField>

    @if(AdminMode)
    {
        <StackButton OnClick="@(() => EditProject())"
                     StartIcon="fa-regular fa-pencil"
                     Label="@Localizer["EditItem", Localizer["Project"]]" />
        <StackButton OnClick="@(() => DeleteProject())"
                     Color="Color.Error"
                     StartIcon="fa-regular fa-folder-xmark"
                     Label="@Localizer["DeleteItem", Localizer["Project"]]" />
    }
</Stack>

@code {
    ClinicProjectReadDto? project;

    protected override void OnInitialized()
    {
        project = Project.ToClinicRead();
    }
}
