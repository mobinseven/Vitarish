@inherits ProjectFormBase<ClinicProjectMetadata, ClinicProjectMetadataModel>


@if(EditableMetadata is null)
{
    return;
}
<Stack>
    @if(TemplateMode)
    {
        <StackTextField @bind-Value="EditableMetadata.LastName"
                        Required
                        Label="@Localizer["Title"]" />

        <StackTextField @bind-Value="EditableMetadata.ClinicalNotes"
                        Lines="4"
                        Label="@Localizer["Description"]" />
    }
    else
    {
        <StackTextField @bind-Value="EditableMetadata.FirstName"
                        Label="@Localizer["FirstName"]" />

        <StackTextField @bind-Value="EditableMetadata.LastName"
                        DebounceInterval="500"
                        Required
                        Label="@Localizer["LastName"]" />

        <StackField>
            <MudDatePicker @bind-Date="EditableMetadata.DateOfBirth"
                           Variant="Variant.Filled"
                           DateFormat="dd/MM/yyyy"
                           Label="@Localizer["DateOfBirth"]" />
        </StackField>

        <StackField>
            <MudDatePicker @bind-Date="EditableMetadata.DateOfSurgery"
                           Variant="Variant.Filled"
                           DateFormat="dd/MM/yyyy"
                           Label="@Localizer["DateOf", Localizer["Surgery"]]" />
        </StackField>

        <StackField>
            <MudRadioGroup T="Gender"
                           @bind-Value="EditableMetadata.Gender">
                <MudRadio Value="@Gender.Female">@Localizer["Female"]</MudRadio>
                <MudRadio Value="@Gender.Male">@Localizer["Male"]</MudRadio>
            </MudRadioGroup>
        </StackField>

        <StackTextField @bind-Value="EditableMetadata.ClinicalNotes"
                        Lines="4"
                        Label="@Localizer["Notes"]" />

        <StackExpandable Label="@Localizer["ClinicalData"]">
            <MudTextField @bind-Value="EditableMetadata.PlaceOfBirth"
                          Label="@Localizer["PlaceOfBirth"]" />
            <MudTextField @bind-Value="EditableMetadata.Email"
                          Label="@Localizer["Email"]"
                          InputType="InputType.Email" />
            <MudTextField @bind-Value="EditableMetadata.Phone"
                          Label="@Localizer["Phone"]"
                          InputType="InputType.Telephone" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="EditableMetadata.InsuranceProvider"
                          Label="@Localizer["InsuranceProvider"]" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="EditableMetadata.VisitReason"
                          Label="@Localizer["VisitReason"]" />
            <MudTextField @bind-Value="EditableMetadata.Allergies"
                          Label="@Localizer["Allergies"]" />
            <MudTextField @bind-Value="EditableMetadata.CurrentMedications"
                          Label="@Localizer["CurrentMedications"]" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="EditableMetadata.EmergencyContactName"
                          Label="@Localizer["EmergencyContactName"]" />
            <MudTextField @bind-Value="EditableMetadata.EmergencyContactPhone"
                          Label="@Localizer["EmergencyContactPhone"]" />
        </StackExpandable>
    }
    <StackButton Label="@Localizer["Save"]" EndIcon="fa-regular fa-save" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(!isValid)" />
    @if(OnCancel.HasDelegate)
    {
        <StackButton Label="@Localizer["Cancel"]" EndIcon="fa-regular fa-xmark" OnClick="() => OnCancel.InvokeAsync()" />
    }
</Stack>

@code {

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var model = new ClinicProjectMetadataModel(OnMetadataChenged);
        if(Project is not null)
        {
            model.LoadFrom(Project.GetClinicProjectMetadata());
        }
        else
        {
            model.LoadFrom(new ClinicProjectMetadata());
        }
        InitializeEditableMetadata(model);

        if(Project is not null && string.IsNullOrWhiteSpace(EditableMetadata.LastName))
        {
            EditableMetadata.LastName = Project.Name;
        }
        StateHasChanged();
    }

    private async void OnMetadataChenged()
    {
        SetMetadata(EditableMetadata.GetModel());
        StateHasChanged();
    }

    string? title => (string.IsNullOrWhiteSpace(EditableMetadata.FirstName) ? Metadata?.LastName : $"{Metadata?.FirstName} {Metadata?.LastName}");

    private bool isValid => !string.IsNullOrWhiteSpace(title);

    protected override async Task SaveAsync()
    {
        if(!isValid)
        {
            return;
        }
        if(Project is null)
        {
            var created = await ProjectsService.AddAsync(title, Metadata?.ClinicalNotes ?? string.Empty, TemplateMode, MetadataJson, CancellationToken.None);
            await OnCreate.InvokeAsync(created);
        }
        else
        {
            await ProjectsService.UpdateAsync(Project.Id, title, Metadata?.ClinicalNotes ?? string.Empty, TemplateMode, MetadataJson, CancellationToken.None);
            await OnUpdate.InvokeAsync(Project.Id);
        }
    }
}
