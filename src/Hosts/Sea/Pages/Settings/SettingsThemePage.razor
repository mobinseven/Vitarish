@page "/settings/theme"
@inherits SettingsSectionPageBase


@inject IUsageConfigurationClient UsageConfigurationService
@inject IThemeService ThemeService

<div style="position: sticky; top: 10px; z-index: 1;">
    <WidthControlled ControlledWidth="50vw">
        <MudPaper Class="py-5" Elevation="0">
            <SettingsBreadcrumbs Items="Breadcrumbs" />
        </MudPaper>
    </WidthControlled>
</div>

<WidthControlled ControlledWidth="50vw">

    @if (!AccessService.Access.Admin)
    {
        <MudAlert Severity="Severity.Warning">@Localizer["AccessDenied"]</MudAlert>
    }
    else
    {
        <MudPaper Class="glass mt-5" Elevation="0">
            <MudStack Spacing="3" Class="pa-6">
                <ThemeForm OnThemeChanged="OnThemeChangedAsync" />
            </MudStack>
        </MudPaper>
    }
</WidthControlled>

<div style="height: 50dvh;">
    <hr />
</div>

@code
{
    private UsageConfigurationDto? _usageConfiguration;
    private UsageConfigurationMetadata _metadata = new();

    private IReadOnlyList<BreadcrumbItem> Breadcrumbs => BuildBreadcrumbs(Localizer["Theme"]);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if(!AccessService.Access.Admin)
        {
            return;
        }

        await LoadConfigurationAsync().ConfigureAwait(false);
    }

    private async Task LoadConfigurationAsync()
    {
        _usageConfiguration = await UsageConfigurationService.GetAsync(CancellationToken.None).ConfigureAwait(false);
        _metadata = UsageConfigurationMetadata.FromJson(_usageConfiguration?.Metadata);
        string? themeSettingsJson = _metadata.ThemeSettingsJson;
        if(!string.IsNullOrWhiteSpace(themeSettingsJson))
        {
            ThemeService.LoadThemeSettingsJson(themeSettingsJson);
        }
    }

    private async Task OnThemeChangedAsync(string json)
    {
        if(string.IsNullOrWhiteSpace(json))
        {
            return;
        }

        ThemeService.LoadThemeSettingsJson(json);

        UsageConfigurationDto configuration = _usageConfiguration
            ?? await UsageConfigurationService.GetAsync(CancellationToken.None).ConfigureAwait(false)
            ?? new(Guid.Empty, null, "{}");

        UsageConfigurationMetadata metadata = UsageConfigurationMetadata.FromJson(configuration.Metadata);

        if(string.Equals(metadata.ThemeSettingsJson, json, StringComparison.Ordinal))
        {
            return;
        }

        metadata.ThemeSettingsJson = json;
        configuration.Metadata = metadata.ToJson();

        UsageConfigurationDto? updated = await UsageConfigurationService.UpdateAsync(configuration, CancellationToken.None).ConfigureAwait(false);
        _usageConfiguration = updated ?? configuration;
        _metadata = metadata;
    }
}

