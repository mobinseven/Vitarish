@page "/Admin/Chat"
@inject IMcpToolProvider McpToolProvider
@inject IUsageConfigurationClient UsageConfigurationService

<EndOfScroll />

<div style="height: 20dvh;">
    <hr />
</div>

<WidthControlled ControlledWidth="50vw">
    <MudPaper Elevation="0" Class="ma-1">
        <AiResponderChat Options="@_options" />
    </MudPaper>
</WidthControlled>

<div style="height: 20dvh;">
    <hr />
</div>


@code {
    ResponderOptions _options = new();
    string? _chatInstructions;

    protected override async Task OnInitializedAsync()
    {
        UsageConfigurationDto? usageConfiguration = await UsageConfigurationService.GetUsageConfigurationAsync(CancellationToken.None);
        UsageConfigurationMetadata metadata = UsageConfigurationMetadata.FromJson(usageConfiguration?.Metadata);
        
        // Get plugin identifiers from usage configuration metadata (per tenant in DB)
        IReadOnlyList<string> pluginIdentifiers = metadata.PluginIdentifiers ?? [];
        IReadOnlyList<ResponderToolDefinition> tools = await McpToolProvider.GetDefinitionsAsync(pluginIdentifiers, false);
        string? preferredPlugin = pluginIdentifiers.FirstOrDefault(static p => !string.IsNullOrWhiteSpace(p))?.Trim();
        
        _chatInstructions = string.IsNullOrWhiteSpace(metadata.ChatInstructions)
            ? null
            : metadata.ChatInstructions.Trim();
        string? chatModel = string.IsNullOrWhiteSpace(metadata.ChatModel)
            ? null
            : metadata.ChatModel.Trim();
        _options = CreateResponderOptions(tools, preferredPlugin, pluginIdentifiers, _chatInstructions, chatModel);
    }

    private static ResponderOptions CreateResponderOptions(
        IReadOnlyList<ResponderToolDefinition> tools,
        string? preferredPlugin,
        IReadOnlyList<string> pluginIdentifiers,
        string? chatInstructions,
        string? chatModel)
        => new()
        {
            Tools = tools,
            Instructions = chatInstructions,
            Model = chatModel,
            EnableWebSearchTool = true
        };
}
