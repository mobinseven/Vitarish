@inject IStringLocalizer Localizer
<Router AppAssembly="typeof(App).Assembly" OnNavigateAsync="OnNavigating">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" Context="auth" DefaultLayout="typeof(MainLayout)" Resource="@ClientIdentityContext.ClientId">
            <Authorizing>
            </Authorizing>
            <NotAuthorized>
                <WidthControlled>
                    <div style="width: 100%;height: 500px;" class="pa-20">
                        @if(auth.User.Identity is not null && auth.User.Identity.IsAuthenticated)
                        {
                            <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Class="pa-10 glass">
                                <MudText Align="Align.Center" Typo="Typo.h6" Class="my-5">@Localizer["AccessDenied"]</MudText>
                                <MudText Align="Align.Center" Typo="Typo.body1" Class="my-3">@Localizer["ContactAdministrator"]</MudText>
                                <Logout>
                                    <SubmitButton>
                                        <MudButton Variant="Variant.Filled" Color="Color.Error" ButtonType="ButtonType.Submit" FullWidth>
                                            @Localizer["Logout"]
                                        </MudButton>
                                    </SubmitButton>
                                </Logout>
                            </MudStack>
                        }
                        else
                        {
                            <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Class="pa-10 glass">
                                <MudText Typo="Typo.h6">
                                    @Localizer["LoginRequired"]
                                </MudText>
                                <Login>
                                    <SubmitButton>
                                        <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" FullWidth>
                                            @Localizer["Continue"]
                                        </MudButton>
                                    </SubmitButton>
                                </Login>
                            </MudStack>
                        }
                    </div>
                </WidthControlled>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <MudAlert Severity="Severity.Error" NoIcon>Not Found</MudAlert>
        </LayoutView>
    </NotFound>
</Router>
<AntiforgeryToken />
