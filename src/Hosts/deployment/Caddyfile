{
    email {$VITARISH_ACME_EMAIL}
    servers {
        protocols h1 h2
    }
}

(security_headers) {
    # NSMAIL-1 unsafe methods: TRACE and plain CONNECT have no product use;
    # answer them at the ingress so no upstream sees them. Extended CONNECT
    # (RFC 8441, carries :protocol) is how browsers open WebSockets over
    # HTTP/2 and must still reach the /api WebSocket endpoints.
    @unsafe_method {
        method TRACE CONNECT
        not header :protocol *
    }
    respond @unsafe_method 405
    # This ingress is the single owner of the NSMAIL-1 response headers. The
    # request CSP carries the per-request nonce read by the Next.js layouts.
    request_header Content-Security-Policy "{$VITARISH_CONTENT_SECURITY_POLICY}"
    tls {
        protocols tls1.2 tls1.3
        ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        curves secp256r1 secp384r1 secp521r1
        key_type p256
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
    encode gzip
    header {
        # The ingress owns these response headers. defer applies them after
        # reverse_proxy so they replace an upstream value (Main also sends HSTS
        # when it requires HTTPS) instead of being sent twice.
        defer
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        # Modern browsers ignore X-XSS-Protection; it is present for evaluator
        # compliance only.
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy-Report-Only "{$VITARISH_CONTENT_SECURITY_POLICY}"
    }
    # NSMAIL-1 caching policy: the ingress wins for HTML documents and API
    # responses so revalidation cannot be weakened by an upstream default.
    # Main's narrower no-store audit-export policy remains satisfied because
    # no-store stays present. Content-hashed files under /_next/static/* are
    # excluded so the upstream long-lived immutable Cache-Control is preserved.
    @revalidated not path /_next/static/*
    header @revalidated {
        # defer applies these after reverse_proxy, so they replace upstream
        # values instead of being joined with them.
        defer
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
    }
}

(brand_fonts) {
    # The licensed Ahang font is in no image or repository file (docs/hosts/web/brand-font.md). The
    # ingress serves the operator's copy, mounted from VITARISH_BRAND_FONT_DIR, at the one URL
    # @vitarish/ui/typography.css requests; without the file browsers fall back to system fonts.
    handle /fonts/ahang/AhangVariable.woff {
        root * /srv/brand-fonts
        rewrite * /AhangVariableGX.woff
        file_server
    }
}

(test_api) {
    @api path /api/*
    reverse_proxy @api test-main:8080
}

(production_api) {
    @api path /api/*
    reverse_proxy @api production-main:8080
}

(production_readiness) {
    # Expose Main readiness only on its public application host for origin-pinned release checks.
    handle /health/ready {
        # handle runs before the site-wide unsafe-method guard, so readiness
        # answers only GET/HEAD itself and never forwards other methods.
        @readiness_unsafe_method not method GET HEAD
        respond @readiness_unsafe_method 405
        reverse_proxy production-main:8080
    }
}

