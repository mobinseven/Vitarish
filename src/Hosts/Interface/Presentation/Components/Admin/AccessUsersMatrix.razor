@if(rows is not null)
{
    <MudDataGrid T="AccessUserModel"
                 Items="rows"
                 EditTrigger="DataGridEditTrigger.Manual"
                 EditMode="DataGridEditMode.Cell"
                 ReadOnly=false
                 Bordered="true"
                 Elevation="0"
                 Dense="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer["AccessClaims"]</MudText>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="u => u.User.LastName"
                            Title="@Localizer["UserName"]"
                            Editable="false">
                <CellTemplate>
                    <MudText Color="@(context.Item.Access.Entrance ? Color.Success : Color.Default)">
                        @context.Item.User.LastName
                    </MudText>
                    <MudText Typo="Typo.caption">
                        @context.Item.User.UserName
                    </MudText>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="u => u.Access"
                            Title="@Localizer["Access"]"
                            Editable="true"
                            Required=false>
                <EditTemplate Context="context">
                    <RoleEditor @bind-Read="context.Item.Access.Read"
                                @bind-Write="context.Item.Access.Write"
                                Roles="roles" />
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="u => u.Access.Admin"
                            Title="@Localizer["Admin"]"
                            Editable="true">
                <EditTemplate Context="context">
                    <MudCheckBox T="bool" @bind-Value="context.Item.Access.Admin" />
                </EditTemplate>
            </PropertyColumn>
        </Columns>
    </MudDataGrid>
}
else
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
