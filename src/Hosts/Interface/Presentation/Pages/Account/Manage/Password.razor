@page "/Account/Manage/Password"

@inherits IdentityBase

<StatusMessage />

<MudText Typo="Typo.h4" GutterBottom="true" Align="Align.Center">@Localizer["Password"]</MudText>

<PasswordChangeForm UserId="@HttpContext?.User.Claims.FirstOrDefault(c => c.Type == "sub")?.Value" @rendermode=InteractiveServer ReturnUrl="@ReturnUrl" FailureUrl="@FailureUrl" />

<form method="get" action="/Account/Manage">
    <MudButton FullWidth="true" ButtonType="ButtonType.Submit">@Localizer["Profile"]</MudButton>
</form>
