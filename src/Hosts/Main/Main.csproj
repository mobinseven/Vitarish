<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
		<OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
		<OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
		<OpenApiDocumentsDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', 'src', 'Hosts', 'Web', 'src', 'api', 'specs'))</OpenApiDocumentsDirectory>

	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Duende.IdentityServer.AspNetIdentity" />
		<PackageReference Include="Duende.IdentityServer.EntityFramework" />
		<PackageReference Include="Hangfire.PostgreSql" />
		<PackageReference Include="Hangfire.AspNetCore" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<TreatAsUsed>true</TreatAsUsed>
		</PackageReference>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
		<PackageReference Include="StackExchange.Redis" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Apps\Aggregator\Core\Apps.Aggregator.Core.csproj" />
		<ProjectReference Include="..\..\Apps\Landing\Application\Landing.Application.csproj" />
		<ProjectReference Include="..\..\Apps\Base\Client\Apps.Base.Client.csproj" />
		<ProjectReference Include="..\..\Libraries\Audit\Audit.Server\Audit.Server.csproj" />
		<ProjectReference Include="..\..\Modules\Authentication\Module\Authentication.Module.csproj" />
		<ProjectReference Include="..\..\Modules\Journey\Module\Journey.Module.csproj" />
		<ProjectReference Include="..\..\Modules\Base\Infrastructure\Modules.Base.Infrastructure.csproj" />
		<ProjectReference Include="..\..\Modules\Requests\Client\Requests.Client.csproj" />
		<ProjectReference Include="..\..\Modules\Sea\Application\Sea.Application.csproj" />
		<ProjectReference Include="..\..\Modules\Users\Domain\Users.Domain.csproj" />
		<ProjectReference Include="..\..\Modules\Users\Infrastructure\Users.Infrastructure.csproj" />
	</ItemGroup>

</Project>
