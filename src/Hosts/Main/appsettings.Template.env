# Connection strings
ConnectionStrings__AaasDb="Server=localhost;Database=vitarish;User Id=sa;Password=change-me;TrustServerCertificate=True;"
ConnectionStrings__Redis="localhost:6379,password=change-me,ssl=False"
ConnectionStrings__Minio="Endpoint=localhost;Port=9000;UseSsl=false;AccessKey=minioadmin;SecretKey=change-me;BucketName=vitarish;Region=us-east-1;ObjectPrefix=vorn"

# Identity and data protection
Vorn__Aaas__Authority="https://localhost:5001"
Vorn__Aaas__DataProtectionPassword="change-me"

# Accounts verification SMS shielding
Vitarish__Accounts__VerificationSmsShield__verificationSmsCooldownSeconds=60
Vitarish__Accounts__VerificationSmsShield__verificationSmsRecentRequestCleanupIntervalSeconds=30
Vitarish__Accounts__VerificationSmsShield__verificationSmsMaximumRecentRequestCount=10000

# AI module options
Vorn__Ai__DefaultTranscriptionModel="gpt-4o-mini-transcribe"
Vorn__Ai__DefaultResponseModel="gpt-5-nano-2025-08-07"
Vorn__Ai__Ollama__BaseUrl="http://localhost:11434"
Vorn__Ai__Ollama__DefaultModel="llama3.2"
Vorn__Ai__Ollama__DefaultTranscriberModel="whisper"
Vorn__Ai__OpenAi__ApiKey="change-me"
Vorn__Ai__Google__Speech__ProjectId="google-project-id"
Vorn__Ai__Google__Speech__Location="us-central1"
Vorn__Ai__Google__Speech__RecognizerId="default"
Vorn__Ai__Google__Speech__CredentialsPath="/path/to/google/credentials.json"
Vorn__Ai__Google__Speech__DefaultLanguageCode="en-US"
Vorn__Ai__Google__Speech__DefaultModelId="long"
Vorn__Ai__Google__Speech__SupportedModels__0="long"
Vorn__Ai__Google__Speech__SupportedModels__1="short"
Vorn__Ai__Google__Speech__SupportedModels__2="chirp"
Vorn__Ai__Google__Speech__SupportedModels__3="chirp-v2"
Vorn__Ai__Google__Speech__SupportedModels__4="medical_dictation"
Vorn__Ai__Google__Gemini__ApiKey="change-me"
Vorn__Ai__QuickRewriteInstructions="Rewrite the provided text in a quick, clear manner while retaining the original meaning."

# Files module options
Vorn__Files__Prefix="uploads"
Vorn__Files__BaseUrl="https://localhost:5001/files"
Vorn__Files__UploadPath="./uploads"

# Communication providers
Vorn__Providers__SmsDotIr__Key="change-me"
Vorn__Providers__SmsDotIr__LineNumber="3000500"
Vorn__Providers__SmsDotIr__VerificationCodeTemplateId="change-me"
Vorn__Providers__Smtp__Host="smtp.example.com"
Vorn__Providers__Smtp__Port=587
Vorn__Providers__Smtp__EnableSsl=true
Vorn__Providers__Smtp__Name="Vitarish"
Vorn__Providers__Smtp__Username="smtp-user"
Vorn__Providers__Smtp__Password="change-me"

# Notification recipients
Vorn__Notifications__StartupSmsRecipient="+15551234567"
Vorn__Notifications__HealthFailureSmsRecipient="+15557654321"

# Instagram scraper
Vorn__InstagramScraper__ApifyToken="change-me"

# Hangfire background jobs
Hangfire__WorkerCount=4
Hangfire__EnableDashboard=true
