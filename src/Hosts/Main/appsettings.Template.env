# Connection strings
ConnectionStrings__AaasDb="Server=localhost;Database=vitarish;User Id=sa;Password=change-me;TrustServerCertificate=True;"
ConnectionStrings__Redis="localhost:6379,password=change-me,ssl=False"
ConnectionStrings__Minio="Endpoint=localhost;Port=9000;UseSsl=false;AccessKey=minioadmin;SecretKey=change-me;BucketName=vitarish;Region=us-east-1;ObjectPrefix=vorn"

# Public landing application
Vitarish__LandingUrl="https://localhost:3002"

# Identity and data protection
Vorn__Aaas__Authority="https://localhost:5001"
Vorn__Aaas__DataProtectionPassword="change-me"

# Accounts verification SMS shielding
Vitarish__Accounts__VerificationSmsShield__verificationSmsCooldownSeconds=60
Vitarish__Accounts__VerificationSmsShield__verificationSmsRecentRequestCleanupIntervalSeconds=30
Vitarish__Accounts__VerificationSmsShield__verificationSmsMaximumRecentRequestCount=10000

# Intelligence module options
Vitarish__Intelligence__DefaultTranscriptionModel="gpt-4o-mini-transcribe"
Vitarish__Intelligence__DefaultResponseModel="gpt-5.6-luna"
Vitarish__Intelligence__LiveTranscription__Enabled=true
Vitarish__Intelligence__LiveTranscription__Languages__0="fa-IR"
Vitarish__Intelligence__LiveTranscription__Languages__1="en-US"
Vitarish__Intelligence__LiveTranscription__MimeTypes__0="audio/webm;codecs=opus"
Vitarish__Intelligence__LiveTranscription__MimeTypes__1="audio/webm"
Vitarish__Intelligence__LiveTranscription__MaxFrameBytes=65536
Vitarish__Intelligence__LiveTranscription__MaxTotalBytes=12582912
Vitarish__Intelligence__LiveTranscription__MaxDurationSeconds=270
Vitarish__Intelligence__LiveTranscription__IdleTimeoutSeconds=20
Vitarish__Intelligence__LiveTranscription__ProviderOperationTimeoutSeconds=285
Vitarish__Intelligence__LiveTranscription__ChannelCapacity=8
Vitarish__Intelligence__Ollama__BaseUrl="http://localhost:11434"
Vitarish__Intelligence__Ollama__DefaultModel="llama3.2"
Vitarish__Intelligence__Ollama__DefaultTranscriberModel="whisper"
Vitarish__Intelligence__OpenAi__ApiKey="change-me"
Vitarish__Intelligence__Google__Speech__ProjectId="google-project-id"
Vitarish__Intelligence__Google__Speech__Location="us-central1"
Vitarish__Intelligence__Google__Speech__RecognizerId="default"
Vitarish__Intelligence__Google__Speech__CredentialsPath=""
Vitarish__Intelligence__Google__Speech__DefaultLanguageCode="en-US"
Vitarish__Intelligence__Google__Speech__DefaultModelId="long"
Vitarish__Intelligence__Google__Speech__SupportedModels__0="long"
Vitarish__Intelligence__Google__Speech__SupportedModels__1="short"
Vitarish__Intelligence__Google__Speech__SupportedModels__2="chirp"
Vitarish__Intelligence__Google__Speech__SupportedModels__3="chirp-v2"
Vitarish__Intelligence__Google__Speech__SupportedModels__4="medical_dictation"
Vitarish__Intelligence__Google__Gemini__ApiKey="change-me"
Vitarish__Intelligence__QuickRewriteInstructions="Rewrite the provided text in a quick, clear manner while retaining the original meaning."

# Files module options
Vorn__Files__Prefix="uploads"
Vorn__Files__BaseUrl="https://localhost:5001/files"
Vorn__Files__UploadPath="./uploads"

# Communication providers
Vorn__Providers__SmsDotIr__Key="change-me"
Vorn__Providers__SmsDotIr__LineNumber="3000500"
Vorn__Providers__SmsDotIr__VerificationCodeTemplateId="change-me"
Vorn__Providers__Smtp__Host="smtp.example.com"
Vorn__Providers__Smtp__Port=587
Vorn__Providers__Smtp__EnableSsl=true
Vorn__Providers__Smtp__Name="Vitarish"
Vorn__Providers__Smtp__Username="smtp-user"
Vorn__Providers__Smtp__Password="change-me"

# Notification recipients
Vorn__Notifications__StartupSmsRecipient="+15551234567"
Vorn__Notifications__HealthFailureSmsRecipient="+15557654321"

# Instagram scraper
Vorn__InstagramScraper__ApifyToken="change-me"

# Hangfire background jobs
Hangfire__WorkerCount=4
Hangfire__EnableDashboard=true

# CORS allowed origins
# Local React web host origins used by the Next.js development server.
Cors__AllowedOrigins__0="http://localhost:3000"
Cors__AllowedOrigins__1="https://localhost:3000"
Cors__AllowedOrigins__2="https://app.localhost"
Cors__AllowedOrigins__3="https://app.yourdomain.com"
