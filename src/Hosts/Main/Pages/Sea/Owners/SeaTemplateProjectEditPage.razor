@inherits SeaProjectPage

@page "/sea/Projects/Templates/Edit/{projectId}"

<CascadingValue Value="IsAdmin">

    <ProjectEditForm Project="Project"
                     OnUpdate="@(projectId => NavigationManager.NavigateTo($"/sea/Projects/Templates/{projectId}"))"
                     OnCreate="@(projectId => NavigationManager.NavigateTo($"/sea/Projects/Templates/{projectId}"))"
                     OnCancel="@(() => NavigationManager.NavigateTo($"/sea/Projects/Templates/{projectId}"))"
                     TemplateMode="true"/>

</CascadingValue>
