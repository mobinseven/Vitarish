@inherits SeaUserEventPage
@attribute [Route(AppRoutes.Sea.OwnerTemplateEventTemplate)]

@if(Project is null || Procedure is null || Event is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <EventItemsTimeline Event="Event" Procedure="Procedure" Project="Project" />
    <EventDetails Event="Event" Procedure="Procedure" Project="Project"
                  OnDelete="@(() => NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProcedure(ProjectId, ProcedureId)))" />
</CascadingValue>
