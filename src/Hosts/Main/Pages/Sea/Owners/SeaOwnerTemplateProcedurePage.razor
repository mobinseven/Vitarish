@inherits SeaUserProcedurePage
@attribute [Route(AppRoutes.Sea.OwnerTemplateProcedureTemplate)]

@if(Project is null || Procedure is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <EventsGrid Project="@Project"
                EventClicked="@(id => { if (id.HasValue) NavigationManager.NavigateTo(AppRoutes.Sea.TemplateEvent(ProjectId, ProcedureId, id.Value)); })"
                Procedure="Procedure" />
    <ProcedureDetails Procedure="Procedure" Project="Project" OnDelete="@(() => NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProject(ProjectId)))" />
</CascadingValue>
