@inherits SeaUserProjectPage

@attribute [Route(AppRoutes.Sea.OwnerTemplateProjectTemplate)]

@if(Project is null)
{
    return;
}

<CascadingValue Value="IsAdmin">

    <ProceduresGrid Project="@Project"
                    OnClicked="@(procedureId => { if (procedureId.HasValue) NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProcedure(ProjectId, procedureId.Value)); })"
                    OnCreated="@(procedureId => NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProcedure(ProjectId, procedureId)))" />

    <ProjectDetails Project="@Project"
                    OnEdit="@(projectId =>NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProjectEdit(projectId)))"
                    OnDeleted="@(() => NavigationManager.NavigateTo(AppRoutes.Sea.OwnerTemplateProjects))" />

</CascadingValue>
