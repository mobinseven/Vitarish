@page "/sea/projects/{projectId}"
@page "/sea/projects/{projectId}/{procedureId}"
@page "/sea/projects/{projectId}/{procedureId}/{eventId}"
@inherits TenantPageBase
@inject NavigationManager NavigationManager
@inject IProjectsService ProjectsService
@inject IReceiptsService ReceiptsService
@inject ISeaUsersService AccessService
@inject IStringLocalizer Localizer
@inject IDialogService DialogService
@if(Project is not null)
{
    <EndOfScroll />
    <WidthControlled ControlledWidth="50vw">
        <CascadingValue Value="IsAdmin">
            <ProceduresGrid Project="@Project"
                            ProjectChanged="@(p => NavigationManager.NavigateTo($"/sea/projects/{p.Id}"))"
                            ProjectDeleted="@(() => NavigationManager.NavigateTo("/"))"
                            Context="procedure"
                            OpenProcedure="OpenProcedureId"
                            ProcedureClicked="@(id => NavigationManager.NavigateTo($"/sea/projects/{projectId}/{id}"))">
                <ProcedureChildContent>
                    <WidthControlled ControlledWidth="90%">
                        <EventsGrid Project="@Project"
                                    OpenEvent=OpenEventId
                                    EventClicked=@(id => NavigationManager.NavigateTo($"/sea/projects/{projectId}/{procedureId}/{id}"))
                                    Procedure="procedure" />
                    </WidthControlled>
                </ProcedureChildContent>
            </ProceduresGrid>
        </CascadingValue>
    </WidthControlled>
}
<div style="height: 20dvh;">
    <hr />
</div>
@code {
    [Parameter] public string? projectId { get; set; }
    [Parameter] public string? procedureId { get; set; }
    [Parameter] public string? eventId { get; set; }

    Guid ProjectId;
    Guid OpenProcedureId;
    Guid OpenEventId;
    ProjectDto? Project;

    protected override async Task OnParametersSetAsync()
    {
        if(userId is null)
        {
            return;
        }

        if(string.IsNullOrWhiteSpace(projectId))
        {
            NavigationManager.NavigateTo("/sea");
            return;
        }

        Guid.TryParse(projectId, out ProjectId);
        Guid.TryParse(procedureId, out OpenProcedureId);
        Guid.TryParse(eventId, out OpenEventId);

        Project = await ProjectsService.GetAsync(ProjectId, CancellationToken.None).GetValueOrDefaultAsync();

        if(Project is null)
        {
            NavigationManager.NavigateTo("/sea");
            return;
        }

        await ReceiptsService.MarkProjectReadAsync(userId.Value, ProjectId, CancellationToken.None);

        if(OpenProcedureId != Guid.Empty)
        {
            await ReceiptsService.MarkProcedureReadAsync(userId.Value, OpenProcedureId, CancellationToken.None);
        }

        if(OpenEventId != Guid.Empty)
        {
            await ReceiptsService.MarkEventReadAsync(userId.Value, OpenEventId, CancellationToken.None);
        }

        StateHasChanged();
    }

}
