@attribute [Route(AppRoutes.Sea.TemplateProjectNew)]

<CascadingValue Value="IsAdmin">

    <ProjectEditForm OnCreate="@(projectId => NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProject(projectId)))"
                     OnCancel="@(() => NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProjects))"
                     TemplateMode="true"/>

</CascadingValue>
