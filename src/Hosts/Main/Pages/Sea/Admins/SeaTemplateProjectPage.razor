@inherits SeaProjectPage

@attribute [Route(AppRoutes.Sea.TemplateProjectTemplate)]

@if(Project is null)
{
    return;
}

<CascadingValue Value="IsAdmin">

    <ProceduresGrid Project="@Project"
                    OnClicked="@(procedureId => NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProcedure(projectId, procedureId)))"
                    OnCreated="@(procedureId => NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProcedure(projectId, procedureId)))" />

    <ProjectDetails Project="@Project"
                    OnEdit="@(projectId =>NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProjectEdit(projectId)))"
                    OnDeleted="@(() => NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProjects))" />

</CascadingValue>
