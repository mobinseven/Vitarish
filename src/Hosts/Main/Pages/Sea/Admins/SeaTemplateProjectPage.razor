@inherits SeaProjectPage

@page "/sea/Admin/Settings/Projects/Templates/{projectId}"

@if(Project is null)
{
    return;
}

<CascadingValue Value="IsAdmin">

    <ProceduresGrid Project="@Project"
                    OnClicked="@(procedureId => NavigationManager.NavigateTo($"/sea/Admin/Settings/Projects/Templates/{projectId}/{procedureId}"))"
                    OnCreated="@(procedureId => NavigationManager.NavigateTo($"/sea/Admin/Settings/Projects/Templates/{projectId}/{procedureId}"))" />

    <ProjectDetails Project="@Project"
                    OnEdit="@(projectId =>NavigationManager.NavigateTo($"/sea/Admin/Settings/Projects/Templates/Edit/{projectId}"))"
                    OnDeleted="@(() => NavigationManager.NavigateTo("/sea/Admin/Settings/Projects/Templates/"))" />

</CascadingValue>
