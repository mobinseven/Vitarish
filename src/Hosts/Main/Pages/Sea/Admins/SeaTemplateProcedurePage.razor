@inherits SeaProcedurePage
@page "/sea/Admin/Settings/Projects/Templates/{projectId}/{procedureId}"

@if(Project is null || Procedure is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <EventsGrid Project="@Project"
                EventClicked=@(id => NavigationManager.NavigateTo($"/sea/Admin/Settings/Projects/Templates/{projectId}/{procedureId}/{id}"))
                Procedure="Procedure" />
    <ProcedureDetails Procedure="Procedure" Project="Project" OnDelete="@(() => NavigationManager.NavigateTo($"/sea/Admin/Settings/Projects/Templates/{projectId}"))" />
</CascadingValue>
