@inherits SeaProjectPage

@attribute [Route(AppRoutes.Sea.TemplateProjectEditTemplate)]

<CascadingValue Value="IsAdmin">

    <ProjectEditForm Project="Project"
                     OnUpdate="@(projectId => NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProject(projectId)))"
                     OnCreate="@(projectId => NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProject(projectId)))"
                     OnCancel="@(() => NavigationManager.NavigateTo(AppRoutes.Sea.TemplateProject(projectId)))"
                     TemplateMode="true"/>

</CascadingValue>
