@attribute [Route(AppRoutes.Sea.ProjectTemplate)]

@if(Project is null)
{
    return;
}
<ProceduresGrid Project="@Project"
                OnClicked="@(procedureId => { if (procedureId.HasValue) NavigationManager.NavigateTo(AppRoutes.Sea.Procedure(ProjectId, procedureId.Value)); })"
                OnCreated="@(procedureId => NavigationManager.NavigateTo(AppRoutes.Sea.Procedure(ProjectId, procedureId)))" />

<ProjectDetails Project="@Project"
                OnEdit="@(projectId =>NavigationManager.NavigateTo(AppRoutes.Sea.ProjectEdit(projectId)))"
                OnDeleted="@(() => NavigationManager.NavigateTo(AppRoutes.Sea.Projects))" />

@code {

    [Parameter] public Guid? projectId { get; set; }


    protected Guid ProjectId;

    protected ProjectReadDto? Project;

    protected bool initialized;
    bool markedAsRead;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)
        {
            return;
        }

        await MarkAsRead();
    }

    protected override async Task ReloadRequired()
    {
        if (projectId is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Projects);
            return;
        }

        var id = projectId.Value;

        ProjectId = id;

        Project = await ValueOrNotifyAsync(SeaClient.GetProjectAsync(ProjectId, CancellationToken.None));

        if(Project is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Projects);
            return;
        }

        NavService.OverridePageTitle(Project.Id.ToString(), Project.Name);
        initialized = true;
    }

    protected async Task MarkAsRead()
    {
        if(UserId is null || Project is null)
        {
            return;
        }

        if(!markedAsRead)
        {
            await CommandOrNotifyAsync(SeaClient.MarkProjectReadAsync(ProjectId, CancellationToken.None));
            markedAsRead = true;
        }
    }

}
