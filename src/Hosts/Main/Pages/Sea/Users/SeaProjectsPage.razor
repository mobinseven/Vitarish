@attribute [Route(AppRoutes.Sea.Projects)]
<CascadingValue Value="IsAdmin">
    <ProjectsGrid OnClicked="@(id => NavigationManager.NavigateTo(AppRoutes.Sea.Project(id)))"
                  OnAdd="@(() => NavigationManager.NavigateTo(AppRoutes.Sea.ProjectNew))" />
</CascadingValue>

@code {
    protected override void OnInitialized() => NavService.EnableSearch();
}
