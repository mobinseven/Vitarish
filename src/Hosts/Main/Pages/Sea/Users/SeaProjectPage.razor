@page "/sea/projects/{projectId}"

@if(Project is null)
{
    return;
}

<CascadingValue Value="IsAdmin">

    <ProceduresGrid Project="@Project"
                    ProcedureClicked="@(procedureId => NavigationManager.NavigateTo($"/sea/projects/{projectId}/{procedureId}"))" />

    <ProjectDetails Project="@Project"
                    OnProcedureAdded="@(procedureId => NavigationManager.NavigateTo($"/sea/projects/{projectId}/{procedureId}"))"
                    
                    OnDelete="@(() => NavigationManager.NavigateTo("/sea/projects"))" />

</CascadingValue>

@code {

    [Parameter] public string? projectId { get; set; }


    Guid ProjectId;

    ProjectDto? Project;

    bool markedAsRead;


    protected override void OnInitialized()
    {
        base.OnInitialized();
        if(projectId is null)
        {
            return;
        }
        RenderForId(projectId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if(projectId is null)
        {
            return;
        }

        Guid.TryParse(projectId, out ProjectId);

        await ReloadRequired();
    }

    protected override async Task ReloadRequired()
    {

        Project = await ProjectsService.GetAsync(ProjectId, CancellationToken.None).GetValueOrDefaultAsync();

        if(Project is null)
        {
            NavigationManager.NavigateTo("/sea/projects");
            return;
        }

        NavService.OverridePageTitle(Project.Id.ToString(), Project.Name);

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(UserId is null || Project is null)
        {
            return;
        }

        if(!markedAsRead)
        {
            await ReceiptsService.MarkProjectReadAsync(UserId.Value, ProjectId, CancellationToken.None);
            markedAsRead = true;
        }
    }

}
