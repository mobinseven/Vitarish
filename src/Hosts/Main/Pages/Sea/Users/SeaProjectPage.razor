@page "/sea/projects/{projectId}"

@if(Project is null)
{
    return;
}

<CascadingValue Value="IsAdmin">

    <ProceduresGrid Project="@Project"
                    ProcedureClicked="@(id => NavigationManager.NavigateTo($"/sea/projects/{projectId}/{id}"))" />

    <ProjectDetails Project="@Project"
                    OnAddProcedure="@(p => NavigationManager.NavigateTo($"/sea/projects/{p.Id}"))"
                    OnEdit="@(p => NavigationManager.NavigateTo($"/sea/projects/{p.Id}"))"
                    OnDelete="@(() => NavigationManager.NavigateTo("/"))" />

</CascadingValue>

@code {

    [Parameter] public string? projectId { get; set; }


    Guid ProjectId;

    ProjectDto? Project;

    bool markedAsRead;

    protected override async Task OnParametersSetAsync()
    {
        if(userId is null)
        {
            return;
        }

        Console.WriteLine($"/sea/projects/{projectId}");

        Guid.TryParse(projectId, out ProjectId);

        Project = await ProjectsService.GetAsync(ProjectId, CancellationToken.None).GetValueOrDefaultAsync();

        if(Project is null)
        {
            NavigationManager.NavigateTo("/sea/projects");
            return;
        }

        NavService.OverridePageTitle(projectId, Project.Name);

        await ReceiptsService.MarkProjectReadAsync(userId.Value, ProjectId, CancellationToken.None);

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(userId is null || Project is null)
        {
            return;
        }

        if(!markedAsRead)
        {
            await ReceiptsService.MarkProjectReadAsync(userId.Value, ProjectId, CancellationToken.None);
            markedAsRead = true;
        }
    }

}
