@page "/sea/Projects/{projectId}"

@if(Project is null)
{
    return;
}

<CascadingValue Value="IsAdmin">

    <ProceduresGrid Project="@Project"
                    OnClicked="@(procedureId => NavigationManager.NavigateTo($"/sea/Projects/{projectId}/{procedureId}"))"
                    OnCreated="@(procedureId => NavigationManager.NavigateTo($"/sea/Projects/{projectId}/{procedureId}"))" />

    <ProjectDetails Project="@Project"
                    OnEdit="@(projectId =>NavigationManager.NavigateTo($"/sea/Projects/Edit/{projectId}"))"
                    OnDeleted="@(() => NavigationManager.NavigateTo("/sea/Projects"))" />

</CascadingValue>

@code {

    [Parameter] public string? projectId { get; set; }


    protected Guid ProjectId;

    protected ProjectDto? Project;

    protected bool initialized;
    bool markedAsRead;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if(projectId is null)
        {
            NavigationManager.NavigateTo("/sea/Projects");
            return;
        }

        Guid.TryParse(projectId, out ProjectId);
        RenderForId(projectId);

        await ReloadRequired();
        initialized = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)
        {
            return;
        }

        await MarkAsRead();
    }

    protected override async Task ReloadRequired()
    {
        if(ProjectId == Guid.Empty)
        {
            return;
        }

        Project = await ProjectsService.GetAsync(ProjectId, CancellationToken.None).GetValueOrDefaultAsync();

        if(Project is null)
        {
            NavigationManager.NavigateTo("/sea/Projects");
            return;
        }

       NavService.OverridePageTitle(Project.Id.ToString(), Project.Name);
    }

    protected async Task MarkAsRead()
    {
        if(UserId is null || Project is null)
        {
            return;
        }

        if(!markedAsRead)
        {
            await ReceiptsService.MarkProjectReadAsync(UserId.Value, ProjectId, CancellationToken.None);
            markedAsRead = true;
        }
    }

}
