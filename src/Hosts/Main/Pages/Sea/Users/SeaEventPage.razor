@page "/sea/Projects/{projectId}/{procedureId}/{eventId}"

@if(Project is null || Procedure is null || Event is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <EventItemsTimeline Event="Event" Procedure="Procedure" Project="Project" />
    <EventDetails Event="Event" Procedure="Procedure" Project="Project"
                  OnDelete="@(() => NavigationManager.NavigateTo($"/sea/Projects/{projectId}/{procedureId}"))"
                  OnUpdate="ReloadRequired"/>
</CascadingValue>

@code {
    [Parameter] public string? projectId { get; set; }
    [Parameter] public string? procedureId { get; set; }
    [Parameter] public string? eventId { get; set; }

    protected Guid ProjectId;
    protected Guid ProcedureId;
    protected  Guid EventId;

    protected ProjectReadDto? Project;
    protected ProcedureReadDto? Procedure;
    protected EventReadDto? Event;

    private bool markedAsRead;

    protected override async Task ReloadRequired()
    {
        Guid.TryParse(projectId, out ProjectId);
        Guid.TryParse(procedureId, out ProcedureId);
        Guid.TryParse(eventId, out EventId);

        if(ProjectId == Guid.Empty)
        {
            return;
        }

        Project = await ProjectsService.GetAsync(ProjectId, CancellationToken.None).GetValueOrDefaultAsync();

        if(Project is null)
        {
            NavigationManager.NavigateTo("/sea/Projects");
            return;
        }

        Procedure = await ProcedureService.GetAsync(ProcedureId, CancellationToken.None).GetValueOrDefaultAsync();

        if(Procedure is null)
        {
            NavigationManager.NavigateTo($"/sea/Projects/{projectId}");
            return;
        }

        Event = await EventService.GetAsync(EventId, CancellationToken.None).GetValueOrDefaultAsync();

        if(Event is null)
        {
            NavigationManager.NavigateTo($"/sea/Projects/{projectId}/{procedureId}");
            return;
        }

        NavService.OverridePageTitle(Project.Id.ToString(), Project.Name);
        NavService.OverridePageTitle(Procedure.Id.ToString(), Procedure.Name);
        NavService.OverridePageTitle(Event.Id.ToString(), Event.Title);

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(UserId is null || Event is null)
        {
            return;
        }

        if(!markedAsRead)
        {
            await ReceiptsService.MarkEventReadAsync(UserId.Value, Event.Id, CancellationToken.None);
            markedAsRead = true;
        }
    }

}
