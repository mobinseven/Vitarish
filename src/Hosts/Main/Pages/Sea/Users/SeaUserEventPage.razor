@attribute [Route(AppRoutes.Sea.EventTemplate)]

@if(Project is null || Procedure is null || Event is null)
{
    return;
}
<EventDetails Event="Event" Procedure="Procedure" Project="Project"
              OnDelete="@(() => NavigationManager.NavigateTo(AppRoutes.Sea.Procedure(ProjectId, ProcedureId)))"
              OnUpdate="ReloadRequired" />
<EventItemsTimeline Event="Event" Procedure="Procedure" Project="Project" />

@code {
    [Parameter] public Guid? projectId { get; set; }
    [Parameter] public Guid? procedureId { get; set; }
    [Parameter] public Guid? eventId { get; set; }

    protected Guid ProjectId;
    protected Guid ProcedureId;
    protected  Guid EventId;

    protected ProjectReadDto? Project;
    protected ProcedureReadDto? Procedure;
    protected EventReadDto? Event;

    private bool markedAsRead;

    protected override async Task ReloadRequired()
    {
        if (projectId is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Projects);
            return;
        }

        var parsedProjectId = projectId.Value;

        if (procedureId is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Project(parsedProjectId));
            return;
        }

        var parsedProcedureId = procedureId.Value;

        if (eventId is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Procedure(parsedProjectId, parsedProcedureId));
            return;
        }

        var parsedEventId = eventId.Value;

        ProjectId = parsedProjectId;
        ProcedureId = parsedProcedureId;
        EventId = parsedEventId;

        Project = await ValueOrNotifyAsync(SeaClient.GetProjectAsync(ProjectId, CancellationToken.None));

        if(Project is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Projects);
            return;
        }

        Procedure = await ValueOrNotifyAsync(SeaClient.GetProcedureAsync(ProcedureId, CancellationToken.None));

        if(Procedure is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Project(ProjectId));
            return;
        }

        Event = await ValueOrNotifyAsync(SeaClient.GetEventAsync(EventId, CancellationToken.None));

        if(Event is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Procedure(ProjectId, ProcedureId));
            return;
        }

        NavService.OverridePageTitle(Project.Id.ToString(), Project.Name);
        NavService.OverridePageTitle(Procedure.Id.ToString(), Procedure.Name);
        NavService.OverridePageTitle(Event.Id.ToString(), null);

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(UserId is null || Event is null)
        {
            return;
        }

        if(!markedAsRead)
        {
            await CommandOrNotifyAsync(SeaClient.MarkEventReadAsync(Event.Id, CancellationToken.None));
            markedAsRead = true;
        }
    }

}
