@page "/sea/Projects/{projectId}/{procedureId}"

@if(Project is null || Procedure is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <EventsGrid Project="@Project"
                EventClicked=@(id => NavigationManager.NavigateTo($"/sea/Projects/{projectId}/{procedureId}/{id}"))
                Procedure="Procedure" />
    <ProcedureDetails Procedure="Procedure" Project="Project" OnDelete="@(() => NavigationManager.NavigateTo($"/sea/Projects/{projectId}"))" />
</CascadingValue>

@code {
    [Parameter] public string? projectId { get; set; }
    [Parameter] public string? procedureId { get; set; }

    protected Guid ProjectId;
    protected Guid ProcedureId;

    protected ProjectDto? Project;
    protected ProcedureDto? Procedure;

    private bool markedAsRead;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if(procedureId is null)
        {
            return;
        }
        RenderForId(procedureId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if(UserId is null)
        {
            return;
        }

        Guid.TryParse(projectId, out ProjectId);
        Guid.TryParse(procedureId, out ProcedureId);

        await ReloadRequired();
    }

    protected override async Task ReloadRequired()
    {
        Project = await ProjectsService.GetAsync(ProjectId, CancellationToken.None).GetValueOrDefaultAsync();

        if(Project is null)
        {
            NavigationManager.NavigateTo("/sea/Projects");
            return;
        }

        Procedure = (await ProcedureService.GetAsync(ProcedureId, CancellationToken.None)).EnsureValue();

        if(Procedure is null)
        {
            NavigationManager.NavigateTo($"/sea/Projects/{projectId}");
            return;
        }


        NavService.OverridePageTitle(Project.Id.ToString(), Project.Name);
        NavService.OverridePageTitle(Procedure.Id.ToString(), Procedure.Name);

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(UserId is null || Procedure is null)
        {
            return;
        }
        if(!markedAsRead)
        {
            await ReceiptsService.MarkProcedureReadAsync(UserId.Value, Procedure.Id, CancellationToken.None);
            markedAsRead = true;
        }
    }

}
