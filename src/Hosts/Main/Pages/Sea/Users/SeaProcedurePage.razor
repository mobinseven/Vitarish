@attribute [Route(AppRoutes.Sea.ProcedureTemplate)]

@if(Project is null || Procedure is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <EventsGrid Project="@Project"
                EventClicked="@(id => { if (id.HasValue) NavigationManager.NavigateTo(AppRoutes.Sea.Event(ProjectId, ProcedureId, id.Value)); })"
                Procedure="Procedure"
                OnUpdate="ReloadRequired" />
    <ProcedureDetails Procedure="Procedure" Project="Project" OnUpdate="ReloadRequired" OnDelete="@(() => NavigationManager.NavigateTo(AppRoutes.Sea.Project(ProjectId)))" />
</CascadingValue>

@code {
    [Parameter] public Guid? projectId { get; set; }
    [Parameter] public Guid? procedureId { get; set; }

    protected Guid ProjectId;
    protected Guid ProcedureId;

    protected ProjectReadDto? Project;
    protected ProcedureReadDto? Procedure;

    private bool markedAsRead;

    protected override async Task ReloadRequired()
    {
        if (projectId is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Projects);
            return;
        }

        var parsedProjectId = projectId.Value;

        if (procedureId is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Project(parsedProjectId));
            return;
        }

        var parsedProcedureId = procedureId.Value;

        ProjectId = parsedProjectId;
        ProcedureId = parsedProcedureId;

        Project = await ProjectsService.GetAsync(ProjectId, CancellationToken.None).GetValueOrDefaultAsync();

        if(Project is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Projects);
            return;
        }

        Procedure = await ProcedureService.GetAsync(ProcedureId, CancellationToken.None).GetValueOrDefaultAsync();

        if(Procedure is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Sea.Project(ProjectId));
            return;
        }


        NavService.OverridePageTitle(Project.Id.ToString(), Project.Name);
        NavService.OverridePageTitle(Procedure.Id.ToString(), Procedure.Name);

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(UserId is null || Procedure is null)
        {
            return;
        }
        if(!markedAsRead)
        {
            await ReceiptsService.MarkProcedureReadAsync(UserId.Value, Procedure.Id, CancellationToken.None);
            markedAsRead = true;
        }
    }

}
