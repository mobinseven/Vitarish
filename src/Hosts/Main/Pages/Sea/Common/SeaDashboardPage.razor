@page "/sea"
@inherits TenantPageBase
@inject IAccessControlledProjectsService ProjectsService

<Stack>
    <StackButton Href="/sea/Projects" Label="@Localizer["Projects"]">
        @projectsCount
    </StackButton>
</Stack>

@if(IsOwner)
{
    <Stack>
        <StackButton Href="/sea/Reminders" Label="@Localizer["Reminders"]" StartIcon="fa-thin fa-comments" />
        <StackButton Href="/sea/Projects/Templates" Label="@Localizer["Templates"]" StartIcon="fa-thin fa-folder-gear" />
        <StackButton Href="/sea/Owner/Settings" Label="@Localizer["Settings"]" StartIcon="fa-thin fa-gear-complex" />
    </Stack>
}

@code {
    private int projectsCount;
    protected override async Task OnAfterRenderAsync(bool f)
    {
        if(!f)
        {
            return;
        }
        projectsCount = await ProjectsService.CountAsync(new ProjectDescriptorDto { }, CancellationToken.None).GetValueOrDefaultAsync();
        await InvokeAsync(StateHasChanged);
    }
}
