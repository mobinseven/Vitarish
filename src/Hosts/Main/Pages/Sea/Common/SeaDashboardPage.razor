@page "/sea"
@inherits TenantPageBase
@inject IAccessControlledProjectsService ProjectsService
@using Vitarish.Interfaces.Base.Plugins

<Stack>
    <StackButton Href="/sea/Projects" Label="@Localizer["Projects"]">
        @if(projectsCount > 0)
        {
            @projectsCount
        }
    </StackButton>
</Stack>

@if(IsOwner)
{
    <Stack>
        <StackField Label="@Localizer["Ownership"]" />
        <StackButton Href="/sea/Reminders" Label="@Localizer["Reminders"]" StartIcon="fa-regular fa-comments" />
        <StackButton Href="/sea/Projects/Templates" Label="@Localizer["Templates"]" StartIcon="fa-regular fa-folder-gear" />
        <StackButton Href="/sea/Owner/Settings" Label="@Localizer["Settings"]" StartIcon="fa-regular fa-gear-complex" />
    </Stack>
}

<FeedWidget Configuration="@(TenantService.Metadata ?? new Dictionary<string, object?>())" />

@code {
    private int projectsCount;
    protected override async Task ReloadRequired()
    {
        EnsureFeedConfiguration();
        projectsCount = await ProjectsService.CountAsync(new ProjectDescriptorDto { }, CancellationToken.None).GetValueOrDefaultAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void EnsureFeedConfiguration()
    {
        if (TenantService.Metadata is null)
        {
            return;
        }

        if (FeedPluginConfiguration.GetConfiguredSourceIds(TenantService.Metadata).Count > 0)
        {
            return;
        }

        TenantService.Metadata[FeedPluginConfiguration.SourceIdsMetadataKey] = new[] { "sea.projects.recent", "sea.attachments.recent" };
    }
}
