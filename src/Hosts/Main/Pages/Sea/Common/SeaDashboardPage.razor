@page "/sea"
@inherits TenantPageBase
@inject IAccessControlledProjectsService ProjectsService

<Stack>
    <StackButton Href="/sea/Projects" Label="@Localizer["Projects"]" EndIcon="fa-regular fa-3x fa-folders">
        @if(projectsCount > 0)
        {
            @projectsCount
        }
    </StackButton>
    <StackButton Href="/appointments" Label="@Localizer["MyAppointments"]" EndIcon="fa-regular fa-calendar-days" />
</Stack>

@if(IsAdmin)
{
    <Stack>
        <StackField Label="@Localizer["Administration"]" />
        <StackButton Href="/sea/Admin/Settings/Projects/Templates" Label="@Localizer["Templates"]" EndIcon="fa-regular fa-folder-gear" />
        <StackButton Href="/appointments/admin" Label="@Localizer["AppointmentsAdmin"]" EndIcon="fa-regular fa-calendar-star" />
    </Stack>
}

@if(IsOwner)
{
    <Stack>
        <StackField Label="@Localizer["Ownership"]" />
        <StackButton Href="/sea/Owner/Settings/Users" Label="@Localizer["Users"]" EndIcon="fa-regular fa-users" />
        <StackButton Href="/sea/Owner/Settings/Advanced" Label="@Localizer["Advanced"]" EndIcon="fa-regular fa-gear-complex" />
    </Stack>
}

@code {
    private int projectsCount;
    protected override async Task ReloadRequired()
    {
        projectsCount = await ProjectsService.CountAsync(new ProjectDescriptorDto { }, CancellationToken.None).GetValueOrDefaultAsync();
        await InvokeAsync(StateHasChanged);
    }
}
