@attribute [Route(AppRoutes.Sea.Dashboard)]
@inherits TenantPageBase
@inject IAccessControlledProjectsService ProjectsService

<Stack>
    <StackButton Href="@AppRoutes.Sea.Projects" Label="@Localizer["Projects"]" EndIcon="fa-regular fa-3x fa-folders">
        @if(projectsCount > 0)
        {
            @projectsCount
        }
    </StackButton>
    <StackButton Href="@AppRoutes.Appointments.Reservations" Label="@Localizer["MyAppointments"]" EndIcon="fa-regular fa-calendar-days" />
</Stack>

@if(IsAdmin)
{
    <Stack>
        <StackField Label="@Localizer["Administration"]" />
        <StackButton Href="@AppRoutes.Sea.TemplateProjects" Label="@Localizer["Templates"]" EndIcon="fa-regular fa-folder-gear" />
        <StackButton Href="@AppRoutes.Appointments.AdminReservations" Label="@Localizer["AppointmentsAdmin"]" EndIcon="fa-regular fa-calendar-star" />
    </Stack>
}

@if(IsOwner)
{
    <Stack>
        <StackField Label="@Localizer["Ownership"]" />
        <StackButton Href="@AppRoutes.Sea.OwnerSettingsUsers" Label="@Localizer["Users"]" EndIcon="fa-regular fa-users" />
        <StackButton Href="@AppRoutes.Sea.OwnerSettingsAdvanced" Label="@Localizer["Advanced"]" EndIcon="fa-regular fa-gear-complex" />
    </Stack>
}

@code {
    private int projectsCount;
    protected override async Task ReloadRequired()
    {
        projectsCount = await ProjectsService.CountAsync(new ProjectDescriptorDto { }, CancellationToken.None).GetValueOrDefaultAsync();
        await InvokeAsync(StateHasChanged);
    }
}
