@page "/appointments/sessions/{sessionId}"
@using Vitarish.Main.Components

<TitleContainer>
    <PageTitle>@(session?.Name ?? Localizer["SessionDetail"].Value)</PageTitle>
    <Breadcrumbs>
        <BreadcrumbItem Icon="fa-regular fa-calendar" Href="/appointments">@Localizer["Appointments"]</BreadcrumbItem>
        <BreadcrumbItem Icon="fa-regular fa-calendar-days" Href="/appointments/sessions">@Localizer["Sessions"]</BreadcrumbItem>
        <BreadcrumbItem>@Localizer["Detail"]</BreadcrumbItem>
    </Breadcrumbs>
</TitleContainer>

@if (session is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <SessionDetail Session="@session" OnReserve="ReserveAsync" />
}

@code {
    [Parameter] public string sessionId { get; set; } = string.Empty;

    private SessionReadDto? session;

    protected override async Task OnParametersSetAsync()
    {
        if (Guid.TryParse(sessionId, out Guid id))
        {
            session = await SessionsService.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();
        }
    }

    private void ReserveAsync()
    {
        NavigationManager.NavigateTo($"/appointments/new?sessionId={sessionId}");
    }
}
