@attribute [Route(AppRoutes.Appointments.UserReservationTemplate)]

@if (reservation is null)
{
    return;
}

<UserReservationDetail Reservation="@reservation"
                   OnCancelled="ReloadRequired" />

@code {
    [Parameter] public Guid? reservationId { get; set; }

    private ReservationReadDto? reservation;

    protected override async Task ReloadRequired()
    {
        if (reservationId is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Appointments.UserReservations);
            return;
        }

        var id = reservationId.Value;

        reservation = await ReservationManager.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if (reservation is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Appointments.UserReservations);
            return;
        }

        NavService.OverridePageTitle(id.ToString(), reservation.Date.ToString("f") ?? id.ToString());
        await InvokeAsync(StateHasChanged);
    }
}
