@page "/AppointmentSessions/{sessionId}"

@inject IAccessControlledAppointmentSessionsService SessionsService

@if (session is null)
{
    return;
}

<AppointmentSessionDetail Session="@session" OnReserved="ReloadRequired" OnCancelled="ReloadRequired" />

@code {
    [Parameter] public string? sessionId { get; set; }

    private AppointmentSessionReadDto? session;

    private void Back()
    {
        NavigationManager.NavigateTo("/AppointmentSessions");
    }

    protected override async Task ReloadRequired()
    {
        if (!Guid.TryParse(sessionId, out Guid id))
        {
            Back();
            return;
        }

        session = await SessionsService.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if (session is null)
        {
            Back();
            return;
        }

        NavService.OverridePageTitle(id.ToString(), session.DateTime.ToString("f"));

        await InvokeAsync(StateHasChanged);
    }
}
