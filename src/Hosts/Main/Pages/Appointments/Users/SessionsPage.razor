@page "/appointments/sessions"
@using Vitarish.Main.Components

<TitleContainer>
    <PageTitle>@Localizer["Sessions"]</PageTitle>
    <Breadcrumbs>
        <BreadcrumbItem Icon="fa-regular fa-calendar" Href="/appointments">@Localizer["Appointments"]</BreadcrumbItem>
        <BreadcrumbItem Icon="fa-regular fa-calendar-days">@Localizer["Sessions"]</BreadcrumbItem>
    </Breadcrumbs>
</TitleContainer>

<SessionsList Descriptor="descriptor"
              OnClicked="@(id => NavigationManager.NavigateTo($"/appointments/sessions/{id}"))" />

@code {
    private SessionDescriptorDto descriptor = new() { Status = SessionStatus.Active };
}
