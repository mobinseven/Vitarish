@page "/Appointments/{appointmentId}/Edit"

@if (appointment is null)
{
    return;
}

<AppointmentForm Appointment="@appointment"
                 OnSaved="@(id => NavigationManager.NavigateTo($"/Appointments/{id}"))"
                 OnCancelled="@(() => NavigationManager.NavigateTo($"/Appointments/{appointmentId}"))" />

@code {
    [Parameter] public string? appointmentId { get; set; }

    private AppointmentReadDto? appointment;

    protected override async Task ReloadRequired()
    {
        if (!Guid.TryParse(appointmentId, out Guid id))
        {
            NavigationManager.NavigateTo("/Appointments");
            return;
        }

        appointment = await AppointmentsService.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if (appointment is null)
        {
            NavigationManager.NavigateTo("/Appointments");
            return;
        }

        await InvokeAsync(StateHasChanged);
    }
}
