@page "/AppointmentSessions"

@inject IAccessControlledAppointmentSessionsService SessionsService
<CascadingValue Value="IsAdmin">
    <AppointmentSessionsList OnClicked="@(id => NavigationManager.NavigateTo($"/Admin/AppointmentSessions/{id}"))"
                             OnAdd="@(() => NavigationManager.NavigateTo($"/Admin/AppointmentSessions/New"))" />
</CascadingValue>

@code {
    protected override void OnInitialized() => NavService.EnableSearch();
}
