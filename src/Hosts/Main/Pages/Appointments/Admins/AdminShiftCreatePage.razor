@attribute [Route(AppRoutes.Appointments.AdminShiftCreate)]
@attribute [Route(AppRoutes.Appointments.AdminShiftCreateTemplate)]

<CascadingValue Value="IsAdmin">
    <ShiftForm OnSaved="@(id => NavigationManager.NavigateTo(AppRoutes.Appointments.AdminShift(id)))"
                 OnCancelled="@(() => NavigationManager.NavigateTo(AppRoutes.Appointments.AdminShifts))"
                 DayOfWeek="@((DayOfWeek?)dayOfWeek)" />
</CascadingValue>

@code {
    [Parameter] public int? dayOfWeek { get; set; }
}
