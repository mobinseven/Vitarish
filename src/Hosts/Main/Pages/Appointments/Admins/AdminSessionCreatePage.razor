@page "/Admin/Sessions/New/{dayOfWeek:int}"

<CascadingValue Value="IsAdmin">
    <SessionForm OnSaved="@(id => NavigationManager.NavigateTo($"/Admin/Sessions/{id}"))"
                 OnCancelled="@(() => NavigationManager.NavigateTo("/Admin/Sessions"))"
                 DayOfWeek="@((DayOfWeek?)dayOfWeek)" />
</CascadingValue>

@code {
    [Parameter] public int? dayOfWeek { get; set; }
}
