@attribute [Route(AppRoutes.Appointments.AdminShiftTemplate)]

@if(shift is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <ShiftDetail Shift="@shift"
                   OnEdit="@(() => NavigationManager.NavigateTo(AppRoutes.Appointments.AdminShiftEdit(_shiftId)))"
                   OnDeleted="Back"
                   OnStatusChanged="ReloadRequired"
                   OnShiftOccurrenceSelected="@(() => NavigationManager.NavigateTo(AppRoutes.Appointments.AdminShiftOccurrence(_shiftId)))" />
</CascadingValue>

@code {
    [Parameter] public Guid? shiftId { get; set; }

    private ShiftReadDto? shift;
    private Guid _shiftId;

    private void Back() => NavigationManager.NavigateTo(AppRoutes.Appointments.AdminShifts);

    protected override async Task ReloadRequired()
    {
        if(shiftId is null)
        {
            Back();
            return;
        }

        shift = await ShiftManager.GetAsync(_shiftId, CancellationToken.None).GetValueOrDefaultAsync();

        if(shift is null)
        {
            Back();
            return;
        }

        NavService.OverridePageTitle(_shiftId.ToString(), Localizer["Shift"]);
        await InvokeAsync(StateHasChanged);
    }
}
