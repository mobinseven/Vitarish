@attribute [Route(AppRoutes.Appointments.AdminShiftTemplate)]
@attribute [Route(AppRoutes.Appointments.AdminShiftOccurrenceTemplate)]

@if(shift is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <ShiftDetail Shift="@shift"
                   OnEdit="@(() => NavigationManager.NavigateTo(AppRoutes.Appointments.AdminShiftEdit(shiftId)))"
                   OnDeleted="Back"
                   OnStatusChanged="ReloadRequired"
                   OnShiftOccurrenceSelected="@(() => NavigationManager.NavigateTo(AppRoutes.Appointments.AdminShiftOccurrence(shiftId)))" />
</CascadingValue>

@code {
    [Parameter] public string? shiftId { get; set; }

    private ShiftReadDto? shift;

    private void Back() => NavigationManager.NavigateTo(AppRoutes.Appointments.AdminShifts);

    protected override async Task ReloadRequired()
    {
        if(!Guid.TryParse(shiftId, out Guid id))
        {
            Back();
            return;
        }

        shift = await ShiftManager.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if(shift is null)
        {
            Back();
            return;
        }

        NavService.OverridePageTitle(id.ToString(), Localizer["Shift"]);
        await InvokeAsync(StateHasChanged);
    }
}
