@page "/appointments/admin/sessions"
@using Vitarish.Main.Components

<TitleContainer>
    <PageTitle>@Localizer["Sessions"]</PageTitle>
    <Breadcrumbs>
        <BreadcrumbItem Icon="fa-regular fa-calendar" Href="/appointments/admin">@Localizer["Appointments"]</BreadcrumbItem>
        <BreadcrumbItem Icon="fa-regular fa-calendar-days">@Localizer["Sessions"]</BreadcrumbItem>
    </Breadcrumbs>
</TitleContainer>

<SessionsList Descriptor="descriptor"
              OnClicked="@(id => NavigationManager.NavigateTo($"/appointments/admin/sessions/{id}"))"
              OnAdd="@(() => NavigationManager.NavigateTo("/appointments/admin/sessions/new"))" />

<Stack>
    <StackButton Label="@Localizer["NewItem", Localizer["Session"]]"
                 EndIcon="fa-regular fa-calendar-plus"
                 Color="Color.Primary"
                 OnClick="@(() => NavigationManager.NavigateTo("/appointments/admin/sessions/new"))" />
</Stack>

@code {
    private SessionDescriptorDto descriptor = new();
}
