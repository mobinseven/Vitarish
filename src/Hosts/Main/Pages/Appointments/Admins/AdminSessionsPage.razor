@page "/Admin/Sessions"

<CascadingValue Value="IsAdmin">
    <SessionsList OnClicked="@(id => NavigationManager.NavigateTo($"/Admin/Sessions/{id}"))"
                  OnAdd="@(dayOfWeek => NavigationManager.NavigateTo($"/Admin/Sessions/New/{(dayOfWeek is null ? string.Empty : (int)dayOfWeek)}"))" />
</CascadingValue>

@code {
    protected override void OnInitialized() => NavService.EnableSearch();
}
