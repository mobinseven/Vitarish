@page "/appointments/admin/sessions"

@inject IAccessControlledSessionsService SessionsService

<CascadingValue Value="IsAdmin">
    <SessionsList OnClicked="@(id => NavigationManager.NavigateTo($"/appointments/admin/sessions/{id}"))"
                  OnAdd="@(() => NavigationManager.NavigateTo("/appointments/admin/sessions/new"))" />
</CascadingValue>

@code {
    protected override void OnInitialized() => NavService.EnableSearch();
}
