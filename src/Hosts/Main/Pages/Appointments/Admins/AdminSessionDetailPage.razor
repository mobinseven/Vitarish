@page "/appointments/admin/sessions/{sessionId}"

@inject IAccessControlledSessionsService SessionsService

@if (session is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <AdminSessionDetail Session="@session"
                        OnEdit="@(() => NavigationManager.NavigateTo($"/appointments/admin/sessions/{sessionId}/edit"))"
                        OnDeleted="@(() => NavigationManager.NavigateTo("/appointments/admin/sessions"))"
                        OnStatusChanged="ReloadRequired" />
</CascadingValue>

@code {
    [Parameter] public string? sessionId { get; set; }

    private AppointmentSessionReadDto? session;

    protected override async Task ReloadRequired()
    {
        if (!Guid.TryParse(sessionId, out Guid id))
        {
            NavigationManager.NavigateTo("/appointments/admin/sessions");
            return;
        }

        session = await SessionsService.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if (session is null)
        {
            NavigationManager.NavigateTo("/appointments/admin/sessions");
            return;
        }

        NavService.OverridePageTitle(id.ToString(), session.DateTime.ToString("f"));

        await InvokeAsync(StateHasChanged);
    }
}
