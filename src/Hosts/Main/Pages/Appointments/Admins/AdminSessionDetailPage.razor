@page "/appointments/admin/sessions/{sessionId}"
@using Vitarish.Main.Components

<TitleContainer>
    <PageTitle>@Localizer["SessionDetail"]</PageTitle>
    <Breadcrumbs>
        <BreadcrumbItem Icon="fa-regular fa-calendar" Href="/appointments/admin">@Localizer["Appointments"]</BreadcrumbItem>
        <BreadcrumbItem Icon="fa-regular fa-calendar-days" Href="/appointments/admin/sessions">@Localizer["Sessions"]</BreadcrumbItem>
        <BreadcrumbItem>@Localizer["Detail"]</BreadcrumbItem>
    </Breadcrumbs>
</TitleContainer>

@if (session is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <AdminSessionDetail Session="@session"
                        OnEdit="@(() => NavigationManager.NavigateTo($"/appointments/admin/sessions/{sessionId}/edit"))"
                        OnDeleted="@(() => NavigationManager.NavigateTo("/appointments/admin/sessions"))"
                        OnStatusChanged="@ReloadAsync" />
}

@code {
    [Parameter] public string sessionId { get; set; } = string.Empty;

    private SessionReadDto? session;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Guid.TryParse(sessionId, out Guid id))
        {
            session = await SessionsService.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();
        }
    }
}
