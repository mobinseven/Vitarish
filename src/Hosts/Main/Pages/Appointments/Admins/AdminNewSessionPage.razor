@page "/appointments/admin/sessions/new"
@using Vitarish.Main.Components

<TitleContainer>
    <PageTitle>@Localizer["NewItem", Localizer["Session"]]</PageTitle>
    <Breadcrumbs>
        <BreadcrumbItem Icon="fa-regular fa-calendar" Href="/appointments/admin">@Localizer["Appointments"]</BreadcrumbItem>
        <BreadcrumbItem Icon="fa-regular fa-calendar-days" Href="/appointments/admin/sessions">@Localizer["Sessions"]</BreadcrumbItem>
        <BreadcrumbItem Icon="fa-regular fa-calendar-plus">@Localizer["New"]</BreadcrumbItem>
    </Breadcrumbs>
</TitleContainer>

<SessionForm OnSaved="@(id => NavigationManager.NavigateTo($"/appointments/admin/sessions/{id}"))"
             OnCancelled="@(() => NavigationManager.NavigateTo("/appointments/admin/sessions"))" />
