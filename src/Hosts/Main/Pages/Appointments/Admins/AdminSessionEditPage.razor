@page "/Admin/Sessions/{sessionId}/Edit"

@if (session is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <SessionForm Session="@session"
                 OnSaved="@(id => NavigationManager.NavigateTo($"/Admin/Sessions/{id}"))"
                 OnCancelled="Back" />
</CascadingValue>

@code {
    [Parameter] public string? sessionId { get; set; }

    private SessionReadDto? session;

    private void Back() => NavigationManager.NavigateTo("/Admin/Sessions");

    protected override async Task ReloadRequired()
    {
        if (!Guid.TryParse(sessionId, out Guid id))
        {
            Back();
            return;
        }

        session = await SessionManager.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if (session is null)
        {
            Back();
            return;
        }

        await InvokeAsync(StateHasChanged);
    }
}
