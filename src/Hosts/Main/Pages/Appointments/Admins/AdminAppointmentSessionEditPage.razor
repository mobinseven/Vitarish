@page "/AppointmentSessions/Admin/{sessionId}/Edit"

@inject IAccessControlledAppointmentSessionsService SessionsService

@if (session is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <AppointmentSessionForm Session="@session"
                 OnSaved="@(id => NavigationManager.NavigateTo($"/AppointmentSessions/Admin/{id}"))"
                 OnCancelled="Back" />
</CascadingValue>

@code {
    [Parameter] public string? sessionId { get; set; }

    private AppointmentSessionReadDto? session;

    private void Back()
    {
        NavigationManager.NavigateTo($"/AppointmentSessions/Admin");
    }

    protected override async Task ReloadRequired()
    {
        if (!Guid.TryParse(sessionId, out Guid id))
        {
            Back();
            return;
        }

        session = await SessionsService.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if (session is null)
        {
            Back();
            return;
        }

        await InvokeAsync(StateHasChanged);
    }
}
