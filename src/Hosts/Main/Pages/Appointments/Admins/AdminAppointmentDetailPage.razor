@page "/appointments/admin/{appointmentId}"

@if (appointment is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <AdminAppointmentDetail Appointment="@appointment"
                            OnEdit="@(() => NavigationManager.NavigateTo($"/appointments/admin/{appointmentId}/edit"))"
                            OnDeleted="@(() => NavigationManager.NavigateTo("/appointments/admin"))"
                            OnStatusChanged="ReloadRequired" />
</CascadingValue>

@code {
    [Parameter] public string? appointmentId { get; set; }

    private AppointmentReadDto? appointment;

    protected override async Task ReloadRequired()
    {
        if (!Guid.TryParse(appointmentId, out Guid id))
        {
            NavigationManager.NavigateTo("/appointments/admin");
            return;
        }

        appointment = await AppointmentsService.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if (appointment is null)
        {
            NavigationManager.NavigateTo("/appointments/admin");
            return;
        }

        NavService.OverridePageTitle(id.ToString(), appointment.ScheduledAt.ToString("f"));

        await InvokeAsync(StateHasChanged);
    }
}
