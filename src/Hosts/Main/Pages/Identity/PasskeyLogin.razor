@attribute [Route(AppRoutes.Account.LoginPasskey)]
@inherits LoginBase
@attribute [RequireAntiforgeryToken]


<HttpStatus CookieName="@IdentityCookieNames.StatusCookieName" />
<AntiforgeryToken />
<WebAuthnLoginForm @rendermode=@InteractiveServer />
<Stack>
    <StackButton Label="@Localizer["LoginVia", Localizer["Phone"]]" EndIcon="fa-solid fa-phone" Href="@AppRoutes.Account.LoginPhone" />
    <StackButton Label="@Localizer["LoginVia", Localizer["Email"]]" EndIcon="fa-solid fa-at" Href="@AppRoutes.Account.LoginEmail" />
    <StackButton Label="@Localizer["LoginVia", Localizer["Password"]]" EndIcon="fa-solid fa-asterisk" Href="@AppRoutes.Account.LoginPassword" />
</Stack>
