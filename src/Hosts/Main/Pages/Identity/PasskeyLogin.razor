@page "/Account/Login/Passkey"
@inherits IdentityBase
@attribute [RequireAntiforgeryToken]

<MudText Typo="Typo.h4" GutterBottom="true" Align="Align.Center">@Localizer["Login"]</MudText>
<AuthorizeView Context="authContext">
    <NotAuthorized>
        <HttpStatus CookieName="@IdentityRedirectManager.StatusCookieName" />
        <AntiforgeryToken />
        <WebAuthnLoginForm @rendermode=@InteractiveServer ReturnUrl="@ReturnUrl" />
        <MudDivider Class="my-3" />
        <form method="get" action="/Account/Login/Phone">
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <MudButton FullWidth="true" ButtonType="ButtonType.Submit">
                @Localizer["LoginVia", Localizer["Phone"]]
            </MudButton>
        </form>
        <form method="get"
              action="Account/Login/Password">
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <MudButton FullWidth="true" ButtonType="ButtonType.Submit">
                @Localizer["LoginVia", Localizer["Password"]]
            </MudButton>
        </form>
        <form method="get"
              action="Account/Login/Email">
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <MudButton FullWidth="true" ButtonType="ButtonType.Submit">
                @Localizer["LoginVia", Localizer["Email"]]
            </MudButton>
        </form>
    </NotAuthorized>
    <Authorized>
        <form method="get" action="@(ReturnUrl)">
            <MudButton FullWidth="true" ButtonType="ButtonType.Submit">@Localizer["Continue"]</MudButton>
        </form>
    </Authorized>
</AuthorizeView>
