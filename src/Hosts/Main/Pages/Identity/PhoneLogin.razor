@page "/Account/Login"
@page "/Account/Login/Phone"
@inherits IdentityBase
@attribute [RequireAntiforgeryToken]
<AuthorizeView>
    <NotAuthorized>
        <HttpStatus CookieName="@IdentityRedirectManager.StatusCookieName" />
        <PhoneLoginForm @rendermode=@InteractiveServer ReturnUrl="@ReturnUrl" FailureUrl="@failureUrl" />
        <Stack>
            <StackButton Label="@Localizer["LoginVia", Localizer["Password"]]" EndIcon="fa-regular fa-asterisk" Href="Account/Login/Password" />
            <StackButton Label="@Localizer["LoginVia", Localizer["Email"]]" EndIcon="fa-regular fa-at" Href="Account/Login/Email" />
            <StackButton Label="@Localizer["LoginVia", Localizer["Passkey"]]" EndIcon="fa-regular fa-key" Href="Account/Login/Passkey" />
        </Stack>
    </NotAuthorized>
    <Authorized>
        <form method="get" action="@(ReturnUrl)">
            <Stack>
                <StackButton Label="@Localizer["Continue"]" Href="@ReturnUrl" ButtonType="ButtonType.Submit" />
            </Stack>
        </form>
    </Authorized>
</AuthorizeView>
