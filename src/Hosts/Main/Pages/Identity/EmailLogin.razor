@attribute [Route(AppRoutes.Account.LoginEmail)]

@inherits LoginBase
@attribute [RequireAntiforgeryToken]


<HttpStatus CookieName="@IdentityCookieNames.StatusCookieName" />
<AntiforgeryToken />
<EmailLoginForm @rendermode=@InteractiveServer />
<Stack>
    <StackButton Label="@Localizer["LoginVia", Localizer["Phone"]]" EndIcon="fa-regular fa-phone" Href="@AppRoutes.Account.LoginPhone" />
    <StackButton Label="@Localizer["LoginVia", Localizer["Password"]]" EndIcon="fa-regular fa-asterisk" Href="@AppRoutes.Account.LoginPassword" />
    <StackButton Label="@Localizer["LoginVia", Localizer["Passkey"]]" EndIcon="fa-regular fa-key" Href="@AppRoutes.Account.LoginPasskey" />
</Stack>
