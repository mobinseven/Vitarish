@page "/Account/Login/Password"
@inherits IdentityBase
@attribute [RequireAntiforgeryToken]

<AuthorizeView>
    <NotAuthorized>
        <HttpStatus CookieName="@IdentityRedirectManager.StatusCookieName" />
        <PasswordLoginForm @rendermode=InteractiveServer />
        <Stack>
            <StackButton Label="@Localizer["LoginVia", Localizer["Phone"]]" EndIcon="fa-regular fa-phone" Href="Account/Login/Phone" />
            <StackButton Label="@Localizer["LoginVia", Localizer["Email"]]" EndIcon="fa-regular fa-at" Href="Account/Login/Email" />
            <StackButton Label="@Localizer["LoginVia", Localizer["Passkey"]]" EndIcon="fa-regular fa-key" Href="Account/Login/Passkey" />
        </Stack>
    </NotAuthorized>
    <Authorized>
        <Stack>
            <StackButton Label="@Localizer["Continue"]" Href="@ReturnUrlManager.GetReturnUrl()" />
        </Stack>
    </Authorized>
</AuthorizeView>
