@attribute [Route(AppRoutes.Account.LoginPassword)]
@inherits LoginBase
@attribute [RequireAntiforgeryToken]


<HttpStatus CookieName="@IdentityCookieNames.StatusCookieName" />
<PasswordLoginForm @rendermode=InteractiveServer />
<Stack>
    <StackButton Label="@Localizer["LoginVia", Localizer["Phone"]]" EndIcon="fa-solid fa-phone" Href="@AppRoutes.Account.LoginPhone" Color="Color.Secondary" />
    <StackButton Label="@Localizer["LoginVia", Localizer["Email"]]" EndIcon="fa-solid fa-at" Href="@AppRoutes.Account.LoginEmail" Color="Color.Secondary" />
    <StackButton Label="@Localizer["LoginVia", Localizer["Passkey"]]" EndIcon="fa-solid fa-key" Href="@AppRoutes.Account.LoginPasskey" Color="Color.Secondary" />
</Stack>
