@inject ReturnUrlManager ReturnUrlManager
@page "/Account/Unauthorized"

<AuthorizeView>
    <Authorized>
        <Stack>
            <StackField Label="@Localizer["AccessDenied"]" />
            <StackButton Label="@Localizer["Home"]" Href="/" />
        </Stack>
    </Authorized>
    <NotAuthorized>
        <Stack>
            <StackField Label="@Localizer["LoginRequired"]" />
            <StackButton @rendermode="null" Label="@Localizer["Continue"]" Href="/Account/Login" />
        </Stack>
    </NotAuthorized>
</AuthorizeView>

@code {

    [Parameter]
    [SupplyParameterFromQuery]
    public string? RequestedPath { get; set; }

    protected override void OnInitialized()
    {
        ReturnUrlManager.SetReturnUrl(RequestedPath);
    }
}
