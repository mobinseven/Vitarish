@attribute [Route(AppRoutes.Account.Logout)]
@inherits IdentityBase

@inject IIdentityServerInteractionService interactionService

@if(!LoggedOut)
{
    <EditForm Model="Input" method="post" OnValidSubmit="LogoutUser" FormName="Logout">
        <Stack>
            <StackField Label="@Localizer["LogoutMessage"]" />
            <StackButton Label="@Localizer["Continue"]" ButtonType="ButtonType.Submit" Color="Color.Error" EndIcon="fa-solid fa-sign-out" />
        </Stack>
    </EditForm>
}
else
{
    <Stack>
        <StackField Color="Color.Primary" Label="@Localizer["LogoutSuccessful"]" />
        @if(PostLogoutRedirectUri != null)
        {
            <StackButton Color="Color.Primary" Href="@PostLogoutRedirectUri" Label="@Localizer["Continue"]"/>
        }
        else
        {
            <StackButton Color="Color.Primary" Href="@AppRoutes.Home" Label="@Localizer["Continue"]"/>
        }
        @if(SignOutIframeUrl != null)
        {
            <iframe width="0" height="0" style="display:none" class="signout" src="@SignOutIframeUrl"></iframe>
        }
    </Stack>
}
