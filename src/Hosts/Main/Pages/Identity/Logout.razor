@page "/Account/Signout"
@inherits IdentityBase

@inject IIdentityServerInteractionService interactionService

@if(!LoggedOut)
{
    <EditForm Model="Input" method="post" OnValidSubmit="LogoutUser" FormName="Logout">
        <Stack>
            <StackField Label="@Localizer["LogoutMessage"]" />
            <StackButton Label="@Localizer["Continue"]" ButtonType="ButtonType.Submit" />
        </Stack>
    </EditForm>
}
else
{
    <Stack>
        <StackField Label="@Localizer["LogoutSuccessful"]" />
        @if(PostLogoutRedirectUri != null)
        {
            <StackButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning" Href="@PostLogoutRedirectUri">@Localizer["Continue"]</StackButton>
        }
        else
        {
            <StackButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning" Href="/">@Localizer["Continue"]</StackButton>
        }
        @if(SignOutIframeUrl != null)
        {
            <iframe width="0" height="0" style="display:none" class="signout" src="@SignOutIframeUrl"></iframe>
        }
    </Stack>
}
