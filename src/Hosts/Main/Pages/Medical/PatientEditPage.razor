@attribute [Route(AppRoutes.Medical.PatientEditTemplate)]

@if(initialized)
{
    <CascadingValue Value="IsAdmin">

        <PatientEditForm Project="patient"
                         OnUpdate="@(id => NavigationManager.NavigateTo(AppRoutes.Medical.Patient(id)))"
                         OnCreate="@(id => NavigationManager.NavigateTo(AppRoutes.Medical.Patient(id)))"
                         OnCancel="@(() => NavigationManager.NavigateTo(AppRoutes.Medical.Patient(patientId)))" />

    </CascadingValue>
}

@code {
    [Parameter] public string? patientId { get; set; }

    private ProjectReadDto? patient;
    private bool initialized;

    private void Back()
    {
        NavigationManager.NavigateTo(AppRoutes.Medical.Patients);
    }

    protected override async Task ReloadRequired()
    {
        if (!Guid.TryParse(patientId, out Guid id))
        {
            Back();
            return;
        }

        patient = await ProjectsService.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if (patient is null)
        {
            Back();
            return;
        }

        initialized = true;
    }
}
