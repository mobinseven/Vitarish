@page "/Medical/Patients/{patientId}/Edit"

@if(initialized)
{
    <CascadingValue Value="IsAdmin">

        <PatientEditForm Project="patient"
                         OnUpdate="@(id => NavigationManager.NavigateTo($"/Medical/Patients/{id}"))"
                         OnCreate="@(id => NavigationManager.NavigateTo($"/Medical/Patients/{id}"))"
                         OnCancel="@(() => NavigationManager.NavigateTo($"/Medical/Patients/{patientId}"))" />

    </CascadingValue>
}

@code {
    [Parameter] public string? patientId { get; set; }

    private ProjectReadDto? patient;
    private bool initialized;

    private void Back()
    {
        NavigationManager.NavigateTo("/Medical/Patients");
    }

    protected override async Task ReloadRequired()
    {
        if (!Guid.TryParse(patientId, out Guid id))
        {
            Back();
            return;
        }

        patient = await ProjectsService.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if (patient is null)
        {
            Back();
            return;
        }

        initialized = true;
    }
}
