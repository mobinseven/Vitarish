@attribute [Route(AppRoutes.Medical.PatientEditTemplate)]

@if(initialized)
{
    <CascadingValue Value="IsAdmin">

        <PatientEditForm Project="patient"
                         OnUpdate="@(id => NavigationManager.NavigateTo(AppRoutes.Medical.Patient(id)))"
                         OnCreate="@(id => NavigationManager.NavigateTo(AppRoutes.Medical.Patient(id)))"
                         OnCancel="@(() => NavigationManager.NavigateTo(AppRoutes.Medical.Patient(_id)))" />

    </CascadingValue>
}

@code {
    [Parameter] public Guid? patientId { get; set; }

    private ProjectReadDto? patient;
    private Guid _id;
    private bool initialized;

    private void Back()
    {
        NavigationManager.NavigateTo(AppRoutes.Medical.Patients);
    }

    protected override async Task ReloadRequired()
    {
        if (patientId is null)
        {
            Back();
            return;
        }

        var id = patientId.Value;

        _id = id;
        patient = await ProjectsService.GetAsync(_id, CancellationToken.None).GetValueOrDefaultAsync();

        if (patient is null)
        {
            Back();
            return;
        }

        initialized = true;
    }
}
