@attribute [Route(AppRoutes.Medical.PatientTemplate)]

@inject IEnumerable<IMedicalPatientSectionPlugin> PatientSectionPlugins

@if(patient is null)
{
    return;
}

<CascadingValue Value="IsAdmin">

    <PatientDetails Project="@patient"
                    OnEdit="@(id => NavigationManager.NavigateTo(AppRoutes.Medical.PatientEdit(id)))"
                    OnDeleted="@(() => NavigationManager.NavigateTo(AppRoutes.Medical.Patients))" />

    <ProceduresGrid Project="@patient"
                    OnClicked="@(procedureId => { if (procedureId.HasValue) NavigationManager.NavigateTo(AppRoutes.Medical.PatientProcedure(patient.Id, procedureId.Value)); })"
                    OnCreated="@(procedureId => NavigationManager.NavigateTo(AppRoutes.Medical.PatientProcedure(patient.Id, procedureId)))" />

    <PatientAppointmentsPanel Patient="@patient" OnEdit="@(() => NavigationManager.NavigateTo(AppRoutes.Medical.PatientEdit(patient.Id)))" />

    @* <PatientRemindersPanel PatientId="@patient.Id" /> *@

    @foreach (var plugin in PatientSectionPlugins)
    {
        <Stack>
            <StackField Label="@plugin.Label" />
            @plugin.Render(patient)
        </Stack>
    }

</CascadingValue>

@code {
    [Parameter] public string? patientId { get; set; }

    private ProjectReadDto? patient;
    private bool initialized;

    protected override async Task ReloadRequired()
    {
        if(!Guid.TryParse(patientId, out Guid id))
        {
            NavigationManager.NavigateTo(AppRoutes.Medical.Patients);
            return;
        }

        patient = await ProjectsService.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if(patient is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Medical.Patients);
            return;
        }

        NavService.OverridePageTitle(patient.Id.ToString(), patient.Name);
        initialized = true;
    }
}
