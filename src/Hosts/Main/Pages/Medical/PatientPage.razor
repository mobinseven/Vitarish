@page "/Medical/Patients/{patientId}"

@inject IEnumerable<IMedicalPatientSectionPlugin> PatientSectionPlugins

@if(patient is null)
{
    return;
}

<CascadingValue Value="IsAdmin">

    <PatientOverviewPanel Project="@patient" />

    <ProceduresGrid Project="@patient"
                    OnClicked="@(procedureId => NavigationManager.NavigateTo($"/Medical/Patients/{patientId}/{procedureId}"))"
                    OnCreated="@(procedureId => NavigationManager.NavigateTo($"/Medical/Patients/{patientId}/{procedureId}"))" />

    <PatientDetails Project="@patient"
                    OnEdit="@(id => NavigationManager.NavigateTo($"/Medical/Patients/{id}/Edit"))"
                    OnDeleted="@(() => NavigationManager.NavigateTo("/Medical/Patients"))" />

    <PatientAppointmentsPanel Patient="@patient" OnEdit="@(() => NavigationManager.NavigateTo($"/Medical/Patients/{patientId}/Edit"))" />

    @* <PatientRemindersPanel PatientId="@patient.Id" /> *@

    @foreach (var plugin in PatientSectionPlugins)
    {
        <Stack>
            <StackField Label="@plugin.Label" />
            @plugin.Render(patient)
        </Stack>
    }

</CascadingValue>

@code {
    [Parameter] public string? patientId { get; set; }

    private ProjectReadDto? patient;
    private bool initialized;

    protected override async Task ReloadRequired()
    {
        if(!Guid.TryParse(patientId, out Guid id))
        {
            NavigationManager.NavigateTo("/Medical/Patients");
            return;
        }

        patient = await ProjectsService.GetAsync(id, CancellationToken.None).GetValueOrDefaultAsync();

        if(patient is null)
        {
            NavigationManager.NavigateTo("/Medical/Patients");
            return;
        }

        NavService.OverridePageTitle(patient.Id.ToString(), patient.Name);
        initialized = true;
    }
}
