@attribute [Route(AppRoutes.Medical.Patients)]

@using Vitarish.Medical.Interface.Components.CheckIn

<CascadingValue Value="IsAdmin">
    <Stack>
        @if (IsAdmin)
        {
            <StackButton Label="@Localizer["CheckInPatient"]"
                         Href="@AppRoutes.Medical.CheckIn"
                         EndIcon="fa-regular fa-person-walking-arrow-right"
                         Color="Color.Primary" />
        }
    </Stack>
    <PatientsGrid OnClicked="@(id => NavigationManager.NavigateTo(AppRoutes.Medical.Patient(id)))"
                  OnAdd="@(() => NavigationManager.NavigateTo(AppRoutes.Medical.PatientNew))" />
</CascadingValue>

@code {
    protected override void OnInitialized() => NavService.EnableSearch();
}
