@page "/Medical/Admin"
@page "/Medical/"

@if(!initialized)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <Stack>
        <StackButton Label="@Localizer["MedicalDashboard"]"
                     Href="/Medical/Patients"
                     HelperText="@($"{patients} {Localizer["Patients"]}")" />
        <StackButton Label="@Localizer["CheckInPatient"]"
                     Href="/Medical/CheckIn"
                     EndIcon="fa-regular fa-person-walking-arrow-right"
                     Color="Color.Primary" />
    </Stack>
    <TodayAppointmentsWidget OnSessionClicked="@(id => NavigationManager.NavigateTo($"/Admin/Sessions/{id}"))"
                             OnSessionsClicked="@(() => NavigationManager.NavigateTo($"/Admin/Sessions"))" />
</CascadingValue>

@code {
    private int patients = 0;
    private bool initialized;

    protected override async Task ReloadRequired()
    {
        ProjectDescriptorDto descriptor = new()
        {
            Skip = 0,
            Take = int.MaxValue,
            Template = false,
            Descending = true
        };

        patients = await ProjectsService.CountAsync(descriptor, CancellationToken.None).GetValueOrDefaultAsync();
        initialized = true;
        await InvokeAsync(StateHasChanged);
    }
}
