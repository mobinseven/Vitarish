@attribute [Route(AppRoutes.Medical.Dashboard)]
@attribute [Route(AppRoutes.Medical.DashboardLegacy)]

@if(!initialized)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <Stack>
        <StackButton Label="@Localizer["MedicalDashboard"]"
                     Href="@AppRoutes.Medical.Patients"
                     HelperText="@($"{patients} {Localizer["Patients"]}")" />
        <StackButton Label="@Localizer["CheckInPatient"]"
                     Href="@AppRoutes.Medical.CheckIn"
                     EndIcon="fa-regular fa-person-walking-arrow-right"
                     Color="Color.Primary" />
    </Stack>
    <TodayAppointmentsWidget OnShiftClicked="@(id => NavigationManager.NavigateTo(AppRoutes.Appointments.AdminShift(id)))"
                             OnShiftsClicked="@(() => NavigationManager.NavigateTo(AppRoutes.Appointments.AdminShifts))" />
</CascadingValue>

@code {
    private int patients = 0;
    private bool initialized;

    protected override async Task ReloadRequired()
    {
        ProjectDescriptorDto descriptor = new()
        {
            Skip = 0,
            Take = int.MaxValue,
            Template = false,
            Descending = true
        };

        patients = await ProjectsService.CountAsync(descriptor, CancellationToken.None).GetValueOrDefaultAsync();
        initialized = true;
        await InvokeAsync(StateHasChanged);
    }
}
