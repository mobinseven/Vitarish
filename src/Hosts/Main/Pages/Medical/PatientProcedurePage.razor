@attribute [Route(AppRoutes.Medical.PatientProcedureTemplate)]

@inject IEnumerable<IMedicalProcedureSectionPlugin> ProcedureSectionPlugins

@if(patient is null || procedure is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <EventsGrid Project="@patient"
                EventClicked="@(id => { if (id.HasValue) NavigationManager.NavigateTo(AppRoutes.Medical.PatientEvent(_patientGuid, _procedureGuid, id.Value)); })"
                Procedure="@procedure"
                OnUpdate="ReloadRequired" />
    <ProcedureDetails Procedure="@procedure"
                      Project="@patient"
                      OnUpdate="ReloadRequired"
                      OnDelete="@(() => NavigationManager.NavigateTo(AppRoutes.Medical.Patient(_patientGuid)))" />

    @foreach (var plugin in ProcedureSectionPlugins)
    {
        <Stack>
            <StackField Label="@plugin.Label" />
            @plugin.Render(patient, procedure)
        </Stack>
    }
</CascadingValue>

@code {
    [Parameter] public Guid? patientId { get; set; }
    [Parameter] public Guid? procedureId { get; set; }

    private ProjectReadDto? patient;
    private ProcedureReadDto? procedure;
    private Guid _patientGuid;
    private Guid _procedureGuid;

    protected override async Task ReloadRequired()
    {
        if (patientId is not { } parsedPatientId)
        {
            NavigationManager.NavigateTo(AppRoutes.Medical.Patients);
            return;
        }

        if (procedureId is not { } parsedProcedureId)
        {
            NavigationManager.NavigateTo(AppRoutes.Medical.Patient(parsedPatientId));
            return;
        }

        _patientGuid = parsedPatientId;
        _procedureGuid = parsedProcedureId;

        patient = await ProjectsService.GetAsync(_patientGuid, CancellationToken.None).GetValueOrDefaultAsync();

        if (patient is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Medical.Patients);
            return;
        }

        procedure = await ProcedureService.GetAsync(_procedureGuid, CancellationToken.None).GetValueOrDefaultAsync();

        if (procedure is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Medical.Patient(_patientGuid));
            return;
        }

        NavService.OverridePageTitle(patient.Id.ToString(), patient.Name);
        NavService.OverridePageTitle(procedure.Id.ToString(), procedure.Name);

        await InvokeAsync(StateHasChanged);
    }
}
