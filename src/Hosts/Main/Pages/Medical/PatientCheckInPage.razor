@page "/Medical/CheckIn"

@using Vitarish.Medical.Interface.Components.CheckIn
@using Vitarish.Appointments.Domain.Dto

<CascadingValue Value="IsAdmin">

    @switch (context.CurrentStep)
    {
        case CheckInStep.Identify:
            <PatientCheckInIntentStep Context="context"
                                      OnSelectPatient="OnPatientSelected"
                                      OnCreateNew="GoToCreate" />
            break;

        case CheckInStep.Book:
            <PatientCheckInSessionStep Context="context"
                                       OnBooked="GoToConfirm"
                                       OnBack="GoBack" />
            break;

        case CheckInStep.Confirm:
            <PatientCheckInConfirmStep Context="context"
                                       OnStartAnother="RestartAsync" />
            break;

        default:
            <PatientCheckInCreateStep Context="context"
                                      OnCreated="OnPatientCreated"
                                      OnSelectExisting="OnPatientSelected"
                                      OnBack="GoBack" />
            break;
    }

</CascadingValue>

@code {
    private PatientCheckInContext context = new();
    private bool inCreateSubStep;

    private Task OnPatientSelected(ProjectReadDto patient)
    {
        context.SelectedPatient = patient;
        context.CurrentStep = CheckInStep.Book;
        inCreateSubStep = false;
        return Task.CompletedTask;
    }

    private Task OnPatientCreated(ProjectReadDto patient)
    {
        context.SelectedPatient = patient;
        context.CurrentStep = CheckInStep.Book;
        inCreateSubStep = false;
        return Task.CompletedTask;
    }

    private Task GoToCreate()
    {
        inCreateSubStep = true;
        context.CurrentStep = (CheckInStep)99;
        return Task.CompletedTask;
    }

    private Task GoToConfirm()
    {
        context.CurrentStep = CheckInStep.Confirm;
        return Task.CompletedTask;
    }

    private Task GoBack()
    {
        inCreateSubStep = false;
        context.CurrentStep = CheckInStep.Identify;
        return Task.CompletedTask;
    }

    private Task RestartAsync()
    {
        context.Reset();
        inCreateSubStep = false;
        return Task.CompletedTask;
    }
}
