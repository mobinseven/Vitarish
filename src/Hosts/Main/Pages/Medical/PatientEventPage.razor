@attribute [Route(AppRoutes.Medical.PatientEventTemplate)]

@if(patient is null || procedure is null || evt is null)
{
    return;
}

<CascadingValue Value="IsAdmin">
    <EventDetails Event="@evt"
                  Procedure="@procedure"
                  Project="@patient"
                  OnDelete="@(() => NavigationManager.NavigateTo(AppRoutes.Medical.PatientProcedure(patientId, procedureId)))"
                  OnUpdate="ReloadRequired" />
    <EventItemsTimeline Event="@evt" Procedure="@procedure" Project="@patient" />
</CascadingValue>

@code {
    [Parameter] public string? patientId { get; set; }
    [Parameter] public string? procedureId { get; set; }
    [Parameter] public string? eventId { get; set; }

    private ProjectReadDto? patient;
    private ProcedureReadDto? procedure;
    private EventReadDto? evt;

    protected override async Task ReloadRequired()
    {
        Guid.TryParse(patientId, out Guid patientGuid);
        Guid.TryParse(procedureId, out Guid procedureGuid);
        Guid.TryParse(eventId, out Guid eventGuid);

        if (patientGuid == Guid.Empty)
        {
            NavigationManager.NavigateTo(AppRoutes.Medical.Patients);
            return;
        }

        patient = await ProjectsService.GetAsync(patientGuid, CancellationToken.None).GetValueOrDefaultAsync();

        if (patient is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Medical.Patients);
            return;
        }

        procedure = await ProcedureService.GetAsync(procedureGuid, CancellationToken.None).GetValueOrDefaultAsync();

        if (procedure is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Medical.Patient(patientId));
            return;
        }

        evt = await EventService.GetAsync(eventGuid, CancellationToken.None).GetValueOrDefaultAsync();

        if (evt is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Medical.PatientProcedure(patientId, procedureId));
            return;
        }

        NavService.OverridePageTitle(patient.Id.ToString(), patient.Name);
        NavService.OverridePageTitle(procedure.Id.ToString(), procedure.Name);
        NavService.OverridePageTitle(evt.Id.ToString(), null);

        await InvokeAsync(StateHasChanged);
    }
}
