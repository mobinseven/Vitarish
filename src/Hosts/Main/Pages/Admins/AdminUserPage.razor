@attribute [Route(AppRoutes.Admin.UserTemplate)]
@inherits AdminCommonBase
@if(this.User is not null)
{
    <Stack>
        <StackTextField Label="@Localizer["FirstName"]" @bind-Value="this.User.FirstName" />
        <StackTextField Label="@Localizer["LastName"]" @bind-Value="this.User.LastName" />
        <StackTextField Label="@Localizer["Phone"]" @bind-Value="this.User.PhoneNumber" />
        <StackTextField Label="@Localizer["Password"]" @bind-Value="password" Style="direction: ltr" />
    </Stack>

    <Stack>
        <StackButton EndIcon="fa-regular fa-save" Color="Color.Primary" OnClick="Save" Label="@Localizer["Save"]" />
        <StackButton EndIcon="fa-regular fa-trash" Color="Color.Error" OnClick="Delete" Label="@Localizer["Delete"]" />
    </Stack>

    <UserRoleEditor User="User" OnUpdate="() => NavigationManager.Refresh(true)" />
}
else
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
