@page "/Admin/AuthenticationClients/{ClientId}"
@inherits AdminBase
@if(Client is not null)
{
    <MudPaper Class="my-3 pa-3" Elevation="0" Square="true">
        <MudTextField @bind-Value=Client.Url Label="@Localizer["Url"]" />
        <MudTextField @bind-Value=Client.Title Label="@Localizer["Title"]" />
        <MudTextField @bind-Value=Client.Description Label="@Localizer["Description"]" />
        <MudTextField @bind-Value=Client.LogoUrl Label="@Localizer["LogoUrl"]" />
        <MudCheckBox T="bool" Class="mt-2" @bind-Value=Client.AutoAccess Label="@Localizer["AutoAccess"]" />
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudButton StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="Save" Variant="Variant.Filled" DropShadow="false">@Localizer["Save"]</MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Delete" Variant="Variant.Text">@Localizer["Delete"]</MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
