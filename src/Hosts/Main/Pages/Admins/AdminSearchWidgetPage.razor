@page "/Admin/Search/Widget"
@inherits AdminCommonBase
@using Vitarish.Search.Domain.Models
@using Vitarish.Search.Interface.Components

<Stack>
    <StackField Label="@Localizer["SearchWidgetTester"]" Color="Color.Primary" />
    <StackField Label="@Localizer["SearchWidgetTesterHint"]" Color="Color.Secondary" />
    <StackTextField Label="@Localizer["IndexName"]" @bind-Value="_indexName" />
    <StackTextField Label="@Localizer["Type"]" @bind-Value="_searchType" />
    <StackNumericField Label="@Localizer["PageSize"]" @bind-Value="Limit" Min="1" Max="@SearchOptions.MaxLimit" />
</Stack>

<SearchWidget IndexName="@IndexName" Type="@SearchType" Options="@_options" />

@code {
    private string? _indexName;
    private string? _searchType;
    private int _limit = SearchOptions.DefaultLimit;
    private SearchOptions _options = default!;

    protected override void OnInitialized()
    {
        _options = CreateOptions(_limit);
    }

    private int Limit
    {
        get => _limit;
        set
        {
            _limit = value;
            _options = CreateOptions(value);
        }
    }

    private string? IndexName => string.IsNullOrWhiteSpace(_indexName)
        ? null
        : _indexName.Trim();

    private string? SearchType => string.IsNullOrWhiteSpace(_searchType)
        ? null
        : _searchType.Trim();

    private static SearchOptions CreateOptions(int limit) => new()
    {
        Limit = SearchOptions.NormalizeLimit(limit)
    };
}
