@page "/Admin/Tenants"
@inherits AdminCommonBase

<Stack>
    @foreach(var tenant in Tenants)
    {
        <StackButton Label="@tenant.Name" OnClick="() => RowClicked(tenant)" />
    }
</Stack>

<Stack>
    <StackButton Label="@Localizer["AddItem", Localizer["Tenant"]]" OnClick="AddTenant"StartIcon="fa-regular fa-plus" />
</Stack>
