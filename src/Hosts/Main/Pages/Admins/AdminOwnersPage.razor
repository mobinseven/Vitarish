@attribute [Route(AppRoutes.Admin.Owners)]

@inherits AdminCommonBase

<Stack>
    <StackField Label="@Localizer["Owners"]" />
    @foreach(var owner in Owners)
    {
        <StackButton Label="@owner.Name" Href="@AppRoutes.Admin.Owner(owner.Id)" />
    }
    <StackButton OnClick="Add" Color="Color.Primary" Label="@(Localizer["AddItem", Localizer["Owner"]])" EndIcon="fa-regular fa-plus" />
</Stack>
