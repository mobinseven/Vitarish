@page "/Admin/TenantIndicators"

@inherits AdminCommonBase

<MudSelect @bind-Value="selectedTenantId" Label="@Localizer["Select Tenant"]" Required Class="mb-4">
    @foreach (var tenant in Tenants)
    {
        <MudSelectItem Value="@tenant.Id">@tenant.Name</MudSelectItem>
    }
</MudSelect>

@if (selectedTenantId != Guid.Empty && Indicators.Any())
{
    <MudDataGrid T="TenantIndicator" Items="Indicators" Elevation="0" Class="mb-4">
        <Columns>
            <PropertyColumn Property="x => x.Method" Title="Method">
                <CellTemplate>
                    <MudChip Size="Size.Small" Color="@(context.Item.Method == IndicatorMethod.Hostname ? Color.Primary : Color.Secondary)">
                        @context.Item.Method
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Value" Title="Value" />
            <PropertyColumn Property="x => x.Status" Title="Status">
                <CellTemplate>
                    <MudChip Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                        @context.Item.Status
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Verification!.Method" Title="Verification">
                <CellTemplate>
                    @if (context.Item.Verification is not null)
                    {
                        <MudChip Size="Size.Small" Color="@(context.Item.Verification.Method == IndicatorVerificationMethod.Manual ? Color.Default : Color.Info)">
                            @context.Item.Verification.Method
                        </MudChip>
                    }
                    else
                    {
                        <MudChip Size="Size.Small" Color="Color.Default">Manual</MudChip>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.IsPrimary" Title="Primary">
                <CellTemplate>
                    @if (context.Item.IsPrimary)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.CreatedAt" Format="yyyy-MM-dd HH:mm" Title="Created" />
            <PropertyColumn Property="x => x.VerifiedAt" Format="yyyy-MM-dd HH:mm" Title="Verified" />
            <TemplateColumn Title="Actions">
                <CellTemplate>
                    <MudStack Row Spacing="1">
                        @if (context.Item.Status == IndicatorStatus.PendingVerification)
                        {
                            @if (context.Item.Verification?.Method == IndicatorVerificationMethod.DnsTxt)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Info"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               Title="Show DNS Instructions"
                                               OnClick="() => ShowDnsInstructions(context.Item)" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.VerifiedUser"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           Title="Verify"
                                           OnClick="() => VerifyIndicator(context.Item)" />
                        }
                        @if (context.Item.Status == IndicatorStatus.Verified)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           Title="Activate"
                                           OnClick="() => ActivateIndicator(context.Item)" />
                        }
                        @if (context.Item.Status == IndicatorStatus.Active)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Pause"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           Title="Disable"
                                           OnClick="() => DisableIndicator(context.Item)" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Title="Delete"
                                       OnClick="() => DeleteIndicator(context.Item)" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}
else if (selectedTenantId != Guid.Empty)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">No indicators found for this tenant.</MudAlert>
}

<MudDivider Class="my-3" />
<MudText Typo="Typo.h6" Class="mb-2">Add New Indicator</MudText>
<MudStack Spacing="2">
    <MudStack Row Spacing="2" AlignItems="AlignItems.End">
        <MudSelect @bind-Value="newMethod" Label="@Localizer["Method"]" Required>
            <MudSelectItem Value="@IndicatorMethod.Hostname">Hostname</MudSelectItem>
            <MudSelectItem Value="@IndicatorMethod.Subdomain">Subdomain</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="newValue"
                      Label="@Localizer["Domain/Subdomain"]"
                      Placeholder="e.g., app.customer.com"
                      Required />
        <MudSelect @bind-Value="newVerificationMethod" Label="@Localizer["Verification Method"]" Required>
            <MudSelectItem Value="@IndicatorVerificationMethod.Manual">Manual</MudSelectItem>
            <MudSelectItem Value="@IndicatorVerificationMethod.DnsTxt">DNS TXT Record</MudSelectItem>
        </MudSelect>
        <MudCheckBox @bind-Value="newIsPrimary" Label="Primary" />
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="AddIndicator"
                   Disabled="@(selectedTenantId == Guid.Empty || string.IsNullOrWhiteSpace(newValue))">
            Add Indicator
        </MudButton>
    </MudStack>
    @if (!string.IsNullOrWhiteSpace(verificationToken) && !string.IsNullOrWhiteSpace(verificationEvidence))
    {
        <MudAlert Severity="Severity.Info" Class="mt-2">
            <MudText Typo="Typo.body2">@Localizer["DnsTxtRecordInstruction"]</MudText>
            <MudText Typo="Typo.body2" Class="mt-2"><strong>Hostname:</strong> @verificationEvidence</MudText>
            <MudText Typo="Typo.body2"><strong>Value:</strong> verify=@verificationToken</MudText>
        </MudAlert>
    }
</MudStack>

@if (!string.IsNullOrWhiteSpace(feedbackMessage))
{
    <MudAlert Severity="@feedbackSeverity" Class="mt-4">@feedbackMessage</MudAlert>
}
