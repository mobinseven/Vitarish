@inherits AdminCommonBase
@attribute [Route(AppRoutes.Admin.OwnerTenantTemplate)]

@if(Tenant is null)
{
    return;
}

<TenantEditor Tenant="Tenant" TenantChanged="SetTenant" />

<TenantIndicatorsEditor Tenant="Tenant" />

<TenantModulesSelector SelectedModuleNames="selectedModules" Label="@Localizer["SelectModules"]">
    <StackButton Label="@Localizer["Save"]" OnClick="SaveTenantModules"
                 Color="Color.Primary" EndIcon="fa-regular fa-save"
                 Disabled="savingModules" />
</TenantModulesSelector>

<Stack>
    <StackButton Color="Color.Error" EndIcon="fa-regular fa-trash" OnClick="RemoveTenant" Label="@Localizer["DeleteItem", Localizer["Tenant"]]" />
</Stack>
