@page "/Profile/Password"
@inherits IdentityCommonBase

@if(User is null)
{
    return;
}

<WidthControlled>
    <MudPaper Class="sticky-top pa-3 my-3" Elevation="0">
        <MudText Typo="Typo.h3" GutterBottom="true" Align="Align.Center">@Localizer["EditItem", Localizer["Password"]]</MudText>
    </MudPaper>

    <MudPaper Elevation="0" Class="pa-4">

        <PasswordChangeForm UserId="@User.Id" />
    </MudPaper>
</WidthControlled>
