@attribute [Route(AppRoutes.Account.Settings)]
@inherits IdentityCommonBase

@if(User is null)
{
    return;
}
<MudStack Spacing="3">
    <AuthorizeView Context="admin" Policy="@IdentityDefinitions.PlatformAdmin">
        <Stack>
            <StackButton Label="@Localizer["Admin"]"
                         StartIcon="fa-regular fa-user-shield"
                         OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Admin.Home))" />
        </Stack>
    </AuthorizeView>
    <Stack>
        <StackField Label="@Localizer["DetailsOf", Localizer["Account"]]">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@User?.UserName</MudText>
        </StackField>
        <StackButton OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Account.SettingsName))"
                     StartIcon="fa-regular fa-person"
                     Label="@Localizer["Name"]">
            @User?.FullName
        </StackButton>
        <StackButton OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Account.SettingsEmail))"
                     StartIcon="fa-regular fa-envelope"
                     Label="@Localizer["Email"]">
            @User?.Email
        </StackButton>
        <StackButton OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Account.SettingsPhone))"
                     StartIcon="fa-regular fa-mobile"
                     Label="@Localizer["PhoneNumber"]">
            @User?.PhoneNumber
        </StackButton>
        <StackButton OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Account.SettingsPassword))"
                     StartIcon="fa-regular fa-lock"
                     Label="@Localizer["EditPassword"]">
            ***********
        </StackButton>
        <StackButton OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Account.SettingsPasskeys))"
                     StartIcon="fa-regular fa-key"
                     Label="@Localizer["Passkeys"]">
            
        </StackButton>
    </Stack>
    <Stack>
        <StackField Label="@Localizer["Language"]">
            <CultureSelector />
        </StackField>
    </Stack>
    <Stack>

        <StackButton OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Account.SettingsAppearance))"
                     StartIcon="fa-regular fa-paint-brush-alt"
                     Label="@Localizer["Appearance"]" />
    </Stack>

    <ProfileRoleEditor />

    <Stack>
        <StackButton Label="@Localizer["Logout"]"
                     Color="Color.Error"
                     EndIcon="fa-regular fa-sign-out-alt"
                     OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Account.Logout))" />
    </Stack>
</MudStack>
