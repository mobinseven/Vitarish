@page "/Profile/Email"
@inherits IdentityCommonBase

@if(User is null)
{
    return;
}

<WidthControlled>
    <MudPaper Class="sticky-top pa-3 my-3" Elevation="0">
        <MudText Typo="Typo.h3" GutterBottom="true" Align="Align.Center">@Localizer["EditItem", Localizer["Email"]]</MudText>
    </MudPaper>
    <MudPaper Elevation="0" Class="pa-4">
        @if(!string.IsNullOrEmpty(User.Email))
        {
            <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Start" NoIcon>@Localizer["CurrentEmail"]: @User.Email</MudAlert>
        }

        <EmailChangeForm />
    </MudPaper>
</WidthControlled>
