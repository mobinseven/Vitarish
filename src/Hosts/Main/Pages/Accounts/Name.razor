@attribute [Route(AppRoutes.Account.SettingsName)]
@inherits IdentityCommonBase

@if(User is null)
{
    return;
}

<Stack>
    <StackTextField @bind-Value="User.FirstName"
                  Label="@Localizer["FirstName"]"
                  Immediate="true"
                  Required="true" />
    <StackTextField @bind-Value="User.LastName"
                  Label="@Localizer["LastName"]"
                  Immediate="true"
                  Required="true" />
    <StackButton Label="@Localizer["Save"]" OnClick="@SaveNameAsync" Color="Color.Primary" EndIcon="fa-solid fa-save" />
</Stack>
