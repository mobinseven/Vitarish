@page "/Settings/Name"
@inherits IdentityCommonBase

@if(User is null)
{
    return;
}

<Stack>
    <StackTextField @bind-Value="User.FirstName"
                  Label="@Localizer["FirstName"]"
                  Immediate="true"
                  Required="true" />
    <StackTextField @bind-Value="User.LastName"
                  Label="@Localizer["LastName"]"
                  Immediate="true"
                  Required="true" />
    <StackButton Label="@Localizer["Save"]" OnClick="@(() => UserService.UpdateUserAsync(User.Id, User))" Color="Color.Primary" EndIcon="fa-regular fa-save" />
</Stack>
