@page "/Settings/Passkeys"

@inherits IdentityCommonBase

@if(IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <Stack>
        @if(!IsSupported)
        {
            <StackField Label="@Localizer["PasskeyNotSupported"]" />
        }
        else
        {
            <StackField Label="@Localizer["RegisteredPasskeys"]" />
            @foreach(var credential in Credentials)
            {
                <StackButton Label="@(credential.FriendlyName ?? Localizer["UnnamedPasskey"])" OnClick="@(() => DeletePasskeyAsync(credential))" />
            }
            <StackButton Label="@Localizer["RegisterNewPasskey"]"
                         OnClick="@RegisterPasskeyAsync"
                         StartIcon="fa-regular fa-key-plus" />
        }
    </Stack>
}

