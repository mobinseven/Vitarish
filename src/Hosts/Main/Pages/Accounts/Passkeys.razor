@attribute [Route(AppRoutes.Account.SettingsPasskeys)]

@inherits IdentityCommonBase

<Stack>
    @if(IsLoading)
    {
        <StackProgress Indeterminate="true" />
    }
    else
    {
        @if(!IsSupported)
        {
            <StackField Label="@Localizer["PasskeyNotSupported"]" />
        }
        else
        {
            @foreach(var credential in Credentials)
            {
                <StackButton Label="@(credential.FriendlyName ?? Localizer["UnnamedPasskey"])" OnClick="@(() => DeletePasskeyAsync(credential))" Color="Color.Error" />
            }
            <StackButton Label="@Localizer["RegisterNewPasskey"]"
                         OnClick="@RegisterPasskeyAsync"
                         Color="Color.Primary"
                         StartIcon="fa-solid fa-plus" />
        }
    }
</Stack>

