@attribute [Route(AppRoutes.Owners.TenantSettingsTemplate)]

@if (tenant is not null)
{
    <OwnerTenantContextHeader DashboardHref="@AppRoutes.Owners.Dashboard"
                              TenantsHref="@AppRoutes.Owners.Tenants" />

    <OwnerTenantSettingsForm Tenant="tenant" TenantChanged="SetTenant" />

    <TenantModulesSelector SelectedModuleNames="selectedModules" Label="@Localizer["ActiveModules"]">
        <StackButton Label="@Localizer["Save"]" OnClick="SaveModules"
                     Color="Color.Primary" EndIcon="fa-regular fa-save"
                     Disabled="savingModules" />
    </TenantModulesSelector>
}
