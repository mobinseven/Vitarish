@attribute [Route(AppRoutes.Owner)]
@attribute [Route(AppRoutes.Owners.Dashboard)]

<OwnerTenantContextHeader DashboardHref="@AppRoutes.Owners.Dashboard"
                          TenantsHref="@AppRoutes.Owners.Tenants" />

@if (tenants.Count > 0)
{
    <Stack>
        <StackField Label="@Localizer["Tenants"]" />
        @foreach (var tenant in tenants.Take(3))
        {
            <OwnerTenantCard Tenant="tenant" Href="@AppRoutes.Owners.Tenant(tenant.Id)" />
        }
        @if (tenants.Count > 3)
        {
            <StackButton Label="@Localizer["ViewAll"]"
                         Href="@AppRoutes.Owners.Tenants"
                         EndIcon="fa-regular fa-arrow-right" />
        }
    </Stack>
}
else if (initialized)
{
    <Stack>
        <StackButton Label="@Localizer["CreateWorkspace"]"
                     Href="@AppRoutes.Owners.CreateTenant"
                     EndIcon="fa-regular fa-plus" />
    </Stack>
}

<OwnerActionInboxCard />

<OwnerBillingCard />

<OwnerAuditLogCard />

<OwnerDangerZoneCard />
