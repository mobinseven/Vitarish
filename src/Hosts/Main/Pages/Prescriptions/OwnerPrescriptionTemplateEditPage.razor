@attribute [Route(AppRoutes.Prescriptions.OwnerPrescriptionTemplateCreate)]
@attribute [Route(AppRoutes.Prescriptions.OwnerPrescriptionTemplateEditTemplate)]
@inherits TenantPageBase

<PrescriptionTemplateEditor TemplateId="TemplateId" OnSaved="OnSaved" />

@code {
    [Parameter] public Guid? TemplateId { get; set; }
