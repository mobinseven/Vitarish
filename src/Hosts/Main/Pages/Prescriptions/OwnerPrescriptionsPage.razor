@attribute [Route(AppRoutes.Prescriptions.OwnerPrescriptions)]
@attribute [EnableSearch]
@inherits TenantPageBase

<PrescriptionsList PatientId="@selectedPatientId"
                   OnClicked="@(id => NavigationManager.NavigateTo(AppRoutes.Prescriptions.OwnerPrescription(id)))"
                   OnAdd="NavigateToCreate" />

@code {
    private Guid? selectedPatientId;

    protected override Task ReloadRequired()
    {
        // Default: show all prescriptions for the clinic (PatientId null shows empty state)
        // Patient selection will be handled via the check-in flow or patient picker
        return Task.CompletedTask;
    }

    private void NavigateToCreate()
    {
        NavigationManager.NavigateTo(AppRoutes.Prescriptions.OwnerPrescriptionCreate);
    }
}
