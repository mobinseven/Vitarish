@attribute [Route(AppRoutes.Prescriptions.OwnerPrescriptionCreate)]
@attribute [Route(AppRoutes.Prescriptions.OwnerPrescriptionCreateTemplate)]
@inherits TenantPageBase

<Stack>
    <StackField Label="@Localizer["NewPrescription"]" />

    <StackTextField @bind-Value="patientNationalId"
                    Label="@Localizer["PatientNationalId"]"
                    HelperText="@Localizer["PatientNationalIdHelp"]" />

    <InsuranceProviderSelector Providers="availableProviders"
                               SelectedProviderKey="selectedProviderKey"
                               SelectedProviderKeyChanged="OnProviderSelected"
                               Label="@Localizer["SelectInsuranceProvider"]"
                               IsLoading="isLoadingProviders" />

    <StackButton Color="Color.Primary"
                 Label="@Localizer["CreateDraft"]"
                 EndIcon="fa-regular fa-file-medical"
                 OnClick="CreateDraftAsync"
                 Disabled="@(PatientId is null || string.IsNullOrWhiteSpace(patientNationalId) || string.IsNullOrWhiteSpace(selectedProviderKey) || isLoadingProviders)" />
</Stack>

@if (PatientId is null)
{
    <MudAlert Severity="Severity.Warning" Class="mt-2">@Localizer["PatientContextRequired"]</MudAlert>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-2">@errorMessage</MudAlert>
}

@code {
    [Parameter] public Guid? PatientId { get; set; }

    [Inject] private IMediator Mediator { get; set; } = default!;

    private string? patientNationalId;
    private string? selectedProviderKey;
    private IReadOnlyList<AvailableProviderDto> availableProviders = [];
    private bool isLoadingProviders;
    private bool hasLoadedProviders;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (isLoadingProviders || hasLoadedProviders)
            return;

        isLoadingProviders = true;

        try
        {
            availableProviders = await Mediator.Send(new GetAvailableProvidersQuery());
            selectedProviderKey = availableProviders.Count == 1 ? availableProviders[0].ProviderKey : null;
            hasLoadedProviders = true;
        }
        finally
        {
            isLoadingProviders = false;
        }
    }

    protected override Task ReloadRequired()
    {
        return Task.CompletedTask;
    }

    private void OnProviderSelected(string providerKey)
    {
        selectedProviderKey = providerKey;
    }

    private async Task CreateDraftAsync()
    {
        if (PatientId is null || string.IsNullOrWhiteSpace(patientNationalId) || string.IsNullOrWhiteSpace(selectedProviderKey))
        {
            errorMessage = PatientId is null
                ? Localizer["PatientContextRequired"]
                : (availableProviders.Count == 0 ? Localizer["NoProvidersAvailable"] : Localizer["SelectInsuranceProvider"]);
            return;
        }

        errorMessage = null;

        Guid effectivePatientId = PatientId.Value;
        Guid doctorId = UserId ?? Guid.Empty;
        Guid clinicId = Guid.TryParse(RequestContext.TenantId, out Guid tid) ? tid : Guid.Empty;

        CreateDraftResult result = await Mediator.Send(new CreateDraftCommand
        {
            PatientId = effectivePatientId,
            PatientNationalId = patientNationalId.Trim(),
            DoctorId = doctorId,
            ClinicId = clinicId,
            SelectedProviderKey = selectedProviderKey,
            TenantId = RequestContext.TenantId ?? string.Empty
        });

        if (result.IsSuccess && result.PrescriptionId.HasValue)
        {
            NavigationManager.NavigateTo(AppRoutes.Prescriptions.OwnerPrescription(result.PrescriptionId.Value));
        }
        else
        {
            errorMessage = result.ErrorMessage ?? Localizer["UnknownError"];
            await InvokeAsync(StateHasChanged);
        }
    }
}
