@page "/"

<Stack>
    <StackField>
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Style="width: 100%;">
            <MudImage Src="/logo/brandmark-opacity50.webp" Height="200" />
        </MudStack>
    </StackField>
</Stack>

<AuthorizeView>
    <Authorized>
        <TenantsWidget />
        <Stack>
            <AuthorizeView Context="admin" Policy="@IdentityDefinitions.PlatformAdmin">
                <StackButton Label="@Localizer["Admin"]"
                             StartIcon="fa-regular fa-user-shield"
                             OnClick="@(() => NavigationManager.NavigateTo("/Admin"))" />
            </AuthorizeView>
            <StackButton Label="@Localizer["Settings"]"
                         StartIcon="fa-regular fa-user-gear"
                         OnClick="@(() => NavigationManager.NavigateTo("/Settings"))" />
        </Stack>
    </Authorized>
    <NotAuthorized>
        <Stack>
            <StackButton Label="@Localizer["Login"]"
                         StartIcon="fa-regular fa-sign-in"
                         OnClick="@(() => NavigationManager.NavigateTo("/Account/Login"))" />
        </Stack>
    </NotAuthorized>
</AuthorizeView>
