@attribute [Route(AppRoutes.Home)]
@attribute [Route(AppRoutes.Owner)]
@attribute [Route(AppRoutes.User)]

<Stack>
    <StackField>
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Style="width: 100%;">
            <MudImage Src="/logo/brandmark-opacity50.webp" Height="100" />
        </MudStack>
    </StackField>
</Stack>

@if (hasTenantContext && activeDashboards.Count > 0)
{
    <Stack>
        @foreach (var (name, route) in activeDashboards)
        {
            <StackButton Label="@name" Href="@route" StartIcon="fa-regular fa-grid" />
        }
    </Stack>
}
else
{
    <AuthorizeView>
        <Authorized>
            <TenantWidget OnTenantNavigate="NavigateToTenant" />
            @if (onboardingEnabled)
            {
                <Stack>
                    <StackButton Label="@Localizer["CreateWorkspace"]"
                                 Href="@AppRoutes.Setup.Index"
                                 EndIcon="fa-regular fa-plus" />
                </Stack>
            }
        </Authorized>
        <NotAuthorized>
            <Stack>
                <StackButton Label="@Localizer["Login"]"
                             EndIcon="fa-regular fa-sign-in"
                             OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Account.Login))" />
            </Stack>
        </NotAuthorized>
    </AuthorizeView>
}

