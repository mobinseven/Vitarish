@page "/"

<AuthorizeView>
    <Authorized>
        <Stack>
            <StackField Label="@Localizer["Dashboard"]" />
            <AuthorizeView Context="admin" Policy="@IdentityAccessConstants.Admin">
                <StackButton Label="@Localizer["Admin"]"
                             StartIcon="fa-thin fa-user-shield"
                             OnClick="@(() => NavigationManager.NavigateTo("/Admin"))" />
            </AuthorizeView>
            <StackButton Label="@Localizer["Profile"]"
                         StartIcon="fa-thin fa-user-gear"
                         OnClick="@(() => NavigationManager.NavigateTo("/Profile"))" />
        </Stack>
        <TenantsWidget />
        <Stack>
            <StackButton Label="@Localizer["Logout"]"
                         StartIcon="fa-thin fa-sign-out-alt"
                         OnClick="@(() => NavigationManager.NavigateTo("/Account/Signout"))" />
        </Stack>
    </Authorized>
    <NotAuthorized>
        <Stack>
            <StackButton Label="@Localizer["Login"]"
                         StartIcon="fa-thin fa-sign-in"
                         OnClick="@(() => NavigationManager.NavigateTo("/Account/Login"))" />
        </Stack>
    </NotAuthorized>
</AuthorizeView>
