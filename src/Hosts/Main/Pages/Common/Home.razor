@attribute [Route(AppRoutes.Home)]
@attribute [Route(AppRoutes.Owner)]
@attribute [Route(AppRoutes.User)]

<AuthorizeView>
    <Authorized>
        <CurrentUserTenantsWidget />

        @if(hasTenantContext && activeDashboards.Count > 0)
        {
            @foreach(var (name, record) in activeDashboards)
            {
                <DynamicComponent @key="name"
                                  Type="@record.ComponentType" />
            }

        }
        else
        {
            <TenantWidget OnTenantNavigate="NavigateToTenant" />
            @if(onboardingEnabled)
            {
                <Stack>
                    <StackButton Label="@Localizer["CreateWorkspace"]"
                                 Href="@AppRoutes.Setup.Index"
                                 EndIcon="fa-solid fa-plus" />
                </Stack>
            }
        }
    </Authorized>
    <NotAuthorized>
        <Stack>
            <StackButton Label="@Localizer["Login"]"
                         EndIcon="fa-solid fa-sign-in"
                         OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Account.Login))" />
        </Stack>
    </NotAuthorized>
</AuthorizeView>
