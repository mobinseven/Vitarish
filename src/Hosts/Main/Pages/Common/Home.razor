@attribute [Route(AppRoutes.Home)]

<Stack>
    <StackField>
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Style="width: 100%;">
            <MudImage Src="/logo/brandmark-opacity50.webp" Height="100" />
        </MudStack>
    </StackField>
</Stack>


<AuthorizeView>
    <Authorized>
        <TenantWidget />
    </Authorized>
    <NotAuthorized>
        <Stack>
            <StackButton Label="@Localizer["Login"]"
                         EndIcon="fa-regular fa-sign-in"
                         OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Account.Login))" />
        </Stack>
    </NotAuthorized>
</AuthorizeView>
