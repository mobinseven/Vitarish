@page "/"

<AuthorizeView>
    <Authorized>
        <TenantsWidget />
        <Stack>
            <AuthorizeView Context="admin" Policy="@IdentityAccessConstants.PlatformAdmin">
                <StackButton Label="@Localizer["Admin"]"
                             StartIcon="fa-thin fa-user-shield"
                             OnClick="@(() => NavigationManager.NavigateTo("/Admin"))" />
            </AuthorizeView>
            <StackButton Label="@Localizer["Settings"]"
                         StartIcon="fa-thin fa-user-gear"
                         OnClick="@(() => NavigationManager.NavigateTo("/Settings"))" />
        </Stack>
    </Authorized>
    <NotAuthorized>
        <Stack>
            <StackButton Label="@Localizer["Login"]"
                         StartIcon="fa-thin fa-sign-in"
                         OnClick="@(() => NavigationManager.NavigateTo("/Account/Login"))" />
        </Stack>
    </NotAuthorized>
</AuthorizeView>
