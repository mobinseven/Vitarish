@attribute [Route(AppRoutes.Clinic.CheckIn)]

@using Vitarish.Clinic.Interface.Components.CheckIn
@using Vitarish.Clinic.Interface.Models

    @switch(context.CurrentStep)
{
    case CheckInStep.Identify:
        <PatientFindOrCreate SearchContext="patientSearchContext"
                             CreateContext="patientCreateContext"
                             OnPatientSelected="OnPatientSelected"
                             OnPatientCreated="OnPatientCreated" />
        break;

    case CheckInStep.Book:
        <PatientCheckInShiftStep Context="context"
                                 OnBooked="GoToConfirm"
                                 OnBack="GoBack" />
        break;

    case CheckInStep.Confirm:
        <PatientCheckInConfirmStep Context="context"
                                   OnGoToPatient="GoToPatient"
                                   OnStartAnother="RestartAsync" />
        break;
}

@code {
    private PatientCheckInContext context = new();
    private PatientAdvancedSearchContext patientSearchContext = new();
    private PatientCreateContext patientCreateContext = new();

    private Task OnPatientSelected(ProjectReadDto patient)
    {
        context.SelectedPatient = patient;
        context.CurrentStep = CheckInStep.Book;
        return Task.CompletedTask;
    }

    private Task OnPatientCreated(ProjectReadDto patient)
    {
        context.SelectedPatient = patient;
        context.CurrentStep = CheckInStep.Book;
        return Task.CompletedTask;
    }

    private Task GoToConfirm()
    {
        context.CurrentStep = CheckInStep.Confirm;
        return Task.CompletedTask;
    }

    private Task GoBack()
    {
        context.CurrentStep = CheckInStep.Identify;
        return Task.CompletedTask;
    }

    private Task RestartAsync()
    {
        context.Reset();
        patientSearchContext.Reset();
        patientCreateContext.Reset();
        return Task.CompletedTask;
    }

    private Task GoToPatient(Guid patientId)
    {
        NavigationManager.NavigateTo(AppRoutes.Clinic.Patient(patientId));
        return Task.CompletedTask;
    }
}
