@attribute [Route(AppRoutes.Clinic.OwnerServiceProviderTemplate)]
@inherits ClinicOwnerServiceProviderPageBase

@if (showForm)
{
    <ServiceProviderForm ServiceProvider="@Provider"
                         OnSaved="@(id => { NavigationManager.NavigateTo(AppRoutes.Clinic.OwnerServiceProvider(id)); })"
                         OnCancelled="@(() => { showForm = false; StateHasChanged(); })" />
}
else
{
    @if (Provider is null)
    {
        <ServiceProviderForm ServiceProvider="null"
                             OnSaved="@(id => NavigationManager.NavigateTo(AppRoutes.Clinic.OwnerServiceProvider(id)))"
                             OnCancelled="Back" />
    }
    else
    {
        <ServiceProviderDetail Provider="@Provider"
                               OnEdit="@(() => { showForm = true; StateHasChanged(); })"
                               OnDeleted="Back" />
    }
}

@code {
    private bool showForm;
}
