@attribute [Route(AppRoutes.Clinic.PatientTemplate)]
@inherits ClinicPatientPageBase
@attribute [PageColor(Vitarish.Modules.Aggregator.Interface.Enums.Palettes.Lagoon)]

@if(Patient is null)
{
    return;
}

<PatientDetails Project="@Patient"
                OnEdit="@(id => NavigationManager.NavigateTo(AppRoutes.Clinic.PatientEdit(id)))"
                OnDeleted="@(() => NavigationManager.NavigateTo(AppRoutes.Clinic.Patients))" />

<ProceduresGrid Project="@Patient"
                OnClicked="@(procedureId => { if (procedureId.HasValue) NavigationManager.NavigateTo(AppRoutes.Clinic.PatientProcedure(Patient.Id, procedureId.Value)); })"
                OnCreated="@(procedureId => NavigationManager.NavigateTo(AppRoutes.Clinic.PatientProcedure(Patient.Id, procedureId)))" />

<PatientAppointmentsPanel Patient="@Patient" OnEdit="@(() => NavigationManager.NavigateTo(AppRoutes.Clinic.PatientEdit(Patient.Id)))" />

@* <PatientRemindersPanel PatientId="@Patient.Id" /> *@
