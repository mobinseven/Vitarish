@attribute [Route(AppRoutes.Clinic.PatientProcedureTemplate)]
@inherits ClinicPatientProcedurePageBase
@attribute [PageColor(Vitarish.Modules.Base.Interface.Enums.Palettes.Yellow)]

@if(Patient is null || Procedure is null)
{
    return;
}
<EventsGrid Project="@Patient"
            EventClicked="@(id => { if (id.HasValue) NavigationManager.NavigateTo(AppRoutes.Clinic.PatientEvent(PatientId, ProcedureId, id.Value)); })"
            Procedure="@Procedure"
            OnUpdate="ReloadRequired" />
<ProcedureDetails Procedure="@Procedure"
                  Project="@Patient"
                  OnUpdate="ReloadRequired"
                  OnDelete="@(() => NavigationManager.NavigateTo(AppRoutes.Clinic.Patient(PatientId)))" />
