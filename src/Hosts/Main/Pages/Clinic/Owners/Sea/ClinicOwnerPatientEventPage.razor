@attribute [Route(AppRoutes.Clinic.PatientEventTemplate)]
@inherits ClinicPatientProcedurePageBase
@attribute [PageColor(Vitarish.Modules.Base.Interface.Enums.Palettes.Pink)]

@if(Patient is null || Procedure is null || evt is null)
{
    return;
}
<EventDetails Event="@evt"
              Procedure="@Procedure"
              Project="@Patient"
              OnDelete="@(() => NavigationManager.NavigateTo(AppRoutes.Clinic.PatientProcedure(PatientId, ProcedureId)))"
              OnUpdate="ReloadRequired" />

<EventItemsTimeline Event="@evt" Procedure="@Procedure" Project="@Patient" />

@code {
    [Parameter] public Guid? eventId { get; set; }

    private EventReadDto? evt;

    protected override async Task ReloadRequired()
    {
        await base.ReloadRequired();

        if(Procedure is null)
        {
            return;
        }

        if(eventId is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Clinic.PatientProcedure(PatientId, ProcedureId));
            return;
        }

        var result = await SeaClient.GetEventAsync(eventId.Value, CancellationToken.None);
        evt = result.Succeeded ? result.Value : null;

        if(evt is null)
        {
            NavigationManager.NavigateTo(AppRoutes.Clinic.PatientProcedure(PatientId, ProcedureId));
            return;
        }

        NavService.OverridePageTitle(evt.Id.ToString(), null);
        await InvokeAsync(StateHasChanged);
    }
}
