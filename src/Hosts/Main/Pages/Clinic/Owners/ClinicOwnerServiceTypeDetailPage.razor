@attribute [Route(AppRoutes.Clinic.OwnerServiceTypeTemplate)]
@inherits ClinicOwnerServiceTypePageBase

@if (showForm)
{
    <ServiceTypeForm ServiceType="@ServiceType"
                     OnSaved="@(id => { NavigationManager.NavigateTo(AppRoutes.Clinic.OwnerServiceType(id)); })"
                     OnCancelled="@(() => { showForm = false; StateHasChanged(); })" />
}
else
{
    @if (ServiceType is null)
    {
        <ServiceTypeForm ServiceType="null"
                         OnSaved="@(id => NavigationManager.NavigateTo(AppRoutes.Clinic.OwnerServiceType(id)))"
                         OnCancelled="Back" />
    }
    else
    {
        <ServiceTypeDetail ServiceType="@ServiceType"
                           OnEdit="@(() => { showForm = true; StateHasChanged(); })"
                           OnDeleted="Back" />
    }
}

@code {
    private bool showForm;
}
