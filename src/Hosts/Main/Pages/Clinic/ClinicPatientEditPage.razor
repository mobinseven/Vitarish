@attribute [Route(AppRoutes.Clinic.PatientEditTemplate)]
@inherits ClinicPatientPageBase

@if(Patient is null)
{
    return;
}

<PatientEditForm Project="Patient"
                 OnUpdate="@(id => NavigationManager.NavigateTo(AppRoutes.Clinic.Patient(id)))"
                 OnCreate="@(id => NavigationManager.NavigateTo(AppRoutes.Clinic.Patient(id)))"
                 OnCancel="@(() => NavigationManager.NavigateTo(AppRoutes.Clinic.Patient(PatientId)))" />
