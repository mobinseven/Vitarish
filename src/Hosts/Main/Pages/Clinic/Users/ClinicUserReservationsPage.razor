@attribute [Route(AppRoutes.Clinic.UserReservations)]

<Stack>
    <StackButton Color="Color.Secondary"
                 OnClick="@(() => NavigationManager.NavigateTo(AppRoutes.Clinic.UserShifts))"
                 StartIcon="fa-regular fa-calendar-days"
                 Label="@Localizer["BrowseItems", Localizer["Shift"]]" />
</Stack>
<ReservationsList OnClicked="@(id => NavigationManager.NavigateTo(AppRoutes.Clinic.UserReservation(id)))" />

@code {
    protected override void OnInitialized() => NavService.EnableSearch();
}
