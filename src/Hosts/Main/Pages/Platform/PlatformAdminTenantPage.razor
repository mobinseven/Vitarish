@attribute [Route(AppRoutes.PlatformAdmin.OwnerTenantTemplate)]

@if(Tenant is null)
{
    return;
}

<TenantEditor Tenant="Tenant" TenantChanged="SetTenant" />

<TenantIndicatorsEditor Tenant="Tenant" />

<TenantModulesSelector SelectedModuleNames="selectedModules" Label="@Localizer["ActiveModules"]" />

<TenantAppsSelector SelectedAppNames="selectedApps" Label="@Localizer["ActiveApps"]" />

<Stack>
    <StackButton Label="@Localizer["Save"]"
                 OnClick="Save"
                 Color="Color.Primary"
                 EndIcon="fa-regular fa-save"
                 Disabled="saving" />
    <StackButton Color="Color.Error"
                 EndIcon="fa-regular fa-trash"
                 OnClick="RemoveTenant"
                 Label="@Localizer["DeleteItem", Localizer["Tenant"]]"
                 Disabled="saving" />
</Stack>
