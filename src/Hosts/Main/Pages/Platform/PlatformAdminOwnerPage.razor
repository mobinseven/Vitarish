
@attribute [Route(AppRoutes.PlatformAdmin.OwnerTemplate)]
@using Vitarish.Parties.Client
@using Vitarish.Parties.Contracts.Results
@using Vitarish.Parties.Contracts.Tenants

@if(Owner is null)
{
    return;
}

<OwnerEditor Owner="Owner" />


<Stack>
    <StackField Label="@Localizer["Tenants"]" />
    @foreach(var tenant in Tenants)
    {
        <StackButton Label="@tenant.Name" Href="@AppRoutes.PlatformAdmin.OwnerTenant(ownerGuid, tenant.Id)" Color="Color.Info" />
    }
    <StackButton Label="@Localizer["AddItem", Localizer["Tenant"]]" Color="Color.Primary" OnClick="AddTenant" EndIcon="fa-solid fa-plus" />
</Stack>

@code {

    [Parameter] public Guid? OwnerId { get; set; }

    private Guid ownerGuid;
    private OwnerReadDto? Owner;
    private List<TenantReadDto> Tenants = new();

    private void Back()
    {
        NavigationManager.NavigateTo(AppRoutes.PlatformAdmin.Owners);
    }

    protected override async Task ReloadRequired()
    {
        if (OwnerId is null)
        {
            Back();
            return;
        }

        var id = OwnerId.Value;

        ownerGuid = id;

        PartiesResult<OwnerReadDto> ownerResult = await PartiesClient.GetOwnerAsync(ownerGuid);
        Owner = ownerResult.Value;

        if(!ownerResult.IsSuccess || Owner == null)
        {
            Back();
        }

        PartiesResult<IReadOnlyList<TenantReadDto>> tenantsResult = await PartiesClient.GetTenantsByOwnerAsync(ownerGuid);
        Tenants = tenantsResult.IsSuccess && tenantsResult.Value is not null ? [.. tenantsResult.Value] : [];
    }

    private async Task AddTenant()
    {
        PartiesResult<TenantReadDto> addedResult = await PartiesClient.CreateTenantAsync(new TenantWriteDto { OwnerId = ownerGuid, Name = Localizer["Tenant"], AppId = "Default" });
        if(!addedResult.IsSuccess || addedResult.Value is null)
        {
            Snackbar.Add(Localizer["Error"], Severity.Error);
            return;
        }
        NavigationManager.NavigateTo(AppRoutes.PlatformAdmin.OwnerTenant(ownerGuid, addedResult.Value.Id));
    }

    private async Task Remove()
    {
        _ = await PartiesClient.DeleteOwnerAsync(ownerGuid);
        Back();
    }
}
