@attribute [Route(AppRoutes.Links.ShortTemplate)]
@inherits CommonBase
@inject ILinkResolverService LinkResolver

@if (_notFound)
{
    <NotFound />
}

@code {
    [Parameter] public string? code { get; set; }

    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (string.IsNullOrWhiteSpace(code))
        {
            _notFound = true;
            return;
        }

        string domain = new Uri(NavigationManager.Uri).Host;
        LinkResolutionResult result = await LinkResolver.ResolveAsync(domain, code);

        switch (result)
        {
            case LinkResolutionResult.Active active:
                NavigationManager.NavigateTo(active.DestinationUrl, forceLoad: true);
                break;
            case LinkResolutionResult.Disabled:
                NavigationManager.NavigateTo(AppRoutes.Links.Disabled);
                break;
            case LinkResolutionResult.Expired:
                NavigationManager.NavigateTo(AppRoutes.Links.Expired);
                break;
            default:
                _notFound = true;
                break;
        }
    }
}
