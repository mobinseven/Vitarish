@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject IStringLocalizer Localizer
<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <SearchRouteState RouteData="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToUnauthorized UnauthorizedRoute="@AppRoutes.Account.Unauthorized" />
            </NotAuthorized>
            <Authorizing>
                <MudProgressLinear Indeterminate />
            </Authorizing>
            </AuthorizeRouteView>
        </SearchRouteState>
    </Found>
    <NotFound>
        <RouteView RouteData="new RouteData(typeof(NotFound), new Dictionary<string,object?>())" DefaultLayout="typeof(SimpleLayout)" />
    </NotFound>
</Router>
