@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RouteView RouteData="new RouteData(typeof(NotAuthorized), new Dictionary<string, object?>())" DefaultLayout="typeof(SimpleLayout)" />
            </NotAuthorized>
            <Authorizing>
                <MudProgressLinear Indeterminate />
            </Authorizing>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <RouteView RouteData="new RouteData(typeof(NotFound), new Dictionary<string,object?>())" DefaultLayout="typeof(SimpleLayout)" />
    </NotFound>
</Router>
