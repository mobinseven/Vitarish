@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.Localization
@using MudBlazor
@using Vitarish.Interfaces.Base.Common
@inject IStringLocalizer Localizer
<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <MudText Typo="Typo.h4" GutterBottom="true" Align="Align.Center">@Localizer["AccessDenied"]</MudText>
                <MudChip T="string" Size="Size.Large">@Localizer["AccessDeniedMessage"]</MudChip>
            </NotAuthorized>
            <Authorizing>
                <MudProgressLinear Indeterminate />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector=".focus" />
    </Found>
</Router>
