@using Vitarish.Modules.Aggregator.Core

<Stack>
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <StackField Label="@Label" />
    }
    @foreach (var module in Modules)
    {
        <StackCheckbox Value="IsSelected(module.Name)"
                       ValueChanged="@(selected => ToggleModule(module.Name, selected))"
                       Label="@module.Name"
                       Disabled="Disabled" />
    }
    @ChildContent
</Stack>

@code {
    [Inject] private IReadOnlyList<IModule> Modules { get; set; } = default!;

    [Parameter] public ISet<string> SelectedModuleNames { get; set; } = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public EventCallback<ISet<string>> SelectedModuleNamesChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsSelected(string moduleName) => SelectedModuleNames.Contains(moduleName);

    private async Task ToggleModule(string moduleName, bool selected)
    {
        if (selected)
        {
            SelectedModuleNames.Add(moduleName);
        }
        else
        {
            SelectedModuleNames.Remove(moduleName);
        }

        await SelectedModuleNamesChanged.InvokeAsync(SelectedModuleNames);
    }
}
