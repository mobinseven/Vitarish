@inherits LayoutComponentBase

@if(Initialized)
{
    <ThemeConnector>
        <MudRTLProvider RightToLeft="@System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft" Style="min-height: 100dvh;">
            <BreakpointProvider @bind-Breakpoint="PageBreakpoint" BreakpointReceived="() => BreakpointReceived  = true" />
            @if(BreakpointReceived)
            {
                <CascadingValue Value="@PageBreakpoint">

                    <BreadcrumbsTree />

                    <WidthControlled>

                        <TitleContainer />

                        <CascadingValue Value="NavService.SearchString">
                            @Body
                        </CascadingValue>

                    </WidthControlled>

                    <div style="height: 20dvh;">
                        <hr />
                    </div>

                    <div style="position: fixed; z-index: 10; bottom: 0; width: 100%;pointer-events: none;">
                        @if(PageBreakpoint >= Breakpoint.Sm)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-5">
                                <Stack Style="border-radius: 70px; pointer-events: auto;">
                                    <NavMenu Size="Size.Large" />
                                </Stack>
                            </MudStack>
                        }
                        else if(PageBreakpoint < Breakpoint.Sm)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-1">
                                <Stack Style="border-radius: 70px; pointer-events: auto;">
                                    <NavMenu />
                                </Stack>
                            </MudStack>
                        }
                    </div>
                    <AntiforgeryToken />
                </CascadingValue>
            }
            <MudPopoverProvider />
            <MudDialogProvider FullWidth="true" 
                               MaxWidth="MaxWidth.Small" />
            <MudSnackbarProvider />
        </MudRTLProvider>
    </ThemeConnector>
}
