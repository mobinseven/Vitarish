@inherits LayoutComponentBase

@if(Initialized)
{
    <ThemeConnector />

    <div style="height: 100%">
        <MudRTLProvider RightToLeft="@System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft" Style="min-height: 100dvh;">
            @if(BreakpointReceived)
            {
                <CascadingValue Value="@PageBreakpoint">

                    <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
                        @{
                            var items = NavService.Breadcrumbs.Skip(1).Take(NavService.Breadcrumbs.Count - 1).Reverse().ToList();
                        }
                        @if(items.Count > 0)
                        {
                            <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelineAlign="TimelineAlign.Default" TimelinePosition="TimelinePosition.Start">
                                @foreach(var breadcrumb in items)
                                {
                                    <MudTimelineItem Elevation="0" Size="Size.Small" Variant="Variant.Outlined" DotStyle="background: none" Class="my-2">
                                        <ItemDot>
                                            <MudButton Href="@breadcrumb.Path" Style="min-width: max-content;" Class="glass py-3">@breadcrumb.Text</MudButton>
                                        </ItemDot>
                                    </MudTimelineItem>
                                }
                            </MudTimeline>
                        }
                        else
                        {
                            <div style="height: 10dvh;">
                                <hr />
                            </div>
                        }
                    </MudStack>


                    <WidthControlled>
                        @if(!Navigating)
                        {
                            <MudPaper Class="sticky-top pa-3 mb-3 glass" Elevation="0">
                                <MudText Typo="Typo.h4" GutterBottom="true" Align="Align.Center">@Localizer[NavService.Breadcrumbs.First().Text]</MudText>
                            </MudPaper>
                        }

                        @Body

                    </WidthControlled>

                    <div style="height: 20dvh;">
                        <hr />
                    </div>


                    <div style="position: fixed; bottom: 0; width: 100%;pointer-events: none;">
                        @if(PageBreakpoint >= Breakpoint.Sm)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-5">
                                <MudPaper Class="pa-5" Elevation="20" Style="border-radius: 70px; pointer-events: auto;">
                                    <NavMenu Size="Size.Large" />
                                </MudPaper>
                            </MudStack>
                        }
                        else if(PageBreakpoint < Breakpoint.Sm)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-1">
                                <MudPaper Class="pa-1" Elevation="20" Style="border-radius: 70px; pointer-events: auto;">
                                    <NavMenu />
                                </MudPaper>
                            </MudStack>
                        }
                    </div>
                    <AntiforgeryToken />
                </CascadingValue>
            }
            <MudPopoverProvider />
            <MudDialogProvider FullWidth="true"
                               MaxWidth="MaxWidth.Small" />
            <MudSnackbarProvider />
        </MudRTLProvider>
    </div>

}
