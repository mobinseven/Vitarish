@using Vitarish.Parties.Interface.Components.Common
@inherits LayoutComponentBase

@if(Initialized)
{
    <ThemeConnector>
        <MudRTLProvider RightToLeft="@System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft" Style="min-height: 100dvh;">
            <BreakpointProvider @bind-Breakpoint="PageBreakpoint" BreakpointReceived="() => BreakpointReceived = true" />
            @if(BreakpointReceived)
            {
                <CascadingValue Value="@PageBreakpoint">

                    <div style="height: 10dvh;">
                        <hr />
                    </div>


                    <WidthControlled>

                        <TenantHeader />

                        @* <CurrentUserTenantsWidget /> *@


                        <BreadcrumbsTree />

                        <TitleContainer />

                        <CascadingValue Value="NavService.SearchString">
                            @Body
                        </CascadingValue>

                        <Stack>
                            <StackField>
                                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Style="width: 100%;">
                                    <MudImage Src="/logo/brandmark-opacity50.webp" Height="100" />
                                </MudStack>
                            </StackField>
                        </Stack>

                    </WidthControlled>

                    <div style="height: 20dvh;">
                        <hr />
                    </div>

                    <div style="position: fixed; z-index: 10; bottom: 0; width: 100%;pointer-events: none;">
                        @if(PageBreakpoint >= Breakpoint.Sm)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-5" Style="pointer-events: auto;">
                                <NavMenu Size="Size.Large" />
                            </MudStack>
                        }
                        else if(PageBreakpoint < Breakpoint.Sm)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-1" Style="pointer-events: auto;">
                                <NavMenu />
                            </MudStack>
                        }
                    </div>
                    <AntiforgeryToken />
                </CascadingValue>
            }
            <MudPopoverProvider />
            <MudDialogProvider FullWidth="true"
                               MaxWidth="MaxWidth.Small" />
            <MudSnackbarProvider />
        </MudRTLProvider>
    </ThemeConnector>
}
