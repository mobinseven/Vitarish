@using Vitarish.Interfaces.Base.Abstractions
@using System.Collections.Concurrent
@using System.Reflection

@ChildContent

@code {
    private static readonly ConcurrentDictionary<Type, bool> SearchEnabledByPageType = new();

    [Inject]
    public required INavService NavService { get; set; }

    [Parameter, EditorRequired]
    public required RouteData RouteData { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet()
    {
        bool searchEnabled = SearchEnabledByPageType.GetOrAdd(
            RouteData.PageType,
            static pageType => pageType.GetCustomAttribute<EnableSearchAttribute>(inherit: true) is not null);
        if (searchEnabled)
        {
            NavService.EnableSearch();
            return;
        }

        NavService.DisableSearch();
    }
}
