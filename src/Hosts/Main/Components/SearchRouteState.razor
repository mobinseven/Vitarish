@using Vitarish.Interfaces.Base.Abstractions
@using System.Reflection

@ChildContent

@code {
    [Inject]
    public required INavService NavService { get; set; }

    [Parameter, EditorRequired]
    public required RouteData RouteData { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet()
    {
        bool searchEnabled = RouteData.PageType.GetCustomAttribute<EnableSearchAttribute>(inherit: true) is not null;
        if (searchEnabled)
        {
            NavService.EnableSearch();
            return;
        }

        NavService.DisableSearch();
    }
}
