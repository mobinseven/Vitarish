@inherits CommonBase
@inject NavigationManager Nav
@inject ReturnUrlManager ReturnUrlManager

<AuthorizeView>
    <Authorized>
        <Stack>
            <StackField Label="@Localizer["AccessDenied"]" />
            <StackButton Label="@Localizer["Home"]" Href="/" />
        </Stack>
    </Authorized>
    <NotAuthorized>
        <Stack>
            <StackField Label="@Localizer["LoginRequired"]" />
            <StackButton Label="@Localizer["Continue"]" Href="/Account/Login" OnClick="@StoreReturnUrl" />
        </Stack>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string RequestedPath => new Uri(Nav.Uri).PathAndQuery;
    
    private void StoreReturnUrl()
    {
        ReturnUrlManager.SetReturnUrl(RequestedPath);
    }
}
