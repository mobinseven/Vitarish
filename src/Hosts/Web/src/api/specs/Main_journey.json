{
  "openapi": "3.1.1",
  "info": {
    "title": "Vitarish.Main | journey",
    "version": "1.0.0"
  },
  "paths": {
    "/api/modules/journey/current": {
      "get": {
        "tags": [
          "Journey"
        ],
        "operationId": "Journey_GetCurrent",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JourneyDecisionDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "JourneyDecisionDto": {
        "required": [
          "step"
        ],
        "type": "object",
        "properties": {
          "step": {
            "$ref": "#/components/schemas/JourneyStepDto"
          },
          "legacyReturnUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "legacyRequiresProfileCompletion": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "JourneyDestinationKindDto": {
        "enum": [
          "Gate",
          "ReturnUrl",
          "AppDashboard",
          "UserHome",
          "GlobalDashboard"
        ]
      },
      "JourneyGateDto": {
        "required": [
          "kind",
          "isBlocking",
          "destinationUrl"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/JourneyGateKindDto"
          },
          "isBlocking": {
            "type": "boolean"
          },
          "destinationUrl": {
            "type": "string"
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "JourneyGateKindDto": {
        "enum": [
          "ContactConfirmation",
          "ProfileCompletion",
          "RequiredConsent",
          "WorkspaceSelection",
          "AccountRecovery",
          "SuspiciousLogin",
          "PasskeyEnrollmentPrompt",
          "MfaEnrollmentPrompt"
        ]
      },
      "JourneyStepDto": {
        "required": [
          "destinationUrl",
          "destinationKind"
        ],
        "type": "object",
        "properties": {
          "destinationUrl": {
            "type": "string"
          },
          "destinationKind": {
            "$ref": "#/components/schemas/JourneyDestinationKindDto"
          },
          "blockingGate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JourneyGateDto"
              }
            ]
          },
          "nonBlockingGates": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/JourneyGateDto"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Journey"
    }
  ]
}