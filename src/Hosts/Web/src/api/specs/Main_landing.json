  "components": {
    "schemas": {
      "AgentInteractiveOptionResponse": {
        "required": [
          "key",
          "label"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "AgentInteractiveQuestionResponse": {
        "required": [
          "prompt",
          "options",
          "maxSelections"
        ],
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentInteractiveOptionResponse"
            }
          },
          "maxSelections": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "AgentInteractiveReplyResponse": {
        "required": [
          "text",
          "question",
          "references",
          "nextAction"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "question": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AgentInteractiveQuestionResponse"
              }
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nextAction": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LandingCatalogResponse": {
        "required": [
          "features",
          "consultation",
          "nextActions"
        ],
        "type": "object",
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LandingFeatureResponse"
            }
          },
          "consultation": {
            "$ref": "#/components/schemas/LandingConsultationResponse"
          },
          "nextActions": {
            "$ref": "#/components/schemas/LandingNextActionsResponse"
          }
        }
      },
      "LandingConsultationOptionResponse": {
        "required": [
          "key",
          "featureKeys",
          "proof"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "featureKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proof": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LandingProofKind"
              }
            ]
          }
        }
      },
      "LandingConsultationQuestionResponse": {
        "required": [
          "key",
          "maxSelections",
          "options"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "maxSelections": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LandingConsultationOptionResponse"
            }
          }
        }
      },
      "LandingConsultationResponse": {
        "required": [
          "kind",
          "booking",
          "pains"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/LandingConsultationQuestionResponse"
          },
          "booking": {
            "$ref": "#/components/schemas/LandingConsultationQuestionResponse"
          },
          "pains": {
            "$ref": "#/components/schemas/LandingConsultationQuestionResponse"
          }
        }
      },
      "LandingConversationResponse": {
        "required": [
          "conversationId",
          "message"
        ],
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "reply": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AgentInteractiveReplyResponse"
              }
            ]
          }
        }
      },
      "LandingFeatureAvailability": {
        "enum": [
          "Live",
          "InProgress",
          "NotYet"
        ]
      },
      "LandingFeatureResponse": {
        "required": [
          "key",
          "availability"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "availability": {
            "$ref": "#/components/schemas/LandingFeatureAvailability"
          }
        }
      },
      "LandingHostBindingResponse": {
        "required": [
          "hostname",
          "tenantId"
        ],
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string"
          },
          "tenantId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "LandingNextActionsResponse": {
        "required": [
          "openClinic",
          "talkToTeam",
          "tryVoice"
        ],
        "type": "object",
        "properties": {
          "openClinic": {
            "type": "string"
          },
          "talkToTeam": {
            "type": "string"
          },
          "tryVoice": {
            "type": "string"
          }
        }
      },
      "LandingOnboardingHandoffRequest": {
        "required": [
          "category",
          "answers"
        ],
        "type": "object",
        "properties": {
          "category": {
            "type": [
              "null",
              "string"
            ]
          },
          "answers": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LandingOnboardingHandoffResponse": {
        "required": [
          "hostname",
          "token"
        ],
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "LandingProofKind": {
        "enum": [
          "NoShowCost",
          "BookingPreview",
          "PatientTimeline",
          "Dictation",
          "ShiftWeek",
          "InProgress",
          null
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SetLandingHostBindingRequest": {
        "required": [
          "tenantId"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SetLandingHostBindingResponse": {
        "required": [
          "hostname",
          "previousTenantId",
          "tenantId",
          "changed"
        ],
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string"
          },
          "previousTenantId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "changed": {
            "type": "boolean"
          }
        }
      },
      "SubmitLandingMessageRequest": {
        "required": [
          "ownerKey",
          "message"
        ],
        "type": "object",
        "properties": {
          "ownerKey": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "conversationId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Landing"
    }
  ]
}