            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ownerKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
