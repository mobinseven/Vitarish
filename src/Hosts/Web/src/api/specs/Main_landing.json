        "properties": {
          "hostname": {
            "type": "string"
          },
          "previousTenantId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "changed": {
            "type": "boolean"
          }
        }
      },
