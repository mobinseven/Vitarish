            }
          }
        }
      },
      "IndexSearchDocumentRequest": {
        "required": [
          "indexName",
          "documents"
        ],
        "type": "object",
        "properties": {
          "indexName": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchDocumentDto"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RebuildSearchIndexRequest": {
        "required": [
          "indexName"
        ],
        "type": "object",
        "properties": {
          "indexName": {
            "type": "string"
          }
        }
      },
      "SearchDocumentDto": {
        "required": [
          "id",
          "title",
          "tenantId",
          "type"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": [
              "null",
              "string"
            ]
          },
          "semanticText": {
            "type": [
              "null",
              "string"
            ]
          },
          "tenantId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "navigationUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "indexName": {
            "type": [
              "null",
              "string"
            ]
          },
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "SearchOptionsDto": {
        "type": "object",
        "properties": {
          "skip": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "limit": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "tenantId": {
            "type": [
              "null",
              "string"
            ]
          },
          "corpusId": {
            "type": [
              "null",
              "string"
            ]
          },
          "metadataFilters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "retrievalMode": {
            "$ref": "#/components/schemas/SearchRetrievalModeDto"
          },
          "minScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "explain": {
            "type": "boolean"
          }
        }
      },
