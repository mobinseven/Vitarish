          "tenantId"
        ],
        "type": "object",
        "properties": {
          "indexName": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "corpusId": {
            "type": [
