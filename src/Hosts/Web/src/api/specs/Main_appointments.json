  "components": {
    "schemas": {
      "AppointmentsCommandResult": {
        "required": [
          "succeeded"
        ],
        "type": "object",
        "properties": {
          "succeeded": {
            "type": "boolean"
          },
          "entityId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AppointmentsError"
              }
            ]
          }
        }
      },
      "AppointmentsError": {
        "required": [
          "code",
          "message"
        ],
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/AppointmentsErrorCode"
          },
          "message": {
            "type": "string"
          },
          "validationErrors": {
            "type": [
              "null",
              "object"
