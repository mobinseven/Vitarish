                "type": "string"
              }
            }
          }
        }
      },
      "AppointmentsErrorCode": {
        "type": "integer"
      },
      "BookableDateQueryRequest": {
        "required": [
          "shiftId",
          "from",
          "to"
        ],
        "type": "object",
        "properties": {
          "shiftId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "BookableShiftSlot": {
        "required": [
          "shift",
          "occurrence"
