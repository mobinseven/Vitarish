          "status": {
            "$ref": "#/components/schemas/ShiftStatus"
          },
          "visibility": {
            "$ref": "#/components/schemas/ShiftVisibility"
          },
          "dayOfWeek": {
            "$ref": "#/components/schemas/DayOfWeek"
          },
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "endTime": {
            "type": "string",
