{
  "openapi": "3.1.1",
  "info": {
    "title": "Vitarish.Main | social",
    "version": "1.0.0"
  },
  "paths": {
    "/api/modules/social/connections": {
      "get": {
        "tags": [
          "Social"
        ],
        "operationId": "SocialListConnections",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SocialConnectionResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/modules/social/connections/{connectionId}/webhooks/latest": {
      "get": {
        "tags": [
          "Social"
        ],
        "operationId": "SocialGetLatestWebhook",
        "parameters": [
          {
            "name": "connectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SocialWebhookEventResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/modules/social/webhooks/{id}/replay": {
      "post": {
        "tags": [
          "Social"
        ],
        "operationId": "SocialReplayWebhook",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SocialReplayWebhookResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SocialConnectionResponse": {
        "required": [
          "id",
          "provider",
          "externalAccountId",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "$ref": "#/components/schemas/SocialProviderResponse"
          },
          "externalAccountId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SocialConnectionStatusResponse"
          }
        }
      },
      "SocialConnectionStatusResponse": {
        "type": "integer"
      },
      "SocialErrorKind": {
        "type": "integer"
      },
      "SocialErrorResponse": {
        "required": [
          "kind",
          "message"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/SocialErrorKind"
          },
          "message": {
            "type": "string"
          },
          "statusCode": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "validationErrors": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "SocialProviderResponse": {
        "type": "integer"
      },
      "SocialReplayWebhookResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/SocialReplayWebhookStatus"
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SocialErrorResponse"
              }
            ]
          },
          "isSuccess": {
            "type": "boolean"
          }
        }
      },
      "SocialReplayWebhookStatus": {
        "type": "integer"
      },
      "SocialWebhookEventResponse": {
        "required": [
          "id",
          "socialConnectionId",
          "provider",
          "receivedAt",
          "verificationStatus",
          "processingStatus",
          "processingError"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "socialConnectionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "provider": {
            "$ref": "#/components/schemas/SocialProviderResponse"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "verificationStatus": {
            "$ref": "#/components/schemas/SocialWebhookVerificationStatusResponse"
          },
          "processingStatus": {
            "$ref": "#/components/schemas/SocialWebhookProcessingStatusResponse"
          },
          "processingError": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SocialWebhookProcessingStatusResponse": {
        "type": "integer"
      },
      "SocialWebhookVerificationStatusResponse": {
        "type": "integer"
      }
    }
  },
  "tags": [
    {
      "name": "Social"
    }
  ]
}