  "components": {
    "schemas": {
      "AttachmentWriteDto": {
        "required": [
          "eventId",
          "content",
          "contentType",
          "contentThumbnail",
          "size"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "contentThumbnail": {
            "type": [
              "null",
              "string"
            ]
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "metadata": {
            "type": "object"
          },
          "metadataValues": {
            "type": "object"
          }
        }
      },
      "EventRoleWriteDto": {
        "required": [
          "eventId",
          "roleId",
          "type"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/RoleType"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "metadata": {
            "type": "object"
          },
          "metadataValues": {
            "type": "object"
          }
        }
      },
      "EventWriteDto": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "procedureId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "previousEventId": {
            "type": [
