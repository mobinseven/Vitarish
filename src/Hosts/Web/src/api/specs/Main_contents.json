  "components": {
    "schemas": {
      "ContentBodyBlock": {
        "required": [
          "type",
          "text",
          "assetId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "assetId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "ContentItemRequest": {
        "required": [
          "type",
          "status",
          "slug",
          "canonicalPath",
          "title",
          "excerpt",
          "body",
          "locale"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ContentItemType"
          },
          "status": {
            "$ref": "#/components/schemas/ContentStatus"
          },
          "slug": {
            "type": "string"
          },
          "canonicalPath": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "body": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentBodyBlock"
            }
          },
          "locale": {
            "type": "string"
          }
        }
      },
      "ContentItemResponse": {
        "required": [
          "id",
          "type",
          "status",
          "slug",
          "canonicalPath",
          "title",
          "excerpt",
          "body",
          "locale",
          "publishedAt",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/ContentItemType"
          },
          "status": {
            "$ref": "#/components/schemas/ContentStatus"
          },
          "slug": {
            "type": "string"
          },
          "canonicalPath": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "body": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentBodyBlock"
            }
          },
          "locale": {
            "type": "string"
          },
          "publishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ContentItemType": {
        "enum": [
          "Article",
          "BlogPost",
          "Announcement",
          "Page",
          "Guide"
        ]
      },
      "ContentRevisionResponse": {
        "required": [
          "id",
          "version",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContentStatus": {
        "enum": [
          "Draft",
          "Scheduled",
          "Published",
          "Archived"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
