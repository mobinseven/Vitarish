{
  "name": "@vitarish/web-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "dev:private-practice-general": "npm run dev --workspace @vitarish/private-practice-general",
    "dev:knowledge-qa-demo": "npm run dev --workspace @vitarish/knowledge-qa-demo",
    "build": "npm run build --workspaces --if-present",
    "build:private-practice-general": "npm run build --workspace @vitarish/private-practice-general",
    "build:knowledge-qa-demo": "npm run build --workspace @vitarish/knowledge-qa-demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "validate:api-boundary": "npm run validate:api-boundary --workspaces --if-present",
    "validate:localization": "npm run validate:localization --workspaces --if-present",
    "validate:date-inputs": "npm run validate:date-inputs --workspaces --if-present",
    "validate:web-ui-boundary": "node scripts/validate-web-ui-boundary.mjs",
    "validate:app-boundaries": "node scripts/validate-web-app-boundaries.mjs",
    "validate:docs:app-boundaries": "python ../../../tools/architecture/validate_app_experience_boundaries.py"
  }
}
