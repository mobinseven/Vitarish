{
  "name": "@vitarish/web-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "dev:private-practice-owner": "npm run dev --workspace @vitarish/private-practice-owner",
    "dev:patients": "npm run dev --workspace @vitarish/patients",
    "dev:knowledge-qa-demo": "npm run dev --workspace @vitarish/knowledge-qa-demo",
    "dev:vitarish-landing": "npm run dev --workspace @vitarish/vitarish-landing",
    "dev:agent-runtime": "npm run dev --workspace @vitarish/agent-runtime",
    "build": "npm run build --workspaces --if-present",
    "build:private-practice-owner": "npm run generate:api --workspace @vitarish/clinic-web && npm run build --workspace @vitarish/private-practice-owner",
    "build:patients": "npm run build --workspace @vitarish/patients",
    "build:knowledge-qa-demo": "npm run build --workspace @vitarish/knowledge-qa-demo",
    "build:vitarish-landing": "npm run build --workspace @vitarish/vitarish-landing",
    "build:agent-runtime": "npm run build --workspace @vitarish/agent-runtime",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:layout:visual": "playwright test --config playwright.layout.config.ts --grep @visual",
    "test:layout:update-linux": "node scripts/update-layout-snapshots-linux.mjs",
    "validate:api-boundary": "npm run validate:api-boundary --workspaces --if-present",
    "validate:localization": "node scripts/validate-localization.mjs",
    "lint:layout": "node scripts/lint-layout.mjs",
    "test:layout-lint": "node --test scripts/layout-policy.test.mjs",
    "validate:web-ui-boundary": "node scripts/validate-web-ui-boundary.mjs",
    "validate:app-boundaries": "node scripts/validate-web-app-boundaries.mjs",
    "validate:docs:app-boundaries": "python ../../../tools/architecture/validate_app_experience_boundaries.py"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
