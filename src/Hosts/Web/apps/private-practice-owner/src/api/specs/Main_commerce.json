  "components": {
    "schemas": {
      "CartRecoveryStatus": {
        "type": "integer"
      },
      "EntityError": {
        "required": [
          "code",
          "message"
        ],
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/EntityErrorCode"
          },
          "message": {
            "type": "string"
          },
          "target": {
            "type": [
              "null",
              "string"
            ]
          },
          "details": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "EntityErrorCode": {
        "type": "integer"
      },
      "EntityResult": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityError"
            }
          },
          "isFailure": {
            "type": "boolean"
          }
        }
      },
      "FulfillmentStatus": {
        "type": "integer"
      },
      "MerchantRecoveryCartReadDto": {
        "type": "object",
        "properties": {
          "cartId": {
            "type": "string",
            "format": "uuid"
          },
          "customerDisplay": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "hasContact": {
            "type": "boolean"
          },
          "estimatedValue": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currencyCode": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastActivityAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "recoveryStatus": {
            "$ref": "#/components/schemas/CartRecoveryStatus"
          },
          "recoveryNote": {
            "type": "string"
          }
        }
      },
      "OrderDescriptorDto": {
        "type": "object",
        "properties": {
          "orderNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OrderStatus"
              }
            ]
          },
          "customerId": {
            "type": [
              "null",
              "string"
            ]
          },
          "id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "skip": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
