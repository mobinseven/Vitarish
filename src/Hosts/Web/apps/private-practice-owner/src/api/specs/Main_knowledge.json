  "components": {
    "schemas": {
      "AskKnowledgeRequest": {
        "required": [
          "corpusId",
          "question"
        ],
        "type": "object",
        "properties": {
          "corpusId": {
            "type": "string",
            "format": "uuid"
          },
          "question": {
            "type": "string"
          },
          "topK": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 8
          },
          "retrievalMode": {
            "$ref": "#/components/schemas/KnowledgeRetrievalMode"
          },
          "saveTrace": {
            "type": "boolean",
            "default": true
          },
          "traceKind": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateKnowledgeCorpusRequest": {
        "required": [
          "name",
          "description",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "DeleteKnowledgeSourceRequest": {
        "required": [
          "corpusId",
          "sourceId"
        ],
        "type": "object",
        "properties": {
          "corpusId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "sourceId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "EvaluateKnowledgeCorpusRequest": {
        "required": [
          "corpusId"
        ],
        "type": "object",
        "properties": {
          "corpusId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "evaluationScope": {
            "$ref": "#/components/schemas/KnowledgeEvaluationScope"
          }
        }
      },
      "ImportKnowledgeSourceFromFileRequest": {
        "required": [
          "corpusId",
          "fileInformationId",
          "sourceName",
          "format"
        ],
        "type": "object",
        "properties": {
          "corpusId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "fileInformationId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "sourceName": {
            "type": [
              "null",
              "string"
            ]
          },
          "format": {
            "$ref": "#/components/schemas/KnowledgeSourceInputFormat"
          }
        }
      },
      "ImportKnowledgeSourceRequest": {
        "required": [
          "corpusId",
          "sourceName",
          "format",
          "content"
        ],
        "type": "object",
        "properties": {
          "corpusId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "sourceName": {
            "type": [
              "null",
              "string"
            ]
          },
          "format": {
            "$ref": "#/components/schemas/KnowledgeSourceInputFormat"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "IndexKnowledgeCorpusRequest": {
        "required": [
          "corpusId"
        ],
        "type": "object",
        "properties": {
          "corpusId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "KnowledgeAskTraceDiagnosticsRequest": {
        "required": [
