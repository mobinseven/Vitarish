# Local development contract (same-origin, like production):
# - React web host origin: http://localhost:3000; the browser calls /api on it.
# - Next proxies /api to the .NET API origin below (scripts/api-proxy-rewrites.mjs).
# - Node must trust the ASP.NET development certificate: run with NODE_OPTIONS=--use-system-ca
#   (Run-Dev.ps1 sets both of these).
NEXT_PUBLIC_API_BASE_URL=
VITARISH_API_PROXY_TARGET=https://localhost:7272
