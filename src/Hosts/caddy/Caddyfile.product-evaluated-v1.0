{
	auto_https disable_redirects
}

(product_evaluated_tls) {
	tls {$VITARISH_TLS_CERT_FILE:?VITARISH_TLS_CERT_FILE is required} {$VITARISH_TLS_KEY_FILE:?VITARISH_TLS_KEY_FILE is required} {
		protocols tls1.2 tls1.2
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-store"
		Pragma "no-cache"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; object-src 'none'"
	}
}

http://{$VITARISH_PUBLIC_HOST:?VITARISH_PUBLIC_HOST is required} {
	redir https://{$VITARISH_PUBLIC_HOST}{uri} 308
}

http://{$VITARISH_PATIENTS_HOST:?VITARISH_PATIENTS_HOST is required} {
	redir https://{$VITARISH_PATIENTS_HOST}{uri} 308
}

http://{$VITARISH_PLATFORM_ADMIN_HOST:?VITARISH_PLATFORM_ADMIN_HOST is required} {
	redir https://{$VITARISH_PLATFORM_ADMIN_HOST}{uri} 308
}

http://{$VITARISH_PM_HOST:?VITARISH_PM_HOST is required} {
	redir https://{$VITARISH_PM_HOST}{uri} 308
}

http://{$VITARISH_KNOWLEDGE_QA_HOST:?VITARISH_KNOWLEDGE_QA_HOST is required} {
	redir https://{$VITARISH_KNOWLEDGE_QA_HOST}{uri} 308
}

http://{$VITARISH_LANDING_HOST:?VITARISH_LANDING_HOST is required} {
	redir https://{$VITARISH_LANDING_HOST}{uri} 308
}

https://{$VITARISH_PUBLIC_HOST:?VITARISH_PUBLIC_HOST is required} {
	import product_evaluated_tls
	@api path /api/*
	reverse_proxy @api main:8080
	reverse_proxy web-private-practice-owner:3000
}

https://{$VITARISH_PATIENTS_HOST:?VITARISH_PATIENTS_HOST is required} {
	import product_evaluated_tls
	reverse_proxy web-patients:3000
}

https://{$VITARISH_PLATFORM_ADMIN_HOST:?VITARISH_PLATFORM_ADMIN_HOST is required} {
	import product_evaluated_tls
	reverse_proxy web-platform-admin:3003
}

https://{$VITARISH_PM_HOST:?VITARISH_PM_HOST is required} {
	import product_evaluated_tls
	reverse_proxy web-vitarish-pm:3004
}

https://{$VITARISH_KNOWLEDGE_QA_HOST:?VITARISH_KNOWLEDGE_QA_HOST is required} {
	import product_evaluated_tls
	reverse_proxy web-knowledge-qa-demo:3001
}

https://{$VITARISH_LANDING_HOST:?VITARISH_LANDING_HOST is required} {
	import product_evaluated_tls
	reverse_proxy web-vitarish-landing:3002
}
