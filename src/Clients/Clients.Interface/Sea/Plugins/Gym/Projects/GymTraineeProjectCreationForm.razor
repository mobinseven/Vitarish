@inherits ProjectsBase
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6">@Localizer["RegisterGymTrainee_Title"]</MudText>

            <AiStreamResponder @ref="responder"
                               Options="responderOptions"
                               OnOutput="HandleResponderOutputAsync"
                               OnOutputEnd="HandleResponderCompletedAsync" />

            @if (!string.IsNullOrWhiteSpace(facilityLabel))
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                    @facilityLabel
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(generationError))
            {
                <MudAlert Severity="Severity.Error">@generationError</MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(metadataValidationError))
            {
                <MudAlert Severity="Severity.Error">@metadataValidationError</MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }

            <MudStepper @bind-ActiveIndex="activeStep" NonLinear="false">
                <ChildContent>
                    <MudStep Title="@Localizer["Step1_TraineeDescription_Title"]" Completed="@DescriptionProvided" Class="px-0">
                        <MudText Typo="Typo.subtitle2">@Localizer["Step1_DescribeTrainee_Header"]</MudText>
                        <MudText Typo="Typo.body2">@Localizer["Step1_DescribeTrainee_Help"]</MudText>
                        <AdvancedInput @bind-Value="traineeDescription" @bind-Busy="inputBusy" />
                    </MudStep>

                    <MudStep Title="@Localizer["Step2_Generate_Title"]" Completed="@MetadataAvailable" Class="px-0">
                        <MudPaper Outlined Class="pa-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle2">@Localizer["Step2_Generating_Header"]</MudText>
                                <MudText Typo="Typo.body2">@Localizer["Step2_Generating_Help"]</MudText>
                                @if (isGenerating)
                                {
                                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                        <MudProgressCircular Size="Size.Medium" Indeterminate />
                                        <MudText Typo="Typo.body2">@Localizer["Common_Processing"]</MudText>
                                    </MudStack>
                                }
                                else if (MetadataAvailable)
                                {
                                    <MudText Typo="Typo.body2">@Localizer["Step2_Generate_Done"]</MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    </MudStep>

                    <MudStep Title="@Localizer["Step3_Review_Title"]" Completed="@CanSubmit" Class="px-0">
                        <MudText Typo="Typo.subtitle2">@Localizer["Step3_Review_Header"]</MudText>
                        <MudText Typo="Typo.body2">@Localizer["Step3_Review_Help"]</MudText>

                        @if (!MetadataAvailable)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-2">@Localizer["Info_MetadataAppearsAfterGenerate"]</MudAlert>
                        }
                        else
                        {
                            <MudGrid Class="mt-2" Spacing="2">
                                <MudItem xs="12">
                                    <MudPaper Elevation="0" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">@Localizer["Section_Identity_Title"]</MudText>
                                            <MudDivider Class="my-1" />
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.FirstName"
                                                                  Label="@Localizer["Field_FirstName"]"
                                                                  Variant="Variant.Outlined"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.LastName"
                                                                  Label="@Localizer["Field_LastName"]"
                                                                  Variant="Variant.Outlined"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudDatePicker @bind-Date="editableMetadata.DateOfBirth"
                                                                   Label="@Localizer["Field_DateOfBirth"]"
                                                                   Variant="Variant.Outlined"
                                                                   DisplayMonths="1" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudSelect T="string"
                                                               @bind-Value="editableMetadata.Gender"
                                                               Label="@Localizer["Field_Gender"]"
                                                               Variant="Variant.Outlined"
                                                               Dense="true">
                                                        <MudSelectItem Value="@GenderFemale">@Localizer["Option_Gender_Female"]</MudSelectItem>
                                                        <MudSelectItem Value="@GenderMale">@Localizer["Option_Gender_Male"]</MudSelectItem>
                                                        <MudSelectItem Value="@GenderUnassigned">@Localizer["Option_Gender_Unassigned"]</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.Nationality"
                                                                  Label="@Localizer["Field_Nationality"]"
                                                                  Variant="Variant.Outlined"
                                                                  Immediate="true" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="0" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">@Localizer["Section_Contact_Title"]</MudText>
                                            <MudDivider Class="my-1" />
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.Email"
                                                                  Label="@Localizer["Field_Email"]"
                                                                  Variant="Variant.Outlined"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.Phone"
                                                                  Label="@Localizer["Field_Phone"]"
                                                                  Variant="Variant.Outlined"
                                                                  Immediate="true" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="0" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">@Localizer["Section_Membership_Title"]</MudText>
                                            <MudDivider Class="my-1" />
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.MembershipType"
                                                                  Label="@Localizer["Field_MembershipType"]"
                                                                  Variant="Variant.Outlined"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.PreferredProgram"
                                                                  Label="@Localizer["Field_PreferredProgram"]"
                                                                  Variant="Variant.Outlined"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12">
                                                    <MudTextField @bind-Value="editableMetadata.Goals"
                                                                  Label="@Localizer["Field_Goals"]"
                                                                  Variant="Variant.Outlined"
                                                                  Immediate="true" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="0" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">@Localizer["Section_Emergency_Title"]</MudText>
                                            <MudDivider Class="my-1" />
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.EmergencyContactName"
                                                                  Label="@Localizer["Field_EmergencyContactName"]"
                                                                  Variant="Variant.Outlined"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.EmergencyContactPhone"
                                                                  Label="@Localizer["Field_EmergencyContactPhone"]"
                                                                  Variant="Variant.Outlined"
                                                                  Immediate="true" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="0" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">@Localizer["Section_Health_Title"]</MudText>
                                            <MudDivider Class="my-1" />
                                            <MudTextField @bind-Value="editableMetadata.MedicalNotes"
                                                          Label="@Localizer["Field_MedicalNotes"]"
                                                          Variant="Variant.Outlined"
                                                          Lines="3"
                                                          AutoGrow="true"
                                                          Immediate="true" />
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        }
                    </MudStep>
                </ChildContent>
                <ActionContent />
            </MudStepper>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@(isGenerating || isSubmitting)"
                       OnClick="Cancel">@Localizer["Cancel"]</MudButton>
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                @if (activeStep > 0)
                {
                    <MudButton Variant="Variant.Text"
                               Disabled="@(isGenerating || isSubmitting)"
                               OnClick="GoToPreviousStep">@Localizer["Back"]</MudButton>
                }
                @switch (activeStep)
                {
                    case 0:
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(!CanBeginGeneration)"
                                   OnClick="BeginGenerationAsync">
                            @if (isGenerating)
                            {
                                <MudProgressCircular Size="Size.Small" Class="me-2" Indeterminate />
                            }
                            @generateLabel
                        </MudButton>
                        break;
                    case 1:
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(!CanOpenReview)"
                                   OnClick="() => activeStep = 2">
                            @Localizer["Btn_ReviewDetails"]
                        </MudButton>
                        break;
                    case 2:
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(!CanSubmit)"
                                   OnClick="SubmitAsync">
                            @if (isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Class="me-2" Indeterminate />
                            }
                            @finishLabel
                        </MudButton>
                        break;
                }
            </MudStack>
        </MudStack>
    </DialogActions>
</MudDialog>
