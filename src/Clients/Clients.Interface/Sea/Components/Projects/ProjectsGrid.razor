@inherits ProjectsBase
<ExpandableItem Context="expandable" ShowMenu=AdminMode Class="sticky-top" Name="@Localizer["Projects"]" NoIcon>
    <InlineContent>
        <MudButton OnClick="AddProject" StartIcon="fa-thin fa-folder-plus">@Localizer["AddItem", Localizer["Project"]]</MudButton>
    </InlineContent>
@*     <MenuItems>
        <MudMenuItem OnClick="ToggleTemplate" Icon="@(template ? "fa-thin fa-folder" : "fa-thin fa-folder-gear")">
            @Localizer["Display", Localizer[template ? "Projects" : "Templates"]]
        </MudMenuItem>
    </MenuItems> *@
</ExpandableItem>
<MudDataGrid T="ProjectDto"
             @ref=grid
             LoadingProgressColor="Color.Success"
             ServerData=ReloadData
             Class="glass"
             Dense
             Breakpoint=Breakpoint.None
             Elevation="0">
    <Columns>
        <TemplateColumn T="ProjectDto">
            <CellTemplate Context="context">
                @RenderProjectCell(context.Item)
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>
