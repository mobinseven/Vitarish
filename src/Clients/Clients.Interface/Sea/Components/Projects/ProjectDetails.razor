@inherits ProjectsBase

@if(Project is null)
{
}
else
{
    <ExpandableItem Size=Size.Small Name="@Project.Description" ShowMenu=AccessService.Access.Admin Class="sticky-top">
        <TitleContent>
            <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Style="width: 100%">
                <MudText Align=Align.Center Typo="Typo.h6" Class="py-2">@Project.Name</MudText>
                @if(!string.IsNullOrWhiteSpace(Project.Description))
                {
                    <MudText HtmlTag="p" Align=Align.Center Typo="Typo.subtitle1" Class="py-3">@Project.Description</MudText>
                }
                @if(Project.Template)
                {
                    <MudChip T="string" Color="Color.Info">@Localizer["Template"]</MudChip>
                }
            </MudStack>
        </TitleContent>
        <MenuItems>
            <MudMenuItem OnClick="@(() => AddProcedure())"
                         Icon="fa-thin fa-file-plus">
                @Localizer["AddItem", Localizer["Procedure"]]
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => EditProject(Project))"
                         Icon="fa-thin fa-pencil">
                @Localizer["EditItem", Localizer["Project"]]
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => DeleteProject(Project))"
                         IconColor="Color.Error"
                         Icon="fa-thin fa-folder-xmark">
                @Localizer["DeleteItem", Localizer["Project"]]
            </MudMenuItem>
        </MenuItems>
    </ExpandableItem>
}