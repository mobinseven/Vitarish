@using MudBlazor

<MudBreadcrumbs Class="mb-4" Items="Items" Style="justify-content: space-evenly;">
    <SeparatorTemplate />
    <ItemTemplate>
        <MudButton Size="Size.Large" Variant="Variant.Text" Href="@context.Href">
            @context.Text
        </MudButton>
    </ItemTemplate>
</MudBreadcrumbs>

@code {
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<BreadcrumbItem> Items { get; set; } = default!;
}

