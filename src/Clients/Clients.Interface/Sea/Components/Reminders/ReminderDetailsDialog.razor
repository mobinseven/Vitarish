@inherits RemindersBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Style="width: 100%">
                <div style="width: 100%">
                    <Chip>
                        <MudStack>
                            <MudText Typo="Typo.h6">@Reminder.Subject</MudText>
                            <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@Reminder.TextBody</MudText>
                        </MudStack>
                    </Chip>
                </div>
            </MudStack>

            <MudText Typo="Typo.body2">@($"{Localizer["Creator"]}: {UserIdToName(Reminder.CreatedBy)}")</MudText>
            <MudText Typo="Typo.body2">@($"{Localizer["Recipient"]}: {UserIdToName(Reminder.RecipientUserId)}")</MudText>
            <MudText Typo="Typo.body2">@($"{Localizer["RemindAt"]}: {Reminder.RemindAt.ToLocalTime().DateTime.ToShortDateString()} {Reminder.CreatedAt.ToLocalTime().DateTime.ToShortTimeString()}")</MudText>
            <MudText Typo="Typo.body2">@($"{Localizer["SentAt"]}: {SentAtText()}")</MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@Localizer["Close"]</MudButton>
        @if(CanEdit)
        {
            <MudButton Color="Color.Error" Variant=Variant.Filled OnClick="DeleteAsync">@Localizer["DeleteItem", Localizer["Reminder"]]</MudButton>
        }
    </DialogActions>
</MudDialog>
