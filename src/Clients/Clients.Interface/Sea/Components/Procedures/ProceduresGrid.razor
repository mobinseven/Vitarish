@inherits ProceduresBase

<ProjectDetails Project="@Project" OnAddProcedure="ProjectChanged" OnEdit="ProjectChanged" OnDelete="ProjectDeleted" />
<MudDataGrid T="ProcedureDto" @ref=grid
             Class="glass"
             ServerData=ReloadData
             Breakpoint=Breakpoint.None
             Elevation="0">
    <Columns>
        <TemplateColumn T="ProcedureDto">
            <CellTemplate Context="context">
                <ExpandableItem Name="@context.Item.Name"
                                Expanded="@(context.Item.Id == OpenProcedure)"
                                ExpandedChanged="@(async e => { await OpenProcedureChanged.InvokeAsync(e ? context.Item.Id : null); await grid!.ReloadServerData(); })"
                                NoIcon
                                ShowMenu=AccessService.Access.Admin>
                    <StartContent>
                        <MudAvatar Class="glass" Variant=Variant.Outlined>
                            <ProgressDisplay Stats="context.Item.Stats ?? new StatsDto()" Title="@context.Item.Name" />
                        </MudAvatar>
                    </StartContent>
                    <InlineContent>
                        <StatsDisplay Stats="context.Item.Stats ?? new StatsDto()" />
                    </InlineContent>
                    <MenuItems>
                        <MudMenuItem OnClick="@(() => EditProcedure(context.Item))"
                                     Icon="@Icons.Material.Filled.Edit">
                            @Localizer["EditItem", Localizer["Procedure"]]
                        </MudMenuItem>
                        <MudMenuItem Disabled="@(IsCommitAllDisabled(context.Item))"
                                     OnClick="@(async () => await CommitAllEventsAsync(context.Item))"
                                     Icon="@Icons.Material.Filled.DoneAll">
                            @Localizer["CommitAllEvents"]
                        </MudMenuItem>
                        <MudMenuItem Disabled="@(IsUncommitAllDisabled(context.Item))"
                                     OnClick="@(async () => await UncommitAllEventsAsync(context.Item))"
                                     Icon="@Icons.Material.Filled.Undo">
                            @Localizer["UncommitAllEvents"]
                        </MudMenuItem>
                        <MudMenuItem OnClick="@(() => DeleteProcedure(context.Item))"
                                     Icon="@Icons.Material.Filled.Delete">
                            @Localizer["DeleteItem", Localizer["Procedure"]]
                        </MudMenuItem>
                    </MenuItems>
                    <ChildContent>
                        @if(ProcedureChildContent is not null)
                        {
                            @ProcedureChildContent(context.Item)
                        }
                    </ChildContent>
                </ExpandableItem>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <LoadingContent>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="glass rounded" Animation="Animation.Wave" />
    </LoadingContent>
</MudDataGrid>
