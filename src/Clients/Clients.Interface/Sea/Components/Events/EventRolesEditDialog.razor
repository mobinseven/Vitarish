@inherits SeaCommonBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField ReadOnly Value="Event?.Title" Variant=Variant.Text Underline=false />
            @if(!string.IsNullOrWhiteSpace(Event?.Description))
            {
                <MudTextField ReadOnly Value="Event?.Description" Variant=Variant.Text AutoGrow Underline=false />
            }
            <MudTable Items="roles" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>@Localizer["Role"]</MudTh>
                    <MudTh>@Localizer["Read"]</MudTh>
                    <MudTh>@Localizer["Write"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Localizer["Role"]">@context.Name</MudTd>
                    <MudTd DataLabel="@Localizer["Read"]">
                        <MudCheckBox T="bool" Value="readRoleIds.Contains(context.Id)" ValueChanged="@((bool b) => OnReadRoleChanged(context.Id, b))" />
                    </MudTd>
                    <MudTd DataLabel="@Localizer["Write"]">
                        <MudCheckBox T="bool" Value="writeRoleIds.Contains(context.Id)" ValueChanged="@((bool b) => OnWriteRoleChanged(context.Id, b))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Close"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@Localizer["Save"]</MudButton>
    </DialogActions>
</MudDialog>
