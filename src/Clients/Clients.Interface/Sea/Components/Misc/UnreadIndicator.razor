@inherits SeaCommonBase

@if(Visible)
{
    if(HasTooltip)
    {
        <span class="@CssClass" title="@Tooltip" aria-label="@Tooltip" role="img"></span>
    }
    else
    {
        <span class="@CssClass" aria-hidden="true"></span>
    }
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool HasTooltip => !string.IsNullOrWhiteSpace(Tooltip);
    private string CssClass => string.IsNullOrWhiteSpace(Class)
        ? "sea-unread-indicator"
        : $"sea-unread-indicator {Class}";
}
