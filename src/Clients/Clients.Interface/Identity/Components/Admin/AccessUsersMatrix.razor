@if(initialized && Users.Any())
{
    <table>
        <thead>
            <tr>
                <th>User</th>
                <th>Access</th>
                <th>Admin</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Users)
            {
                <tr>
                    <td>@user.FullName (@user.UserName)</td>
                    <td>
                        @if(user.Access != null)
                        {
                            <RoleEditor @bind-Read="user.Access.Read"
                                        @bind-Write="user.Access.Write"
                                        Roles="Roles" />
                        }
                        else
                        {
                            <span>No access data</span>
                        }
                    </td>
                    <td>
                        @if(user.Access != null)
                        {
                            <input type="checkbox" @bind="user.Access.Admin" />
                        }
                    </td>
                    <td>
                        <button type="button" @onclick="() => Remove(user.Id)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if(initialized)
{
    <p>No users</p>
}
else
{
    <p>Loading...</p>
}
