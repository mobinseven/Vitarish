
@if (authState?.User.Identity?.IsAuthenticated ?? false)
{
    <form method="get" action="@(UrlExtensions.UrlCombine(ClientIdentityContext.Authority, "/Account/Manage"))" style="width: inherit;">
        <input type="hidden" name="ReturnUrl" value="@(currentUrl)" />
        @SubmitButton(authState)
        <AntiforgeryToken />
    </form>
}
