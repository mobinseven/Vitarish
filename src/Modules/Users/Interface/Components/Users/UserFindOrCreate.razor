@inherits TenantCommonBase
@implements IDisposable

<Stack>
    @if (!string.IsNullOrWhiteSpace(Value))
    {
        <StackField Label="@Localizer["User"]"
                    HelperText="@selectedUserSubtitle"
                    AdornmentIcon="fa-solid fa-user-check" />

        <StackButton Label="@Localizer["ChangeUser"]"
                     EndIcon="fa-solid fa-arrow-rotate-right"
                     OnClick="ShowFindForm" Color="Color.Secondary" />

        @if (ResolvedOptions.AllowUnlink)
        {
            <StackButton Label="@Localizer["None"]"
                         EndIcon="fa-solid fa-link-slash"
                         OnClick="ClearAsync" Color="Color.Error" />
        }
    }
    else
    {
        <StackButton Label="@Localizer["FindExistingUser"]"
                     EndIcon="fa-solid fa-magnifying-glass"
                     Color="@(!showCreateForm ? Color.Primary : Color.Default)"
                     OnClick="ShowFindForm" />

        @if (ResolvedOptions.AllowCreate)
        {
            <StackButton Label="@Localizer["CreateOrAutoLinkUser"]"
                         EndIcon="fa-solid fa-user-plus"
                         Color="@(showCreateForm ? Color.Primary : Color.Default)"
                         OnClick="ShowCreateForm" />
        }

        @if (!showCreateForm || !ResolvedOptions.AllowCreate)
        {
            <UserFindForm SearchScope="@searchScope"
                          SearchScopeChanged="OnScopeChangedAsync"
                          ShowSearchScopeSelector="@ResolvedOptions.ShowSearchScopeSelector"
                          OnUserSelected="OnUserSelectedAsync" />
        }
        else
        {
            <UserCreateForm AutoLinkExistingUser="@ResolvedOptions.AutoLinkExistingUser"
                            AllowAutoLinkToggle="@ResolvedOptions.AllowAutoLinkToggle"
                            OnUserReady="OnUserSelectedAsync"
                            OnCancel="ShowFindForm" />
        }
    }
</Stack>

@if (!string.IsNullOrWhiteSpace(warning))
{
    <MudAlert Severity="Severity.Warning">@warning</MudAlert>
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public EventCallback<UserSummaryResponse?> SelectedUserChanged { get; set; }
    [Parameter] public UserFindOrCreateOptions? Options { get; set; }

    [Inject] private IUsersClient UsersClient { get; set; } = default!;

    private bool showCreateForm;
    private UserSearchScope searchScope = UserSearchScope.TenantUsers;
    private string selectedUserSubtitle = string.Empty;
    private string? warning;
    private string? lastValue;
    private UserFindOrCreateOptions? lastOptions;
    private readonly CancellationTokenSource lifecycleCts = new();

    private UserFindOrCreateOptions ResolvedOptions => Options ?? new UserFindOrCreateOptions();

    protected override async Task OnParametersSetAsync()
    {
        if (lastValue != Value)
        {
            lastValue = Value;
            selectedUserSubtitle = await ResolveSelectedUserSubtitleAsync(Value);
        }

        if (!ReferenceEquals(lastOptions, Options))
        {
            lastOptions = Options;
            searchScope = ResolvedOptions.DefaultSearchScope;
        }
    }

    private Task OnScopeChangedAsync(UserSearchScope scope)
    {
        searchScope = scope;
        return InvokeAsync(StateHasChanged);
    }

    private void ShowFindForm()
    {
        warning = null;
        showCreateForm = false;
    }

    private void ShowCreateForm()
    {
        warning = null;
        showCreateForm = true;
    }

    private async Task OnUserSelectedAsync(string userId)
    {
        warning = null;
        UsersClientResult<UserSummaryResponse> userResult = await UsersClient.GetUserAsync(userId, lifecycleCts.Token);
        if (!userResult.IsSuccess || userResult.Value is null)
        {
            warning = Localizer["Error"];
            return;
        }

        UserSummaryResponse user = userResult.Value;

        if (ResolvedOptions.EnsureTenantUserRoleOnLink)
        {
            await EnsureTenantUserRoleAsync(user);
        }

        showCreateForm = false;
        await SetValueAsync(user.Id);
        await SelectedUserChanged.InvokeAsync(user);
    }

    private async Task EnsureTenantUserRoleAsync(UserSummaryResponse user)
    {
        if (string.IsNullOrWhiteSpace(RequestContext.TenantId))
        {
            return;
        }

        string tenantUserRole = $"{RequestContext.TenantId}:{IdentityDefinitions.TenantUser}";
        UsersClientResult<UserRoleCheckResponse> roleResult = await UsersClient.CheckUserRoleAsync(new CheckUserRoleQueryParameters(user.Id, tenantUserRole), lifecycleCts.Token);
        if (roleResult.Value?.IsInRole == true)
        {
            return;
        }

        UsersClientResult<UsersCommandResponse> addResult = await UsersClient.AddUserToRoleAsync(user.Id, new AddUserToRoleRequest(tenantUserRole), lifecycleCts.Token);
        if (!addResult.IsSuccess || addResult.Value?.Succeeded != true)
        {
            warning = Localizer["FailedToAssignTenantRole"];
        }
    }

    private async Task ClearAsync()
    {
        warning = null;
        await SetValueAsync(null);
        await SelectedUserChanged.InvokeAsync(null);
    }

    private async Task SetValueAsync(string? value)
    {
        Value = value;
        lastValue = value;
        selectedUserSubtitle = await ResolveSelectedUserSubtitleAsync(value);
        await ValueChanged.InvokeAsync(value);
        await InvokeAsync(StateHasChanged);
    }

    private async Task<string> ResolveSelectedUserSubtitleAsync(string? userId)
    {
        if (string.IsNullOrWhiteSpace(userId))
        {
            return string.Empty;
        }

        UsersClientResult<UserSummaryResponse> userResult = await UsersClient.GetUserAsync(userId, lifecycleCts.Token);
        if (!userResult.IsSuccess || userResult.Value is null)
        {
            return userId;
        }

        UserSummaryResponse user = userResult.Value;
        return string.Join(" · ", new[]
        {
            string.IsNullOrWhiteSpace(user.FullName) ? user.UserName ?? user.Id : user.FullName,
            user.PhoneNumber,
            user.Email
        }.Where(v => !string.IsNullOrWhiteSpace(v)));
    }

    public void Dispose()
    {
        lifecycleCts.Cancel();
        lifecycleCts.Dispose();
    }
}
