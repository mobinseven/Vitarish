@inherits TenantCommonBase
@implements IDisposable

<Stack>
    <StackTextField @bind-Value="firstName" Label="@Localizer["FirstName"]" />
    <StackTextField @bind-Value="lastName" Label="@Localizer["LastName"]" />
    <StackTextField @bind-Value="phoneNumber" Label="@Localizer["Phone"]" InputType="InputType.Telephone" />
    <StackTextField @bind-Value="email" Label="@Localizer["Email"]" InputType="InputType.Email" />
    <StackTextField @bind-Value="identificationCode" Label="@Localizer["IdentificationCode"]" />

    @if (AllowAutoLinkToggle)
    {
        <StackField Label="@Localizer["AutoLinkExistingUser"]">
            <MudSwitch T="bool" Value="@autoLinkExisting" ValueChanged="v => autoLinkExisting = v" />
        </StackField>
    }

    <StackButton Label="@Localizer["Create"]"
                 EndIcon="@(submitting ? "fa-solid fa-circle-notch fa-spin" : "fa-solid fa-plus")"
                 Color="Color.Primary"
                 Disabled="@submitting"
                 OnClick="SubmitAsync" />
    @if (OnCancel.HasDelegate)
    {
        <StackButton Label="@Localizer["Cancel"]" EndIcon="fa-solid fa-xmark" OnClick="() => OnCancel.InvokeAsync()" Color="Color.Secondary" />
    }
</Stack>

@if (!string.IsNullOrWhiteSpace(error))
{
    <MudAlert Severity="Severity.Warning">@error</MudAlert>
}

@code {
    [Parameter] public bool AutoLinkExistingUser { get; set; } = true;
    [Parameter] public bool AllowAutoLinkToggle { get; set; } = true;
    [Parameter] public EventCallback<string> OnUserReady { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    [Inject] private IUsersClient UsersClient { get; set; } = default!;

    private string? firstName;
    private string? lastName;
    private string? phoneNumber;
    private string? email;
    private string? identificationCode;
    private string? error;
    private bool submitting;
    private bool autoLinkExisting;
    private CancellationTokenSource? submitCts;

    protected override void OnParametersSet() => autoLinkExisting = AutoLinkExistingUser;

    private async Task SubmitAsync()
    {
        error = null;
        string? phone = Normalize(phoneNumber);
        string? mail = Normalize(email);
        string? idCode = Normalize(identificationCode);
        string? fName = Normalize(firstName);
        string? lName = Normalize(lastName);

        if (phone is null && mail is null)
        {
            error = Localizer["PhoneOrEmailRequired"];
            return;
        }

        submitCts?.Cancel();
        submitCts?.Dispose();
        submitCts = new CancellationTokenSource();
        submitting = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (!autoLinkExisting)
            {
               if (phone is not null)
                {
                    var checkResult = await UsersClient.CheckUserPhoneNumberInUseAsync(new CheckUserPhoneNumberInUseQueryParameters(phone), submitCts.Token);
                    if (!checkResult.IsSuccess)
                    {
                        error = GetFailureMessage(checkResult.Failure);
                        return;
                    }
                    if (checkResult.Value?.Exists == true)
                    {
                        error = Localizer["UserWithPhoneExists"];
                        return;
                    }
                }
                if (mail is not null)
                {
                    var checkResult = await UsersClient.CheckUserEmailInUseAsync(new CheckUserEmailInUseQueryParameters(mail), submitCts.Token);
                    if (!checkResult.IsSuccess)
                    {
                        error = GetFailureMessage(checkResult.Failure);
                        return;
                    }
                    if (checkResult.Value?.Exists == true)
                    {
                        error = Localizer["UserWithEmailExists"];
                        return;
                    }
                }
            }

            UsersClientResult<UserSummaryResponse> createResult = phone is not null
                ? await UsersClient.CreateUserWithPhoneAsync(new CreateUserWithPhoneRequest(phone, fName, lName, idCode), submitCts.Token)
                : await UsersClient.CreateUserWithEmailAsync(new CreateUserWithEmailRequest(mail!, fName, lName, idCode), submitCts.Token);

            if (!createResult.IsSuccess || createResult.Value is null)
            {
                error = GetFailureMessage(createResult.Failure);
                return;
            }

            UserSummaryResponse user = createResult.Value;

            if (mail is not null && !string.Equals(user.Email, mail, StringComparison.OrdinalIgnoreCase))
            {
                bool emailInUse = (await UsersClient.CheckUserEmailInUseAsync(new CheckUserEmailInUseQueryParameters(mail, user.Id), submitCts.Token)).Value?.Exists == true;
                if (!emailInUse)
                {
                    UsersClientResult<UsersCommandResponse> emailResult = await UsersClient.SetUserEmailAsync(user.Id, new SetUserEmailRequest(mail), submitCts.Token);
                    if (!emailResult.IsSuccess || emailResult.Value?.Succeeded != true)
                    {
                        error = GetFailureMessage(emailResult.Failure);
                        return;
                    }
                }
            }

            await OnUserReady.InvokeAsync(user.Id);
        }
        finally
        {
            submitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetFailureMessage(UsersClientFailure? failure) => failure?.Kind switch
    {
        UsersClientFailureKind.Conflict => Localizer["FailedToCreateOrLinkUser"],
        UsersClientFailureKind.Canceled => string.Empty,
        UsersClientFailureKind.Validation => Localizer["Error"],
        _ => Localizer["FailedToCreateOrLinkUser"]
    };

    private static string? Normalize(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        submitCts?.Cancel();
        submitCts?.Dispose();
    }
}
