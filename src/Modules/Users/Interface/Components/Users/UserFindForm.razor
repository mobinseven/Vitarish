@inherits TenantCommonBase

<Stack>
    <StackTextField Value="@query"
                    ValueChanged="OnQueryChangedAsync"
                    Label="@Localizer["Search"]"
                    HelperText="@Localizer["User"]"
                    Adornment="Adornment.End"
                    AdornmentIcon="@(searching ? "fa-solid fa-circle-notch fa-spin" : "fa-solid fa-search")" />

    @if (ShowSearchScopeSelector)
    {
        <StackSelect T="UserSearchScope"
                     Value="@SearchScope"
                     ValueChanged="OnScopeChangedAsync"
                     Label="@Localizer["Scope"]">
            <StackSelectItem T="UserSearchScope" Value="@UserSearchScope.TenantUsers">@Localizer["TenantUsers"]</StackSelectItem>
            <StackSelectItem T="UserSearchScope" Value="@UserSearchScope.AllPlatformUsers">@Localizer["AllPlatformUsers"]</StackSelectItem>
        </StackSelect>
    }

    @if (results.Count == 0 && !string.IsNullOrWhiteSpace(query) && !searching)
    {
        <StackField Label="@Localizer["NoItems", Localizer["User"]]" />
    }
    else
    {
        @foreach (var user in results)
        {
            <StackButton Label="@GetDisplayName(user)"
                         HelperText="@GetHelperText(user)"
                         EndIcon="fa-solid fa-user-check"
                         OnClick="() => SelectUserAsync(user.Id)" Color="Color.Primary" />
        }
    }
</Stack>

@code {
    [Parameter] public UserSearchScope SearchScope { get; set; } = UserSearchScope.TenantUsers;
    [Parameter] public EventCallback<UserSearchScope> SearchScopeChanged { get; set; }
    [Parameter] public bool ShowSearchScopeSelector { get; set; } = true;
    [Parameter] public EventCallback<string> OnUserSelected { get; set; }

    [Inject] private IUsersClient UsersClient { get; set; } = default!;

    private const int MaxResults = 50;
    private const int DebounceMs = 300;

    private string query = string.Empty;
    private bool searching;
    private IReadOnlyList<UserSummaryResponse> results = [];
    private CancellationTokenSource? debounceCts;

    protected override Task OnInitializedAsync() => RefreshResultsAsync();

    private async Task OnScopeChangedAsync(UserSearchScope scope)
    {
        SearchScope = scope;
        await SearchScopeChanged.InvokeAsync(scope);
        await RefreshResultsAsync();
    }

    private async Task OnQueryChangedAsync(string? value)
    {
        query = value ?? string.Empty;

        CancellationTokenSource? previous = debounceCts;
        CancellationTokenSource current = debounceCts = new CancellationTokenSource();
        previous?.Cancel();

        try
        {
            await Task.Delay(DebounceMs, current.Token);
            await RefreshResultsAsync(current.Token);
        }
        catch (OperationCanceledException)
        {
            // superseded by newer keystroke
        }
        finally
        {
            previous?.Dispose();
        }
    }

    private async Task RefreshResultsAsync(CancellationToken ct = default)
    {
        searching = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            results = [.. await GetResultsAsync(ct)];
        }
        finally
        {
            searching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<IEnumerable<UserSummaryResponse>> GetResultsAsync(CancellationToken ct = default)
    {
        if (SearchScope == UserSearchScope.TenantUsers)
        {
            IEnumerable<UserSummaryResponse> tenantUsers = GetUsers().Select(u => new UserSummaryResponse(u.Id, u.UserName, u.FirstName, u.LastName, u.Email, u.PhoneNumber, u.IdentificationCode, u.DateOfBirth, u.BirthCountryCode, u.BirthCity, u.FullName));
            if (string.IsNullOrWhiteSpace(query))
            {
                return tenantUsers.Take(MaxResults);
            }

            return tenantUsers.Where(MatchesQuery).Take(MaxResults);
        }

        if (string.IsNullOrWhiteSpace(query))
        {
            return [];
        }

        UsersClientResult<IReadOnlyList<UserSummaryResponse>> result = await UsersClient.SearchUsersAsync(new SearchUsersQueryParameters(query.Trim(), MaxResults), ct);
        return result.IsSuccess ? result.Value! : [];
    }

    private bool MatchesQuery(UserSummaryResponse user)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        string q = query.Trim();
        return Contains(user.FullName, q)
               || Contains(user.PhoneNumber, q)
               || Contains(user.Email, q)
               || Contains(user.UserName, q)
               || Contains(user.IdentificationCode, q)
               || Contains(user.Id, q);
    }

    private static bool Contains(string? value, string query)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(query, StringComparison.OrdinalIgnoreCase);

    private async Task SelectUserAsync(string userId) => await OnUserSelected.InvokeAsync(userId);

    private static string GetDisplayName(UserSummaryResponse user)
        => string.IsNullOrWhiteSpace(user.FullName) ? user.UserName ?? user.Id : user.FullName;

    private static string GetHelperText(UserSummaryResponse user)
    {
        List<string> parts = [];
        if (!string.IsNullOrWhiteSpace(user.PhoneNumber))
        {
            parts.Add(user.PhoneNumber!);
        }
        if (!string.IsNullOrWhiteSpace(user.Email))
        {
            parts.Add(user.Email!);
        }
        if (!string.IsNullOrWhiteSpace(user.IdentificationCode))
        {
            parts.Add(user.IdentificationCode!);
        }
        return string.Join(" · ", parts);
    }
}
