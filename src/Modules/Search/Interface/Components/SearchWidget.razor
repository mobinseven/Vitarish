@inherits CommonBase



<Stack>
    <StackTextField @bind-Value="_query"
                    Placeholder="@Localizer["Search"]"
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    OnAdornmentClick="SearchAsync"
                    OnKeyUp="HandleKeyUpAsync"
                    Immediate="false" />

</Stack>

<Stack>

    @if(_loading)
    {
        <StackButton Color="Color.Primary" EndIcon="fa-regular fa-circle-notch fa-spin" />
    }

    @if(_errorMessage is not null)
    {
        <StackButton Label="@Localizer["Retry"]" Color="Color.Error" EndIcon="fa-regular fa-refresh" OnClick="SearchAsync" />
    }
    else if(_result is not null)
    {
        @if(_result.Items.Count == 0)
        {
            <StackField Color="Color.Secondary" Label="@Localizer["NoResults"]" />
        }
        else
        {
            @foreach(SearchDocument item in _result.Items)
            {
                <StackButton Label="@item.Title" HelperText="@item.Body" OnClick="() => Navigate(item)" />
            }

            @if(_result.TotalCount > Options.Limit)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @string.Format(Localizer["ShowingOf"], _result.Items.Count, _result.TotalCount)
                </MudText>
            }
        }
    }

</Stack>
