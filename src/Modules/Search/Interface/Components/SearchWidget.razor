@inherits CommonBase

<Stack>
    <StackTextField @bind-Value="_query"
                    Placeholder="@Localizer["Search"]"
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    OnAdornmentClick="SearchAsync"
                    OnKeyUp="HandleKeyUpAsync"
                    Immediate="false" />

</Stack>

<Stack>

    @if(_loading)
    {
        <StackButton Color="Color.Primary" EndIcon="fa-solid fa-circle-notch fa-spin" />
    }

    @if(_errorMessage is not null)
    {
        <StackButton Label="@Localizer["Retry"]" Color="Color.Error" EndIcon="fa-solid fa-refresh" OnClick="SearchPageAsync" />
    }
    else if(_result is not null)
    {
        @if(_result.Items.Count == 0)
        {
            <StackField Color="Color.Info" Label="@Localizer["NoResults"]" />
        }
        else
        {
            @foreach(SearchResultGroup group in _resultGroups)
            {
                <Stack>
                    <StackField Label="@group.IndexName" Color="Color.Primary" />
                    @foreach(SearchDocument item in group.Items)
                    {
                        <StackButton Label="@item.Title" HelperText="@item.Body" OnClick="() => NavigateAsync(item)" Color="Color.Info" />
                    }
                </Stack>
            }

            <StackField Label="@GetPageSummary()" Color="Color.Info" />

            @if(TotalPages > 1)
            {
                <StackButton Label="@Localizer["Previous"]" Disabled="@(!HasPreviousPage)" StartIcon="fa-solid fa-chevron-left" OnClick="GoToPreviousPageAsync" Color="Color.Info" />
                <StackButton Label="@Localizer["Next"]" Disabled="@(!HasNextPage)" EndIcon="fa-solid fa-chevron-right" OnClick="GoToNextPageAsync" Color="Color.Info" />
            }
        }
    }

</Stack>
