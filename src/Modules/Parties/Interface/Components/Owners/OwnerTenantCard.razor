<StackButton Label="@Tenant.Name" HelperText="@Tenant.AppId" Href="@Href" Color="Color.Info" />
@code {
    [Parameter, EditorRequired] public TenantReadDto Tenant { get; set; } = default!;
    [Parameter] public string Href { get; set; } = "#";

    private IReadOnlyList<string> modules = [];

    protected override void OnParametersSet()
    {
        modules = TenantMetadataValues.GetActiveModules(Tenant?.Metadata);
    }
}
