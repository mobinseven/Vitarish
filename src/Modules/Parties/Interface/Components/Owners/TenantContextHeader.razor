@if(owner is not null)
{
    <StackField Align="Align.Center" Label="@tenant?.Name" HelperText="@owner.Name" />
    <StackButton Size="Size.Small" Label="@Localizer["Dashboard"]" Href="@DashboardHref" EndIcon="fa-solid fa-grid" Color="Color.Info" />
    <StackButton Size="Size.Small" Label="@Localizer["Owner"]" Href="@TenantsHref" EndIcon="fa-solid fa-building" Color="Color.Info" />
}

@code {
    [Parameter] public string DashboardHref { get; set; } = string.Empty;
    [Parameter] public string TenantsHref { get; set; } = string.Empty;

    private OwnerReadDto? owner;
    private TenantReadDto? tenant;
    protected override async Task ReloadRequired()
    {
        Guid? ownerGuid = GetOwnerGuid();
        if(ownerGuid is null)
            return;

        owner = await PartiesService.GetOwnerAsync(ownerGuid.Value);
        if(RequestContext.TenantId is not null)
            tenant = await PartiesService.GetTenantAsync(Guid.Parse(RequestContext.TenantId));
    }
}
