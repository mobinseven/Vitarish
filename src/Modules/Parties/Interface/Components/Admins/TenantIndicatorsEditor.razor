@namespace Vitarish.Parties.Interface.Components.Admins
@inherits PartiesAdminComponentBase

@if(Tenant is null)
{
    return;
}

<Stack>
    <StackField Label="@Localizer["TenantIndicators"]" />
    @foreach(var indicator in Indicators)
    {
        <StackButton Label="@indicator.Value" StartIcon="@GetStatusIcon(indicator.Status)" OnClick="() => EditIndicator(indicator)" Color="Color.Secondary" />
    }
    <StackButton OnClick="AddIndicator" EndIcon="fa-solid fa-plus" Color="Color.Primary" Label="@Localizer["AddItem", Localizer["TenantIndicator"]]" />
</Stack>
