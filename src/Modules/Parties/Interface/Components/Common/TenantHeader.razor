<Stack>
    @if(tenant is not null)
    {
        <MudButton FullWidth OnClick="@(() => NavigationManager.NavigateTo("/"))">
            <div>
                <MudStack AlignItems="AlignItems.Center" Style="height: 100%;" Justify="Justify.Center" Class="my-4">
                    @if(!string.IsNullOrWhiteSpace(tenant.LogoUrl))
                    {
                        <div>
                            <MudAvatar>
                                <MudImage Src="tenant.LogoUrl" />
                            </MudAvatar>
                        </div>
                    }
                    <div>
                        @tenant.Name
                    </div>
                    @if(!string.IsNullOrWhiteSpace(tenant.Description))
                    {
                        <div>
                            @tenant.Description
                        </div>
                    }
                </MudStack>
            </div>
        </MudButton>
    }
</Stack>

@code {
    private TenantReadDto? tenant;
    protected override async Task ReloadRequired()
    {
        if(RequestContext.TenantId is not null)
            tenant = await PartiesService.GetTenantAsync(Guid.Parse(RequestContext.TenantId));
    }
}
