@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@inherits MudTimePicker
@inject IStringLocalizer Localizer

<span @attributes="TriggerAttributes"
      class="@EffectiveTriggerClass"
      role="button"
      tabindex="@EffectiveTriggerTabIndex"
      aria-label="@EffectiveTriggerAriaLabel()"
      aria-haspopup="dialog"
      aria-expanded="@AriaExpanded"
      aria-disabled="@AriaDisabled"
      @onclick="OpenAsync"
      @onkeydown="OnTriggerKeyDown">
    <MudChip T="string"
             Icon="@ChipIcon"
             Disabled="@Disabled"
             Size="@ChipSize"
             Text="@EffectiveLabel()" />
</span>

<MudDialog Visible="@_open" VisibleChanged="@OnDialogVisibleChanged">
    <DialogContent>
        <div @key="_editorKey"
             class="@EffectiveEditorClass"
             @onkeydown="OnEditorKeyDown">
            <MudStack Spacing="2">
                @if (!string.IsNullOrWhiteSpace(Label))
                {
                    <MudText Typo="Typo.subtitle2">@Label</MudText>
                }

                @if (!string.IsNullOrWhiteSpace(HelperText))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@HelperText</MudText>
                }

                <MudStack Row
                          Class="stack-time-picker-selects"
                          Justify="Justify.Center"
                          AlignItems="AlignItems.Center"
                          Spacing="1">
                <MudSelect T="int"
                           Value="_hour"
                           ValueChanged="SetHourAsync"
                           Disabled="@Disabled"
                           ReadOnly="@ReadOnly"
                           Underline="false"
                           Variant="@EditorVariant"
                           Label="@Localizer[HourLabelKey]">
                    @foreach (var item in HourItems)
                    {
                        <MudSelectItem T="int" @key="item" Value="@item">
                            @item.ToString("00", EffectiveCulture)
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudText Typo="Typo.caption" Class="stack-time-picker-separator" aria-hidden="true">:</MudText>

                <MudSelect T="int"
                           Value="_minute"
                           ValueChanged="SetMinuteAsync"
                           Disabled="@Disabled"
                           ReadOnly="@ReadOnly"
                           Underline="false"
                           Variant="@EditorVariant"
                           Label="@Localizer[MinuteLabelKey]">
                    @foreach (var item in MinuteItems)
                    {
                        <MudSelectItem T="int" @key="item" Value="@item">
                            @item.ToString("00", EffectiveCulture)
                        </MudSelectItem>
                    }
                </MudSelect>
                </MudStack>
            </MudStack>
        </div>
        <MudButton Color="@NowButtonColor"
                   Variant="@NowButtonVariant"
                   Disabled="@IsInteractionDisabled"
                   OnClick="SetNowAsync">
            @EffectiveNowText
        </MudButton>
    </DialogContent>
</MudDialog>

@code {
    [Parameter]
    public global::System.TimeOnly TimeOnlyValue { get; set; } = global::System.TimeOnly.MinValue;

    [Parameter]
    public EventCallback<global::System.TimeOnly> TimeOnlyValueChanged { get; set; }

    [Parameter]
    public int MinuteStep { get; set; } = 15;

    [Parameter]
    public global::System.TimeOnly? Min { get; set; }

    [Parameter]
    public global::System.TimeOnly? Max { get; set; }

    [Parameter]
    public string? ChipIcon { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "Select Time";

    [Parameter]
    public string DoneText { get; set; } = "Done";

    [Parameter]
    public string NowText { get; set; } = "Now";

    [Parameter]
    public string HourLabelKey { get; set; } = "Hour";

    [Parameter]
    public string MinuteLabelKey { get; set; } = "Minute";

    [Parameter]
    public Variant EditorVariant { get; set; } = Variant.Filled;

    [Parameter]
    public Color NowButtonColor { get; set; } = Color.Secondary;

    [Parameter]
    public Variant NowButtonVariant { get; set; } = Variant.Text;

    [Parameter]
    public Size ChipSize { get; set; } = Size.Large;

    [Parameter]
    public int ChipTextMaxLength { get; set; } = 80;

    [Parameter]
    public string ChipTimeFormat { get; set; } = "HH:mm";

    [Parameter]
    public string? TriggerAriaLabel { get; set; }

    [Parameter]
    public string? TriggerClass { get; set; }

    [Parameter]
    public int TriggerTabIndex { get; set; } = 0;

    [Parameter]
    public IReadOnlyDictionary<string, object>? TriggerAttributes { get; set; }

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    [Parameter]
    public bool CloseOnEnter { get; set; } = true;

    [Parameter]
    public bool CloseOnCtrlEnter { get; set; } = true;

    [Parameter]
    public EventCallback Opened { get; set; }

    [Parameter]
    public EventCallback Closed { get; set; }

    private int _hour;
    private int _minute;
    private bool _open;
    private Guid _editorKey = Guid.NewGuid();

    private CultureInfo EffectiveCulture => Culture ?? CultureInfo.CurrentCulture;
    private int NormalizedMinuteStep => Math.Clamp(MinuteStep, 1, 60);
    private string AriaExpanded => _open ? "true" : "false";
    private string AriaDisabled => IsInteractionDisabled ? "true" : "false";
    private int EffectiveTriggerTabIndex => IsInteractionDisabled ? -1 : TriggerTabIndex;
    private string EffectiveDoneText => string.IsNullOrWhiteSpace(DoneText) ? Localizer["Done"] : DoneText;
    private string EffectiveNowText => string.IsNullOrWhiteSpace(NowText) ? Localizer["Now"] : NowText;
    private bool IsInteractionDisabled => Disabled || ReadOnly;

    private string EffectiveTriggerClass
        => $"stack-field-trigger stack-time-picker-trigger {(Disabled ? "stack-field-disabled" : string.Empty)} {(ReadOnly ? "stack-field-readonly" : string.Empty)} {TriggerClass}".Trim();

    private string EffectiveEditorClass
        => $"stack-item stack-field-editor stack-field-editor-compact stack-time-picker-editor {Class}".Trim();

    private global::System.TimeOnly EffectiveMin
    {
        get
        {
            if (Min is not null && Max is not null && Min > Max)
            {
                return Max.Value;
            }

            return Min ?? global::System.TimeOnly.MinValue;
        }
    }

    private global::System.TimeOnly EffectiveMax
    {
        get
        {
            if (Min is not null && Max is not null && Min > Max)
            {
                return Min.Value;
            }

            return Max ?? global::System.TimeOnly.MaxValue;
        }
    }

    private IEnumerable<int> HourItems
    {
        get
        {
            for (var hour = 0; hour < 24; hour++)
            {
                var firstMinuteOfHour = new global::System.TimeOnly(hour, 0);
                var lastMinuteOfHour = new global::System.TimeOnly(hour, 59, 59, 999);

                if (firstMinuteOfHour <= EffectiveMax && lastMinuteOfHour >= EffectiveMin)
                {
                    yield return hour;
                }
            }
        }
    }

    private IEnumerable<int> MinuteItems
    {
        get
        {
            var step = NormalizedMinuteStep;
            var items = Enumerable.Range(0, 60 / step + 1)
                .Select(index => index * step)
                .Where(minute => minute < 60);

            if (IsMinuteAllowed(_minute))
            {
                items = items.Append(_minute);
            }

            return items
                .Where(IsMinuteAllowed)
                .Distinct()
                .OrderBy(minute => minute);
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var selectedTime = ResolveSelectedTime();
        selectedTime = ClampToLimits(selectedTime);

        _hour = selectedTime.Hour;
        _minute = selectedTime.Minute;
    }

    private global::System.TimeOnly ResolveSelectedTime()
    {
        if (TimeOnlyValueChanged.HasDelegate || TimeOnlyValue != global::System.TimeOnly.MinValue || Time is null)
        {
            return TimeOnlyValue;
        }

        return global::System.TimeOnly.FromTimeSpan(Time.Value);
    }

    private async Task OpenAsync()
    {
        if (IsInteractionDisabled || _open)
        {
            return;
        }

        _editorKey = Guid.NewGuid();
        _open = true;
        await Opened.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        if (!_open)
        {
            return;
        }

        _open = false;
        await Closed.InvokeAsync();
    }

    private async Task OnDialogVisibleChanged(bool visible)
    {
        if (visible)
        {
            await OpenAsync();
            return;
        }

        await CloseAsync();
    }

    private async Task OnTriggerKeyDown(KeyboardEventArgs args)
    {
        if (IsInteractionDisabled || args.Repeat || !IsActivationKey(args))
        {
            return;
        }

        await OpenAsync();
    }

    private async Task OnEditorKeyDown(KeyboardEventArgs args)
    {
        if (IsInteractionDisabled)
        {
            return;
        }

        if (CloseOnEscape && args.Key == "Escape")
        {
            await CloseAsync();
            return;
        }

        if (IsEnterKey(args) && CloseOnCtrlEnter && (args.CtrlKey || args.MetaKey))
        {
            await CloseAsync();
            return;
        }

        if (IsEnterKey(args) && CloseOnEnter && !args.ShiftKey && !args.AltKey && !args.CtrlKey && !args.MetaKey)
        {
            await CloseAsync();
        }
    }

    private Task SetHourAsync(int hour)
        => SetSelectedTimeAsync(hour, _minute);

    private Task SetMinuteAsync(int minute)
        => SetSelectedTimeAsync(_hour, minute);

    private async Task SetNowAsync()
    {
        if (IsInteractionDisabled)
        {
            return;
        }

        var now = global::System.TimeOnly.FromDateTime(DateTime.Now);
        await SetSelectedTimeAsync(now.Hour, SnapMinute(now.Minute));
    }

    private async Task SetSelectedTimeAsync(int hour, int minute)
    {
        if (IsInteractionDisabled)
        {
            return;
        }

        var value = ClampToLimits(new global::System.TimeOnly(hour, minute));

        _hour = value.Hour;
        _minute = value.Minute;

        TimeOnlyValue = value;
        Time = value.ToTimeSpan();

        await TimeOnlyValueChanged.InvokeAsync(value);
        await TimeChanged.InvokeAsync(Time);
    }

    private int SnapMinute(int minute)
    {
        var step = NormalizedMinuteStep;
        var snapped = (int)Math.Round(minute / (double)step, MidpointRounding.AwayFromZero) * step;

        return Math.Clamp(snapped, 0, 59);
    }

    private bool IsMinuteAllowed(int minute)
    {
        var value = new global::System.TimeOnly(_hour, minute);

        return value >= EffectiveMin && value <= EffectiveMax;
    }

    private global::System.TimeOnly ClampToLimits(global::System.TimeOnly value)
    {
        if (value < EffectiveMin)
        {
            return EffectiveMin;
        }

        if (value > EffectiveMax)
        {
            return EffectiveMax;
        }

        return value;
    }

    private string EffectiveTriggerAriaLabel()
    {
        if (!string.IsNullOrWhiteSpace(TriggerAriaLabel))
        {
            return TriggerAriaLabel!;
        }

        var target = !string.IsNullOrWhiteSpace(Label) ? Label! : "time value";

        return _open ? $"Editing {target}" : $"Edit {target}";
    }

    private string EffectiveLabel()
    {
        var labelGiven = !string.IsNullOrWhiteSpace(Label);
        var helpGiven = !string.IsNullOrWhiteSpace(HelperText);
        var selectedTime = ClampToLimits(new global::System.TimeOnly(_hour, _minute));
        var selectedText = FormatTime(selectedTime);

        string text;
        if (labelGiven)
        {
            text = $"{Label}: {selectedText}";
        }
        else if (!string.IsNullOrWhiteSpace(selectedText))
        {
            text = selectedText;
        }
        else if (helpGiven)
        {
            text = HelperText!;
        }
        else
        {
            text = EmptyText;
        }

        return Truncate(text, ChipTextMaxLength);
    }

    private string FormatTime(global::System.TimeOnly value)
    {
        var format = string.IsNullOrWhiteSpace(ChipTimeFormat) ? "HH:mm" : ChipTimeFormat;
        return value.ToString(format, EffectiveCulture);
    }

    private static bool IsActivationKey(KeyboardEventArgs args)
        => IsEnterKey(args) || args.Key is " " or "Space" or "Spacebar" || args.Code == "Space";

    private static bool IsEnterKey(KeyboardEventArgs args)
        => args.Key == "Enter" || args.Code is "Enter" or "NumpadEnter";

    private static string Truncate(string text, int maxLength)
    {
        if (maxLength <= 0 || text.Length <= maxLength)
        {
            return text;
        }

        return string.Concat(text.AsSpan(0, Math.Max(0, maxLength - 1)), "…");
    }
}
