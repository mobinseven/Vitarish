@using MudBlazor
@using Vitarish.Parties.Contracts.Tenants
@using Vitarish.Parties.Interface.Components.Base
@inherits PartiesCommonBase

@if(tenant is not null)
{
    @if(Content is null)
    {
        <Stack Class="sticky-top">
            <div>
                <MudStack AlignItems="AlignItems.Center" Style="height: 100%;" Justify="Justify.Center" Class="my-4">
                    @if(!string.IsNullOrWhiteSpace(tenant.LogoUrl))
                    {
                        <div>
                            <MudAvatar>
                                <MudImage Src="tenant.LogoUrl" />
                            </MudAvatar>
                        </div>
                    }
                    <div>
                        @tenant.Name
                    </div>
                </MudStack>
            </div>
            <div />
            <div>
                <MudAvatar>
                    <MudIcon Icon="fa-solid fa-user" />
                </MudAvatar>
            </div>
        </Stack>
    }
    else
    {
        @Content(tenant)
    }
}
@code {
    private TenantReadDto? tenant;
    [Parameter]
    public RenderFragment<TenantReadDto>? Content { get; set; }
    protected override async Task ReloadRequired()
    {
        // if(RequestContext.TenantId is not null)
        //     tenant = await PartiesClient.GetTenantAsync(Guid.Parse(RequestContext.TenantId));
    }
}
