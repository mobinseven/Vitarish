@using Vitarish.Platform.Domain.Models
<Stack>
    <StackTextField Label="@Localizer["Theme name"]" @bind-Value="Model.Name" Required />

    <StackExpandable Label="@Localizer["Light palette"]">
        <StackColorPicker Label="@Localizer["Primary"]" @bind-Value="Model.LightPrimary" />
        <StackColorPicker Label="@Localizer["Primary contrast text"]" @bind-Value="Model.LightPrimaryContrastText" />
        <StackColorPicker Label="@Localizer["Secondary"]" @bind-Value="Model.LightSecondary" />
        <StackColorPicker Label="@Localizer["Secondary contrast text"]" @bind-Value="Model.LightSecondaryContrastText" />
        <StackColorPicker Label="@Localizer["Tertiary"]" @bind-Value="Model.LightTertiary" />
        <StackColorPicker Label="@Localizer["Tertiary contrast text"]" @bind-Value="Model.LightTertiaryContrastText" />
        <StackColorPicker Label="@Localizer["Info"]" @bind-Value="Model.LightInfo" />
        <StackColorPicker Label="@Localizer["Info contrast text"]" @bind-Value="Model.LightInfoContrastText" />
        <StackColorPicker Label="@Localizer["Success"]" @bind-Value="Model.LightSuccess" />
        <StackColorPicker Label="@Localizer["Success contrast text"]" @bind-Value="Model.LightSuccessContrastText" />
        <StackColorPicker Label="@Localizer["Warning"]" @bind-Value="Model.LightWarning" />
        <StackColorPicker Label="@Localizer["Warning contrast text"]" @bind-Value="Model.LightWarningContrastText" />
        <StackColorPicker Label="@Localizer["Error"]" @bind-Value="Model.LightError" />
        <StackColorPicker Label="@Localizer["Error contrast text"]" @bind-Value="Model.LightErrorContrastText" />
        <StackColorPicker Label="@Localizer["Background"]" @bind-Value="Model.LightBackground" />
        <StackColorPicker Label="@Localizer["Surface"]" @bind-Value="Model.LightSurface" />
        <StackColorPicker Label="@Localizer["Text"]" @bind-Value="Model.LightTextPrimary" />
    </StackExpandable>
    <StackPalettePreview Colors="Model.LightPreview" />

    <StackExpandable Label="@Localizer["Dark palette"]">
        <StackColorPicker Label="@Localizer["Primary"]" @bind-Value="Model.DarkPrimary" />
        <StackColorPicker Label="@Localizer["Primary contrast text"]" @bind-Value="Model.DarkPrimaryContrastText" />
        <StackColorPicker Label="@Localizer["Secondary"]" @bind-Value="Model.DarkSecondary" />
        <StackColorPicker Label="@Localizer["Secondary contrast text"]" @bind-Value="Model.DarkSecondaryContrastText" />
        <StackColorPicker Label="@Localizer["Tertiary"]" @bind-Value="Model.DarkTertiary" />
        <StackColorPicker Label="@Localizer["Tertiary contrast text"]" @bind-Value="Model.DarkTertiaryContrastText" />
        <StackColorPicker Label="@Localizer["Info"]" @bind-Value="Model.DarkInfo" />
        <StackColorPicker Label="@Localizer["Info contrast text"]" @bind-Value="Model.DarkInfoContrastText" />
        <StackColorPicker Label="@Localizer["Success"]" @bind-Value="Model.DarkSuccess" />
        <StackColorPicker Label="@Localizer["Success contrast text"]" @bind-Value="Model.DarkSuccessContrastText" />
        <StackColorPicker Label="@Localizer["Warning"]" @bind-Value="Model.DarkWarning" />
        <StackColorPicker Label="@Localizer["Warning contrast text"]" @bind-Value="Model.DarkWarningContrastText" />
        <StackColorPicker Label="@Localizer["Error"]" @bind-Value="Model.DarkError" />
        <StackColorPicker Label="@Localizer["Error contrast text"]" @bind-Value="Model.DarkErrorContrastText" />
        <StackColorPicker Label="@Localizer["Background"]" @bind-Value="Model.DarkBackground" />
        <StackColorPicker Label="@Localizer["Surface"]" @bind-Value="Model.DarkSurface" />
        <StackColorPicker Label="@Localizer["Text"]" @bind-Value="Model.DarkTextPrimary" />
    </StackExpandable>
    <StackPalettePreview Colors="Model.DarkPreview" />

    <StackButton Label="@Localizer["Save"]" OnClick="Save" Color="Color.Primary" />
    <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" />
</Stack>

@code {
    [Inject] private IStringLocalizer Localizer { get; set; } = default!;
    [Parameter, EditorRequired] public PlatformThemeFormModel Model { get; set; } = new();
    [Parameter, EditorRequired] public EventCallback<PlatformThemeFormModel> OnSave { get; set; }
    [Parameter, EditorRequired] public EventCallback OnCancel { get; set; }

    private Task Save() => OnSave.InvokeAsync(Model);
    private Task Cancel() => OnCancel.InvokeAsync();

    public sealed class PlatformThemeFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string LightPrimary { get; set; } = ThemePalette.FallbackPrimary;
        public string LightPrimaryContrastText { get; set; } = ThemePalette.FallbackPrimaryContrastText;
        public string LightSecondary { get; set; } = ThemePalette.FallbackSecondary;
        public string LightSecondaryContrastText { get; set; } = ThemePalette.FallbackSecondaryContrastText;
        public string LightTertiary { get; set; } = ThemePalette.FallbackTertiary;
        public string LightTertiaryContrastText { get; set; } = ThemePalette.FallbackTertiaryContrastText;
        public string LightInfo { get; set; } = ThemePalette.FallbackInfo;
        public string LightInfoContrastText { get; set; } = ThemePalette.FallbackInfoContrastText;
        public string LightSuccess { get; set; } = ThemePalette.FallbackSuccess;
        public string LightSuccessContrastText { get; set; } = ThemePalette.FallbackSuccessContrastText;
        public string LightWarning { get; set; } = ThemePalette.FallbackWarning;
        public string LightWarningContrastText { get; set; } = ThemePalette.FallbackWarningContrastText;
        public string LightError { get; set; } = ThemePalette.FallbackError;
        public string LightErrorContrastText { get; set; } = ThemePalette.FallbackErrorContrastText;
        public string LightBackground { get; set; } = ThemePalette.FallbackBackground;
        public string LightSurface { get; set; } = ThemePalette.FallbackSurface;
        public string LightTextPrimary { get; set; } = ThemePalette.FallbackTextPrimary;
        public string DarkPrimary { get; set; } = "#60A5FA";
        public string DarkPrimaryContrastText { get; set; } = "#07101F";
        public string DarkSecondary { get; set; } = "#38BDF8";
        public string DarkSecondaryContrastText { get; set; } = "#041018";
        public string DarkTertiary { get; set; } = "#C084FC";
        public string DarkTertiaryContrastText { get; set; } = "#14091F";
        public string DarkInfo { get; set; } = "#29B6F6";
        public string DarkInfoContrastText { get; set; } = "#031018";
        public string DarkSuccess { get; set; } = "#66BB6A";
        public string DarkSuccessContrastText { get; set; } = "#071207";
        public string DarkWarning { get; set; } = "#FFA726";
        public string DarkWarningContrastText { get; set; } = "#1A0F00";
        public string DarkError { get; set; } = "#F44336";
        public string DarkErrorContrastText { get; set; } = "#1A0503";
        public string DarkBackground { get; set; } = "#323232";
        public string DarkSurface { get; set; } = "#323232";
        public string DarkTextPrimary { get; set; } = "#E2E8F0";

        public IReadOnlyList<string> LightPreview => [LightPrimary, LightSecondary, LightTertiary, LightInfo, LightSuccess, LightWarning, LightError, LightBackground, LightSurface, LightTextPrimary];
        public IReadOnlyList<string> DarkPreview => [DarkPrimary, DarkSecondary, DarkTertiary, DarkInfo, DarkSuccess, DarkWarning, DarkError, DarkBackground, DarkSurface, DarkTextPrimary];
    }
}
