@inherits CommonBase
<MudStack Spacing="3">
    <MudTextField @bind-Value="EditableMetadata.FirstName"
                  Label="@Localizer["FirstName"]" />
    <MudTextField @bind-Value="EditableMetadata.LastName"
                  Label="@Localizer["LastName"]" />
    <MudTextField @bind-Value="EditableMetadata.DateOfBirth"
                  Label="@Localizer["DateOfBirth"]"
                  InputType="InputType.Date" />
    <MudDatePicker @bind-Date="EditableMetadata.DateOfSurgery"
                   Label="@Localizer["DateOf", Localizer["Surgery"]]" />
    <MudRadioGroup T="Gender"
                   @bind-Value="EditableMetadata.Gender">
        <MudRadio Value="@Gender.Female">@Localizer["Female"]</MudRadio>
        <MudRadio Value="@Gender.Male">@Localizer["Male"]</MudRadio>
    </MudRadioGroup>
    <MudDivider Class="my-1" />
    <MudTextField @bind-Value="EditableMetadata.ClinicalNotes"
                  Lines="4"
                  Label="@Localizer["Notes"]" />
    <MudExpansionPanels Dense Outlined Elevation="0" Class="border">
        <MudExpansionPanel Dense KeepContentAlive=false Text="@Localizer["ClinicalData"]">
            <MudTextField @bind-Value="EditableMetadata.Email"
                          Label="@Localizer["Email"]"
                          InputType="InputType.Email" />
            <MudTextField @bind-Value="EditableMetadata.Phone"
                          Label="@Localizer["Phone"]" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="EditableMetadata.InsuranceProvider"
                          Label="@Localizer["InsuranceProvider"]" />
            <MudTextField @bind-Value="EditableMetadata.PolicyNumber"
                          Label="@Localizer["PolicyNumber"]" />
            <MudTextField @bind-Value="EditableMetadata.PrimaryPhysician"
                          Label="@Localizer["PrimaryPhysician"]" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="EditableMetadata.VisitReason"
                          Label="@Localizer["VisitReason"]" />
            <MudTextField @bind-Value="EditableMetadata.PreferredPharmacy"
                          Label="@Localizer["PreferredPharmacy"]" />
            <MudTextField @bind-Value="EditableMetadata.Allergies"
                          Label="@Localizer["Allergies"]" />
            <MudTextField @bind-Value="EditableMetadata.CurrentMedications"
                          Label="@Localizer["CurrentMedications"]" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="EditableMetadata.EmergencyContactName"
                          Label="@Localizer["EmergencyContactName"]" />
            <MudTextField @bind-Value="EditableMetadata.EmergencyContactPhone"
                          Label="@Localizer["EmergencyContactPhone"]" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="EditableMetadata.DepartmentName"
                          Label="@Localizer["Department"]" />
            <MudSwitch T="bool"
                       @bind-Value="EditableMetadata.ConsentToShareRecords"
                       Color="Color.Primary"
                       Class="mt-2"
                       Label="@Localizer["ConsentToShareRecords"]" />
            <MudDivider Class="my-1" />
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public required ClinicProjectMetadataModel EditableMetadata { get; set; }
        = default!;
}
