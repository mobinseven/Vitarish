@using Vitarish.Sea.Interface.Plugins.Base.Projects


@inherits ProjectCreationFormBase<ClinicProjectMetadata, ClinicProjectMetadataModel>

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">@Localizer["RegisterClinicPatient"]</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(isSubmitting || isGenerating)"
                           OnClick="ToggleManualMode">
                    @if(isManualMode)
                    {
                        @Localizer["SwitchToAi"]
                    }
                    else
                    {
                        @Localizer["SwitchToManual"]
                    }
                </MudButton>
            </MudStack>

            @if(!string.IsNullOrWhiteSpace(facilityLabel))
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                    @facilityLabel
                </MudAlert>
            }

            @if(!string.IsNullOrWhiteSpace(departmentLabel))
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                    @departmentLabel
                </MudAlert>
            }

            @if(!string.IsNullOrWhiteSpace(generationError) && !isManualMode)
            {
                <MudAlert Severity="Severity.Error">@generationError</MudAlert>
            }

            @if(!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }

            @if(isManualMode)
            {
                @if(!string.IsNullOrWhiteSpace(manualValidationError))
                {
                    <MudAlert Severity="Severity.Error">@manualValidationError</MudAlert>
                }

                <MudText Typo="Typo.subtitle2">@Localizer["ManualEntry"]</MudText>
                <ClinicProjectManualEditor EditableMetadata="EditableMetadata" />
            }
            else
            {
                @if(!string.IsNullOrWhiteSpace(metadataValidationError))
                {
                    <MudAlert Severity="Severity.Error">@metadataValidationError</MudAlert>
                }

                <MudStepper @bind-ActiveIndex="activeStep" NonLinear=false>
                    <TitleTemplate></TitleTemplate>
                    <ChildContent>
                        <MudStep Title="@Localizer["PatientDescription"]" Completed="@DescriptionProvided" Class="px-0">
                            <MudText Typo="Typo.subtitle2">@Localizer["DescribePatient"]</MudText>
                            <MudText Typo="Typo.body2">@Localizer["DescribePatientHelp"]</MudText>
                            <AiJsonGeneratorInput @ref="generator"
                                                @bind-Value="patientDescription"
                                                DisplaySubmit=false
                                                Schema="@MetadataJsonSchema"
                                                OnJsonReceived="HandleAiJsonAsync"
                                                OnError="HandleAiErrorAsync"
                                                OnBusyChanged="HandleAiBusyAsync">
                                <TrailingContent />
                            </AiJsonGeneratorInput>
                        </MudStep>

                        <MudStep Title="@Localizer["Generate"]" Completed="@MetadataAvailable" Class="px-0">
                            <MudPaper Outlined Class="pa-4">
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.subtitle2">@Localizer["Generating"]</MudText>
                                    <MudText Typo="Typo.body2">@Localizer["GeneratingHelp"]</MudText>
                                    @if(isGenerating)
                                    {
                                        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                            <MudProgressCircular Size="Size.Medium" Indeterminate />
                                            <MudText Typo="Typo.body2">@Localizer["Processing"]</MudText>
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2">@Localizer["GenerationDone"]</MudText>
                                    }
                                </MudStack>
                            </MudPaper>
                        </MudStep>

                        <MudStep Title="@Localizer["Review"]" Completed="@CanContinueToFinish" Class="px-0">
                            <MudText Typo="Typo.subtitle2">@Localizer["Review"]</MudText>
                            <MudText Typo="Typo.body2">@Localizer["ReviewHelp"]</MudText>

                            <MudDivider Class="my-1" />
                            <ClinicProjectManualEditor EditableMetadata="EditableMetadata" />

                            @if(Metadata is null)
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                                    @Localizer["MetadataAppearsAfterApply"]
                                </MudAlert>
                            }
                        </MudStep>

                        <MudStep Title="@Localizer["Finish"]" Completed="@CanSubmit" Class="px-0">
                            <MudText Typo="Typo.subtitle2">@Localizer["Confirm"]</MudText>
                            <MudText Typo="Typo.body2">@Localizer["ConfirmHelp"]</MudText>

                            @if(Metadata is not null)
                            {
                                <MudPaper Elevation="0" Class="pa-3">
                                    <MudTable Items="MetadataTableRows" Dense="true" Hover="true" Elevation="0">
                                        <RowTemplate>
                                            <MudTd DataLabel="@context.Label">@context.Value</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </MudPaper>

                                <MudAlert Severity="Severity.Success" Variant="Variant.Text">
                                    @Localizer["ReadyToCreateProjectFor", BuildDisplayName(Metadata!)]
                                </MudAlert>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                                    @Localizer["ApplyValidMetadataBeforeFinish"]
                                </MudAlert>
                            }
                        </MudStep>
                    </ChildContent>
                    <ActionContent />
                </MudStepper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       OnClick="Cancel">@Localizer["Cancel"]</MudButton>

            @if(isManualMode)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(!CanSubmitManual)"
                           OnClick="SubmitManualAsync">
                    @if(isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Class="me-2" Indeterminate />
                    }
                    @finishLabel
                </MudButton>
            }
            else
            {
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                    @if(activeStep > 0)
                    {
                        <MudButton Variant="Variant.Text"
                                   Disabled="@(isSubmitting || isGenerating)"
                                   OnClick="GoToPreviousStep">@Localizer["Back"]</MudButton>
                    }

                    @switch(activeStep)
                    {
                        case 0:
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@(!CanBeginGeneration)"
                                       OnClick="() => generator.SubmitAsync()">
                                @if(isGenerating)
                                {
                                    <MudProgressCircular Size="Size.Small" Class="me-2" Indeterminate />
                                }
                                @generateLabel
                            </MudButton>
                            break;
                        case 1:
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@(!CanOpenReview)"
                                       OnClick="(() => activeStep = 2)">
                                @Localizer["ReviewDetails"]
                            </MudButton>
                            break;
                        case 2:
                            @if(CanApplyMetadata)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="ApplyAndProceedAsync">
                                    @Localizer["ApplyAndContinue"]
                                </MudButton>
                            }
                            else if(CanContinueToFinish)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="(() => activeStep = 3)">
                                    @Localizer["Continue"]
                                </MudButton>
                            }
                            break;
                        case 3:
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@(!CanSubmit)"
                                       OnClick="SubmitAsync">
                                @if(isSubmitting)
                                {
                                    <MudProgressCircular Size="Size.Small" Class="me-2" Indeterminate />
                                }
                                @finishLabel
                            </MudButton>
                            break;
                    }
                </MudStack>
            }
        </MudStack>
    </DialogActions>
</MudDialog>
