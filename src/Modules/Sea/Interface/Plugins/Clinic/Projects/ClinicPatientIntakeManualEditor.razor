@using Microsoft.Extensions.Localization

<MudStack Spacing="3">
    <MudTextField @bind-Value="EditableMetadata.FirstName"
                  Label="@Localizer["Field_FirstName"]"
                  Variant="Variant.Outlined"
                  Immediate="true" />
    <MudTextField @bind-Value="EditableMetadata.LastName"
                  Label="@Localizer["Field_LastName"]"
                  Variant="Variant.Outlined"
                  Immediate="true" />
    <MudTextField @bind-Value="EditableMetadata.DateOfBirth"
                  Label="@Localizer["Field_DateOfBirth"]"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  InputType="InputType.Date" />
    <MudSelect T="string"
               @bind-Value="EditableMetadata.Gender"
               Label="@Localizer["Field_Gender"]"
               Variant="Variant.Outlined"
               Dense="true"
               Clearable="true">
        <MudSelectItem Value="@GenderFemale">@Localizer["Option_Gender_Female"]</MudSelectItem>
        <MudSelectItem Value="@GenderMale">@Localizer["Option_Gender_Male"]</MudSelectItem>
        <MudSelectItem Value="@GenderUnspecified">@Localizer["Option_Gender_Unspecified"]</MudSelectItem>
    </MudSelect>
    <MudDivider Class="my-1" />
    <MudTextField @bind-Value="EditableMetadata.ClinicalNotes"
                  Lines="4"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  Label="@Localizer["Field_Notes"]" />
    <MudExpansionPanels Dense Outlined Elevation="0" Class="border">
        <MudExpansionPanel Dense KeepContentAlive=false Text="@Localizer["Section_ClinicalData"]">
            <MudTextField @bind-Value="EditableMetadata.Email"
                          Label="@Localizer["Field_Email"]"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          InputType="InputType.Email" />
            <MudTextField @bind-Value="EditableMetadata.Phone"
                          Label="@Localizer["Field_Phone"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="EditableMetadata.InsuranceProvider"
                          Label="@Localizer["Field_InsuranceProvider"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudTextField @bind-Value="EditableMetadata.PolicyNumber"
                          Label="@Localizer["Field_PolicyNumber"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudTextField @bind-Value="EditableMetadata.PrimaryPhysician"
                          Label="@Localizer["Field_PrimaryPhysician"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="EditableMetadata.VisitReason"
                          Label="@Localizer["Field_VisitReason"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudTextField @bind-Value="EditableMetadata.PreferredPharmacy"
                          Label="@Localizer["Field_PreferredPharmacy"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudTextField @bind-Value="EditableMetadata.Allergies"
                          Label="@Localizer["Field_Allergies"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudTextField @bind-Value="EditableMetadata.CurrentMedications"
                          Label="@Localizer["Field_CurrentMedications"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="EditableMetadata.EmergencyContactName"
                          Label="@Localizer["Field_EmergencyContactName"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudTextField @bind-Value="EditableMetadata.EmergencyContactPhone"
                          Label="@Localizer["Field_EmergencyContactPhone"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudDivider Class="my-1" />
            <MudTextField @bind-Value="EditableMetadata.DepartmentName"
                          Label="@Localizer["Field_Department"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudSwitch T="bool"
                       @bind-Value="EditableMetadata.ConsentToShareRecords"
                       Color="Color.Primary"
                       Class="mt-2"
                       Label="@Localizer["Field_ConsentToShareRecords"]" />
            <MudDivider Class="my-1" />
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public required ClinicPatientIntakeProjectCreationForm.ClinicPatientIntakeMetadataModel EditableMetadata { get; set; }
        = default!;

    [Parameter, EditorRequired]
    public required IStringLocalizer Localizer { get; set; }
        = default!;

    [Parameter, EditorRequired]
    public required string GenderFemale { get; set; }
        = string.Empty;

    [Parameter, EditorRequired]
    public required string GenderMale { get; set; }
        = string.Empty;

    [Parameter, EditorRequired]
    public required string GenderUnspecified { get; set; }
        = string.Empty;
}
