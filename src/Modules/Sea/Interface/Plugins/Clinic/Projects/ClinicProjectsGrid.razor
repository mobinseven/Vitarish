@inherits ProjectsGrid

@if(IsAdmin)
{
    <Stack>
        <StackButton Color="Color.Primary"
                     OnClick="AddProject"
                     StartIcon="fa-regular fa-folder-plus"
                     Label="@Localizer["AddItem", Localizer["Project"]]" />
    </Stack>
}

@if(projects is null)
{
    return;
}

@if(TemplateMode)
{
    <Stack>
        @foreach(var project in projects)
        {
            <StackButton OnClick="() => OnClicked.InvokeAsync(project.Id)"
                         Label="@project.Name"
                         HighlightString="@SearchString" />
        }
    </Stack>

    return;
}

@if(projectsViaSurgeryData?.Count > 0)
{
    <Stack>
        <StackSort Methods="SortMethodsViaSurgeryData" />

        @foreach(var project in projectsViaSurgeryData)
        {
            <StackButton OnClick="() => OnClicked.InvokeAsync(project.Id)"
                         Label="@project.Name"
                         HighlightString="@SearchString">
                <StatsDisplay Stats="project.Stats" />
            </StackButton>
        }
    </Stack>
}

@if(projectsLackSurgeryData?.Count > 0)
{
    <Stack>
        <StackField Label="@Localizer["NoItems", Localizer["DateOf", Localizer["Surgery"]]]" />
        <StackSort Methods="SortMethodsLackSurgeryData" />
        @foreach(var project in projectsLackSurgeryData)
        {
            <StackButton OnClick="() => OnClicked.InvokeAsync(project.Id)"
                         Label="@project.Name"
                         HighlightString="@SearchString">
                <StatsDisplay Stats="project.Stats" />
            </StackButton>
        }
    </Stack>
}
