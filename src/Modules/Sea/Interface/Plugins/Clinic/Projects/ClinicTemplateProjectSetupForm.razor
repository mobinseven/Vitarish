@inherits ProjectsBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">@Localizer["ConfigureClinicTemplate"]</MudText>
            @if (!string.IsNullOrWhiteSpace(facilityLabel))
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                    @facilityLabel
                </MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(departmentLabel))
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                    @departmentLabel
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }

            <MudForm @ref="form" Model="formModel">
                <MudGrid Class="mt-2">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="formModel.TemplateName"
                                      Label="@Localizer["TemplateName"]"
                                      Variant="ThemeService.SecondaryVariant"
                                      Required="true"
                                      For="() => formModel.TemplateName" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="formModel.TemplateDescription"
                                      Label="@Localizer["TemplateDescription"]"
                                      Variant="ThemeService.SecondaryVariant"
                                      AutoGrow="true"
                                      Lines="3"
                                      For="() => formModel.TemplateDescription" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="formModel.DefaultDepartmentName"
                                      Label="@Localizer["DefaultDepartment"]"
                                      Variant="ThemeService.SecondaryVariant"
                                      For="() => formModel.DefaultDepartmentName" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="formModel.DefaultPrimaryPhysician"
                                      Label="@Localizer["DefaultPhysician"]"
                                      Variant="ThemeService.SecondaryVariant"
                                      For="() => formModel.DefaultPrimaryPhysician" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="formModel.DefaultVisitReason"
                                      Label="@Localizer["DefaultVisitReason"]"
                                      Variant="ThemeService.SecondaryVariant"
                                      Required="true"
                                      For="() => formModel.DefaultVisitReason" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="formModel.IntakeChecklist"
                                      Label="@Localizer["IntakeChecklist"]"
                                      Variant="ThemeService.SecondaryVariant"
                                      AutoGrow="true"
                                      Lines="3"
                                      For="() => formModel.IntakeChecklist" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="formModel.BaselineConsentText"
                                      Label="@Localizer["BaselineConsentText"]"
                                      Variant="ThemeService.SecondaryVariant"
                                      AutoGrow="true"
                                      Lines="3"
                                      For="() => formModel.BaselineConsentText" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack>
                            <MudCheckBox @bind-Value="formModel.IncludeInsuranceSection"
                                         Label="@Localizer["IncludeInsuranceSection"]"
                                         For="() => formModel.IncludeInsuranceSection" />
                            <MudCheckBox @bind-Value="formModel.IncludeClinicalNotesSection"
                                         Label="@Localizer["IncludeClinicalNotesSection"]"
                                         For="() => formModel.IncludeClinicalNotesSection" />
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@isSubmitting"
                   OnClick="SubmitAsync">
            @if (isSubmitting)
            {
                <MudProgressCircular Size="@Size.Small" Class="me-2" Indeterminate="true" />
            }
            @submitLabel
        </MudButton>
    </DialogActions>
</MudDialog>
