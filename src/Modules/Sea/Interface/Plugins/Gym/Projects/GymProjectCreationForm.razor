@using Vitarish.Sea.Interface.Plugins.Base.Enums
@inherits ProjectsBase
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6">@Localizer["RegisterGymTrainee"]</MudText>

            <AiStreamResponder @ref="responder"
                               Options="responderOptions"
                               OnOutput="HandleResponderOutputAsync"
                               OnOutputEnd="HandleResponderCompletedAsync" />

            @if (!string.IsNullOrWhiteSpace(facilityLabel))
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                    @facilityLabel
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(generationError))
            {
                <MudAlert Severity="Severity.Error">@generationError</MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(metadataValidationError))
            {
                <MudAlert Severity="Severity.Error">@metadataValidationError</MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }

            <MudStepper @bind-ActiveIndex="activeStep" NonLinear="false">
                <ChildContent>
                    <MudStep Title="@Localizer["TraineeDescription"]" Completed="@DescriptionProvided" Class="px-0">
                        <MudText Typo="Typo.subtitle2">@Localizer["DescribeTrainee"]</MudText>
                        <MudText Typo="Typo.body2">@Localizer["DescribeTraineeHelp"]</MudText>
                        <AdvancedInput @bind-Value="traineeDescription" @bind-Busy="inputBusy" />
                    </MudStep>

                    <MudStep Title="@Localizer["Generate"]" Completed="@MetadataAvailable" Class="px-0">
                        <MudPaper Outlined Class="pa-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle2">@Localizer["Generating"]</MudText>
                                <MudText Typo="Typo.body2">@Localizer["GeneratingHelp"]</MudText>
                                @if (isGenerating)
                                {
                                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                        <MudProgressCircular Size="Size.Medium" Indeterminate />
                                        <MudText Typo="Typo.body2">@Localizer["Processing"]</MudText>
                                    </MudStack>
                                }
                                else if (MetadataAvailable)
                                {
                                    <MudText Typo="Typo.body2">@Localizer["GenerationDone"]</MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    </MudStep>

                    <MudStep Title="@Localizer["Review"]" Completed="@CanSubmit" Class="px-0">
                        <MudText Typo="Typo.subtitle2">@Localizer["Review"]</MudText>
                        <MudText Typo="Typo.body2">@Localizer["ReviewHelp"]</MudText>

                        @if (!MetadataAvailable)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-2">@Localizer["MetadataAppearsAfterGenerate"]</MudAlert>
                        }
                        else
                        {
                            <MudGrid Class="mt-2" Spacing="2">
                                <MudItem xs="12">
                                    <MudPaper Elevation="0" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">@Localizer["Identity"]</MudText>
                                            <MudDivider Class="my-1" />
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.FirstName"
                                                                  Label="@Localizer["FirstName"]"
                                                                  Variant="ThemeService.SecondaryVariant"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.LastName"
                                                                  Label="@Localizer["LastName"]"
                                                                  Variant="ThemeService.SecondaryVariant"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudDatePicker @bind-Date="editableMetadata.DateOfBirth"
                                                                   Label="@Localizer["DateOfBirth"]"
                                                                   Variant="ThemeService.SecondaryVariant"
                                                                   DisplayMonths="1" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudRadioGroup T="Gender?"
                                                               @bind-Value="editableMetadata.Gender">
                                                        <MudRadio Value="@Gender.Female">@Localizer["Female"]</MudRadio>
                                                        <MudRadio Value="@Gender.Male">@Localizer["Male"]</MudRadio>
                                                    </MudRadioGroup>
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.Nationality"
                                                                  Label="@Localizer["Nationality"]"
                                                                  Variant="ThemeService.SecondaryVariant"
                                                                  Immediate="true" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="0" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">@Localizer["Contact"]</MudText>
                                            <MudDivider Class="my-1" />
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.Email"
                                                                  Label="@Localizer["Email"]"
                                                                  Variant="ThemeService.SecondaryVariant"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.Phone"
                                                                  Label="@Localizer["Phone"]"
                                                                  Variant="ThemeService.SecondaryVariant"
                                                                  Immediate="true" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="0" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">@Localizer["Membership"]</MudText>
                                            <MudDivider Class="my-1" />
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.MembershipType"
                                                                  Label="@Localizer["MembershipType"]"
                                                                  Variant="ThemeService.SecondaryVariant"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.PreferredProgram"
                                                                  Label="@Localizer["PreferredProgram"]"
                                                                  Variant="ThemeService.SecondaryVariant"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12">
                                                    <MudTextField @bind-Value="editableMetadata.Goals"
                                                                  Label="@Localizer["Goals"]"
                                                                  Variant="ThemeService.SecondaryVariant"
                                                                  Immediate="true" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="0" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">@Localizer["Emergency"]</MudText>
                                            <MudDivider Class="my-1" />
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.EmergencyContactName"
                                                                  Label="@Localizer["EmergencyContactName"]"
                                                                  Variant="ThemeService.SecondaryVariant"
                                                                  Immediate="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="editableMetadata.EmergencyContactPhone"
                                                                  Label="@Localizer["EmergencyContactPhone"]"
                                                                  Variant="ThemeService.SecondaryVariant"
                                                                  Immediate="true" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="0" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">@Localizer["Health"]</MudText>
                                            <MudDivider Class="my-1" />
                                            <MudTextField @bind-Value="editableMetadata.MedicalNotes"
                                                          Label="@Localizer["MedicalNotes"]"
                                                          Variant="ThemeService.SecondaryVariant"
                                                          Lines="3"
                                                          AutoGrow="true"
                                                          Immediate="true" />
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        }
                    </MudStep>
                </ChildContent>
                <ActionContent />
            </MudStepper>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@(isGenerating || isSubmitting)"
                       OnClick="Cancel">@Localizer["Cancel"]</MudButton>
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                @if (activeStep > 0)
                {
                    <MudButton Variant="Variant.Text"
                               Disabled="@(isGenerating || isSubmitting)"
                               OnClick="GoToPreviousStep">@Localizer["Back"]</MudButton>
                }
                @switch (activeStep)
                {
                    case 0:
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(!CanBeginGeneration)"
                                   OnClick="BeginGenerationAsync">
                            @if (isGenerating)
                            {
                                <MudProgressCircular Size="Size.Small" Class="me-2" Indeterminate />
                            }
                            @generateLabel
                        </MudButton>
                        break;
                    case 1:
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(!CanOpenReview)"
                                   OnClick="() => activeStep = 2">
                            @Localizer["ReviewDetails"]
                        </MudButton>
                        break;
                    case 2:
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(!CanSubmit)"
                                   OnClick="SubmitAsync">
                            @if (isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Class="me-2" Indeterminate />
                            }
                            @finishLabel
                        </MudButton>
                        break;
                }
            </MudStack>
        </MudStack>
    </DialogActions>
</MudDialog>
