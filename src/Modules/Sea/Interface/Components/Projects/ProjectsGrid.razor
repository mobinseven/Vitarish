@inherits ProjectsBase
<Stack>
    <StackButton Color="Color.Primary"
                 OnClick="AddProject"
                 StartIcon="fa-thin fa-folder-plus"
                 Label="@Localizer["AddItem", Localizer["Project"]]" />
</Stack>
<MudDataGrid T="ProjectDto"
             @ref="grid"
             LoadingProgressColor="Color.Success"
             ServerData="ReloadData"
             Class="glass"
             Dense
             Breakpoint=Breakpoint.None
             Elevation="0">
    <Columns>
        <TemplateColumn T="ProjectDto">
            <CellTemplate Context="context">
                @RenderProjectCell(context.Item)
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>
