@inherits ProjectsBase
@if(Plugin is null)
{
    @if(AdminMode)
    {
        <Stack>
            <StackButton Color="Color.Primary"
                         OnClick="AddProject"
                         StartIcon="fa-solid fa-folder-plus"
                         Label="@Localizer["AddItem", Localizer["Project"]]" />
        </Stack>
    }
    <Stack>
        @foreach(var project in projects)
        {
            <StackButton OnClick="() => OnClicked.InvokeAsync(project.Id)"
                         Label="@project.Name"
                         HighlightString="@SearchString"
                         EndIcon="" Color="Color.Info">
                <StatsDisplay Stats="project.Stats" />
            </StackButton>
        }
        @if(projects.Count == 0)
        {
            <StackButton OnClick="ReloadRequired" Label="@Localizer["NoItems", Localizer["Project"]]" HelperText="@Localizer["NoItemsHelp", Localizer["Project"]]" EndIcon="fa-solid fa-refresh" Color="Color.Info">
                @Localizer["Reload"]
            </StackButton>
        }
    </Stack>
}
else
{
    @Plugin.Render(new ProjectsGridPlugin(OnClicked, OnAdd, TemplateMode))
}
