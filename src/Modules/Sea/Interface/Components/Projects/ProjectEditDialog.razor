@inherits ProjectsBase

<MudDialog>
    <DialogContent>
        @if(Plugin is null)
        {
            <MudStack Spacing="2">
                <MudTextField @bind-Value="name" Variant=Variant.Outlined Label="@Localizer["Project"]" />
                <MudTextField @bind-Value="description" Variant=Variant.Outlined AutoGrow Lines=3 Label="@Localizer["Description"]" />
            </MudStack>
        }
        else
        {
            if(Project is null)
            {
                throw new InvalidOperationException("This flow is used for editing a project not adding a new one.");
            }
            @Plugin.Render(new ProjectEditPlugin(Project, OnUpdate(Project)))
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Close"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@string.IsNullOrWhiteSpace(name)">@Localizer["Save"]</MudButton>
    </DialogActions>
</MudDialog>
