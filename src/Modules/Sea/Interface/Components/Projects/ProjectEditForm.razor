@inherits ProjectsBase
@if(Plugin is null)
{
    <Stack>
        <StackTextField @bind-Value="projectWriteDto.Name" Label="@Localizer["Project"]" />
        <StackTextField @bind-Value="projectWriteDto.Description" AutoGrow Lines=3 Label="@Localizer["Description"]" />
        <StackCheckbox @bind-Value="projectWriteDto.Template" Label="@Localizer["Template"]" />
    </Stack>
    <Stack>
        <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(projectWriteDto.Name)" />
        <StackButton Label="@Localizer["Close"]" OnClick="Cancel" />
    </Stack>
}
else
{
    @Plugin.Render(new ProjectEditPlugin(Project, OnUpdate, OnCreate, OnCancel, TemplateMode))
}
