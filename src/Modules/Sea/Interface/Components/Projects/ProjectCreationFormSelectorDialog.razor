
@inherits ProjectsBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">@Localizer["Choose project form"]</MudText>
            <MudList T="object" Dense="true">
                @foreach (var plugin in Options)
                {
                    var metadata = GetMetadata(plugin);
                    <MudListItem T="object" OnClick="@(() => Select(plugin))">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">@metadata.DisplayName</MudText>
                            @if (!string.IsNullOrWhiteSpace(metadata.Description))
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@metadata.Description</MudText>
                            }
                        </MudStack>
                    </MudListItem>
                }
                @if (ShowStandardForm)
                {
                    <MudListItem T="object" OnClick="@(() => Select(null))">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">@Localizer["Standard project"]</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Localizer["Use the default project creation dialog."]</MudText>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@Localizer["Cancel"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public required IReadOnlyList<IProjectCreationFormPlugin> Options { get; set; }

    [Parameter]
    public bool ShowStandardForm { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, ProjectCreationFormPluginDisplayMetadata>? DisplayMetadata { get; set; }

    private void Select(IProjectCreationFormPlugin? plugin)
        => Dialog.Close(DialogResult.Ok(plugin));

    private void Cancel() => Dialog.Cancel();

    private ProjectCreationFormPluginDisplayMetadata GetMetadata(IProjectCreationFormPlugin plugin)
    {
        if(DisplayMetadata is not null && DisplayMetadata.TryGetValue(plugin.Id, out var metadata))
        {
            return metadata;
        }

        return new ProjectCreationFormPluginDisplayMetadata(plugin.DisplayName, plugin.Description);
    }
}
