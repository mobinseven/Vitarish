@inherits ProjectsBase

@if(Project is null)
{
    return;
}

@if(Plugin is null)
{
    @if(AdminMode)
    {
        <Stack>
            <StackButton OnClick="@(() => AddProcedure())"
                         Color="Color.Primary"
                         StartIcon="fa-thin fa-file-plus"
                         Label="@Localizer["AddItem", Localizer["Procedure"]]" />
        </Stack>
    }
    <Stack>
        <StackField Label="@Project.Name" HelperText="@Localizer["Project"]">
            @if(!string.IsNullOrWhiteSpace(Project.Description))
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-3">@Project.Description</MudText>
            }
        </StackField>
        @if(AdminMode)
        {
            <StackButton OnClick="@(() => EditProject())"
                         StartIcon="fa-thin fa-pencil"
                         Label="@Localizer["EditItem", Localizer["Project"]]" />
            <StackButton OnClick="@(() => DeleteProject())"
                         Color="Color.Error"
                         StartIcon="fa-thin fa-folder-xmark"
                         Label="@Localizer["DeleteItem", Localizer["Project"]]" />
        }
    </Stack>
}
else
{
    @Plugin.Render(new ProjectDetailsPlugin(Project, OnEdit, OnDeleted, OnProcedureAdded))
}
