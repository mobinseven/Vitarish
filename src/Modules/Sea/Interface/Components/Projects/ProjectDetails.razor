@inherits ProjectsBase

@if(Project is null)
{
    return;
}

@if(Plugin is null)
{
    <Stack>
        <StackField Label="@Project.Name" HelperText="@Localizer["Project"]">
            <ProjectAvatar AvatarFileId="@Project.AvatarFileId" Size="96" Style="margin-bottom: 0.5rem;" />
            @if(!string.IsNullOrWhiteSpace(Project.Description))
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-3">@Project.Description</MudText>
            }
        </StackField>
        @if(AdminMode)
        {
            <StackButton OnClick="@(() => EditProject())"
                         EndIcon="fa-regular fa-pencil"
                         Label="@Localizer["EditItem", Localizer["Project"]]" />
            <StackButton OnClick="@(() => DeleteProject())"
                         Color="Color.Error"
                         EndIcon="fa-regular fa-folder-xmark"
                         Label="@Localizer["DeleteItem", Localizer["Project"]]" />
        }
    </Stack>
}
else
{
    @Plugin.Render(new ProjectDetailsPlugin(Project, OnEdit, OnDeleted))
}
