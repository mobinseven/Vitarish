@using System.Threading.Tasks
@inherits ProjectsBase

<StackButton OnClick="HandleClickedAsync"
             Label="@Context.Project.Name"
             HighlightString="@Context.HighlightString">
    <StatsDisplay Stats="DisplayStats" />
</StackButton>


@code {
    [Parameter, EditorRequired]
    public ProjectGridCellDisplayContext Context { get; set; } = default!;

    private StatsDto DisplayStats => Context.Stats ?? new();

    private Task HandleClickedAsync()
    {
        if(!Context.OnClicked.HasDelegate)
        {
            return Task.CompletedTask;
        }

        return Context.OnClicked.InvokeAsync(Context.Project.Id);
    }
}
