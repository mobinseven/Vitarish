@inherits ProjectsBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">@Localizer["TemplateItem", Localizer["Project"]]</MudText>
            <MudTextField @bind-Value="name"
                          Variant="ThemeService.SecondaryVariant"
                          Label="@Localizer["Project"]" />
            <MudTextField @bind-Value="description"
                          Variant="ThemeService.SecondaryVariant"
                          AutoGrow
                          Lines="3"
                          Label="@Localizer["Description"]" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Close"]</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@string.IsNullOrWhiteSpace(name)"
                   OnClick="SaveAsync">
            @Localizer["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>
