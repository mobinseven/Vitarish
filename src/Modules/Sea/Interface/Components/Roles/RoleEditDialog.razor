@inherits RolesBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackTextField @bind-Value="name" Label="@Localizer["Role"]" />
        </Stack>
        <Stack>
            <StackButton Color="Color.Primary" OnClick="SaveAsync" Label="@Localizer["Save"]" Disabled="@string.IsNullOrWhiteSpace(name)" EndIcon="fa-solid fa-save" />
            <StackButton EndIcon="fa-solid fa-xmark" Label="@Localizer["Cancel"]" OnClick="Cancel" />
        </Stack>
    </DialogContent>
</MudDialog>
