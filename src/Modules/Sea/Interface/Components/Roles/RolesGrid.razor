@inherits RolesBase

<MudDataGrid T="RoleDto" Items="@roles" Hover="true" Class="mt-4">
    <ToolBarContent>
        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddRole">@Localizer["Add"]</MudButton>
    </ToolBarContent>
    <Columns>
        <TemplateColumn T="RoleDto">
            <CellTemplate Context="context">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => EditRole(context.Item))" />
                <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteRole(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>
