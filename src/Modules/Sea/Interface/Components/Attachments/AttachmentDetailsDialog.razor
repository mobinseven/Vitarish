@inherits SeaCommonBase
<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            @if(Attachment.ContentType.StartsWith("image"))
            {
                <ImageElement Src="@Attachment.Content" Type="@Attachment.ContentType" />
            }
            @if(Attachment.ContentType.StartsWith("video"))
            {
                <VideoElement Src="@Attachment.Content" Type="@Attachment.ContentType" />
            }
            @if(Attachment.ContentType.StartsWith("text"))
            {
                if(editing)
                {
                    <MudTextField @bind-Value="editContent" Style="width:100%;" AutoGrow Immediate Variant="ThemeService.SecondaryVariant" />
                }
                else
                {
                    <TextChip Color="Color" Class="pa-2 glass" Text="@Attachment.Content" />
                }
            }
            <MudText Typo="Typo.body2">@($"{Localizer["Attacher"]}: {UserIdToName(Attachment.CreatedBy)}")</MudText>
            <MudText Typo="Typo.body2">@($"{Localizer["CreatedAt"]}: {Attachment.CreatedAt.ToLocalTime()}")</MudText>
            @if(Attachment.UpdatedAt is not null)
            {
                <MudText Typo="Typo.body2">@($"{Localizer["Updated"]}: {Attachment.UpdatedAt}")</MudText>
            }
            <MudText Typo="Typo.caption">@($"{Localizer["ContentType"]}: {Attachment.ContentType}")</MudText>
            @if(readers.Count > 0)
            {
                <MudList T="string">
                    <MudListSubheader>
                        @Localizer["SeenBy"]
                    </MudListSubheader>
                    @foreach(var reader in GetReaders())
                    {
                        <MudListItem Dense="true" Icon="fa-thin fa-check-double" Text="@reader" />
                    }
                </MudList>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@Localizer["Close"]</MudButton>
        @if(editing)
        {
            <MudButton Variant="Variant.Filled" OnClick="SaveAsync" Color="Color.Primary" DropShadow="false">@Localizer["Save"]</MudButton>
            <MudButton OnClick="CancelEdit" DropShadow="false">@Localizer["Cancel"]</MudButton>
        }
        else if(CanWrite)
        {
            if(Attachment.ContentType.StartsWith("text"))
            {
                <MudButton Variant="Variant.Filled" OnClick="StartEdit" DropShadow="false">@Localizer["Edit"]</MudButton>
            }
            <MudButton Variant="Variant.Filled" OnClick="DeleteAttachment" Color="Color.Error" DropShadow="false">@Localizer["DeleteItem", Localizer["Attachment"]]</MudButton>
        }
    </DialogActions>
</MudDialog>
