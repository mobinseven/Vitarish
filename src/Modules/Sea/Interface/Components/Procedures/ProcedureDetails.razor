@inherits ProceduresBase

@if(AdminMode)
{
    <Stack>
        <StackField Label="@Procedure.Name" HelperText="@Procedure.Description" />
        <StackButton Label="@Localizer["EditItem", Localizer["Procedure"]]" OnClick="EditProcedure" EndIcon="fa-solid fa-edit" Color="Color.Secondary" />
        <StackButton Label="@Localizer["DeleteItem", Localizer["Procedure"]]" Color="Color.Error" OnClick="DeleteProcedure" EndIcon="fa-solid fa-trash" />
    </Stack>
}

@code {

    [Parameter, EditorRequired] public required ProjectReadDto Project { get; set; }
    [Parameter, EditorRequired] public required ProcedureReadDto Procedure { get; set; }

    [Parameter] public EventCallback OnUpdate { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private async Task EditProcedure()
    {
        DialogParameters parameters = new()
        {
            { nameof(ProcedureEditDialog.ProjectId), Project.Id },
            { nameof(ProcedureEditDialog.Procedure), Procedure },
            { nameof(ProcedureEditDialog.ProjectName), Project.Name }
        };
        IDialogReference dialog = await DialogService.ShowAsync<ProcedureEditDialog>(null, parameters);
        DialogResult? result = await dialog.Result;


        if(result is null || result.Canceled)
        {
            return;
        }

        await OnUpdate.InvokeAsync();
    }


    private async Task DeleteProcedure()
    {
        DialogParameters parameters = new()
        {
            { nameof(StrictConfirmDialog.ContentText), Localizer["ConfirmationQuestion"].Value },
            { nameof(StrictConfirmDialog.ButtonText), Localizer["DeleteItem", Localizer["Procedure"]].Value },
            { nameof(StrictConfirmDialog.ItemName), Procedure.Name },
            { nameof(StrictConfirmDialog.Color), Color.Error }
        };

        IDialogReference dialog = await DialogService.ShowAsync<StrictConfirmDialog>(Localizer["DeleteItem", Localizer["Procedure"]], parameters);
        DialogResult? result = await dialog.Result;

        if(result is null || result.Canceled)
        {
            return;
        }
        else
        {
            await CommandOrNotifyAsync(SeaClient.DeleteProcedureAsync(Procedure.Id, CancellationToken.None));
            await OnDelete.InvokeAsync();
        }
    }

}
