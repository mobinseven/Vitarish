@inherits ProceduresBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackField Label="@Localizer["Procedure"]" />
            <StackTextField @bind-Value="procedure.Name" Label="@Localizer["Name"]" />
            <StackTextField @bind-Value="procedure.Description" Label="@Localizer["Description"]" Lines="3" />
        </Stack>
        <Stack>
            <StackButton OnClick="SaveAsync" Color="Color.Primary" Label="@Localizer["Save"]" EndIcon="fa-solid fa-save" />
            <StackButton OnClick="Cancel" Label="@Localizer["Close"]" EndIcon="fa-solid fa-xmark" />
        </Stack>
    </DialogContent>
</MudDialog>
