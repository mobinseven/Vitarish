@inherits ProceduresBase

<Stack>
    <StackField Label="@Localizer["Procedures"]" />
    @foreach(var procedure in procedures)
    {
        <StackButton Label="@procedure.Name" OnClick="@(() => ProcedureClicked.InvokeAsync(procedure.Id))">
            <StatsDisplay Stats="procedure.Stats ?? new StatsDto()" />
        </StackButton>
    }
</Stack>
