@inherits SeaCommonBase

<Stack>
    <StackField Label="@Localizer["ReminderSignature"]">
        <MudTextField @bind-Value="MetadataService.ReminderSignature" Lines="4" AutoGrow Underline="false" Variant="Variant.Outlined" />
    </StackField>
</Stack>

<AuthorizeView Policy="@IdentityDefinitions.PlatformAdmin">
    <Stack>
        <StackField Label="@Localizer["Plugin"]">
            <MudSelect T="string" @bind-Value="MetadataService.PluginIdentifier" Clearable="true" Underline="false">
                <MudSelectItem T="string" Value="null">@Localizer["None"]</MudSelectItem>
                @foreach(PluginIdentifier plugin in SeaPluginIdentifiers.List)
                {
                    <MudSelectItem T="string" Value="@plugin.Title">
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@plugin.Icon" />
                            <MudText Typo="Typo.body2">
                                @Localizer[plugin.Title]
                            </MudText>
                        </MudStack>
                    </MudSelectItem>
                }
            </MudSelect>
        </StackField>
    </Stack>
</AuthorizeView>
