@inherits UsageConfigurationsBase

<MudTextField Label="@Localizer["ReminderSignature"]" Variant="ThemeService.SecondaryVariant" @bind-Value="_configuration.ReminderSignature" />

@if(_projectGridCellDisplayPlugins.Count > 1)
{
    <br />
    <MudSelect T="string" Label="@Localizer["ProjectGridCellDisplay"]" Variant="ThemeService.SecondaryVariant" @bind-Value="PreferredProjectGridCellDisplayPluginId" Clearable="true">
        <MudSelectItem T="string" Value="@AutomaticPluginSelectionValue">@Localizer["ProjectGridCellDisplayAutomatic"]</MudSelectItem>
        @foreach(IProjectGridCellDisplayPlugin plugin in _projectGridCellDisplayPlugins)
        {
            <MudSelectItem T="string" Value="@plugin.Id">@plugin.DisplayName</MudSelectItem>
        }
    </MudSelect>
}

<br />
<MudSelect T="string" Label="@Localizer["PreferredChatModel"]" Variant="ThemeService.SecondaryVariant" @bind-Value="_metadata.ChatModel" Clearable="true">
    @foreach(ModelOption model in AvailableModels)
    {
        <MudSelectItem T="string" Value="@model.Id">@model.DisplayName</MudSelectItem>
    }
</MudSelect>

<br />
<MudTextField Label="@Localizer["ChatInstructions"]" Variant="ThemeService.SecondaryVariant" @bind-Value="_metadata.ChatInstructions" Lines="6" AutoGrow />

<br />
<MudTextField Label="@Localizer["ProjectOverviewInstructions"]" Variant="ThemeService.SecondaryVariant" @bind-Value="_metadata.ProjectOverviewInstructions" Lines="6" AutoGrow />

<br />
<MudTextField Label="@Localizer["ProcedureOverviewInstructions"]" Variant="ThemeService.SecondaryVariant" @bind-Value="_metadata.ProcedureOverviewInstructions" Lines="6" AutoGrow />

@if(_clinicPatientIntakePluginAvailable)
{
    <br />
    <MudTextField Label="@Localizer["ClinicPatientIntakeInstructions"]" Variant="ThemeService.SecondaryVariant" @bind-Value="_metadata.ClinicPatientIntakeInstructions" Lines="6" AutoGrow />
}

<br />
<MudButton StartIcon="fa-thin fa-floppy-disk" OnClick="SaveAsync">@Localizer["Save"]</MudButton>

