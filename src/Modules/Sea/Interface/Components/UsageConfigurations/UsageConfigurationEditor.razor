@inherits UsageConfigurationsBase

<Stack>
    <StackField Label="@Localizer["ReminderSignature"]">
        <MudTextField @bind-Value="_configuration.ReminderSignature" Lines="4" AutoGrow />
    </StackField>
</Stack>

<Stack>
    <StackField Label="@Localizer["Plugin"]">
        <MudSelect T="string" @bind-Value="_metadata.PluginIdentifier" Clearable="true" Underline="false">
            <MudSelectItem T="string" Value="null">@Localizer["None"]</MudSelectItem>
            @foreach(string plugin in SeaPluginIdentifiers.List)
            {
                <MudSelectItem T="string" Value="@plugin">@Localizer[plugin]</MudSelectItem>
            }
        </MudSelect>
    </StackField>
</Stack>

<Stack>
    <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" />
</Stack>

