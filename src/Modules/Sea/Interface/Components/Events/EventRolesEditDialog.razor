@inherits SeaCommonBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackField AdornmentIcon="fa-thin fa-glasses" Label="@Localizer["ReadRolesFor"]" />
            @foreach(var role in roles)
            {
                <StackCheckbox Label="@role.Name" Value="readRoleIds.Contains(role.Id)" ValueChanged="@((bool b) => OnReadRoleChanged(role.Id, b))" />
            }
        </Stack>
        <Stack>
            <StackField AdornmentIcon="fa-thin fa-pen" Label="@Localizer["WriteRolesFor"]" />
            @foreach(var role in roles)
            {
                <StackCheckbox Label="@role.Name" Value="writeRoleIds.Contains(role.Id)" ValueChanged="@((bool b) => OnWriteRoleChanged(role.Id, b))" />
            }
        </Stack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Close"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@Localizer["Save"]</MudButton>
    </DialogActions>
</MudDialog>
