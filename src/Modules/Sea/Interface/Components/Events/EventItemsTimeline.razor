@inherits EventsBase

<PaletteCard Title="@Localizer["Attachments"]">
    @if(items.Count > 0)
    {
        @foreach(var item in items)
        {
            <Stack>
                @if(!string.IsNullOrWhiteSpace(item.Placeholder))
                {
                    <StackField Label="@item.Placeholder" AdornmentIcon="fa-solid fa-circle-notch fa-spin" />
                }
                else
                {
                    @item.Content
                }
            </Stack>
        }
    }
    @if(CanWrite)
    {
        <EventItemsInput Project="Project" Procedure="Procedure" Event="Event" OnCreated="ReloadRequired" />
    }
</PaletteCard>
