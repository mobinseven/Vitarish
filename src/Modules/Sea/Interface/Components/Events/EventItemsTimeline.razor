@inherits EventsBase

<Stack>
    @foreach(var item in items)
    {
        @if(!string.IsNullOrWhiteSpace(item.Placeholder))
        {
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Justify="Justify.FlexStart"
                      Style="width: 100%">
                <div>
                    <MudFab Size=Size.Small
                            DropShadow=false
                            StartIcon="fa-regular fa-circle-notch fa-spin" />
                </div>
                <div>
                    <Chip Class="py-2 glass">
                        <MudText Typo="Typo.caption"
                                 Class="shimmer">
                            @item.Placeholder
                        </MudText>
                    </Chip>
                </div>
            </MudStack>
        }
        else
        {
            @item.Content
        }
    }
    @if(items.Count == 0)
    {
        <StackField Label="@Localizer["NoItems", Localizer["Attachment"]]" HelperText="@Localizer["NoItemsHelp", Localizer["Attachment"]]" />
    }
</Stack>
@if(CanWrite)
{
    <Stack>
        <StackField>
            <EventItemsInput Project="Project" Procedure="Procedure" Event="Event" />
        </StackField>
    </Stack>
}
