@inherits EventsBase

<Stack>
    @foreach(var evt in events)
    {
        if(evt.Title == "Redacted")
        {
            <StackButton Label="@Localizer["NoAccess"]"
                         Style="filter: blur(5px); pointer-events: none;" />
        }
        else
        {
            <StackButton Label="@evt.Title"
                         Color="@(evt.IsCommitted ? Color.Success : Color.Default)"
                         StartIcon="@(evt.IsCommitted ? "fa-solid fa-check" : "fa-solid fa-moon-full")"
                         EndIcon=""
                         OnClick="@(() => EventClicked.InvokeAsync(evt.Id))">
                <StatsDisplay Stats="evt.Stats ?? new StatsReadDto()" />
            </StackButton>
        }
    }

    @if(AdminMode)
    {
        <StackButton Color="Color.Primary"
                     EndIcon="fa-solid fa-plus"
                     OnClick="AddEvent"
                     Label="@Localizer["AddItem", Localizer["Event"]]" />
    }
</Stack>
