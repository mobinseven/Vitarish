@inherits EventsBase

<Stack>
    @foreach(var evt in events)
    {
        <StackButton Label="@evt.Title" Color="@(evt.IsCommitted ? Color.Primary : Color.Default)" StartIcon="@(evt.IsCommitted ? "fa-thin fa-check" : "fa-thin fa-fw")" OnClick="@(() => EventClicked.InvokeAsync(evt.Id))">
            <StatsDisplay Stats="evt.Stats ?? new StatsDto()" />
        </StackButton>
    }
</Stack>

@if(AdminMode)
{
    <Stack>
        <StackButton Color="Color.Primary" StartIcon="fa-thin fa-plus" Size=Size.Large OnClick="AddEvent" Label="@Localizer["AddItem", Localizer["Event"]]"/>
    </Stack>
}

