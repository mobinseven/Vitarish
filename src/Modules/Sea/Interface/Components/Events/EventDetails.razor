@inherits EventsBase

@if(!string.IsNullOrWhiteSpace(Event.Description))
{
    <Stack>
        <StackField Label="@Event.Title" HelperText="@Event.Description" />
    </Stack>
}

@if(Event.IsCommitted)
{
    <Stack>
        <StackField Label="@Localizer["Committed"]" Color="Color.Primary" AdornmentIcon="fa-duotone fa-circle-check fa-2x" AdornmentColor="Color.Primary">
            @{
                var userName = UserIdToName(Event.CommittedBy);
            }
            @if(!string.IsNullOrWhiteSpace(userName))
            {
                <MudText Typo="Typo.caption">@($"{Localizer["By"]}: {userName}")</MudText>
            }
            <MudText Typo="Typo.caption">@($"{Localizer["At"]}: {Event.CommittedAt!.Value.DateTime.ToLocalTime().ToShortDateString()} {Event.CommittedAt!.Value.DateTime.ToLocalTime().ToShortTimeString()}")</MudText>
        </StackField>
        @if(AdminMode)
        {
            <StackButton StartIcon="fa-thin fa-xmark" Color="Color.Error" OnClick="() => ToggleCommitAsync()" Label="@Localizer["Uncommit"]" />
        }
    </Stack>
}
else if(CanWrite)
{
    <Stack>
        <StackButton StartIcon="fa-thin fa-check" Color="Color.Primary" OnClick="() => ToggleCommitAsync()" Label="@Localizer["Commit"]" />
    </Stack>
}


@if(AdminMode)
{
    <Stack>
        <StackButton StartIcon="fa-thin fa-users" OnClick="EditEventRoles" Label="@Localizer["EditRoles", Localizer["Event"]]" />
        <StackButton StartIcon="fa-thin fa-trash" OnClick="DeleteEvent" Label="@Localizer["DeleteItem", Localizer["Event"]]" Color="Color.Error" />
    </Stack>
}

@code {
    [Parameter, EditorRequired] public required ProjectDto Project { get; set; }
    [Parameter, EditorRequired] public required ProcedureDto Procedure { get; set; }
    [Parameter, EditorRequired] public required EventDto Event { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }

    private async Task EditEventRoles()
    {
        DialogParameters parameters = new()
        {
            { nameof(EventEditDialog.Event), Event }
        };

        var dialog = await DialogService.ShowAsync<EventRolesEditDialog>(null, parameters);
        await dialog.Result;
    }

    private async Task DeleteEvent()
    {
        DialogParameters parameters = new()
        {
            { nameof(StrictConfirmDialog.ContentText), Localizer["ConfirmationQuestion"].Value },
            { nameof(StrictConfirmDialog.ButtonText), Localizer["Delete"].Value },
            { nameof(StrictConfirmDialog.ItemName), Event.Title },
            { nameof(StrictConfirmDialog.Color), Color.Error }
        };
        IDialogReference dialog = await DialogService.ShowAsync<StrictConfirmDialog>(Localizer["Delete"], parameters);
        DialogResult? result = await dialog.Result;

        if(result is null)
        {
            return;
        }

        if(result.Canceled)
        {
            return;
        }
        else
        {
            _ = await EventsService.RemoveEventAsync(Procedure.Id, Event.Id, CancellationToken.None);
            await OnDelete.InvokeAsync();
        }
    }

    private bool CanWrite;


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        CanWrite = await EventsService.CanWriteEvent(Event.Id);
    }


    private async void ToggleCommitAsync()
    {
        if(Event.IsCommitted)
        {
            DialogParameters parameters = new()
            {
                { nameof(ConfirmDialog.ContentText), Localizer["UncommitHelp"].Value },
                { nameof(ConfirmDialog.ButtonText), Localizer["Uncommit", Event.Title].Value },
                { nameof(ConfirmDialog.Color), Color.Error }
            };
            IDialogReference dialog = await DialogService.ShowAsync<ConfirmDialog>(Localizer["Uncommit"], parameters);
            DialogResult? result = await dialog.Result;

            if(result is null)
            {
                return;
            }

            if(result.Canceled)
            {
                return;
            }

            await EventsService.UncommitAsync(Event.Id, CancellationToken.None);
            string uncommitMessage = Localizer["Uncommitted"];
            await AttachmentsService.AddAsync(Event.Id, uncommitMessage, "text/plain", null, Encoding.UTF8.GetByteCount(uncommitMessage), CancellationToken.None);
        }
        else
        {
            DateTimeOffset commitTime = new(DateTime.Now, TimeZoneInfo.Local.GetUtcOffset(DateTime.UtcNow));
            await EventsService.CommitAsync(Event.Id, CancellationToken.None);
            string commitMessage = Localizer["Committed"];
            await AttachmentsService.AddAsync(Event.Id, commitMessage, "text/plain", null, Encoding.UTF8.GetByteCount(commitMessage), CancellationToken.None);
        }
    }
}
