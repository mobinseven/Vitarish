@inherits SeaCommonBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="1">
            <MudText Typo="Typo.h6">@Event.Title</MudText>
            <MudText Typo="Typo.body2">@Event.Description</MudText>
            @if(Event.IsCommitted)
            {
                <MudText Typo="Typo.body2">@($"{Localizer["CommittedBy"]}: {UserIdToName(Event.CommittedBy)}")</MudText>
                <MudText Typo="Typo.body2">@($"{Localizer["CommittedAt"]}: {Event.CommittedAt!.Value.DateTime.ToLocalTime().ToShortDateString()} {Event.CommittedAt!.Value.DateTime.ToLocalTime().ToShortTimeString()}")</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="MudDialog.Cancel">@Localizer["Close"]</MudButton>
        @if(Event.IsCommitted)
        {
            if(AdminMode)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="() => ToggleCommitAsync()">@Localizer["Uncommit"]</MudButton>
            }
        }
        else
        {
            if(CanWrite)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ToggleCommitAsync()">@Localizer["Commit"]</MudButton>
            }
        }
    </DialogActions>
</MudDialog>
