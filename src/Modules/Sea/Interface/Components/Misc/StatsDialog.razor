@inherits SeaCommonBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackField Label="@Localizer["Events"]" HelperText="@Stats.Events.ToString()" />
            <StackField Label="@Localizer["Committed"]" HelperText="@Stats.CommittedEvents.ToString()" />
            <StackField Label="@Localizer["Attachments"]" HelperText="@Stats.EventItems.ToString()" />
            <StackField Label="@Localizer["NewItems"]" HelperText="@Stats.NewItems.ToString()" />
        </Stack>
        <Stack>
            <StackButton Label="@Localizer["Close"]" OnClick="Cancel" Color="Color.Secondary" />
        </Stack>
    </DialogContent>
</MudDialog>


@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!; 
    [Parameter, EditorRequired] public StatsReadDto Stats { get; set; }
    [Parameter, EditorRequired] public string Icon { get; set; }

    private void Cancel() => MudDialog.Cancel();

}
