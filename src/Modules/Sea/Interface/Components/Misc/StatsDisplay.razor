@inherits SeaCommonBase
@using System.Text.Encodings.Web
@((MarkupString)BlinkIcon)

@code {
    [Parameter, EditorRequired] public StatsReadDto? Stats { get; set; }

    private bool HasNewItems => Stats?.NewItems > 0;

    private int BadgeCount => HasNewItems
        ? Stats!.NewItems
        : Stats?.EventItems ?? 0;

    private string BadgeContent =>
        NumberExtensions.LocalizeNumerals(BadgeCount.ToString());

    private string TextColor => HasNewItems
        ? "var(--mud-palette-primary)"
        : "currentColor";

    private MarkupString BlinkIcon => new(BadgeCount <= 0
        ? ""
        : $"""
          <span class="fa-layers fa-fw" style="color:{TextColor}">
              <i class="{IconClass}"></i>
              <span class="fa-layers-counter" style="color:inherit;background:transparent">
                  {HtmlEncoder.Default.Encode(BadgeContent)}
              </span>
          </span>
          """);

    private string IconClass => HasNewItems
        ? "fa-solid fa-envelope fa-fade fa-xl"
        : "fa-solid fa-envelope-open fa-xl";
}
