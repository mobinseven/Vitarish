@inherits UsersBase

<Stack>
    @foreach(var user in users)
    {
        <StackExpandable Label="@user.FullName" HighlightString="@SearchString">
            <UserRolesSelect User="@user" />
        </StackExpandable>
    }
    @if(users.Length == 0)
    {
        <StackButton OnClick="ReloadRequired" Label="@Localizer["Reload"]" HelperText="@Localizer["NoItemsHelp", Localizer["User"]]" EndIcon="fa-solid fa-refresh" Color="Color.Secondary"/>
    }
</Stack>
