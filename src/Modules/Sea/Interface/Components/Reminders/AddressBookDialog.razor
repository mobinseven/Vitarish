@inherits SeaCommonBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="1">
            <MudList T="UserDto">
                @foreach(var user in AccessService.Users.Where(u => !string.IsNullOrEmpty(GetAddress(u, Kind))))
                {
                    <MudCheckBox T="bool" ValueChanged="() => ToggleUser(user)" Value="IsSelected(user)">@user.FullName</MudCheckBox>
                }
                @foreach(var recipient in selected.Where(r=>r.RecipientUserId is null))
                {
                    <MudCheckBox T="bool" ValueChanged="() => RemoveRecipient(recipient)" Value="true">@recipient.Recipient</MudCheckBox>
                }
            </MudList>
            <MudTextField @bind-Value="customAddress" Label="@AddressLabel" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="fa-thin fa-plus" OnAdornmentClick="AddCustom" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Close"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm" Disabled="@(selected.Count == 0)">@Localizer["Ok"]</MudButton>
    </DialogActions>
</MudDialog>
