@inherits RemindersBase

@if(Reminders is null)
{
    return;
}

<Stack>
    @if(Reminders.Count == 0)
    {
        <StackField Label="@Localizer["NoItems", Localizer["Reminder"]]" />
    }
    else
    {
        <StackSort Methods="SortMethods" />
        @foreach(var reminder in Reminders)
        {
            <StackButton OnClick="() => OnClicked(reminder)"
                         Label="@reminder.Subject"
                         HighlightString="@SearchString">
                @UserIdToName(reminder.RecipientUserId)
            </StackButton>
        }
    }
</Stack>
