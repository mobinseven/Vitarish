@inherits CommerceComponentBase

<MudText Typo="Typo.h5">Cart</MudText>

@if (_cart is null)
{
    <MudText Typo="Typo.body2">Your cart is empty.</MudText>
}
else
{
    <MudText Typo="Typo.body2">Cart ready for checkout.</MudText>
}

@code {
    private CartReadDto? _cart;

    protected override async Task OnInitializedAsync()
    {
        // Cart loading will be handled through CommerceClient when cart retrieval is implemented.
    }
}
