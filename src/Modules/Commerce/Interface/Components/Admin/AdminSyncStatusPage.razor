@inherits CommerceComponentBase

<MudText Typo="Typo.h4">Commerce Sync Status</MudText>

<MudStack Row Spacing="2" Class="mt-4">
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="TriggerCatalogSync">
        Sync Catalog Now
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="TriggerOrderSync">
        Sync Orders Now
    </MudButton>
</MudStack>

@code {
    private async Task TriggerCatalogSync() => _ = await CommerceClient.TriggerCatalogSyncAsync(ComponentCancellationToken);
    private async Task TriggerOrderSync() => _ = await CommerceClient.TriggerOrderSyncAsync(ComponentCancellationToken);
}
