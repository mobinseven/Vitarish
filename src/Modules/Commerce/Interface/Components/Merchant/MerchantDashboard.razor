@inherits CommerceComponentBase

<MudText Typo="Typo.h4">Commerce Operations</MudText>

<Stack>
    <StackCard Caption="Orders" Label="@_orderCount.ToString()" HelperText="orders total" />
    <StackCard Caption="Pending Fulfillment" Label="@_pendingFulfillment.ToString()" HelperText="orders" />
    <StackCard Caption="Sales (Today)" Label="@_todaySales.ToString("0.##")" />
    <StackCard Caption="Abandoned Carts (Registered)" Label="@_recoveryQueueCount.ToString()" HelperText="pending" />
</Stack>

<Stack>
    <StackField Label="Quick Actions" />
    <StackButton Color="Color.Primary" Href="@OrdersHref" Label="Orders" EndIcon="fa-solid fa-receipt" />
    <StackButton Color="Color.Primary" Href="@ProductsHref" Label="Products" EndIcon="fa-solid fa-box" />
    <StackButton Color="Color.Primary" Href="@RecoveryHref" Label="Recovery Queue" EndIcon="fa-solid fa-cart-shopping" />
    <StackButton Color="Color.Primary" Href="@SettingsHref" Label="Settings" EndIcon="fa-solid fa-gear" />
    <StackField Label="Sales (7d)" HelperText="@_weekSales.ToString("0.##")" />
    <StackField Label="Products" HelperText="@_productCount.ToString()" />
</Stack>

@code {
    [Parameter] public string OrdersHref { get; set; } = string.Empty;
    [Parameter] public string ProductsHref { get; set; } = string.Empty;
    [Parameter] public string RecoveryHref { get; set; } = string.Empty;
    [Parameter] public string SettingsHref { get; set; } = string.Empty;

    private int _orderCount;
    private int _productCount;
    private int _pendingFulfillment;
    private int _recoveryQueueCount;
    private decimal _todaySales;
    private decimal _weekSales;

    protected override async Task OnInitializedAsync()
    {
        _orderCount = await CommerceClient.CountAsync(new OrderDescriptorDto(), ComponentCancellationToken)
            .GetValueOrDefaultAsync();
        _productCount = await CommerceClient.CountAsync(new ProductDescriptorDto(), ComponentCancellationToken)
            .GetValueOrDefaultAsync();
        _recoveryQueueCount = await CommerceClient.CountRecoveryQueueAsync(ComponentCancellationToken);

        IReadOnlyList<OrderReadDto> pending = await CommerceClient.GetListAsync(
            new OrderDescriptorDto { Status = OrderStatus.Pending },
            ComponentCancellationToken).GetValueOrDefaultAsync() ?? [];
        _pendingFulfillment = pending.Count(order => order.FulfillmentStatus != FulfillmentStatus.Fulfilled);

        DateTime now = DateTime.UtcNow;
        DateTime dayStart = DateTime.SpecifyKind(now.Date, DateTimeKind.Utc);
        DateTime weekStart = DateTime.SpecifyKind(now.Date.AddDays(-7), DateTimeKind.Utc);

        IReadOnlyList<OrderReadDto> todayOrders = await CommerceClient.GetListAsync(
            new OrderDescriptorDto { CreatedFrom = dayStart },
            ComponentCancellationToken).GetValueOrDefaultAsync() ?? [];
        _todaySales = todayOrders.Sum(order => order.TotalAmount);

        IReadOnlyList<OrderReadDto> weekOrders = await CommerceClient.GetListAsync(
            new OrderDescriptorDto { CreatedFrom = weekStart },
            ComponentCancellationToken).GetValueOrDefaultAsync() ?? [];
        _weekSales = weekOrders.Sum(order => order.TotalAmount);
    }
}
