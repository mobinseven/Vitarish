@inherits CommerceComponentBase

<MudText Typo="Typo.h4">Orders</MudText>

<Stack>
    <StackExpandable Label="Filters" StartIcon="fa-solid fa-sliders">
        <StackTextField Label="Order Number" @bind-Value="_orderNumberFilter" InputType="InputType.Number" />
        <StackTextField Label="Customer" @bind-Value="_customerFilter" />
        <StackSelect T="OrderStatus?" Label="Status" @bind-Value="_statusFilter">
            <StackSelectItem T="OrderStatus?" Value="@((OrderStatus?)null)">All</StackSelectItem>
            @foreach (OrderStatus status in Enum.GetValues<OrderStatus>())
            {
                <StackSelectItem T="OrderStatus?" Value="@status">@status</StackSelectItem>
            }
        </StackSelect>
        <StackDatePicker Label="From" @bind-Date="_fromDate" />
        <StackDatePicker Label="To" @bind-Date="_toDate" />
        <StackButton Color="Color.Primary" EndIcon="fa-solid fa-filter" OnClick="LoadOrdersAsync" Label="Apply Filters" />
        <StackButton EndIcon="fa-solid fa-rotate-left" OnClick="ClearFiltersAsync" Label="Reset" />
    </StackExpandable>
</Stack>

@if (_orders is null)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <Stack>
        <StackField Label="Orders" HelperText="@($"{_orders.Count} orders found")" />
        @foreach (OrderReadDto order in _orders)
        {
            <StackExpandable Label="@($"#{order.OrderNumber} · {order.CustomerDisplay}")" StartIcon="fa-solid fa-receipt">
                <StackField Label="Status">
                    <MudChip T="string" Size="Size.Small">@order.Status</MudChip>
                </StackField>
                <StackField Label="Fulfillment">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@order.FulfillmentStatus</MudChip>
                </StackField>
                <StackField Label="Total" HelperText="@($"{order.TotalAmount} {order.CurrencyCode.ToUpperInvariant()}")" />
                <StackField Label="Date" HelperText="@order.CreatedAt.ToString("yyyy-MM-dd")" />
                @if (order.RefundStatus == RefundStatus.None)
                {
                    <StackButton Color="Color.Secondary" EndIcon="fa-solid fa-rotate-left" OnClick="() => RequestRefundAsync(order.Id)" Label="Request Refund" />
                }
                else
                {
                    <StackField Label="Refund">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@order.RefundStatus</MudChip>
                    </StackField>
                }
            </StackExpandable>
        }
        @if (_orders.Count == 0)
        {
            <StackField Label="No orders found" />
        }
    </Stack>
}

@code {
    private IReadOnlyList<OrderReadDto>? _orders;
    private string _orderNumberFilter = string.Empty;
    private string _customerFilter = string.Empty;
    private OrderStatus? _statusFilter;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        OrderDescriptorDto descriptor = new()
        {
            OrderNumber = GetOrderNumberFilter(),
            Status = _statusFilter,
            Search = string.IsNullOrWhiteSpace(_customerFilter) ? null : _customerFilter,
            CreatedFrom = _fromDate is null ? null : DateTime.SpecifyKind(_fromDate.Value.Date, DateTimeKind.Utc),
            CreatedTo = _toDate is null ? null : DateTime.SpecifyKind(_toDate.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc)
        };

        _orders = await OrderService.GetListAsync(descriptor, CancellationToken.None).GetValueOrDefaultAsync() ?? [];
    }

    private int? GetOrderNumberFilter()
    {
        if (string.IsNullOrWhiteSpace(_orderNumberFilter))
        {
            return null;
        }

        return int.TryParse(_orderNumberFilter, out int orderNumber) ? orderNumber : null;
    }

    private async Task ClearFiltersAsync()
    {
        _orderNumberFilter = string.Empty;
        _customerFilter = string.Empty;
        _statusFilter = null;
        _fromDate = null;
        _toDate = null;
        await LoadOrdersAsync();
    }

    private async Task RequestRefundAsync(Guid orderId)
    {
        _ = await OrderService.RequestRefundAsync(orderId, "Requested by merchant.", CancellationToken.None);
        await LoadOrdersAsync();
    }
}
