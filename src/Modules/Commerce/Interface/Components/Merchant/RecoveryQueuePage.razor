@inherits CommerceComponentBase

<MudText Typo="Typo.h4">Abandoned Cart Recovery (Registered Customers)</MudText>
<MudText Typo="Typo.body2">Manual follow-up only. Guest carts are excluded.</MudText>

@if (_items is null)
{
    <MudProgressCircular Indeterminate Class="mt-4" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">No registered abandoned carts are waiting for recovery.</MudAlert>
}
else
{
    <Stack>
        <StackField Label="Recovery Queue" HelperText="@($"{_items.Count} carts awaiting review")" />
        @foreach (MerchantRecoveryCartReadDto item in _items)
        {
            <StackExpandable Label="@item.CustomerDisplay" StartIcon="fa-solid fa-cart-shopping">
                <StackField Label="Contact" HelperText="@(item.HasContact ? "Available" : "Missing")" />
                <StackField Label="Estimated Value" HelperText="@item.EstimatedValue.ToString("0.##")" />
                <StackField Label="Age" HelperText="@($"{(DateTime.UtcNow - item.CreatedAt).TotalHours:0}h")" />
                <StackField Label="Last Activity" HelperText="@item.LastActivityAt?.ToString("yyyy-MM-dd HH:mm")" />
                <StackField Label="Status">
                    <MudChip T="string" Size="Size.Small">@item.RecoveryStatus</MudChip>
                </StackField>
                <StackTextField Value="@GetNote(item.CartId)"
                                ValueChanged="value => SetNote(item.CartId, value)"
                                Label="Notes"
                                Placeholder="Internal note"
                                HelperText="Save note with one of the actions or the Save button." />
                <StackButton EndIcon="fa-solid fa-save" OnClick="() => SaveNoteAsync(item.CartId)" Label="Save" />
                <StackButton EndIcon="fa-solid fa-message" OnClick="() => UpdateRecoveryAsync(item.CartId, CartRecoveryStatus.Contacted)" Label="Contacted" />
                <StackButton Color="Color.Success" EndIcon="fa-solid fa-check" OnClick="() => UpdateRecoveryAsync(item.CartId, CartRecoveryStatus.Recovered)" Label="Recovered" />
                <StackButton Color="Color.Warning" EndIcon="fa-solid fa-ban" OnClick="() => UpdateRecoveryAsync(item.CartId, CartRecoveryStatus.Ignored)" Label="Ignore" />
            </StackExpandable>
        }
    </Stack>
}

@code {
    private IReadOnlyList<MerchantRecoveryCartReadDto>? _items;
    private readonly Dictionary<Guid, string> _notes = [];

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _items = await CartService.GetRecoveryQueueAsync(CancellationToken.None);
        _notes.Clear();
        foreach (MerchantRecoveryCartReadDto item in _items)
        {
            _notes[item.CartId] = item.RecoveryNote;
        }
    }

    private string GetNote(Guid cartId) => _notes.TryGetValue(cartId, out string? note) ? note : string.Empty;

    private Task SetNote(Guid cartId, string value)
    {
        _notes[cartId] = value;
        return Task.CompletedTask;
    }

    private async Task UpdateRecoveryAsync(Guid cartId, CartRecoveryStatus status)
    {
        _ = await CartService.UpdateRecoveryAsync(cartId, status, GetNote(cartId), CancellationToken.None);
        await ReloadAsync();
    }

    private async Task SaveNoteAsync(Guid cartId)
    {
        CartRecoveryStatus status = _items?.FirstOrDefault(item => item.CartId == cartId)?.RecoveryStatus ?? CartRecoveryStatus.ContactPending;
        _ = await CartService.UpdateRecoveryAsync(cartId, status, GetNote(cartId), CancellationToken.None);
        await ReloadAsync();
    }
}
