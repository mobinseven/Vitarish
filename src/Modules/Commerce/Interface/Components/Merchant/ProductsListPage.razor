@inherits CommerceComponentBase

<MudText Typo="Typo.h4">Products</MudText>

@if (_products is null)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <Stack>
        <StackField Label="Products" HelperText="@($"{_products.Count} products found")" />
        @foreach (ProductReadDto product in _products)
        {
            <StackCard Label="@product.Title" HelperText="@product.Handle">
                <MudChip T="string" Size="Size.Small">@product.Status</MudChip>
            </StackCard>
        }
        @if (_products.Count == 0)
        {
            <StackField Label="No products found" />
        }
    </Stack>
}

@code {
    private IReadOnlyList<ProductReadDto>? _products;

    protected override async Task OnInitializedAsync()
    {
        _products = await ProductService.GetListAsync(
            new ProductDescriptorDto(),
            CancellationToken.None).GetValueOrDefaultAsync() ?? [];
    }
}
