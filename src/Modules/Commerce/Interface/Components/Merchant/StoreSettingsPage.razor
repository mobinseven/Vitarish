@inherits CommerceComponentBase

<MudText Typo="Typo.h4">Store Settings</MudText>

@if (_store is null)
{
    <Stack>
        <StackField Label="No store configured for this tenant." />
    </Stack>
}
else
{
    <Stack>
        <StackField Label="Store Name" HelperText="@_store.Name" />
        <StackField Label="Currency" HelperText="@_store.CurrencyCode" />
        <StackExpandable Label="Technical integration details" StartIcon="fa-solid fa-plug">
            <StackField Label="MedusaJS Base URL" HelperText="@_store.MedusaBaseUrl" />
        </StackExpandable>
    </Stack>
}

@code {
    private StoreReadDto? _store;

    protected override async Task OnInitializedAsync()
    {
        _store = await CommerceClient.GetStoreByTenantAsync(ComponentCancellationToken);
    }
}
