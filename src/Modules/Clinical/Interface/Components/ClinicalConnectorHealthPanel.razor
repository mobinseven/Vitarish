@inherits CommonBase

@if (_loading)
{
    <Stack>
        <StackButton Label="@Localizer["ClinicalConnectorHealth"]" Disabled="true" EndIcon="fa-regular fa-spinner" />
    </Stack>
}
else if (_report is not null)
{
    <Stack>
        <StackField Label="@_report.State.ToString()" HelperText="@Localizer["ConnectorStatus"]">
            <ConnectorHealthBadge State="@_report.State" />
        </StackField>
        <StackField Label="@(_report.Endpoint.Length == 0 ? Localizer["NotConfigured"].Value : _report.Endpoint)" HelperText="@Localizer["Endpoint"]" />
        <StackField Label="@_report.CheckedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")" HelperText="@Localizer["LastChecked"]" />
        @if (!string.IsNullOrWhiteSpace(_report.FhirVersion))
        {
            <StackField Label="@_report.FhirVersion" HelperText="@Localizer["FhirVersion"]" />
        }
        <StackField Label="@FormatSoftware(_report)" HelperText="@Localizer["Software"]" />
        <StackField Label="@FormatResources(_report.SupportedResourceTypes)" HelperText="@Localizer["SupportedResourceTypes"]" />
        @if (!string.IsNullOrWhiteSpace(_report.FailureMessage))
        {
            <StackField Label="@_report.FailureMessage" HelperText="@Localizer["Error"]" Color="Color.Error" />
        }
        <StackButton Label="@Localizer["Refresh"]" EndIcon="fa-regular fa-rotate-right" OnClick="ReloadRequired" />
    </Stack>
}
