@inherits CommonBase

<MudDialog>
    <DialogContent>
        <Stack>
            <MudNumericField @bind-Value="_systolicBp" Label="@Localizer["SystolicBp"]" Adornment="Adornment.End" AdornmentText="mmHg" />
            <MudNumericField @bind-Value="_diastolicBp" Label="@Localizer["DiastolicBp"]" Adornment="Adornment.End" AdornmentText="mmHg" />
            <MudNumericField @bind-Value="_pulseRate" Label="@Localizer["PulseRate"]" Adornment="Adornment.End" AdornmentText="/min" />
            <MudNumericField @bind-Value="_temperature" Label="@Localizer["Temperature"]" Adornment="Adornment.End" AdornmentText="°C" />
            <MudNumericField @bind-Value="_weightKg" Label="@Localizer["WeightKg"]" Adornment="Adornment.End" AdornmentText="kg" />
            <MudNumericField @bind-Value="_heightCm" Label="@Localizer["HeightCm"]" Adornment="Adornment.End" AdornmentText="cm" />
            <MudNumericField @bind-Value="_spo2" Label="@Localizer["SpO2"]" Adornment="Adornment.End" AdornmentText="%" />
            <MudNumericField @bind-Value="_respRate" Label="@Localizer["RespiratoryRate"]" Adornment="Adornment.End" AdornmentText="/min" />
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <StackField Label="@_errorMessage" HelperText="@Localizer["Error"]" Color="Color.Error" />
            }
        </Stack>
    </DialogContent>
    <DialogActions>
        <Stack>
            <StackButton Color="Color.Primary"
                         Label="@Localizer["Save"]"
                         EndIcon="fa-regular fa-heart-pulse"
                         Disabled="@_saving"
                         OnClick="SaveAsync" />
            <StackButton Label="@Localizer["Cancel"]"
                         EndIcon="fa-regular fa-xmark"
                         OnClick="Cancel" />
        </Stack>
    </DialogActions>
</MudDialog>
