@inherits CommonBase

<Stack>
    <StackExpandable Label="@Localizer["Filters"]" StartIcon="fa-regular fa-sliders">
        <StackTextField Label="@Localizer["LocalEntityType"]"
                        Value="@_localEntityType"
                        ValueChanged="@(v => { _localEntityType = v; })" />
        <StackTextField Label="@Localizer["LocalEntityId"]"
                        Value="@_localEntityIdText"
                        ValueChanged="@(v => { _localEntityIdText = v; })" />
        <StackTextField Label="@Localizer["Search"]"
                        Value="@_searchText"
                        ValueChanged="@(v => { _searchText = v; })" />
        <StackCheckbox Label="@Localizer["IncludeArchived"]"
                       Value="@_includeArchived"
                       ValueChanged="@(v => { _includeArchived = v; })" />
        <StackButton Label="@Localizer["ApplyFilters"]"
                     EndIcon="fa-regular fa-magnifying-glass"
                     OnClick="LoadLinksAsync" />
    </StackExpandable>
    <StackButton Label="@Localizer["AddLink"]"
                 EndIcon="fa-regular fa-link"
                 Color="Color.Primary"
                 OnClick="OpenLinkDialogAsync" />
</Stack>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <Stack>
        <StackField Label="@_errorMessage" HelperText="@Localizer["Error"]" Color="Color.Error" />
    </Stack>
}

<Stack>
    @if (_loading)
    {
        <StackButton Label="@Localizer["ResourceLinks"]" Disabled="true" EndIcon="fa-regular fa-spinner" />
    }
    else if (_links.Count == 0)
    {
        <StackButton Label="@Localizer["NoResourceLinksFound"]"
                     EndIcon="fa-regular fa-rotate-right"
                     OnClick="ReloadRequired" />
    }
    else
    {
        @foreach (ResourceLinkReadDto link in _links)
        {
            <StackButton Label="@($"{link.ResourceType}/{link.ResourceId}")"
                         HelperText="@($"{link.LocalEntityType} · {link.CreatedAt.ToLocalTime():yyyy-MM-dd HH:mm}")"
                         OnClick="@(() => OpenLinkDetailAsync(link))">
                <MudChip T="string"
                         Color="@(link.IsArchived ? Color.Default : Color.Success)"
                         Size="Size.Small"
                         Variant="Variant.Filled">
                    @(link.IsArchived ? Localizer["Archived"] : Localizer["Active"])
                </MudChip>
            </StackButton>
        }
    }
</Stack>
