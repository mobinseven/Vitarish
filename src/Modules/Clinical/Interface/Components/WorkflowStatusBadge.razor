@inherits CommonBase

<MudChip T="string" Color="@StatusColor" Size="Size.Small" Variant="Variant.Filled">
    @Status.ToString()
</MudChip>

@code {
    [Parameter, EditorRequired] public VisitWorkflowStatus Status { get; set; }

    private Color StatusColor => Status switch
    {
        VisitWorkflowStatus.Draft => Color.Default,
        VisitWorkflowStatus.CheckedIn => Color.Info,
        VisitWorkflowStatus.InTriage => Color.Warning,
        VisitWorkflowStatus.ReadyForProvider => Color.Primary,
        VisitWorkflowStatus.InProgress => Color.Tertiary,
        VisitWorkflowStatus.Signed => Color.Success,
        VisitWorkflowStatus.Completed => Color.Success,
        VisitWorkflowStatus.Cancelled => Color.Error,
        _ => Color.Default
    };
}
