@inherits CommonBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackButton Label="@Localizer["CompleteVisitConfirmation"]" Disabled="true" />
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <StackField Label="@_errorMessage" HelperText="@Localizer["Error"]" Color="Color.Error" />
            }
        </Stack>
    </DialogContent>
    <DialogActions>
        <Stack>
            <StackButton Color="Color.Success"
                         Label="@Localizer["CompleteVisit"]"
                         EndIcon="fa-regular fa-circle-check"
                         Disabled="@_saving"
                         OnClick="CompleteAsync" />
            <StackButton Label="@Localizer["Cancel"]"
                         EndIcon="fa-regular fa-xmark"
                         OnClick="Cancel" />
        </Stack>
    </DialogActions>
</MudDialog>
