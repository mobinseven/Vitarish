@inherits CommonBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackButton Label="@($"{Localizer["NoteReference"]}: {NoteDocumentRef}")" Disabled="true" />
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <StackField Label="@_errorMessage" HelperText="@Localizer["Error"]" Color="Color.Error" />
            }
        </Stack>
    </DialogContent>
    <DialogActions>
        <Stack>
            <StackButton Color="Color.Primary"
                         Label="@Localizer["SignNote"]"
                         EndIcon="fa-regular fa-signature"
                         Disabled="@_saving"
                         OnClick="SignAsync" />
            <StackButton Label="@Localizer["Cancel"]"
                         EndIcon="fa-regular fa-xmark"
                         OnClick="Cancel" />
        </Stack>
    </DialogActions>
</MudDialog>
