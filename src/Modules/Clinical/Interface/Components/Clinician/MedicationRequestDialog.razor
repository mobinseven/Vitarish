@inherits CommonBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackTextField Label="@Localizer["MedicationCode"]" @bind-Value="_medicationCode" Required="true" />
            <StackTextField Label="@Localizer["MedicationCodeSystem"]" @bind-Value="_medicationCodeSystem" Required="true" />
            <StackTextField Label="@Localizer["MedicationDisplay"]" @bind-Value="_medicationDisplay" />
            <StackTextField Label="@Localizer["DosageInstruction"]" @bind-Value="_dosageInstruction" />
            <StackTextField Label="@Localizer["Notes"]" @bind-Value="_notes" />
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <StackField Label="@_errorMessage" HelperText="@Localizer["Error"]" Color="Color.Error" />
            }
        </Stack>
    </DialogContent>
    <DialogActions>
        <Stack>
            <StackButton Color="Color.Primary"
                         Label="@Localizer["AddMedication"]"
                         EndIcon="fa-regular fa-pills"
                         Disabled="@_saving"
                         OnClick="SaveAsync" />
            <StackButton Label="@Localizer["Cancel"]"
                         EndIcon="fa-regular fa-xmark"
                         OnClick="Cancel" />
        </Stack>
    </DialogActions>
</MudDialog>
