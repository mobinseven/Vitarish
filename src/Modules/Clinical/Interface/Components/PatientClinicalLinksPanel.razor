@inherits CommonBase
@using Vitarish.Clinical.Interface.Components

@if (!_loaded)
{
    <Stack>
        <StackButton Label="@Localizer["FhirResources"]" Disabled="true" EndIcon="fa-regular fa-spinner" />
    </Stack>
}
else if (_hasLinks || IsAdmin)
{
    <Stack>
        @if (IsAdmin)
        {
            <StackButton Label="@Localizer["LinkResource"]"
                         EndIcon="fa-regular fa-link"
                         OnClick="OpenLinkDialogAsync" />
        }
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <StackField Label="@_errorMessage" HelperText="@Localizer["Error"]" Color="Color.Error" />
        }
        @if (_links.Count == 0)
        {
            <StackField Label="@Localizer["NoFhirResourcesLinked"]" />
        }
        else
        {
            @foreach (ResourceLinkReadDto link in _links)
            {
                <StackField Label="@($"{link.ResourceType}/{link.ResourceId}")"
                            HelperText="@(link.ResourceVersionId != null ? $"{Localizer["Version"]}: {link.ResourceVersionId}" : null)">
                    @if (IsAdmin)
                    {
                        <MudIconButton Icon="fa-regular fa-link-slash" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => UnlinkAsync(link.Id))" Title="@Localizer["Unlink"]" />
                    }
                </StackField>
            }
        }
    </Stack>
}
