@inherits CommonBase

<Stack>
    <StackExpandable Label="@Localizer["ExecuteFhirOperation"]" StartIcon="fa-regular fa-bolt">
        <StackSelect T="string?" Label="@Localizer["ResourceType"]"
                     Value="@_resourceType"
                     ValueChanged="OnResourceTypeChanged">
            @if (_configuration is not null)
            {
                @foreach (string resourceType in _configuration.AllowedResourceTypes)
                {
                    <MudSelectItem T="string?" Value="@resourceType">@resourceType</MudSelectItem>
                }
            }
        </StackSelect>
        <StackSelect T="FhirInteractionType" Label="@Localizer["Operation"]"
                     Value="@_interaction"
                     ValueChanged="OnInteractionChanged">
            @foreach (FhirInteractionType operation in Enum.GetValues<FhirInteractionType>())
            {
                <MudSelectItem T="FhirInteractionType" Value="@operation">@operation</MudSelectItem>
            }
        </StackSelect>
        <StackTextField Label="@Localizer["ResourceId"]"
                        Value="@_resourceId"
                        ValueChanged="@(v => { _resourceId = v; })" />
        <StackTextField Label="@Localizer["IdempotencyKey"]"
                        Value="@_idempotencyKey"
                        ValueChanged="@(v => { _idempotencyKey = v; })" />
        <StackTextField Label="@Localizer["Query"]"
                        Value="@_query"
                        ValueChanged="@(v => { _query = v; })" />
        <StackTextField Label="@Localizer["PayloadJson"]"
                        Lines="6"
                        AutoGrow="true"
                        Value="@_payloadJson"
                        ValueChanged="@(v => { _payloadJson = v; })" />
    </StackExpandable>
    <StackButton Color="Color.Primary"
                 Label="@Localizer["Execute"]"
                 EndIcon="fa-regular fa-play"
                 Disabled="@_running"
                 OnClick="ExecuteAsync" />
    @if (!string.IsNullOrWhiteSpace(_resultMessage))
    {
        <StackField Label="@_resultMessage" HelperText="@Localizer["Status"]">
            @if (_lastResponse is not null)
            {
                <FhirOperationStatusBadge Status="@_lastResponse.Status" />
            }
        </StackField>
    }
</Stack>

<Stack>
    <StackExpandable Label="@Localizer["Filters"]" StartIcon="fa-regular fa-sliders">
        <StackSelect T="FhirInteractionType?" Label="@Localizer["OperationFilter"]"
                     Value="@_interactionFilter"
                     ValueChanged="@(v => { _interactionFilter = v; })">
            <MudSelectItem T="FhirInteractionType?" Value="@((FhirInteractionType?)null)">@Localizer["All"]</MudSelectItem>
            @foreach (FhirInteractionType operation in Enum.GetValues<FhirInteractionType>())
            {
                <MudSelectItem T="FhirInteractionType?" Value="@operation">@operation</MudSelectItem>
            }
        </StackSelect>
        <StackSelect T="FhirOperationStatus?" Label="@Localizer["StatusFilter"]"
                     Value="@_statusFilter"
                     ValueChanged="@(v => { _statusFilter = v; })">
            <MudSelectItem T="FhirOperationStatus?" Value="@((FhirOperationStatus?)null)">@Localizer["All"]</MudSelectItem>
            @foreach (FhirOperationStatus status in Enum.GetValues<FhirOperationStatus>())
            {
                <MudSelectItem T="FhirOperationStatus?" Value="@status">@status</MudSelectItem>
            }
        </StackSelect>
        <StackTextField Label="@Localizer["Search"]"
                        Value="@_searchText"
                        ValueChanged="@(v => { _searchText = v; })" />
        <StackButton Label="@Localizer["ApplyFilters"]"
                     EndIcon="fa-regular fa-magnifying-glass"
                     OnClick="LoadOperationsAsync" />
    </StackExpandable>
</Stack>

<Stack>
    @if (_loading)
    {
        <StackButton Label="@Localizer["OperationHistory"]" Disabled="true" EndIcon="fa-regular fa-spinner" />
    }
    else if (_operations.Count == 0)
    {
        <StackButton Label="@Localizer["NoOperationsFound"]"
                     EndIcon="fa-regular fa-rotate-right"
                     OnClick="LoadOperationsAsync" />
    }
    else
    {
        @foreach (ClinicalFhirOperationRecord operation in _operations)
        {
            <StackButton Label="@FormatOperationLabel(operation)"
                         HelperText="@operation.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")"
                         OnClick="@(() => OpenOperationDetailAsync(operation))">
                <FhirOperationStatusBadge Status="@operation.Status" />
            </StackButton>
        }
    }
</Stack>
