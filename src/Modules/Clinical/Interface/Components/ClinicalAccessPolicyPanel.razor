@inherits CommonBase

@if (_loading)
{
    <Stack>
        <StackButton Label="@Localizer["ClinicalAccessPolicy"]" Disabled="true" EndIcon="fa-regular fa-spinner" />
    </Stack>
}
else if (_policy is not null)
{
    <Stack>
        <StackField Label="@(_policy.Enabled ? Localizer["Enabled"].Value : Localizer["Disabled"].Value)" HelperText="@Localizer["Status"]">
            <MudChip T="string" Color="@(_policy.Enabled ? Color.Success : Color.Default)" Size="Size.Small" Variant="Variant.Filled">
                @(_policy.Enabled ? Localizer["Enabled"] : Localizer["Disabled"])
            </MudChip>
        </StackField>
        <StackField Label="@(_policy.AllowReads ? Localizer["Yes"].Value : Localizer["No"].Value)" HelperText="@Localizer["AllowReads"]" />
        <StackField Label="@(_policy.AllowWrites ? Localizer["Yes"].Value : Localizer["No"].Value)" HelperText="@Localizer["AllowWrites"]" />
        <StackField Label="@(_policy.AllowPatientSelfAccess ? Localizer["Yes"].Value : Localizer["No"].Value)" HelperText="@Localizer["AllowPatientSelfAccess"]" />
        <StackField Label="@(_policy.RequireAccessReason ? Localizer["Yes"].Value : Localizer["No"].Value)" HelperText="@Localizer["RequireAccessReason"]" />
        @if (_policy.AllowedResourceTypes.Count > 0)
        {
            <StackField Label="@string.Join(", ", _policy.AllowedResourceTypes)" HelperText="@Localizer["AllowedResourceTypes"]" />
        }
        @if (_policy.AllowedRoles.Count > 0)
        {
            <StackField Label="@string.Join(", ", _policy.AllowedRoles)" HelperText="@Localizer["AllowedRoles"]" />
        }
        <StackButton Label="@Localizer["Refresh"]" EndIcon="fa-regular fa-rotate-right" OnClick="ReloadRequired" />
    </Stack>
}
