@inherits CommonBase

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (_policy is not null)
{
    <MudPaper Class="pa-4 d-flex flex-column gap-4">
        <div class="d-flex justify-space-between align-center gap-2 flex-wrap">
            <MudText Typo="Typo.h6">@Localizer["ClinicalAccessPolicy"]</MudText>
            <MudChip T="string" Color="@(_policy.Enabled ? Color.Success : Color.Default)" Variant="Variant.Filled">
                @(_policy.Enabled ? Localizer["Enabled"] : Localizer["Disabled"])
            </MudChip>
        </div>

        <MudSimpleTable Elevation="0">
            <tbody>
                <tr>
                    <td><strong>@Localizer["AllowReads"]</strong></td>
                    <td>@(_policy.AllowReads ? Localizer["Yes"] : Localizer["No"])</td>
                </tr>
                <tr>
                    <td><strong>@Localizer["AllowWrites"]</strong></td>
                    <td>@(_policy.AllowWrites ? Localizer["Yes"] : Localizer["No"])</td>
                </tr>
                <tr>
                    <td><strong>@Localizer["AllowPatientSelfAccess"]</strong></td>
                    <td>@(_policy.AllowPatientSelfAccess ? Localizer["Yes"] : Localizer["No"])</td>
                </tr>
                <tr>
                    <td><strong>@Localizer["RequireAccessReason"]</strong></td>
                    <td>@(_policy.RequireAccessReason ? Localizer["Yes"] : Localizer["No"])</td>
                </tr>
            </tbody>
        </MudSimpleTable>

        @if (_policy.AllowedResourceTypes.Count > 0)
        {
            <div>
                <MudText Typo="Typo.subtitle2" Class="mb-1">@Localizer["AllowedResourceTypes"]</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    @foreach (string resourceType in _policy.AllowedResourceTypes)
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@resourceType</MudChip>
                    }
                </MudStack>
            </div>
        }

        @if (_policy.AllowedRoles.Count > 0)
        {
            <div>
                <MudText Typo="Typo.subtitle2" Class="mb-1">@Localizer["AllowedRoles"]</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    @foreach (string role in _policy.AllowedRoles)
                    {
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">@role</MudChip>
                    }
                </MudStack>
            </div>
        }

        <Stack>
            <StackButton Label="@Localizer["Refresh"]" EndIcon="fa-regular fa-rotate-right" OnClick="ReloadRequired" />
        </Stack>
    </MudPaper>
}
