@inherits CommonBase

@if (_loading)
{
    <Stack>
        <StackButton Label="@Localizer["ClinicalTenantSettings"]" Disabled="true" EndIcon="fa-regular fa-spinner" />
    </Stack>
}
else if (_settings is not null)
{
    <Stack>
        <StackField Label="@(_settings.Enabled ? Localizer["Enabled"].Value : Localizer["Disabled"].Value)"
                    HelperText="@Localizer["TenantSettingsAreReadOnly"]">
            <MudChip T="string" Color="@(_settings.Enabled ? Color.Success : Color.Default)" Size="Size.Small" Variant="Variant.Filled">
                @(_settings.Enabled ? Localizer["Enabled"] : Localizer["Disabled"])
            </MudChip>
        </StackField>
        <StackField Label="@(_settings.EndpointOverride ?? Localizer["InheritedFromConfiguration"].Value)" HelperText="@Localizer["EndpointOverride"]" />
        @if (!string.IsNullOrWhiteSpace(_settings.Environment))
        {
            <StackField Label="@_settings.Environment" HelperText="@Localizer["Environment"]" />
        }
        @if (!string.IsNullOrWhiteSpace(_settings.Organization))
        {
            <StackField Label="@_settings.Organization" HelperText="@Localizer["Organization"]" />
        }
        @if (!string.IsNullOrWhiteSpace(_settings.Clinic))
        {
            <StackField Label="@_settings.Clinic" HelperText="@Localizer["Clinic"]" />
        }
        <StackField Label="@(_settings.RequireAccessReason ? Localizer["Yes"].Value : Localizer["No"].Value)" HelperText="@Localizer["RequireAccessReason"]" />
        @if (_settings.AllowedResourceTypes.Count > 0)
        {
            <StackField Label="@string.Join(", ", _settings.AllowedResourceTypes)" HelperText="@Localizer["AllowedResourceTypes"]" />
        }
        <StackButton Label="@Localizer["Refresh"]" EndIcon="fa-regular fa-rotate-right" OnClick="ReloadRequired" />
    </Stack>
}
