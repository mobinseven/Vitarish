@inherits CommonBase

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (_settings is not null)
{
    <MudPaper Class="pa-4 d-flex flex-column gap-4">
        <div class="d-flex justify-space-between align-center gap-2 flex-wrap">
            <MudText Typo="Typo.h6">@Localizer["ClinicalTenantSettings"]</MudText>
            <MudChip T="string" Color="@(_settings.Enabled ? Color.Success : Color.Default)" Variant="Variant.Filled">
                @(_settings.Enabled ? Localizer["Enabled"] : Localizer["Disabled"])
            </MudChip>
        </div>

        <MudSimpleTable Elevation="0">
            <tbody>
                <tr>
                    <td><strong>@Localizer["EndpointOverride"]</strong></td>
                    <td>@(_settings.EndpointOverride ?? Localizer["InheritedFromConfiguration"])</td>
                </tr>
                <tr>
                    <td><strong>@Localizer["Environment"]</strong></td>
                    <td>@(_settings.Environment ?? "—")</td>
                </tr>
                <tr>
                    <td><strong>@Localizer["Organization"]</strong></td>
                    <td>@(_settings.Organization ?? "—")</td>
                </tr>
                <tr>
                    <td><strong>@Localizer["Clinic"]</strong></td>
                    <td>@(_settings.Clinic ?? "—")</td>
                </tr>
                <tr>
                    <td><strong>@Localizer["RequireAccessReason"]</strong></td>
                    <td>@(_settings.RequireAccessReason ? Localizer["Yes"] : Localizer["No"])</td>
                </tr>
            </tbody>
        </MudSimpleTable>

        @if (_settings.AllowedResourceTypes.Count > 0)
        {
            <div>
                <MudText Typo="Typo.subtitle2" Class="mb-1">@Localizer["AllowedResourceTypes"]</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    @foreach (string resourceType in _settings.AllowedResourceTypes)
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@resourceType</MudChip>
                    }
                </MudStack>
            </div>
        }

        <MudAlert Severity="Severity.Info" Dense="true">@Localizer["TenantSettingsAreReadOnly"]</MudAlert>

        <Stack>
            <StackButton Label="@Localizer["Refresh"]" EndIcon="fa-regular fa-rotate-right" OnClick="ReloadRequired" />
        </Stack>
    </MudPaper>
}
