@inherits CommonBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackTextField Label="@Localizer["PatientReference"]" Value="@PatientFhirReference" ReadOnly="true" />
            <StackTextField Label="@Localizer["VisitType"]" @bind-Value="_visitType" Required="true" />
            <StackTextField Label="@Localizer["Location"]" @bind-Value="_locationId" />
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <StackField Label="@_errorMessage" HelperText="@Localizer["Error"]" Color="Color.Error" />
            }
        </Stack>
    </DialogContent>
    <DialogActions>
        <Stack>
            <StackButton Color="Color.Primary"
                         Label="@Localizer["CheckIn"]"
                         EndIcon="fa-regular fa-arrow-right-to-city"
                         Disabled="@_saving"
                         OnClick="CheckInAsync" />
            <StackButton Label="@Localizer["Cancel"]"
                         EndIcon="fa-regular fa-xmark"
                         OnClick="Cancel" />
        </Stack>
    </DialogActions>
</MudDialog>
