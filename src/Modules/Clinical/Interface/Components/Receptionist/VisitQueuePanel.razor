@inherits CommonBase

<Stack>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_queue.Count == 0)
    {
        <StackButton Label="@Localizer["NoCheckedInPatients"]"
                     EndIcon="fa-regular fa-rotate-right"
                     OnClick="LoadAsync" />
    }
    else
    {
        <MudList T="OperationalProjectionSummary">
            @foreach (OperationalProjectionSummary item in _queue)
            {
                <MudListItem>
                    <ChildContent>
                        <Stack Row="true">
                            <StackButton Label="@item.PatientFhirReference" OnClick="@(() => OnSelected.InvokeAsync(item))" />
                            <WorkflowStatusBadge Status="@item.Status" />
                            <StackButton Label="@item.WorkflowCreatedAt.ToLocalTime().ToString("HH:mm")" Disabled="true" />
                        </Stack>
                    </ChildContent>
                </MudListItem>
            }
        </MudList>
        <StackButton EndIcon="fa-regular fa-rotate-right"
                     Label="@Localizer["Refresh"]"
                     OnClick="LoadAsync" />
    }
</Stack>
