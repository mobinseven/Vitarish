@inherits CommonBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackTextField Label="@Localizer["FamilyName"]" @bind-Value="_familyName" Required="true" />
            <StackTextField Label="@Localizer["GivenName"]" @bind-Value="_givenName" Required="true" />
            <StackTextField Label="@Localizer["MiddleName"]" @bind-Value="_middleName" />
            <MudDatePicker @bind-Date="_birthDate" Label="@Localizer["BirthDate"]" Required="true" />
            <StackTextField Label="@Localizer["Gender"]" @bind-Value="_gender" />
            <StackTextField Label="@Localizer["Phone"]" @bind-Value="_phone" />
            <StackTextField Label="@Localizer["Email"]" @bind-Value="_email" />
            <StackTextField Label="@Localizer["AddressLine"]" @bind-Value="_addressLine" />
            <StackTextField Label="@Localizer["City"]" @bind-Value="_city" />
            <StackTextField Label="@Localizer["State"]" @bind-Value="_state" />
            <StackTextField Label="@Localizer["PostalCode"]" @bind-Value="_postalCode" />
            <StackTextField Label="@Localizer["Country"]" @bind-Value="_country" />
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <StackField Label="@_errorMessage" HelperText="@Localizer["Error"]" Color="Color.Error" />
            }
        </Stack>
    </DialogContent>
    <DialogActions>
        <Stack>
            <StackButton Color="Color.Primary"
                         Label="@Localizer["Register"]"
                         EndIcon="fa-regular fa-user-plus"
                         Disabled="@_saving"
                         OnClick="SaveAsync" />
            <StackButton Label="@Localizer["Cancel"]"
                         EndIcon="fa-regular fa-xmark"
                         OnClick="Cancel" />
        </Stack>
    </DialogActions>
</MudDialog>
