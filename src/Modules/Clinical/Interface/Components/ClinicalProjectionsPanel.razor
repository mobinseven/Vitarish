@inherits CommonBase

<Stack>
    <StackExpandable Label="@Localizer["Filters"]" StartIcon="fa-regular fa-sliders">
        <StackTextField Label="@Localizer["ResourceType"]"
                        Value="@_resourceType"
                        ValueChanged="@(v => { _resourceType = v; })" />
        <StackTextField Label="@Localizer["ResourceId"]"
                        Value="@_resourceId"
                        ValueChanged="@(v => { _resourceId = v; })" />
        <StackTextField Label="@Localizer["PatientReference"]"
                        Value="@_patientReference"
                        ValueChanged="@(v => { _patientReference = v; })" />
        <StackCheckbox Label="@Localizer["IncludeExpired"]"
                       Value="@_includeExpired"
                       ValueChanged="@(v => { _includeExpired = v; })" />
        <StackButton Label="@Localizer["ApplyFilters"]"
                     EndIcon="fa-regular fa-magnifying-glass"
                     OnClick="LoadAsync" />
    </StackExpandable>
    <StackButton Label="@Localizer["SyncResource"]"
                 EndIcon="fa-regular fa-rotate-right"
                 OnClick="OpenSyncDialogAsync" />
</Stack>

<Stack>
    @if (_loading)
    {
        <StackButton Label="@Localizer["FhirProjections"]" Disabled="true" EndIcon="fa-regular fa-spinner" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <StackField Label="@_errorMessage" HelperText="@Localizer["Error"]" Color="Color.Error" />
    }
    else if (_projections.Count == 0)
    {
        <StackButton Label="@Localizer["NoProjectionsFound"]"
                     EndIcon="fa-regular fa-rotate-right"
                     OnClick="ReloadRequired" />
    }
    else
    {
        @foreach (ProjectionReadDto proj in _projections)
        {
            <StackButton Label="@($"{proj.ResourceType}/{proj.ResourceId}")"
                         HelperText="@FormatProjectionHelperText(proj)"
                         OnClick="@(() => OpenProjectionDetailAsync(proj))">
                <SyncStateBadge State="@proj.SyncState" />
            </StackButton>
        }
    }
</Stack>
