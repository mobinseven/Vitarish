@inherits CommonBase

<Stack>
    <StackExpandable Label="@Localizer["Filters"]" StartIcon="fa-regular fa-sliders">
        <StackTextField Label="@Localizer["Category"]"
                        Value="@_category"
                        ValueChanged="@(v => { _category = v; })" />
        <StackTextField Label="@Localizer["Action"]"
                        Value="@_action"
                        ValueChanged="@(v => { _action = v; })" />
        <StackTextField Label="@Localizer["ResourceType"]"
                        Value="@_resourceType"
                        ValueChanged="@(v => { _resourceType = v; })" />
        <StackTextField Label="@Localizer["ActorId"]"
                        Value="@_actorId"
                        ValueChanged="@(v => { _actorId = v; })" />
        <StackButton Label="@Localizer["ApplyFilters"]"
                     EndIcon="fa-regular fa-magnifying-glass"
                     OnClick="LoadAsync" />
    </StackExpandable>
</Stack>

<Stack>
    @if (_loading)
    {
        <StackButton Label="@Localizer["AuditLog"]" Disabled="true" EndIcon="fa-regular fa-spinner" />
    }
    else if (_entries.Count == 0)
    {
        <StackButton Label="@Localizer["NoAuditEntriesFound"]"
                     EndIcon="fa-regular fa-rotate-right"
                     OnClick="ReloadRequired" />
    }
    else
    {
        @foreach (AuditLogReadDto entry in _entries)
        {
            <StackButton Label="@FormatEntryLabel(entry)"
                         HelperText="@FormatEntryHelperText(entry)"
                         OnClick="@(() => OpenEntryDetailAsync(entry))">
                <ClinicalOutcomeBadge Outcome="@entry.Outcome" />
            </StackButton>
        }
    }
</Stack>
