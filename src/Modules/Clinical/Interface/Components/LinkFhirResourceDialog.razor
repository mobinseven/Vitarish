@inherits CommonBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackTextField Label="@Localizer["ResourceType"]" @bind-Value="_resourceType" Required="true" />
            <StackTextField Label="@Localizer["ResourceId"]" @bind-Value="_resourceId" Required="true" />
            <StackTextField Label="@Localizer["PatientReference"]" @bind-Value="_patientReference" />
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <StackField Label="@_errorMessage" HelperText="@Localizer["Error"]" Color="Color.Error" />
            }
        </Stack>
    </DialogContent>
    <DialogActions>
        <Stack>
            <StackButton Color="Color.Primary"
                         Label="@Localizer["Save"]"
                         EndIcon="fa-regular fa-save"
                         Disabled="@_saving"
                         OnClick="SaveAsync" />
            <StackButton Label="@Localizer["Cancel"]"
                         EndIcon="fa-regular fa-xmark"
                         OnClick="Cancel" />
        </Stack>
    </DialogActions>
</MudDialog>
