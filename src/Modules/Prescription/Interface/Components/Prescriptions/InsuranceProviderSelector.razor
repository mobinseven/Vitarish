@inject IStringLocalizer Localizer

@if (IsLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (Providers.Count == 0)
{
    <MudAlert Severity="Severity.Warning">@Localizer["NoProvidersAvailable"]</MudAlert>
}
else if (Providers.Count == 1 && ShowSingleProviderAsField)
{
    <StackField Label="@Providers[0].ProviderKey" HelperText="@Localizer["SelectedProvider"]" />
}
else
{
    <MudSelect T="string"
               Label="@Label"
               Value="@SelectedProviderKey"
               ValueChanged="OnSelectedProviderKeyChanged"
               Required="@Required"
               Variant="Variant.Outlined"
               Dense="true">
        @foreach (var provider in Providers)
        {
            <MudSelectItem T="string" Value="@provider.ProviderKey">
                @provider.ProviderKey
            </MudSelectItem>
        }
    </MudSelect>
}

@code {
    [Parameter] public IReadOnlyList<AvailableProviderDto> Providers { get; set; } = [];
    [Parameter] public string? SelectedProviderKey { get; set; }
    [Parameter] public EventCallback<string> SelectedProviderKeyChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool Required { get; set; } = true;
    [Parameter] public bool ShowSingleProviderAsField { get; set; } = true;

    protected override void OnParametersSet()
    {
        Label ??= Localizer["SelectInsuranceProvider"];
    }

    private Task OnSelectedProviderKeyChanged(string providerKey)
    {
        return SelectedProviderKeyChanged.InvokeAsync(providerKey);
    }
}
