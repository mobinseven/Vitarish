@inherits PrescriptionBase

@if (Prescription is null || Prescription.Status != PrescriptionStatus.Draft)
{
    return;
}

<Stack>
    <StackField Label="@Localizer["SelectPayer"]" />

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (coverages.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">@Localizer["NoCoveragesFound"]</MudAlert>
    }
    else if (coverages.Count == 1)
    {
        @* Single coverage — show read-only with auto-selected provider *@
        <StackField Label="@coverages[0].ProviderName" HelperText="@Localizer["InsuranceProvider"]">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                @coverages[0].ProviderKey
            </MudChip>
        </StackField>
    }
    else
    {
        @* Multiple coverages — show selector *@
        <MudSelect T="string"
                   Label="@Localizer["SelectInsuranceProvider"]"
                   Value="@selectedProviderKey"
                   ValueChanged="OnProviderSelectedAsync"
                   Variant="Variant.Outlined"
                   Dense="true">
            @foreach (var coverage in coverages)
            {
                <MudSelectItem T="string" Value="@coverage.ProviderKey">
                    @coverage.ProviderName
                    @if (!string.IsNullOrEmpty(coverage.CoverageType))
                    {
                        <text> — @coverage.CoverageType</text>
                    }
                    @if (coverage.IsEligible)
                    {
                        <MudIcon Icon="fa-regular fa-shield-check" Size="Size.Small" Color="Color.Success" />
                    }
                </MudSelectItem>
            }
        </MudSelect>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
</Stack>
