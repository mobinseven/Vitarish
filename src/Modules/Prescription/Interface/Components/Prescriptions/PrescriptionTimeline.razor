@inherits PrescriptionBase

@if (Prescription is null)
{
    return;
}

<Stack>
    <StackField Label="@Localizer["Timeline"]" />

    <MudTimeline TimelinePosition="TimelinePosition.Start">
        <MudTimelineItem Color="Color.Success" Size="Size.Small">
            <ItemContent>
                <MudText Typo="Typo.body2">@Localizer["Draft"]</MudText>
                <MudText Typo="Typo.caption">@Prescription.CreatedAt.ToLocalTime().ToString("g")</MudText>
            </ItemContent>
        </MudTimelineItem>

        @if (Prescription.SubmittedAt.HasValue)
        {
            <MudTimelineItem Color="@(Prescription.Status >= PrescriptionStatus.Submitted ? Color.Success : Color.Default)" Size="Size.Small">
                <ItemContent>
                    <MudText Typo="Typo.body2">@Localizer["Submitted"]</MudText>
                    <MudText Typo="Typo.caption">@Prescription.SubmittedAt.Value.ToLocalTime().ToString("g")</MudText>
                </ItemContent>
            </MudTimelineItem>
        }

        @if (Prescription.Status is PrescriptionStatus.AcceptedByProvider)
        {
            <MudTimelineItem Color="Color.Success" Size="Size.Small">
                <ItemContent>
                    <MudText Typo="Typo.body2">@Localizer["AcceptedByProvider"]</MudText>
                </ItemContent>
            </MudTimelineItem>
        }

        @if (Prescription.Status is PrescriptionStatus.RejectedByProvider)
        {
            <MudTimelineItem Color="Color.Error" Size="Size.Small">
                <ItemContent>
                    <MudText Typo="Typo.body2">@Localizer["RejectedByProvider"]</MudText>
                </ItemContent>
            </MudTimelineItem>
        }

        @if (Prescription.Status is PrescriptionStatus.Edited)
        {
            <MudTimelineItem Color="Color.Info" Size="Size.Small">
                <ItemContent>
                    <MudText Typo="Typo.body2">@Localizer["Edited"]</MudText>
                </ItemContent>
            </MudTimelineItem>
        }

        @if (Prescription.Status is PrescriptionStatus.Cancelled)
        {
            <MudTimelineItem Color="Color.Dark" Size="Size.Small">
                <ItemContent>
                    <MudText Typo="Typo.body2">@Localizer["Cancelled"]</MudText>
                </ItemContent>
            </MudTimelineItem>
        }
    </MudTimeline>
</Stack>
