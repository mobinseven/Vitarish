@inherits PrescriptionBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackTextField @bind-Value="doctorIdText" Label="@Localizer["DoctorId"]" Required />

            <InsuranceProviderSelector Providers="providers"
                                       SelectedProviderKey="providerKey"
                                       SelectedProviderKeyChanged="OnProviderSelected"
                                       Label="@Localizer["ProviderKey"]"
                                       IsLoading="isLoadingProviders"
                                       ShowSingleProviderAsField="false" />

            <StackTextField @bind-Value="providerDoctorIdentifier" Label="@Localizer["ProviderDoctorIdentifier"]" />
            <StackTextField @bind-Value="providerUsername" Label="@Localizer["ProviderUsername"]" />
            <StackTextField @bind-Value="credentialSecretRef" Label="@Localizer["CredentialSecretRef"]"
                            HelperText="@Localizer["CredentialSecretRefHelp"]" InputType="InputType.Password" />
        </Stack>
        <Stack>
            <StackButton Color="Color.Primary" OnClick="SaveAsync" Disabled="@(!IsValid)"
                         Label="@Localizer["Save"]" EndIcon="fa-solid fa-save" />
            <StackButton OnClick="Cancel" Label="@Localizer["Cancel"]" EndIcon="fa-solid fa-xmark" Color="Color.Secondary" />
        </Stack>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid ClinicId { get; set; }

    private string doctorIdText = string.Empty;
    private string providerKey = string.Empty;
    private string? providerDoctorIdentifier;
    private string? providerUsername;
    private string? credentialSecretRef;
    private List<AvailableProviderDto> providers = [];
    private bool isLoadingProviders;

    private bool IsValid => Guid.TryParse(doctorIdText, out _)
        && !string.IsNullOrWhiteSpace(providerKey)
        && providers.Any(provider => string.Equals(provider.ProviderKey, providerKey, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        isLoadingProviders = true;

        try
        {
            providers = [.. await Mediator.Send(new GetAvailableProvidersQuery())];
            providerKey = providers.Count == 1 ? providers[0].ProviderKey : string.Empty;
        }
        finally
        {
            isLoadingProviders = false;
        }
    }

    private void OnProviderSelected(string selectedProviderKey)
    {
        providerKey = selectedProviderKey;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (!Guid.TryParse(doctorIdText, out var doctorId) || !IsValid)
            return;

        var result = await Mediator.Send(new SaveCredentialCommand
        {
            DoctorId = doctorId,
            ProviderKey = providerKey,
            ClinicId = ClinicId,
            ProviderDoctorIdentifier = providerDoctorIdentifier,
            ProviderUsername = providerUsername,
            CredentialSecretRef = credentialSecretRef
        });

        if (result.IsSuccess)
        {
            Snackbar.Add(Localizer["CredentialSaved"], Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.CredentialId));
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? Localizer["UnknownError"], Severity.Error);
        }
    }
}
