@inherits PrescriptionBase

<MudDialog>
    <TitleContent>
        @Localizer["ConfigureCredential"]
    </TitleContent>
    <DialogContent>
        <Stack>
            <MudTextField T="string" Label="@Localizer["DoctorId"]" @bind-Value="doctorIdText" Required />
            <MudTextField T="string" Label="@Localizer["InsuranceProviderId"]" @bind-Value="providerIdText" Required />
            <MudTextField T="string" Label="@Localizer["ProviderDoctorIdentifier"]" @bind-Value="providerDoctorIdentifier" />
            <MudTextField T="string" Label="@Localizer["ProviderUsername"]" @bind-Value="providerUsername" />
            <MudTextField T="string" Label="@Localizer["CredentialSecretRef"]" @bind-Value="credentialSecretRef"
                          HelperText="@Localizer["CredentialSecretRefHelp"]" InputType="InputType.Password" />
        </Stack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="@(!IsValid)">
            @Localizer["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid ClinicId { get; set; }

    private string doctorIdText = string.Empty;
    private string providerIdText = string.Empty;
    private string? providerDoctorIdentifier;
    private string? providerUsername;
    private string? credentialSecretRef;

    private bool IsValid => Guid.TryParse(doctorIdText, out _) && Guid.TryParse(providerIdText, out _);

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (!Guid.TryParse(doctorIdText, out var doctorId) || !Guid.TryParse(providerIdText, out var providerId))
            return;

        var result = await Mediator.Send(new SaveCredentialCommand
        {
            DoctorId = doctorId,
            InsuranceProviderId = providerId,
            ClinicId = ClinicId,
            ProviderDoctorIdentifier = providerDoctorIdentifier,
            ProviderUsername = providerUsername,
            CredentialSecretRef = credentialSecretRef
        });

        if (result.IsSuccess)
        {
            Snackbar.Add(Localizer["CredentialSaved"], Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.CredentialId));
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? Localizer["UnknownError"], Severity.Error);
        }
    }
}
