@inherits PrescriptionBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackField Label="@Localizer["ConfirmCancelPrescription"]" />
            <StackSelect T="string" Label="@Localizer["CancellationReason"]" @bind-Value="selectedReason">
                <StackSelectItem T="string" Value="@("DoctorRequest")">@Localizer["DoctorRequest"]</StackSelectItem>
                <StackSelectItem T="string" Value="@("PatientRequest")">@Localizer["PatientRequest"]</StackSelectItem>
                <StackSelectItem T="string" Value="@("ErrorInPrescription")">@Localizer["ErrorInPrescription"]</StackSelectItem>
                <StackSelectItem T="string" Value="@("DuplicatePrescription")">@Localizer["DuplicatePrescription"]</StackSelectItem>
                <StackSelectItem T="string" Value="@("Other")">@Localizer["Other"]</StackSelectItem>
            </StackSelect>
            <StackTextField Label="@Localizer["AdditionalNotes"]" @bind-Value="additionalNotes"
                           Lines="3" MaxLength="500" />
        </Stack>
        <Stack>
            <StackButton Color="Color.Error" OnClick="Submit"
                         Disabled="@string.IsNullOrEmpty(selectedReason)"
                         Label="@Localizer["ConfirmCancellation"]" />
            <StackButton OnClick="Cancel" Label="@Localizer["Cancel"]" EndIcon="fa-regular fa-xmark" />
        </Stack>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid PrescriptionId { get; set; }

    private string? selectedReason;
    private string? additionalNotes;

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        string reason = string.IsNullOrEmpty(additionalNotes)
            ? selectedReason!
            : $"{selectedReason}: {additionalNotes}";
        MudDialog.Close(DialogResult.Ok(reason));
    }
}
