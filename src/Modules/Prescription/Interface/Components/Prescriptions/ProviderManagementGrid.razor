@inherits PrescriptionBase

<Stack>
    <StackField Label="@Localizer["ProviderManagement"]" HelperText="@Localizer["ProviderManagementHelp"]" />
</Stack>

@if (providers is not null)
{
    @foreach (var provider in providers)
    {
        <Stack>
            <StackExpandable Label="@($"{provider.Name} ({provider.ProviderKey})")">
                <MudChip T="string" Color="@GetProviderStatusColor(provider.Status)" Size="Size.Small">@provider.Status</MudChip>
                <StackField Label="@provider.IntegrationMode.ToString()" HelperText="@Localizer["IntegrationMode"]" />
                <StackField Label="@provider.CapabilityCount.ToString()" HelperText="@Localizer["Capabilities"]" />
                @if (provider.ProviderType is not null)
                {
                    <StackField Label="@provider.ProviderType" HelperText="@Localizer["ProviderType"]" />
                }
                <StackField Label="@provider.CreatedAt.ToLocalTime().ToString("g")" HelperText="@Localizer["RegisteredAt"]" />

                <StackButton Color="Color.Info"
                             OnClick="() => TestConnectivityAsync(provider.ProviderKey)"
                             Label="@Localizer["TestConnectivity"]" />
                <StackButton Color="Color.Success"
                             OnClick="() => SetStatusAsync(provider.ProviderId, ProviderStatus.Active)"
                             Label="@Localizer["Activate"]"
                             Disabled="@(provider.Status == ProviderStatus.Active)" />
                <StackButton Color="Color.Warning"
                             OnClick="() => SetStatusAsync(provider.ProviderId, ProviderStatus.Sandbox)"
                             Label="@Localizer["Sandbox"]"
                             Disabled="@(provider.Status == ProviderStatus.Sandbox)" />
                <StackButton Color="Color.Dark"
                             OnClick="() => SetStatusAsync(provider.ProviderId, ProviderStatus.Disabled)"
                             Label="@Localizer["Disable"]"
                             Disabled="@(provider.Status == ProviderStatus.Disabled)" />
            </StackExpandable>
        </Stack>
    }

    @if (providers.Count == 0)
    {
        <Stack>
            <StackField Label="@Localizer["NoProviders"]" />
        </Stack>
    }
}
else
{
    <MudProgressLinear Indeterminate />
}

<Stack>
    <StackButton Color="Color.Primary"
                 OnClick="ShowRegistrationDialogAsync"
                 Label="@Localizer["RegisterProvider"]" />
</Stack>
