@inherits PrescriptionBase

<Stack>
    <StackField Label="@Localizer["CredentialSetup"]" HelperText="@Localizer["CredentialSetupHelp"]" />
</Stack>

@if (credentials is not null)
{
    <Stack>
        <StackField Label="@credentials.Count.ToString()" HelperText="@Localizer["TotalCredentials"]" />
    </Stack>

    @foreach (var cred in credentials)
    {
        <Stack>
            <StackExpandable Label="@($"{cred.ProviderName} — {cred.DoctorName}")">
                <MudChip T="string" Color="@GetStatusColor(cred.Status)" Size="Size.Small">@cred.Status</MudChip>
                @if (cred.ProviderDoctorIdentifier is not null)
                {
                    <StackField Label="@cred.ProviderDoctorIdentifier" HelperText="@Localizer["ProviderDoctorId"]" />
                }
                @if (cred.ProviderUsername is not null)
                {
                    <StackField Label="@cred.ProviderUsername" HelperText="@Localizer["Username"]" />
                }
                @if (cred.ExpiresAt.HasValue)
                {
                    <StackField Label="@cred.ExpiresAt.Value.ToLocalTime().ToString("g")" HelperText="@Localizer["ExpiresAt"]" />
                    @if (cred.IsExpiringSoon)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">@Localizer["ExpiringSoon"] (@cred.DaysUntilExpiry @Localizer["Days"])</MudChip>
                    }
                }

                <StackButton Color="Color.Info"
                             OnClick="() => TestCredentialAsync(cred.CredentialId)"
                             Label="@Localizer["TestCredential"]" />
                <StackButton Color="Color.Error"
                             OnClick="() => RevokeCredentialAsync(cred.CredentialId)"
                             Label="@Localizer["RevokeCredential"]" />
            </StackExpandable>
        </Stack>
    }

    @if (credentials.Count == 0)
    {
        <Stack>
            <StackField Label="@Localizer["NoCredentials"]" />
        </Stack>
    }
}
else
{
    <MudProgressLinear Indeterminate />
}

<Stack>
    <StackButton Color="Color.Primary"
                 OnClick="ShowConfigureDialogAsync"
                 Label="@Localizer["AddCredential"]" />
</Stack>
