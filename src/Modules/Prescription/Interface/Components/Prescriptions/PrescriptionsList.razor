@inherits PrescriptionBase

@if (prescriptions.Count == 0)
{
    <Stack>
        <StackButton OnClick="ReloadRequired" Label="@Localizer["NoItems", Localizer["Prescription"]]" HelperText="@Localizer["NoItemsHelp", Localizer["Prescription"]]" EndIcon="fa-regular fa-refresh">
            @Localizer["Reload"]
        </StackButton>
    </Stack>
}
else
{
    <Stack>
        @foreach (var prescription in prescriptions)
        {
            <StackExpandable OnClick="() => OnClicked.InvokeAsync(prescription.Id)"
                             Label="@FormatLabel(prescription)"
                             HighlightString="@SearchString">
                <StackField Label="@prescription.CreatedAt.ToLocalTime().ToString("g")" HelperText="@Localizer["CreatedAt"]" />
                <StackField Label="@(prescription.ItemCount.ToString())" HelperText="@Localizer["Items"]" />
                <PrescriptionStatusBadge Status="@prescription.Status" />
            </StackExpandable>
        }
    </Stack>
}

@if (AdminMode)
{
    <Stack>
        <StackButton Color="Color.Primary"
                     Label="@Localizer["AddItem", Localizer["Prescription"]]"
                     EndIcon="fa-regular fa-file-prescription"
                     OnClick="() => OnAdd.InvokeAsync()" />
    </Stack>
}
