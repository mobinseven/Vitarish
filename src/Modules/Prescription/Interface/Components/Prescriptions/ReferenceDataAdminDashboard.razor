@inherits PrescriptionBase

<Stack>
    <StackField Label="@Localizer["ProviderSyncAdmin"]" HelperText="@Localizer["ProviderSyncAdminHelp"]" />
</Stack>

@if (availableProviders is null)
{
    <MudProgressLinear Indeterminate="true" />
}

@if (availableProviders is not null)
{
    @foreach (var provider in availableProviders)
    {
        <Stack>
            <StackExpandable Label="@provider.ProviderKey">
                <StackButton Color="Color.Primary"
                             Disabled="@isSyncing"
                             OnClick="@(() => TriggerSyncAsync(provider.ProviderKey, DrugCodeSystem))"
                             Label="@Localizer["SyncDrug"]" />
                <StackButton Color="Color.Primary"
                             Disabled="@isSyncing"
                             OnClick="@(() => TriggerSyncAsync(provider.ProviderKey, ServiceCodeSystem))"
                             Label="@Localizer["SyncService"]" />
            </StackExpandable>
        </Stack>
    }
}
