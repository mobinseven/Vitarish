@inherits PrescriptionBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackAlert Severity="Severity.Warning">@Localizer["PaperFallbackExplanation"]</StackAlert>
            <StackTextField @bind-Value="reason"
                            Label="@Localizer["FallbackReason"]"
                            Required
                            Lines="3"
                            MaxLength="1024" />
            <StackTextField @bind-Value="paperTrackingNumber"
                            Label="@Localizer["PaperTrackingNumber"]"
                            HelperText="@Localizer["PaperTrackingNumberHelp"]"
                            MaxLength="256" />
            <StackButton Color="Color.Warning" Disabled="@string.IsNullOrWhiteSpace(reason)"
                         OnClick="SubmitAsync" Label="@Localizer["ConfirmPaperFallback"]" />
            <StackButton OnClick="Cancel" Label="@Localizer["Cancel"]" EndIcon="fa-regular fa-xmark" />
        </Stack>
    </DialogContent>
</MudDialog>
