@using Microsoft.JSInterop
@implements IAsyncDisposable
@namespace Vitarish.Files.Interface.Components

<div class="camera-container">
    <video @ref="_videoElement" autoplay playsinline style="width: 100%; max-width: 600px; background: black;"></video>
    <div class="controls mt-2">
        @if (!_isStreaming)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartCamera">Start Camera</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Capture">Capture Image</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="StopCamera" Class="ml-2">Stop Camera</MudButton>
        }
    </div>
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
    }
</div>

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Parameter] public string InputId { get; set; } = default!;

    private ElementReference _videoElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _cameraStream;
    private bool _isStreaming;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Vitarish.Files.Interface/Components/FileCameraImage.razor.js");
        }
    }

    private async Task StartCamera()
    {
        _error = null;
        try
        {
            if (_module != null)
            {
                _cameraStream = await _module.InvokeAsync<IJSObjectReference>("startCamera", _videoElement);
                _isStreaming = true;
            }
        }
        catch (Exception)
        {
            _error = "Could not access camera. Please ensure you have given permission.";
        }
    }

    private async Task StopCamera()
    {
        if (_module != null && _cameraStream != null)
        {
            await _module.InvokeVoidAsync("stopCamera", _videoElement, _cameraStream);
            await _cameraStream.DisposeAsync();
            _cameraStream = null;
            _isStreaming = false;
        }
    }

    private async Task Capture()
    {
        if (_module != null && !string.IsNullOrEmpty(InputId))
        {
            await using var file = await _module.InvokeAsync<IJSObjectReference>("captureImage", _videoElement);
            await using var streamTransferModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Vitarish.Files.Interface/Components/StreamTransfer.razor.js");
            await streamTransferModule.InvokeVoidAsync("addFile", InputId, file);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await StopCamera();
        if (_module != null)
        {
            await _module.DisposeAsync();
        }
    }
}
