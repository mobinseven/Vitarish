@using Microsoft.JSInterop
@implements IAsyncDisposable
@namespace Vitarish.Files.Interface.Components

<div class="camera-container">
    <video @ref="_videoElement" autoplay playsinline muted style="width: 100%; max-width: 600px; background: black;"></video>
    <div class="controls mt-2">
        @if (!_isStreaming)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartCamera">Start Camera</MudButton>
        }
        else
        {
            @if (!_isRecording)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="StartRecording">Start Recording</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="StopCamera" Class="ml-2">Stop Camera</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="StopRecording">Stop Recording (@_timer s)</MudButton>
            }
        }
    </div>
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
    }
</div>

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Parameter] public string InputId { get; set; } = default!;

    private ElementReference _videoElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _cameraStream;
    private bool _isStreaming;
    private bool _isRecording;
    private string? _error;
    private int _timer;
    private System.Threading.Timer? _uiTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Vitarish.Files.Interface/Components/FileCameraVideo.razor.js");
        }
    }

    private async Task StartCamera()
    {
        _error = null;
        try
        {
            if (_module != null)
            {
                _cameraStream = await _module.InvokeAsync<IJSObjectReference>("startCamera", _videoElement);
                _isStreaming = true;
            }
        }
        catch (Exception ex)
        {
            _error = "Could not access camera/microphone. Please ensure you have given permission.";
            Console.WriteLine(ex.Message);
        }
    }

    private async Task StopCamera()
    {
        if (_isRecording)
        {
            await StopRecording();
        }

        if (_module != null && _cameraStream != null)
        {
            await _module.InvokeVoidAsync("stopCamera", _videoElement, _cameraStream);
            await _cameraStream.DisposeAsync();
            _cameraStream = null;
            _isStreaming = false;
        }
    }

    private async Task StartRecording()
    {
        if (_module != null && _cameraStream != null)
        {
            await _module.InvokeVoidAsync("startRecording", _cameraStream);
            _isRecording = true;
            _timer = 0;
            _uiTimer = new System.Threading.Timer(_ =>
            {
                _timer++;
                InvokeAsync(StateHasChanged);
            }, null, 1000, 1000);
        }
    }

    private async Task StopRecording()
    {
        if (_module != null && _isRecording)
        {
            _uiTimer?.Dispose();
            _uiTimer = null;
            var file = await _module.InvokeAsync<IJSObjectReference>("stopRecording");
            _isRecording = false;

            if (!string.IsNullOrEmpty(InputId))
            {
                var streamTransferModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Vitarish.Files.Interface/Components/StreamTransfer.razor.js");
                await streamTransferModule.InvokeVoidAsync("addFile", InputId, file);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _uiTimer?.Dispose();
        await StopCamera();
        if (_module != null)
        {
            await _module.DisposeAsync();
        }
    }
}
