@using MudBlazor
@using Vitarish.Files.Client
@using Vitarish.Files.Contracts.Results
@using Vitarish.Modules.Base.Interface.Common


@inherits StackButton
@implements IDisposable

<StreamTransfer @ref="_streamTransferComponent"
                RenderActContent="true"
                OnFileUploaded="HandleFileUploaded"
                OnStateChange="@(async () => await InvokeAsync(StateHasChanged))">

    <ActivatorContent>
        @{
            var pendingFile = _streamTransferComponent!.PendingFiles.FirstOrDefault();
        }
        @if(pendingFile is not null)
        {
            <FileImageAvatar Src="@pendingFile.Thumbnail"
                             Size="Size.Large">
                @if(_streamTransferComponent.Transferring)
                {
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;">
                        <MudProgressCircular Max="100" Min="0" Value="@pendingFile.Progress" />
                    </div>
                }
                else
                {
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
                        <MudFab OnClick="() => RemovePendingFile(_streamTransferComponent, pendingFile)" StartIcon="fa-solid fa-xmark" Size="Size.Small" DropShadow=false />
                    </div>
                }
            </FileImageAvatar>
        }
        else if(_file is not null)
        {
            <FileImageAvatar FileInformation="_file"
                             Size="Size.Large" />
        }
        else
        {
            <MudAvatar Color="@Color"
                       Size="Size.Large">
                <MudIcon Icon="fa-solid fa-camera" />
            </MudAvatar>
        }

    </ActivatorContent>
</StreamTransfer>

@code {
    [Inject] protected IFilesClient FilesClient { get; set; } = default!;

    [Parameter] public Guid? FileId { get; set; }
    [Parameter] public EventCallback<Guid?> FileIdChanged { get; set; }

    private StreamTransfer? _streamTransferComponent;
    private readonly CancellationTokenSource _componentCancellation = new();

    private FileInformationDto? _file;

    public bool HasPendingFiles => _streamTransferComponent?.PendingFiles.Count > 0;

    public async Task Upload()
    {
        if(_streamTransferComponent is null)
        {
            return;
        }

        await _streamTransferComponent.StartTransferAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        if(FileId is not null && FileId != Guid.Empty)
        {
            _file = await GetFileInformationOrDefaultAsync(FileId.Value);
        }
    }

    private async Task<FileInformationDto?> GetFileInformationOrDefaultAsync(Guid fileId)
    {
        FilesResult<FileInformationDto> result = await FilesClient.GetFileInformationAsync(fileId, _componentCancellation.Token);
        return result.Succeeded ? result.Value : null;
    }

    private async Task HandleFileUploaded(FileInformationDto file)
    {
        _file = file;
        FileId = _file.Id;
        await FileIdChanged.InvokeAsync(FileId);
        await InvokeAsync(StateHasChanged);
    }

    public new void Dispose()
    {
        _componentCancellation.Cancel();
        _componentCancellation.Dispose();
    }

    private static void RemovePendingFile(StreamTransfer transfer, PendingFileDto item) => transfer.RemovePendingFileAsync(item);

}
