@using MudBlazor
@using Vitarish.Files.Application.Abstractions
@using Vitarish.Interfaces.Base.Common
@using Vitarish.Requests.Application.Abstractions

@inherits StackButton

<StreamTransfer @ref="_streamTransferComponent"
                RenderActContent="true"
                OnFileUploaded="HandleFileUploaded"
                OnStateChange="@(async () => await InvokeAsync(StateHasChanged))">

    <ActivatorContent>
        @{
            PendingFileDto? pendingFile = _streamTransferComponent?.PendingFiles.FirstOrDefault();
            bool transferring = _streamTransferComponent?.Transferring == true;
        }

        @if(pendingFile is not null)
        {
            <MudChip T="string"
                     Text="@pendingFile.Name"
                     Icon="fa-solid fa-xmark"
                     Disabled="@transferring">
                @if(transferring)
                {
                    <MudProgressLinear Max="100" Min="0" Value="@pendingFile.Progress" />
                }
            </MudChip>
            <MudChip T="string"
                     Icon="fa-solid fa-xmark"
                     Size="@Size"
                     Color="@Color"
                     Text="@pendingFile.Name"
                     Disabled="@transferring"
                     OnClick="() => RemovePendingFileAsync(pendingFile)" />
        }
        else if(_file is not null)
        {
            <MudChip T="string"
                     Text="@_file.ContentType"
                     Icon="fa-solid fa-file"
                     Disabled="@transferring"
                     Size="@Size"
                     Color="@Color" />
        }
        else
        {
            <MudChip T="string"
                     Text="@Label"
                     Icon="fa-solid fa-file"
                     Disabled="@transferring"
                     Size="@Size"
                     Color="@Color" />
        }
    </ActivatorContent>
</StreamTransfer>

@code {
    [Inject] protected IRequestContext RequestContext { get; set; } = default!;
    [Inject] protected IFilesModule FilesModule { get; set; } = default!;
    [Inject] protected IFileInformationService FileInformationService { get; set; } = default!;

    [Parameter] public Guid? FileId { get; set; }
    [Parameter] public EventCallback<Guid?> FileIdChanged { get; set; }

    [Parameter] public FileInformationReadDto? FileInfo { get; set; }
    [Parameter] public EventCallback<FileInformationReadDto?> FileInfoChanged { get; set; }

    private StreamTransfer? _streamTransferComponent;
    private FileInformationReadDto? _file;
    private Guid? _resolvedFileId;
    private int _syncVersion;

    public bool HasPendingFiles => _streamTransferComponent?.PendingFiles.Count > 0;

    public async Task Upload()
    {
        if(_streamTransferComponent is null)
        {
            return;
        }

        await _streamTransferComponent.StartTransferAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await SynchronizeBoundValuesAsync();
    }

    private async Task SynchronizeBoundValuesAsync()
    {
        if(FileInfo is not null)
        {
            Guid? fileInfoId = NormalizeFileId(FileInfo.Id);

            _file = FileInfo;
            _resolvedFileId = fileInfoId;

            if(FileId != fileInfoId && FileIdChanged.HasDelegate)
            {
                FileId = fileInfoId;
                await FileIdChanged.InvokeAsync(fileInfoId);
            }

            return;
        }

        Guid? requestedFileId = NormalizeFileId(FileId);

        if(requestedFileId is null)
        {
            if(_file is not null || _resolvedFileId is not null)
            {
                await SetBoundFileAsync(null, notifyFileId: false, notifyFileInfo: true);
            }

            return;
        }

        if(_resolvedFileId == requestedFileId)
        {
            return;
        }

        int syncVersion = ++_syncVersion;

        FileInformationReadDto? resolvedFile = await FileInformationService
            .GetAsync(requestedFileId.Value, CancellationToken.None)
            .GetValueOrDefaultAsync();

        if(syncVersion != _syncVersion)
        {
            return;
        }

        await SetBoundFileAsync(resolvedFile, notifyFileId: false, notifyFileInfo: true);
    }

    private async Task HandleFileUploaded(FileInformationReadDto file)
    {
        await SetBoundFileAsync(file, notifyFileId: true, notifyFileInfo: true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetBoundFileAsync(
        FileInformationReadDto? file,
        bool notifyFileId,
        bool notifyFileInfo)
    {
        Guid? fileId = NormalizeFileId(file?.Id);

        _file = file;
        _resolvedFileId = fileId;
        FileId = fileId;
        FileInfo = file;

        if(notifyFileId && FileIdChanged.HasDelegate)
        {
            await FileIdChanged.InvokeAsync(fileId);
        }

        if(notifyFileInfo && FileInfoChanged.HasDelegate)
        {
            await FileInfoChanged.InvokeAsync(file);
        }
    }

    private async Task RemovePendingFileAsync(PendingFileDto item)
    {
        if(_streamTransferComponent is null)
        {
            return;
        }

        await _streamTransferComponent.RemovePendingFileAsync(item);
    }

    private static Guid? NormalizeFileId(Guid? fileId) => fileId is { } value && value != Guid.Empty
        ? value
        : null;
}
