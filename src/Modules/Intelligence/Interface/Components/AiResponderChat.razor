@inherits CommonBase

<CascadingValue Value="_context">
    @if(ChildContent is not null)
    {
        @ChildContent(_context)
    }
    else
    {
        <MudStack Spacing="2">
            @if(_turns.Count == 0)
            {
                @if(PlaceholderContent is null)
                {
                    <TextChip Color="Color.Info" Text="Start the conversation by sending a message." />
                }
                else
                {
                    @PlaceholderContent
                }
            }
            else
            {
                <MudStack Spacing="2">
                    @foreach(AiResponderChatTurn turn in _turns)
                    {
                        <MudStack AlignItems="AlignItems.Start" Style="width: 100%">
                            @foreach(ResponderInput textInput in turn.TextInputs)
                            {
                                if(!string.IsNullOrWhiteSpace(textInput.Text))
                                {
                                    <TextChip Color="Color.Info" Text="@textInput.Text" />
                                }
                            }

                            @foreach(ResponderInput imageInput in turn.ImageInputs)
                            {
                                if(!string.IsNullOrWhiteSpace(imageInput.ImageUrl))
                                {
                                    <ImageChip Src="@imageInput.ImageUrl" />
                                }
                            }

                            @foreach(ResponderInput fileInput in turn.FileInputs)
                            {
                                <MudChip T="string"
                                         Icon="@Icons.Material.Filled.AttachFile"
                                         Variant="ThemeService.SecondaryVariant"
                                         Color="Color.Primary">
                                    @GetFileChipText(fileInput)
                                </MudChip>
                            }
                        </MudStack>
                        <MudStack Row AlignItems="AlignItems.Start" Justify="Justify.FlexEnd" Reverse Style="width: 100%">
                            <div class="ma-1">
                                <MudFab Size=Size.Small DropShadow=false StartIcon="fa-solid fa-brain-circuit" />
                            </div>
                            <div style="width: 100%">
                                <MudStack AlignItems="AlignItems.End">
                                    @if(!string.IsNullOrWhiteSpace(turn.AssistantText))
                                    {
                                        <TextChip Text="@turn.AssistantText" Color="Color.Secondary" />
                                    }
                                    @foreach(ResponderOutput nonText in turn.NonTextOutputs)
                                    {
                                        switch(nonText.Type)
                                        {
                                            case ResponderOutputType.McpApprovalRequest:
                                                @if(!turn.Approved)
                                                {
                                                    <MudButton Variant=Variant.Filled Color=Color.Info OnClick="() => ApproveRequestAsync(turn, nonText)">@Localizer["Approve"]</MudButton>
                                                }
                                                else
                                                {
                                                    <MudButton Disabled>@Localizer["Approved"]</MudButton>
                                                }
                                                break;
                                            case ResponderOutputType.McpToolCall:
                                                <MudExpansionPanels Elevation="0" Dense>
                                                    <MudExpansionPanel Dense Text="@Localizer["Details"]">
                                                        <TextChip Text="@nonText.ToolName" />
                                                        <TextChip Text="@nonText.ToolArguments" />
                                                    </MudExpansionPanel>
                                                </MudExpansionPanels>
                                                break;
                                            case ResponderOutputType.Reasoning:
                                                break;
                                        }
                                    }

                                    @if(turn.IsStreaming)
                                    {
                                        <Chip>
                                            <span class="shimmer">@Localizer["Responding"]</span>
                                        </Chip>
                                    }
                                </MudStack>
                            </div>
                        </MudStack>
                    }
                </MudStack>
            }

            <MudPaper Style="width: 100%;" Class="@($"pa-2 sticky-bottom {InputAreaClass}")" Elevation="0">
                @InputFragment
            </MudPaper>
        </MudStack>
    }
</CascadingValue>
