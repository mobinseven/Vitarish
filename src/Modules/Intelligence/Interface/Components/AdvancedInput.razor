@inherits CommonBase

@if(IntelligenceModule.IsAvailable)
{
    <AiStreamTranscriber @ref="_transcriber"
                         Value="@_value"
                         OnChunk="OnChunk"
                         OnSupportStatusChanged="()=>StateHasChanged()"
                         OnTransciptionEnd="OnTranscriptionEnded"
                         OnRecordingStateChanged="OnRecordingChanged"
                         OnTranscribingStateChanged="OnTranscribingChanged" />

    <AiStreamRewriter @ref="_rewriter"
                      Value="@_value"
                      ValueChanged="OnRewriteValueChanged"
                      OnRewriteStarted="OnRewriteStarted"
                      OnRewriteCompleted="OnRewriteCompleted"
                      OnRewriteError="OnRewriteError" />
}
@if(FileUploadEnabled)
{
    <StreamTransfer @ref="_streamTransferComponent"
                    OnFileUploaded="HandleFileUploaded"
                    OnStateChange="()=>StateHasChanged()">
        <ActivatorContent>
            <MudIconButton Icon="fa-solid fa-photo-film"
                           HtmlTag="div"
                           Disabled=@(_busy || !FilesModule.IsAvailable)
                           Size="Size.Small"
                           Color="Color.Primary"
                           DropShadow=false />
        </ActivatorContent>
    </StreamTransfer>
}

<MudField Style="width: 100%; position: relative;" Underline=false Variant="Variant.Text">
    @if(_streamTransferComponent is not null && fileAttachmentMode)
    {
        <MudField Underline=false>
            @foreach(var item in _streamTransferComponent!.PendingFiles)
            {
                <Chip Class="glass" Style="@($"white-space: pre-wrap;height:auto; overflow: auto; background-image: url('{item.Thumbnail}'); background-size: cover;")">
                    <MudImage Src="@item.Thumbnail" Style="opacity:0; height: 100px;" />
                    @if(_streamTransferComponent.Transferring)
                    {
                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;">
                            <MudProgressCircular Max="100" Min="0" Value="@item.Progress" />
                        </div>
                    }
                    else
                    {
                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
                            <MudFab OnClick="() => RemovePendingFile(_streamTransferComponent, item)" StartIcon="fa-solid fa-xmark" Size="Size.Small" DropShadow=false />
                        </div>
                    }
                </Chip>
            }
        </MudField>
    }

    @if(Busy)
    {
        @if(BusyContent is not null)
        {
            @BusyContent
        }
        else
        {
            <ShimmeringText Text="@Localizer["Thinking"]" />
        }
    }
    else
    {

        <MudTextField T="string"
                      @ref="_textInput"
                      Value="@_value"
                      Placeholder="@Localizer["TypeHere"]"
                      ValueChanged="(v) => UpdateValueAsync(v)"
                      Variant="Variant.Text"
                      Lines="@Lines"
                      Underline="false"
                      Immediate />
    }

    <MudStack Row Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Style="width: 100%; pointer-events: none;"
              Spacing="0">
        <MudStack Row Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="1" Style="pointer-events: auto;">
            @if(_streamTransferComponent is not null)
            {
                @_streamTransferComponent.ActContent
            }
            @if(EndContent is not null)
            {
                <div>
                    @EndContent
                </div>
            }
        </MudStack>
        <MudStack Row Justify="Justify.FlexStart" AlignItems="AlignItems.Center" Spacing="0" Style="pointer-events: auto;">
            @if(_streamTransferComponent is not null && _streamTransferComponent!.Transferring)
            {
                <div>
                    <MudFab StartIcon="fa-solid fa-circle-notch fa-spin"
                            Disabled
                            Size="Size.Small"
                            Color="Color.Primary"
                            DropShadow=false />
                </div>
            }
            else
            {
                @if(DisplaySubmit)
                {
                    <div>
                        <MudFab StartIcon="@(Busy ? "fa-solid fa-circle-notch fa-spin" : "fa-solid fa-arrow-up")"
                                Disabled="@(Busy || string.IsNullOrWhiteSpace(_value))"
                                OnClick="SubmitAsync"
                                Size="Size.Small"
                                Color="Color.Primary"
                                DropShadow=false />
                    </div>
                }
                @if(StartContent is not null)
                {
                    <div>
                        @StartContent
                    </div>
                }
                @if(IntelligenceModule.IsAvailable)
                {
                    @if(RewriteEnabled)
                    {
                        <div>
                            <MudIconButton Size="Size.Small"
                                           DropShadow=false
                                           Color="Color.Primary"
                                           Icon="@(_rewriting ? "fa-solid fa-wand-sparkles fa-fade" : "fa-solid fa-wand-sparkles")"
                                           Disabled=@(_rewriting || _recording || _transcribing || _transferring || _value.Length < MinStringLengthToRewrite)
                                           OnClick="RewriteAsync" />
                        </div>
                    }
                    @if(_transcriber?.Supported ?? false)
                    {
                        <div>
                            <MudIconButton Size="Size.Small"
                                           DropShadow=false
                                           Color="@(_recording  || _transcribing ? Color.Error : Color.Primary)"
                                           Icon="@(_recording ? "fa-duotone fa-solid fa-microphone fa-fade" : _transcribing ? "fa-duotone fa-solid fa-waveform-lines fa-fade" : "fa-solid fa-microphone")"
                                           Disabled=@(_transcribing || _rewriting || _transferring)
                                           OnClick="ToggleRecordingAsync" />
                        </div>
                    }
                }
            }
        </MudStack>
    </MudStack>
</MudField>
