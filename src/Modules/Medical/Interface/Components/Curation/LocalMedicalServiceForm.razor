@inherits MedicalBase

<Stack>
    <StackTextField @bind-Value="writeDto.Name" Label="@Localizer["Name"]" />
    <StackTextField @bind-Value="writeDto.Category" Label="@Localizer["Category"]" />
    <StackTextField @bind-Value="writeDto.Specialty" Label="@Localizer["Specialty"]" />
    <StackTextField @bind-Value="writeDto.Description" Label="@Localizer["Description"]" />
    <StackDatePicker @bind-DateOnlyValue="writeDto.EffectiveFrom" Label="@Localizer["EffectiveFrom"]" />
    <StackDatePicker @bind-DateOnlyValue="writeDto.EffectiveTo" Label="@Localizer["EffectiveTo"]" />
</Stack>
<Stack>
    @if (Service is not null && Service.RecordOrigin == RecordOrigin.Local)
    {
        <StackButton Label="@Localizer["RetireItem", Localizer["MedicalService"]]"
                     Color="Color.Error"
                     EndIcon="fa-solid fa-ban"
                     OnClick="RetireAsync" />
    }
    <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" EndIcon="fa-solid fa-save" />
    <StackButton Label="@Localizer["Cancel"]" OnClick="() => OnCancelled.InvokeAsync()" EndIcon="fa-solid fa-xmark" />
</Stack>
