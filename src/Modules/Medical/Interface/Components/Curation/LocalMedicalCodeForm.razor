@inherits MedicalBase

<Stack>
    <StackSelect T="Guid" Label="@Localizer["CodeSystemRelease"]" @bind-Value="writeDto.CodeSystemReleaseId">
        @foreach (var r in releases)
        {
            <MudSelectItem T="Guid" Value="r.Id">@r.ReleaseName</MudSelectItem>
        }
    </StackSelect>
    <StackTextField @bind-Value="writeDto.Code" Label="@Localizer["Code"]" />
    <StackTextField @bind-Value="writeDto.DisplayName" Label="@Localizer["DisplayName"]" />
    <StackTextField @bind-Value="writeDto.LongDescription" Label="@Localizer["LongDescription"]" />
    <StackDatePicker @bind-DateOnlyValue="writeDto.EffectiveFrom" Label="@Localizer["EffectiveFrom"]" />
    <StackDatePicker @bind-DateOnlyValue="writeDto.EffectiveTo" Label="@Localizer["EffectiveTo"]" />
</Stack>
<Stack>
    <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" EndIcon="fa-regular fa-save" />
    <StackButton Label="@Localizer["Cancel"]" OnClick="() => OnCancelled.InvokeAsync()" EndIcon="fa-regular fa-xmark" />
</Stack>
