@inherits MedicalBase

<Stack>
    <StackSelect T="string" Label="@Localizer["SourceCodeSystem"]" @bind-Value="sourceSystemKey">
        @foreach (var cs in codeSystems)
        {
            <StackSelectItem T="string" Value="cs.SystemKey">@cs.Name (@cs.SystemKey)</StackSelectItem>
        }
    </StackSelect>
    <StackTextField @bind-Value="sourceCodeText" Label="@Localizer["SourceCode"]" />
    <StackButton Label="@Localizer["FindSourceCode"]" OnClick="FindSourceCodeAsync"
                 Color="Color.Default" EndIcon="fa-solid fa-magnifying-glass" />

    @if (sourceCode is not null)
    {
        <StackField Label="@sourceCode.DisplayName" HelperText="@Localizer["SourceCode"]" />
    }

    <StackSelect T="string" Label="@Localizer["TargetCodeSystem"]" @bind-Value="targetSystemKey">
        @foreach (var cs in codeSystems)
        {
            <StackSelectItem T="string" Value="cs.SystemKey">@cs.Name (@cs.SystemKey)</StackSelectItem>
        }
    </StackSelect>
    <StackTextField @bind-Value="targetCodeText" Label="@Localizer["TargetCode"]" />
    <StackButton Label="@Localizer["FindTargetCode"]" OnClick="FindTargetCodeAsync"
                 Color="Color.Default" EndIcon="fa-solid fa-magnifying-glass" />

    @if (targetCode is not null)
    {
        <StackField Label="@targetCode.DisplayName" HelperText="@Localizer["TargetCode"]" />
    }

    <StackSelect T="MappingType" Label="@Localizer["MappingType"]" @bind-Value="mappingType">
        @foreach (var mt in Enum.GetValues<MappingType>())
        {
            <StackSelectItem T="MappingType" Value="mt">@Localizer[mt.ToString()]</StackSelectItem>
        }
    </StackSelect>
    <StackDatePicker @bind-DateOnlyValue="effectiveFrom" Label="@Localizer["EffectiveFrom"]" />
    <StackDatePicker @bind-DateOnlyValue="effectiveTo" Label="@Localizer["EffectiveTo"]" />
</Stack>
<Stack>
    <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary"
                 Disabled="@(sourceCode is null || targetCode is null)"
                 EndIcon="fa-solid fa-save" />
    <StackButton Label="@Localizer["Cancel"]" OnClick="() => OnCancelled.InvokeAsync()" EndIcon="fa-solid fa-xmark" />
</Stack>
