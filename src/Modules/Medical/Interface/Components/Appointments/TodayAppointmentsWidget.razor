@inherits Vitarish.Modules.Base.TenantCommonBase

<Stack>
    <StackField Label="@Localizer["TodayAppointments"]" />
    @foreach(var (session, reservations) in todaySessions)
    {
        <StackButton Label="@session.Title"
                     EndIcon=""
                     OnClick="@(() => OnSessionClicked.InvokeAsync(session.Id))"
                     HelperText="@($"{session.Stats.ReservationCount} {Localizer["Reservations"]}")">
            <SessionStatusBadge Status="session.Status" />
            <MudAvatarGroup Spacing="3" Max="10" Class="px-4 pb-3">
                @foreach(var reservation in reservations)
                {
                    <MudTooltip Text="@GetReservationDisplayName(reservation)" Arrow="true">
                        <MudAvatar Color="@GetAvatarColor(reservation.Status)"
                                   Style="cursor:pointer">
                            @GetInitials(GetReservationDisplayName(reservation))
                        </MudAvatar>
                    </MudTooltip>
                }
            </MudAvatarGroup>
        </StackButton>
    }
    <StackButton Label="@Localizer["Appointments"]" Color="Color.Primary" OnClick="OnSessionsClicked" />
</Stack>
