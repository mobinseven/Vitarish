@inherits Vitarish.Modules.Base.TenantCommonBase

<Stack>
    <StackField Label="@Localizer["TodayAppointments"]" />
    @foreach(var (shift, reservations) in todayShifts)
    {
        <StackButton Label="@Localizer[shift.DayOfWeek.ToString()]"
                     EndIcon=""
                     OnClick="@(() => OnShiftClicked.InvokeAsync(shift.Id))"
                     HelperText="@($"{shift.StartTime:t}-{shift.EndTime:t} · {shift.Stats.ReservationCount} {Localizer["Reservations"]}")">
            <ShiftStatusBadge Status="shift.Status" />
            <MudAvatarGroup Spacing="3" Max="10" Class="px-4 pb-3">
                @foreach(var reservation in reservations)
                {
                    <MudTooltip Text="@GetReservationDisplayName(reservation)" Arrow="true">
                        <MudAvatar Color="@GetAvatarColor(reservation.Status)"
                                   Style="cursor:pointer">
                            @GetInitials(GetReservationDisplayName(reservation))
                        </MudAvatar>
                    </MudTooltip>
                }
            </MudAvatarGroup>
        </StackButton>
    }
    <StackButton Label="@Localizer["Appointments"]" Color="Color.Primary" OnClick="OnShiftsClicked" />
</Stack>
