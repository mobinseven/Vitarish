@inherits Vitarish.Modules.Base.TenantCommonBase

<Stack>
    <StackField Label="@Localizer["TodayAppointments"]" />
    @foreach(var (session, appointments) in todaySessions)
    {
        <StackButton Label="@session.DateTime.ToString("t")"
                     EndIcon=""
                     OnClick="@(() => OnSessionClicked.InvokeAsync(session.Id))"
                     HelperText="@($"{session.Stats.ReservationCount}/{session.Capacity}")">
            <AppointmentSessionStatusBadge Status="session.Status" />
            <MudAvatarGroup Spacing="3" Max="10" Class="px-4 pb-3">
                @foreach(var appointment in appointments)
                {
                    <MudTooltip Text="@(GetUserFullNameById(appointment.UserId) ?? appointment.UserId ?? "?")" Arrow="true">
                        <MudAvatar Color="@GetAvatarColor(appointment.Status)"
                                   Style="cursor:pointer">
                            @GetInitials(GetUserFullNameById(appointment.UserId))
                        </MudAvatar>
                    </MudTooltip>
                }
            </MudAvatarGroup>
        </StackButton>
    }
    <StackButton Label="@Localizer["Appointments"]" Color="Color.Primary" OnClick="OnSessionsClicked" />
</Stack>
