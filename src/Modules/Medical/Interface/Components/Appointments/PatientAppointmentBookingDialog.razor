@inherits Vitarish.Modules.Base.TenantCommonBase

<MudDialog>
    <DialogContent>
        @if (shifts.Count == 0)
        {
            <Stack>
                <StackButton Label="@Localizer["NoItems", Localizer["AppointmentShift"]]"
                             HelperText="@Localizer["NoItemsHelp", Localizer["AppointmentShift"]]"
                             EndIcon="fa-regular fa-refresh"
                             OnClick="LoadShiftsAsync">
                    @Localizer["Reload"]
                </StackButton>
            </Stack>
        }
        else
        {
            <Stack>
                @foreach (var shift in shifts)
                {
                    bool isFull = shift.Stats.ReservationCount >= shift.TotalSeats;
                    <StackButton OnClick="@(() => ReserveAsync(shift))"
                                 Label="@Localizer[shift.DayOfWeek.ToString()]"
                                 HelperText="@($"{shift.StartTime:t}-{shift.EndTime:t} · {shift.Stats.ReservationCount}/{shift.TotalSeats}")"
                                 Disabled="@isFull">
                        <ShiftStatusBadge Status="shift.Status" />
                    </StackButton>
                }
            </Stack>
            <Stack>
                <StackCheckbox @bind-Value="createReminder"
                               Label="@Localizer["CreateReminderAfterBooking"]" />
            </Stack>
        }
    </DialogContent>
    <DialogActions>
        <Stack>
            <StackButton Label="@Localizer["Cancel"]"
                         EndIcon="fa-regular fa-xmark"
                         OnClick="Cancel" />
        </Stack>
    </DialogActions>
</MudDialog>
