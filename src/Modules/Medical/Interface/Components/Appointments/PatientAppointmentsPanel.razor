@inherits Vitarish.Modules.Base.TenantCommonBase

<Stack>
    <StackField Label="@Localizer["Appointments"]" />
    @if (AdminMode)
    {
        <StackButton Color="Color.Primary"
                     OnClick="OpenBookingDialogAsync"
                     EndIcon="fa-regular fa-calendar-plus"
                     Label="@Localizer["AddItem", Localizer["Appointment"]]" />
    }
    @if (reservations is not null && reservations.Count > 0)
    {
        @foreach (var reservation in reservations)
        {
            <StackButton OnClick="@(() => OpenDetailDialogAsync(reservation))"
                         Label="@GetReservationLabel(reservation)">
                <ReservationStatusBadge Status="reservation.Status" />
            </StackButton>
        }
    }
</Stack>

    @code {
    [Parameter, EditorRequired] public ProjectReadDto Patient { get; set; } = default!;
    [Parameter] public EventCallback OnEdit { get; set; }

    [Inject] private IAccessControlledReservationManager ReservationManager { get; set; } = default!;
    [Inject] private IAccessControlledSessionManager SessionsService { get; set; } = default!;

    private List<ReservationReadDto> reservations = [];
    private Dictionary<Guid, SessionReadDto> reservationSessions = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Prefer the linked user ID; fall back to the patient's own project ID as a stable
        // party identifier — the Appointments module treats it as an opaque string.
        string? userId = Patient.UserIds.FirstOrDefault();
        string reservingPartyId = !string.IsNullOrWhiteSpace(userId)
            ? userId
            : Patient.Id.ToString();

        ReservationDescriptorDto descriptor = new() { ReservingPartyId = reservingPartyId, Skip = 0, Take = int.MaxValue };
        IReadOnlyList<ReservationReadDto> all = await ReservationManager.GetListAsync(descriptor, CancellationToken.None).GetValueOrDefaultAsync() ?? [];
        reservationSessions = await LoadReservationSessionsAsync(all);
        reservations = [.. all.OrderBy(r => r.Date).ThenBy(r => GetSessionStartTime(r.SessionId)).ThenBy(r => GetSessionTitle(r.SessionId))];
        await InvokeAsync(StateHasChanged);
    }

    private async Task<Dictionary<Guid, SessionReadDto>> LoadReservationSessionsAsync(IReadOnlyList<ReservationReadDto> reservationItems)
    {
        Dictionary<Guid, SessionReadDto> sessionsById = [];

        foreach (Guid sessionId in reservationItems.Select(r => r.SessionId).Distinct())
        {
            SessionReadDto? session = await SessionsService.GetAsync(sessionId, CancellationToken.None).GetValueOrDefaultAsync();
            if (session is not null)
            {
                sessionsById[session.Id] = session;
            }
        }

        return sessionsById;
    }

    private string GetReservationLabel(ReservationReadDto reservation)
    {
        if (!reservationSessions.TryGetValue(reservation.SessionId, out SessionReadDto? session))
        {
            return $"{reservation.Date:d} {Localizer["SessionUnavailable"].Value}";
        }

        return $"{reservation.Date:d} {session.StartTime:t} {session.Title}";
    }

    private TimeOnly GetSessionStartTime(Guid sessionId)
        => reservationSessions.TryGetValue(sessionId, out SessionReadDto? session) ? session.StartTime : TimeOnly.MinValue;

    private string GetSessionTitle(Guid sessionId)
        => reservationSessions.TryGetValue(sessionId, out SessionReadDto? session) ? session.Title : string.Empty;

    private async Task OpenBookingDialogAsync()
    {
        DialogParameters parameters = new()
        {
            { nameof(PatientAppointmentBookingDialog.Patient), Patient }
        };

        IDialogReference dialog = await DialogService.ShowAsync<PatientAppointmentBookingDialog>(
            Localizer["AddItem", Localizer["Appointment"]], parameters);
        _ = await dialog.Result;
        await LoadAsync();
    }

    private async Task OpenDetailDialogAsync(ReservationReadDto reservation)
    {
        DialogParameters parameters = new()
        {
            { nameof(ReservationDetailDialog.Reservation), reservation }
        };

        IDialogReference dialog = await DialogService.ShowAsync<ReservationDetailDialog>(null, parameters);
        _ = await dialog.Result;
        await LoadAsync();
    }
}
