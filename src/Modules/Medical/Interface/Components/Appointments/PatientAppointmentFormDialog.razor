@inherits Vitarish.Modules.Base.TenantCommonBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackSelect T="Guid?"
                         Value="@selectedSessionId"
                         ValueChanged="@(id => SelectSession(id))"
                         Label="@Localizer["Session"]">
                @foreach (var session in availableSessions)
                {
                    int available = session.Capacity - session.ReservationCount;
                    <MudSelectItem T="Guid?" Value="@((Guid?)session.Id)">
                        @(string.IsNullOrWhiteSpace(session.Name) ? session.ScheduledAt.ToString("f") : session.Name)
                        — @session.ScheduledAt.ToString("f")
                        (@available @Localizer["Available"])
                    </MudSelectItem>
                }
            </StackSelect>
            @if (selectedSession is not null)
            {
                <StackField Label="@selectedSession.ScheduledAt.ToString("f")" HelperText="@Localizer["ScheduledAt"]" />
            }
            <StackTextField @bind-Value="notes" AutoGrow Lines=3 Label="@Localizer["Notes"]" />
        </Stack>
        <Stack>
            <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" EndIcon="fa-regular fa-save" />
            <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" EndIcon="fa-regular fa-xmark" />
        </Stack>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public Guid SubjectId { get; set; }

    [Inject] private IAccessControlledAppointmentsService AppointmentsService { get; set; } = default!;
    [Inject] private IAccessControlledSessionsService SessionsService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private List<SessionReadDto> availableSessions = [];
    private SessionReadDto? selectedSession;
    private Guid? selectedSessionId;
    private string? notes;

    protected override async Task OnInitializedAsync()
    {
        SessionDescriptorDto descriptor = new()
        {
            Status = SessionStatus.Active,
            Skip = 0,
            Take = int.MaxValue
        };

        IReadOnlyList<SessionReadDto> sessions = await SessionsService
            .GetListAsync(descriptor, CancellationToken.None)
            .GetValueOrDefaultAsync() ?? [];

        availableSessions = [.. sessions.OrderBy(s => s.ScheduledAt)];
    }

    private void SelectSession(Guid? sessionId)
    {
        selectedSessionId = sessionId;
        selectedSession = sessionId is not null
            ? availableSessions.FirstOrDefault(s => s.Id == sessionId)
            : null;
    }

    private async Task SaveAsync()
    {
        AppointmentWriteDto dto = new()
        {
            SessionId = selectedSessionId,
            Notes = notes
        };
        dto.Metadata[MetadataKeys.SubjectId] = SubjectId.ToString();

        AppointmentReadDto saved = await AppointmentsService.AddAsync(dto, CancellationToken.None).EnsureValueAsync();
        _ = Snackbar.Add(Localizer["Saved"], Severity.Success);
        MudDialog.Close(DialogResult.Ok(saved.Id));
    }

    private void Cancel() => MudDialog.Cancel();
}
