@inherits Vitarish.Modules.Base.TenantCommonBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackDatePicker @bind-Date="scheduledAtDate" Label="@Localizer["Date"]" />
            <StackTimePicker @bind-Time="scheduledAtTime" Label="@Localizer["Time"]" />
            <StackTextField @bind-Value="notes" AutoGrow Lines=3 Label="@Localizer["Notes"]" />
        </Stack>
        <Stack>
            <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" EndIcon="fa-regular fa-save" />
            <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" EndIcon="fa-regular fa-xmark" />
        </Stack>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public Guid SubjectId { get; set; }

    [Inject] private IAccessControlledAppointmentsService AppointmentsService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private DateTime? scheduledAtDate = DateTime.Now.Date;
    private TimeSpan? scheduledAtTime = DateTime.Now.ToLocalTime().TimeOfDay;
    private string? notes;

    private async Task SaveAsync()
    {
        DateTimeOffset scheduledAt = scheduledAtDate.HasValue
            ? new DateTimeOffset(scheduledAtDate.Value.Add(scheduledAtTime ?? TimeSpan.Zero), DateTimeOffset.Now.Offset)
            : DateTimeOffset.Now;

        AppointmentWriteDto dto = new()
        {
            ScheduledAt = scheduledAt,
            Notes = notes
        };
        dto.Metadata[MetadataKeys.SubjectId] = SubjectId.ToString();

        AppointmentReadDto saved = await AppointmentsService.AddAsync(dto, CancellationToken.None).EnsureValueAsync();
        _ = Snackbar.Add(Localizer["Saved"], Severity.Success);
        MudDialog.Close(DialogResult.Ok(saved.Id));
    }

    private void Cancel() => MudDialog.Cancel();
}
