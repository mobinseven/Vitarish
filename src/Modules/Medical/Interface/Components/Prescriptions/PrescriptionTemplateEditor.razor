@inherits PrescriptionBase

<Stack>
    <StackTextField @bind-Value="name" Label="@Localizer["Name"]" />
    <StackTextField @bind-Value="description" Label="@Localizer["Description"]" />
    <StackButton Color="Color.Primary"
                 Label="@Localizer["Save"]"
                 EndIcon="fa-solid fa-floppy-disk"
                 OnClick="SaveAsync"
                 Disabled="@string.IsNullOrWhiteSpace(name)" />
</Stack>

@if (template is not null)
{
    <Stack>
        <StackField Label="@template.Status.ToString()" HelperText="@Localizer["Status"]" />
        @foreach (PrescriptionTemplateItemDto item in template.Items.OrderBy(i => i.SortOrder))
        {
            <StackExpandable Label="@(item.DisplayName ?? item.ReferenceCode ?? item.Category.ToString())"
                             HelperText="@($"{item.Category} · {item.Quantity}")">
                <StackField Label="@(item.ReferenceCode ?? "—")" HelperText="@Localizer["Code"]" />
                <StackButton Color="Color.Error"
                             Label="@Localizer["Delete"]"
                             EndIcon="fa-solid fa-trash"
                             OnClick="() => RemoveItemAsync(item.Id)" />
            </StackExpandable>
        }
    </Stack>

    <Stack>
        <MudSelect T="PrescriptionItemCategory" Label="@Localizer["Category"]" @bind-Value="newItem.Category">
            @foreach (PrescriptionItemCategory category in Enum.GetValues<PrescriptionItemCategory>())
            {
                <MudSelectItem Value="@category">@category</MudSelectItem>
            }
        </MudSelect>
        <StackTextField @bind-Value="newItem.ReferenceCode" Label="@Localizer["Code"]" />
        <StackTextField @bind-Value="newItem.DisplayName" Label="@Localizer["Name"]" />
        <MudNumericField T="int" @bind-Value="newItem.Quantity" Min="1" Label="@Localizer["Quantity"]" />
        <MudNumericField T="int?" @bind-Value="newItem.DurationDays" Min="1" Label="@Localizer["DurationDays"]" />
        <StackTextField @bind-Value="newItem.DosageJson" Label="@Localizer["Dosage"]" />
        <StackButton Color="Color.Secondary"
                     Label="@Localizer["AddItem", Localizer["TemplateItem"]]"
                     EndIcon="fa-solid fa-plus"
                     OnClick="AddItemAsync" />
    </Stack>
}
