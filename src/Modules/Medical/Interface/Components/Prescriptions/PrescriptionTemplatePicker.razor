@inherits PrescriptionBase

<Stack>
    <StackSelect T="Guid?" Label="@Localizer["Templates"]" Value="selectedTemplateId" ValueChanged="OnTemplateSelectedAsync">
        @foreach (PrescriptionTemplateSummaryDto template in templates)
        {
            <StackSelectItem T="Guid?" Value="@((Guid?)template.Id)">@template.Name (@template.ItemCount)</StackSelectItem>
        }
    </StackSelect>

    @if (selectedTemplate is not null)
    {
        <StackField Label="@selectedTemplate.Name" HelperText="@selectedTemplate.Description" />
        <StackField Label="@selectedTemplate.ItemCount.ToString()" HelperText="@Localizer["Items"]" />
        <StackButton Color="Color.Secondary"
                     Label="@Localizer["Load"]"
                     EndIcon="fa-solid fa-download"
                     OnClick="LoadAsync"
                     Disabled="@(PrescriptionId == Guid.Empty || selectedTemplateId is null)" />
    }
</Stack>
