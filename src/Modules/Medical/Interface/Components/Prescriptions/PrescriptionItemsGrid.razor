@inherits PrescriptionBase

@if (Prescription is null)
{
    return;
}

<Stack>
    <StackField Label="@Localizer["PrescriptionItems"]" />

    @if (Prescription.Items.Count == 0)
    {
        <StackField Label="@Localizer["NoItems", Localizer["Item"]]" />
    }
    else
    {
        @foreach (var item in Prescription.Items.OrderBy(i => i.SortOrder))
        {
            <StackExpandable Label="@FormatItemLabel(item)"
                             Color="@CategoryColor(item.Category)">
                <StackField Label="@Localizer[item.Category.ToString()]" HelperText="@Localizer["Category"]" />
                @if (!string.IsNullOrEmpty(item.ReferenceCode))
                {
                    <StackField Label="@item.ReferenceCode" HelperText="@Localizer["Code"]" />
                }
                <StackField Label="@item.Quantity.ToString()" HelperText="@Localizer["Quantity"]" />
                @if (item.DurationDays.HasValue)
                {
                    <StackField Label="@item.DurationDays.Value.ToString()" HelperText="@Localizer["DurationDays"]" />
                }
                @if (CanEdit)
                {
                    <StackButton Color="Color.Error"
                                 Label="@Localizer["RemoveItem", Localizer["Item"]]"
                                 EndIcon="fa-solid fa-trash"
                                 OnClick="() => RemoveItemAsync(item.Id)" />
                }
            </StackExpandable>
        }
    }

    @if (CanEdit)
    {
        <StackButton Color="Color.Primary"
                     Label="@Localizer["AddItem", Localizer["Item"]]"
                     EndIcon="fa-solid fa-plus"
                     OnClick="ShowAddItemDialogAsync" />
    }
</Stack>
