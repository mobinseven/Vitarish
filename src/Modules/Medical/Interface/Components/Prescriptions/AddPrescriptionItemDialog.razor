@inherits PrescriptionBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackField Label="@Localizer["AddItem", Localizer["Item"]]" />
            <StackSelect T="PrescriptionItemCategory" @bind-Value="category" Label="@Localizer["Category"]">
                @foreach(var cat in Enum.GetValues<PrescriptionItemCategory>())
                {
                    <StackSelectItem Value="cat">@Localizer[cat.ToString()]</StackSelectItem>
                }
            </StackSelect>

            <StackTextField @bind-Value="searchTerm"
                            Label="@Localizer["SearchCode"]"
                            HelperText="@Localizer["SearchCodeHelp"]" />

            <StackButton Label="@Localizer["Search"]"
                         EndIcon="fa-solid fa-search"
                         OnClick="SearchCodesAsync" Color="Color.Secondary" />

            @if (searchResults.Count > 0)
            {
                <MudList T="string" Dense="true" Class="mt-2">
                    @foreach (var item in searchResults)
                    {
                        <MudListItem T="string" OnClick="() => SelectCode(item)">
                            <MudText Typo="Typo.body2">@item.DisplayName</MudText>
                            <MudText Typo="Typo.caption">@item.Code</MudText>
                        </MudListItem>
                    }
                </MudList>
            }

            @if (selectedCode is not null)
            {
                <StackField Label="@selectedCode.Value.DisplayName" HelperText="@selectedCode.Value.Code" />
            }

            <StackNumericField @bind-Value="quantity" Label="@Localizer["Quantity"]" Min="1" />
            <StackNumericField @bind-Value="durationDays" Label="@Localizer["DurationDays"]" Min="1" />
        </Stack>
        <Stack>
            <StackButton Color="Color.Primary" Label="@Localizer["Add"]" OnClick="AddAsync" />
            <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" Disabled="@(!CanAdd)" Color="Color.Secondary" />
        </Stack>
    </DialogContent>
</MudDialog>
