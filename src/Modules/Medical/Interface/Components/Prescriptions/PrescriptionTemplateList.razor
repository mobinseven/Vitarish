@inherits PrescriptionBase

<Stack>
    <StackButton Color="Color.Primary"
                 Label="@Localizer["AddItem", Localizer["Template"]]"
                 EndIcon="fa-solid fa-plus"
                 OnClick="() => OnCreate.InvokeAsync()" />

    <MudSwitch T="bool" Value="includeArchived" ValueChanged="OnIncludeArchivedChanged" Label="@Localizer["ShowArchived"]" Color="Color.Primary" />

    @if (!templates.Any())
    {
        <MudAlert Severity="Severity.Info">@Localizer["NoItemsHelp", Localizer["Templates"]]</MudAlert>
    }
    else
    {
        @foreach (PrescriptionTemplateSummaryDto template in templates)
        {
            <StackExpandable @key="template.Id"
                             Label="@template.Name"
                             HelperText="@TemplateSummary(template)"
                             HighlightString="@SearchString"
                             OnClick="() => OnSelected.InvokeAsync(template.Id)">
                <StackField Label="@template.Status.ToString()" HelperText="@Localizer["Status"]" />
                <StackField Label="@template.ItemCount.ToString()" HelperText="@Localizer["Items"]" />
                <StackField Label="@template.CreatedAt.ToLocalTime().ToString("g")" HelperText="@Localizer["CreatedAt"]" />
                @if (template.Status == PrescriptionTemplateStatus.Active)
                {
                    <StackButton Color="Color.Warning"
                                 Label="@Localizer["Archive"]"
                                 EndIcon="fa-solid fa-box-archive"
                                 OnClick="() => ArchiveAsync(template.Id)" />
                }
            </StackExpandable>
        }
    }
</Stack>
