@inherits MedicalBase

<Stack>
    <StackTextField @bind-Value="searchText" Label="@Localizer["SearchDrugs"]" />
    <StackButton Label="@Localizer["Search"]" OnClick="SearchAsync" Color="Color.Primary"
                 EndIcon="fa-solid fa-magnifying-glass" />
</Stack>

@if (results.Count > 0)
{
    <Stack>
        <StackField Label="@Localizer["Results"]" />
        @foreach (var drug in results)
        {
            <StackExpandable Label="@drug.PrimaryName"
                             HelperText="@drug.PrimaryIdentifierValue"
                             HighlightString="@searchText">
                <ExpandableContent>
                    <Stack>
                        <StackField Label="@drug.PrimaryName" HelperText="@Localizer["PrimaryName"]" />
                        <StackField Label="@drug.PrimaryIdentifierType.ToString()" HelperText="@Localizer["IdentifierType"]" />
                        <StackField Label="@drug.PrimaryIdentifierValue" HelperText="@Localizer["IdentifierValue"]" />
                        <StackField Label="@Localizer[drug.Status.ToString()]" HelperText="@Localizer["Status"]" />
                        <StackField Label="@Localizer[drug.RecordOrigin.ToString()]" HelperText="@Localizer["RecordOrigin"]" />
                    </Stack>
                </ExpandableContent>
            </StackExpandable>
        }
    </Stack>
}
else if (searched)
{
    <Stack>
        <StackField Label="@Localizer["NoResults"]" />
    </Stack>
}
