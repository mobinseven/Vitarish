@inherits MedicalBase

@if (codeSystem is null)
{
    return;
}

<Stack>
    <StackField Label="@codeSystem.Name" HelperText="@Localizer["Name"]" />
    <StackField Label="@codeSystem.SystemKey" HelperText="@Localizer["SystemKey"]" />
    <StackField Label="@Localizer[codeSystem.Category.ToString()]" HelperText="@Localizer["Category"]" />
    @if (!string.IsNullOrWhiteSpace(codeSystem.Authority))
    {
        <StackField Label="@codeSystem.Authority" HelperText="@Localizer["Authority"]" />
    }
    @if (!string.IsNullOrWhiteSpace(codeSystem.CanonicalUri))
    {
        <StackField Label="@codeSystem.CanonicalUri" HelperText="@Localizer["CanonicalUri"]" />
    }
    @if (!string.IsNullOrWhiteSpace(codeSystem.Description))
    {
        <StackField Label="@codeSystem.Description" HelperText="@Localizer["Description"]" />
    }
    <StackField Label="@(codeSystem.IsActive ? Localizer["Active"].Value : Localizer["Inactive"].Value)"
                HelperText="@Localizer["Status"]" />
</Stack>

<Stack>
    <StackField Label="@Localizer["Releases"]" />
    @foreach (var release in releases)
    {
        <StackExpandable Label="@release.ReleaseName"
                         HelperText="@(release.IsActive ? Localizer["Active"].Value : Localizer["Inactive"].Value)"
                         HighlightString="@SearchString">
            <ExpandableContent>
                <CodeSystemReleaseDetail Release="release"
                                         OnActivationChanged="ReloadRequired" />
            </ExpandableContent>
        </StackExpandable>
    }
    @if (AdminMode)
    {
        <StackExpandable Color="Color.Primary"
                         Label="@Localizer["AddItem", Localizer["Release"]]"
                         EndIcon="fa-regular fa-plus">
            <ExpandableContent>
                <CodeSystemReleaseForm CodeSystemId="codeSystem.Id"
                                       OnSaved="() => context.CloseAsync()"
                                       OnCancelled="() => context.CloseAsync()" />
            </ExpandableContent>
        </StackExpandable>
    }
</Stack>
