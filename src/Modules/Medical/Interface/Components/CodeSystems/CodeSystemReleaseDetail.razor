@inherits MedicalBase

@if (Release is null)
{
    return;
}

<Stack>
    <StackField Label="@Release.ReleaseName" HelperText="@Localizer["ReleaseName"]" />
    @if (Release.ReleaseDate is { } rd)
    {
        <StackField Label="@rd.ToString()" HelperText="@Localizer["ReleaseDate"]" />
    }
    @if (Release.EffectiveFrom is { } ef)
    {
        <StackField Label="@ef.ToString()" HelperText="@Localizer["EffectiveFrom"]" />
    }
    @if (Release.EffectiveTo is { } et)
    {
        <StackField Label="@et.ToString()" HelperText="@Localizer["EffectiveTo"]" />
    }
    @if (!string.IsNullOrWhiteSpace(Release.SourceVersion))
    {
        <StackField Label="@Release.SourceVersion" HelperText="@Localizer["SourceVersion"]" />
    }
    @if (!string.IsNullOrWhiteSpace(Release.SourceLocator))
    {
        <StackField Label="@Release.SourceLocator" HelperText="@Localizer["SourceLocator"]" />
    }
    <StackField Label="@(Release.IsActive ? Localizer["Active"].Value : Localizer["Inactive"].Value)"
                HelperText="@Localizer["Status"]" />
</Stack>

@if (AdminMode)
{
    <Stack>
        @if (!Release.IsActive)
        {
            <StackButton Label="@Localizer["Activate"]"
                         Color="Color.Success"
                         EndIcon="fa-solid fa-circle-check"
                         OnClick="ActivateAsync" />
        }
        else
        {
            <StackButton Label="@Localizer["Deactivate"]"
                         Color="Color.Warning"
                         EndIcon="fa-solid fa-circle-pause"
                         OnClick="DeactivateAsync" />
        }
    </Stack>
}
