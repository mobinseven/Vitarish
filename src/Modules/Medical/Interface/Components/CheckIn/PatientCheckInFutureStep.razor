@inherits Vitarish.Modules.Base.TenantCommonBase
<Stack>
    <StackField Label="@Localizer["FutureSessionTitle"]"
                HelperText="@(Context.SelectedPatient?.Name ?? string.Empty)" />
</Stack>
<Stack>

    @if (loading)
    {
        <StackField Label="@Localizer["Loading"]" AdornmentIcon="fa-regular fa-spinner" />
    }
    else if (availableSlots.Count == 0)
    {
        <StackField Label="@Localizer["NoItems", Localizer["AppointmentSession"]]"
                    HelperText="@Localizer["NoFutureSlotsHelp"]" />
    }
    else
    {
        @foreach(var slot in availableSlots)
        {
            <StackButton Label="@slot.Session.Title"
                         HelperText="@($"{slot.Occurrence.Date:d} {slot.Occurrence.StartTime:t}–{slot.Occurrence.EndTime:t} · {slot.Occurrence.AvailableSeats} {Localizer["SeatsAvailable"]}")"
                         EndIcon="fa-regular fa-calendar-plus"
                         Disabled="@booking"
                         OnClick="@(() => BookSlotAsync(slot.Session, slot.Occurrence))" />
        }
    }

    @if (!string.IsNullOrWhiteSpace(bookingError))
    {
        <StackField Label="@bookingError"
                    AdornmentIcon="fa-regular fa-circle-xmark"
                    AdornmentColor="Color.Error"
                    Color="Color.Error" />
    }
</Stack>


<Stack>
    <StackButton Label="@Localizer["Back"]"
                 EndIcon="fa-regular fa-arrow-left"
                 OnClick="OnBack" />
</Stack>

@code {
    [Parameter, EditorRequired] public PatientCheckInContext Context { get; set; } = default!;
    [Parameter] public EventCallback OnBooked { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    [Inject] private IAccessControlledSessionManager SessionsService { get; set; } = default!;
    [Inject] private IAccessControlledReservationManager ReservationManager { get; set; } = default!;
    [Inject] private ISessionBookableDateQueryService BookableDateQueryService { get; set; } = default!;

    private record FutureSlot(SessionReadDto Session, SessionReservationReadDto Occurrence);

    private List<FutureSlot> availableSlots = [];
    private bool loading;
    private bool booking;
    private string? bookingError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        await InvokeAsync(StateHasChanged);

        DateOnly today = DateOnly.FromDateTime(DateTime.UtcNow);
        DateOnly until = today.AddDays(30);

        SessionDescriptorDto sessionDescriptor = new()
        {
            Status = SessionStatus.Active,
            Skip = 0,
            Take = int.MaxValue
        };

        IReadOnlyList<SessionReadDto> sessions = await SessionsService
            .GetListAsync(sessionDescriptor, CancellationToken.None)
            .GetValueOrDefaultAsync() ?? [];

        List<FutureSlot> slots = [];

        foreach (SessionReadDto session in sessions)
        {
            SessionDateRangeQuery range = new()
            {
                DateFrom = today.AddDays(1),
                DateTo = until
            };

            IReadOnlyList<SessionReservationReadDto> bookable = await BookableDateQueryService
                .GetBookableDatesAsync(session.Id, range, CancellationToken.None);

            foreach (SessionReservationReadDto occurrence in bookable.Where(o => o.AvailableSeats > 0))
            {
                slots.Add(new FutureSlot(session, occurrence));
            }
        }

        availableSlots = [.. slots.OrderBy(s => s.Occurrence.Date).ThenBy(s => s.Occurrence.StartTime).ThenBy(s => s.Session.Title)];

        loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task BookSlotAsync(SessionReadDto session, SessionReservationReadDto occurrence)
    {
        string? patientUserId = Context.SelectedPatient?.UserIds.FirstOrDefault();
        if (string.IsNullOrWhiteSpace(patientUserId))
        {
            return;
        }

        bookingError = null;
        booking = true;
        await InvokeAsync(StateHasChanged);

        EntityResult<ReservationReadDto> result = await ReservationManager
            .ReserveAsync(session.Id, occurrence.Date, patientUserId, CancellationToken.None);

        booking = false;

        if (result.IsFailure || result.Value is null)
        {
            bookingError = result.Errors.FirstOrDefault()?.Message ?? Localizer["Error"].Value;
            await InvokeAsync(StateHasChanged);
            return;
        }

        Context.SelectedSession = session;
        Context.SelectedOccurrence = occurrence;
        Context.ConfirmedReservation = result.Value;
        Context.Outcome = CheckInOutcome.FutureSession;

        await OnBooked.InvokeAsync();
    }
}
