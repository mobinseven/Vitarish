@inherits Vitarish.Modules.Base.TenantCommonBase

<Stack>
    <StackField Label="@Localizer["SelectSession"]"
                HelperText="@(Context.SelectedPatient?.Name ?? string.Empty)" />
</Stack>

<Stack>

    @if(loadingReservations)
    {
        <StackField Label="@Localizer["Loading"]" AdornmentIcon="fa-regular fa-circle-notch fa-spin" />
    }
    else
    {
        <StackCalendar MinDate="@DateTime.Today" ViewMode="Interfaces.Base.Enums.StackCalendarViewMode.Week">
            <DayTemplate Context="day">
                @{
                    var slot = slots.FirstOrDefault(i => i.Occurrence?.Date == DateOnly.FromDateTime(day.Date));
                    bool alreadyBooked = patientReservations.Any(r =>
                        DateOnly.FromDateTime(day.Date) == r.Date &&
                        r.SessionId == slot?.Session.Id &&
                        r.Status != ReservationStatus.Cancelled &&
                        r.Status != ReservationStatus.Rejected &&
                        r.Status != ReservationStatus.Expired);
                    bool available = slot?.Occurrence is not null && slot.Occurrence.AvailableSeats > 0;
                    bool sessionIsFull = slot?.Occurrence is not null && slot.Occurrence.AvailableSeats == 0;
                }
                <button type="button"
                        class="@day.CssClass"
                        disabled="@day.IsDisabledForInteraction"
                        aria-current="@(day.IsToday ? "date" : null)"
                        aria-selected="@day.IsSelected"
                        @onclick="async () =>
                        {
                            await day.SelectAsync();

                            if(available && slot?.Occurrence is not null)
                                await BookSlotAsync(slot.Session, slot.Occurrence);
                        }">
                    @if(alreadyBooked)
                    {
                        <MudBadge Dot
                                  Color="Color.Success">
                            @day.DayNumber
                        </MudBadge>
                    }
                    else if(available)
                    {
                        <MudBadge Dot
                                  Color="slot?.Occurrence?.AvailableSeats > 0 ? Color.Primary : Color.Default">
                            @day.DayNumber
                        </MudBadge>
                    }
                    else if(sessionIsFull)
                    {
                        <MudBadge Dot
                                  Color="Color.Info">
                            @day.DayNumber
                        </MudBadge>
                    }
                    else
                    {
                        @day.DayNumber
                    }
                </button>
            </DayTemplate>
        </StackCalendar>
    }

    @if(!string.IsNullOrWhiteSpace(bookingError))
    {
        <StackField Label="@bookingError"
                    AdornmentIcon="fa-regular fa-circle-xmark"
                    AdornmentColor="Color.Error"
                    Color="Color.Error" />
    }

    <StackButton Label="@Localizer["Back"]"
                 EndIcon="fa-regular fa-arrow-left"
                 OnClick="OnBack" />
</Stack>

