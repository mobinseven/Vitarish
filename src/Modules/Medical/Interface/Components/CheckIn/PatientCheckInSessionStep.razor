@inherits Vitarish.Modules.Base.TenantCommonBase

<Stack>
    <StackField Label="@Localizer["SelectSession"]"
                HelperText="@(Context.SelectedPatient?.Name ?? string.Empty)" />

    @if(loading)
    {
        <StackField Label="@Localizer["Loading"]" AdornmentIcon="fa-regular fa-spinner" />
    }
    else if(allSlots.Count == 0)
    {
        <StackField Label="@Localizer["NoItems", Localizer["AppointmentSession"]]"
                    HelperText="@Localizer["NoItemsHelp", Localizer["AppointmentSession"]]" />
    }
    else
    {
        @foreach(var slot in allSlots)
        {
            bool alreadyBooked = Context.PatientTodayReservations.Any(r =>
                r.SessionId == slot.Session.Id &&
                r.Status != ReservationStatus.Cancelled &&
                r.Status != ReservationStatus.Rejected &&
                r.Status != ReservationStatus.Expired);

            bool isToday = slot.Occurrence?.Date == today;
            bool available = slot.Occurrence is not null && slot.Occurrence.AvailableSeats > 0;

            string helperText = slot.Occurrence is not null
                ? (isToday
                    ? $"{slot.Occurrence.StartTime:t}–{slot.Occurrence.EndTime:t} · {slot.Occurrence.ReservationCount}/{slot.Occurrence.TotalSeats} {Localizer["Seats"]}"
                    : $"{slot.Occurrence.Date:d} {slot.Occurrence.StartTime:t}–{slot.Occurrence.EndTime:t} · {slot.Occurrence.AvailableSeats} {Localizer["SeatsAvailable"]}")
                : $"{slot.Session.StartTime:t}–{slot.Session.EndTime:t}";

            <StackButton Label="@slot.Session.Title"
                         HelperText="@helperText"
                         EndIcon="">
                <SessionStatusBadge Status="slot.Session.Status" />
            </StackButton>

            @if(alreadyBooked)
            {
                <StackField Label="@Localizer["AlreadyBooked"]"
                            AdornmentIcon="fa-regular fa-circle-check"
                            AdornmentColor="Color.Success"
                            Color="Color.Success" />
            }
            else if(available && slot.Occurrence is not null)
            {
                <StackCheckbox @bind-Value="Context.MarkAsArrived"
                               Label="@Localizer["MarkAsArrived"]" />

                <StackButton Label="@(isToday ? Localizer["BookNow"] : Localizer["BookForDate", slot.Occurrence.Date.ToString("d")])"
                             Color="Color.Primary"
                             EndIcon="fa-regular fa-calendar-plus"
                             Disabled="@booking"
                             OnClick="@(() => BookSlotAsync(slot.Session, slot.Occurrence))" />
            }
            else
            {
                <StackField Label="@Localizer["SessionFull"]"
                            AdornmentIcon="fa-regular fa-circle-xmark"
                            AdornmentColor="Color.Warning" />
            }
        }
    }

    @if(!string.IsNullOrWhiteSpace(bookingError))
    {
        <StackField Label="@bookingError"
                    AdornmentIcon="fa-regular fa-circle-xmark"
                    AdornmentColor="Color.Error"
                    Color="Color.Error" />
    }

    <StackButton Label="@Localizer["Back"]"
                 EndIcon="fa-regular fa-arrow-left"
                 OnClick="OnBack" />
</Stack>

@code {
    [Parameter, EditorRequired] public PatientCheckInContext Context { get; set; } = default!;
    [Parameter] public EventCallback OnBooked { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    [Inject] private IAccessControlledSessionManager SessionsService { get; set; } = default!;
    [Inject] private IAccessControlledReservationManager ReservationManager { get; set; } = default!;
    [Inject] private ISessionBookableDateQueryService BookableDateQueryService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private record SessionSlot(SessionReadDto Session, SessionReservationReadDto? Occurrence);

    private List<SessionSlot> allSlots = [];
    private DateOnly today;
    private bool loading;
    private bool booking;
    private string? bookingError;

    protected override async Task OnInitializedAsync()
    {
        today = DateOnly.FromDateTime(DateTime.UtcNow);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        await InvokeAsync(StateHasChanged);

        SessionDescriptorDto sessionDescriptor = new()
        {
            Status = SessionStatus.Active,
            Skip = 0,
            Take = int.MaxValue
        };

        IReadOnlyList<SessionReadDto> sessions = await SessionsService
            .GetListAsync(sessionDescriptor, CancellationToken.None)
            .GetValueOrDefaultAsync() ?? [];

        sessions = [.. sessions.OrderBy(s => s.DayOfWeek).ThenBy(s => s.StartTime).ThenBy(s => s.Title)];

        List<SessionSlot> slots = [];

        foreach(SessionReadDto session in sessions)
        {
            // Try to find a slot for today first
            SessionDateRangeQuery todayRange = new()
            {
                DateFrom = today,
                DateTo = today
            };

            IReadOnlyList<SessionReservationReadDto> todayBookable = await BookableDateQueryService
                .GetBookableDatesAsync(session.Id, todayRange, CancellationToken.None);

            SessionReservationReadDto? todayOccurrence = todayBookable.FirstOrDefault(o => o.Date == today);

            if(todayOccurrence is not null)
            {
                slots.Add(new SessionSlot(session, todayOccurrence));
            }
            else
            {
                // 30-day lookahead: enough to surface the next scheduled occurrence for
                // sessions that don't run daily; receptionist can see and book the nearest
                // available future slot without leaving the check-in screen.
                SessionDateRangeQuery futureRange = new()
                {
                    DateFrom = today.AddDays(1),
                    DateTo = today.AddDays(30)
                };

                IReadOnlyList<SessionReservationReadDto> futureBookable = await BookableDateQueryService
                    .GetBookableDatesAsync(session.Id, futureRange, CancellationToken.None);

                SessionReservationReadDto? nextSlot = futureBookable
                    .Where(o => o.AvailableSeats > 0)
                    .OrderBy(o => o.Date)
                    .FirstOrDefault();

                slots.Add(new SessionSlot(session, nextSlot));
            }
        }

        // Context.TodaySessions records today-only occurrences, used by other consumers
        // (e.g. the confirm step). allSlots covers today + future and drives this UI.
        Context.TodaySessions = [.. sessions.Select(s =>
        {
            SessionReservationReadDto? todayOcc = slots.FirstOrDefault(sl => sl.Session.Id == s.Id && sl.Occurrence?.Date == today)?.Occurrence;
            return (s, todayOcc);
        })];

        allSlots = slots;

        // Load existing patient reservations using the same party identifier that will be
        // used when booking: linked user ID if available, otherwise the patient's project ID.
        string? patientUserId = Context.SelectedPatient?.UserIds.FirstOrDefault();
        string reservingPartyId = !string.IsNullOrWhiteSpace(patientUserId)
            ? patientUserId
            : Context.SelectedPatient!.Id.ToString();

        ReservationDescriptorDto reservationDescriptor = new()
        {
            ReservingPartyId = reservingPartyId,
            Date = today,
            Skip = 0,
            Take = int.MaxValue
        };

        Context.PatientTodayReservations = await ReservationManager
            .GetListAsync(reservationDescriptor, CancellationToken.None)
            .GetValueOrDefaultAsync() ?? [];

        loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task BookSlotAsync(SessionReadDto session, SessionReservationReadDto occurrence)
    {
        bookingError = null;
        booking = true;
        await InvokeAsync(StateHasChanged);

        // Prefer the linked user account; fall back to the patient's own project ID as a
        // stable party identifier — the Appointments module treats it as an opaque string.
        string? patientUserId = Context.SelectedPatient?.UserIds.FirstOrDefault();
        string reservingPartyId = !string.IsNullOrWhiteSpace(patientUserId)
            ? patientUserId
            : Context.SelectedPatient!.Id.ToString();

        EntityResult<ReservationReadDto> reserveResult = await ReservationManager
            .ReserveAsync(session.Id, occurrence.Date, reservingPartyId, CancellationToken.None);

        if(reserveResult.IsFailure || reserveResult.Value is null)
        {
            bookingError = reserveResult.Errors.FirstOrDefault()?.Message ?? Localizer["Error"].Value;
            booking = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        ReservationReadDto reservation = reserveResult.Value;

        if(Context.MarkAsArrived && occurrence.Date == today)
        {
            EntityResult confirmResult = await ReservationManager
                .ConfirmReservationAsync(reservation.Id, CancellationToken.None);

            if(!confirmResult.IsFailure)
            {
                _ = await ReservationManager
                    .PresentReservationAsync(reservation.Id, CancellationToken.None);
            }
        }

        Context.SelectedSession = session;
        Context.SelectedOccurrence = occurrence;
        Context.ConfirmedReservation = reservation;
        Context.Outcome = occurrence.Date == today ? CheckInOutcome.CurrentSession : CheckInOutcome.FutureSession;

        booking = false;
        await OnBooked.InvokeAsync();
    }
}
