@inherits Vitarish.Modules.Base.TenantCommonBase

<Stack>
    <StackField Label="@Localizer["SelectSession"]"
                HelperText="@(Context.SelectedPatient?.Name ?? string.Empty)" />
</Stack>

<Stack>

    @if (loadingReservations)
    {
        <StackField Label="@Localizer["Loading"]" AdornmentIcon="fa-regular fa-circle-notch fa-spin" />
    }
    else
    {
        <BookableSessionsCalendar Descriptor="@sessionDescriptor"
                                  Range="@sessionRange">
            <SlotActions Context="slot">
                @{
                    bool alreadyBooked = patientTodayReservations.Any(r =>
                        r.SessionId == slot.Session.Id &&
                        r.Status != ReservationStatus.Cancelled &&
                        r.Status != ReservationStatus.Rejected &&
                        r.Status != ReservationStatus.Expired);

                    bool isToday = slot.Occurrence?.Date == today;
                    bool available = slot.Occurrence is not null && slot.Occurrence.AvailableSeats > 0;
                }
                @if (alreadyBooked)
                {
                    <MudChip T="string" Color="Color.Success" Text="@Localizer["AlreadyBooked"]" />
                }
                else if (available)
                {
                    <MudChip T="string" Color="Color.Primary"
                             Icon="fa-regular fa-calendar-plus"
                             OnClick="@(() => BookSlotAsync(slot.Session, slot.Occurrence!))"
                             Disabled="@booking"
                             Text="@(isToday ? Localizer["BookNow"] : Localizer["BookForDate", slot.Occurrence!.Date.ToString("d")])" />
                }
                else
                {
                    <MudChip T="string" Icon="fa-regular fa-circle-xmark"
                             Color="Color.Warning"
                             Text="@Localizer["SessionFull"]" />
                }
            </SlotActions>
        </BookableSessionsCalendar>
    }

    @if (!string.IsNullOrWhiteSpace(bookingError))
    {
        <StackField Label="@bookingError"
                    AdornmentIcon="fa-regular fa-circle-xmark"
                    AdornmentColor="Color.Error"
                    Color="Color.Error" />
    }

    <StackButton Label="@Localizer["Back"]"
                 EndIcon="fa-regular fa-arrow-left"
                 OnClick="OnBack" />
</Stack>

