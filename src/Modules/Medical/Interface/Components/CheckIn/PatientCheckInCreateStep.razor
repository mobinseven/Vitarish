@inherits Vitarish.Modules.Base.TenantCommonBase

<Stack>
    @if(Context.DuplicateCandidates.Count > 0)
    {
        <StackField Label="@Localizer["DuplicateWarning"]"
                    HelperText="@Localizer["DuplicateWarningHelp"]"
                    AdornmentIcon="fa-regular fa-triangle-exclamation"
                    AdornmentColor="Color.Warning"
                    Color="Color.Warning" />

        @foreach(var candidate in Context.DuplicateCandidates)
        {
            <StackButton Label="@candidate.Name"
                         HelperText="@GetCandidateHelperText(candidate)"
                         Color="Color.Warning"
                         EndIcon="fa-regular fa-user-check"
                         OnClick="@(() => SelectExistingAsync(candidate))" />
        }
    }
</Stack>

<Stack>
    <StackField Label="@Localizer["NewPatientIntake"]" />

    <StackTextField @bind-Value="draft.IdentificationCode"
                    Label="@Localizer["IdentificationCode"]"
                    HelperText="@Localizer["IdentificationCodeHelp"]"
                    AdornmentIcon="@(string.IsNullOrWhiteSpace(draft.IdentificationCode) ? "fa-regular fa-triangle-exclamation" : "fa-regular fa-id-card")"
                    AdornmentColor="@(string.IsNullOrWhiteSpace(draft.IdentificationCode) ? Color.Warning : Color.Default)" />

    <StackTextField @bind-Value="draft.LastName"
                    Required
                    Label="@Localizer["LastName"]" />

    <StackTextField @bind-Value="draft.FirstName"
                    Label="@Localizer["FirstName"]" />

    <StackDatePicker @bind-Date="draft.DateOfBirth"
                     Label="@Localizer["DateOfBirth"]" />

    <StackTextField @bind-Value="draft.Phone"
                    Label="@Localizer["Phone"]"
                    InputType="InputType.Telephone" />

    <StackTextField @bind-Value="draft.Email"
                    Label="@Localizer["Email"]"
                    InputType="InputType.Email" />

    @if(!string.IsNullOrWhiteSpace(validationError))
    {
        <StackField Label="@validationError"
                    AdornmentIcon="fa-regular fa-circle-xmark"
                    AdornmentColor="Color.Error"
                    Color="Color.Error" />
    }
</Stack>


<Stack>
    <StackButton Label="@Localizer["Save"]"
                 EndIcon="fa-regular fa-save"
                 Color="Color.Primary"
                 Disabled="@saving"
                 OnClick="SaveAsync" />

    <StackButton Label="@Localizer["Back"]"
                 EndIcon="fa-regular fa-arrow-left"
                 OnClick="OnBack" />
</Stack>

    @code {
    [Parameter, EditorRequired] public PatientCheckInContext Context { get; set; } = default!;
    [Parameter] public EventCallback<ProjectReadDto> OnCreated { get; set; }
    [Parameter] public EventCallback<ProjectReadDto> OnSelectExisting { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Inject] private IAccessControlledProjectsService ProjectsService { get; set; } = default!;

    private PatientWriteDto draft = new();
    private string? validationError;
    private bool saving;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        draft = Context.NewPatientDraft as PatientWriteDto ?? new PatientWriteDto();

        // Pre-fill IdentificationCode if the user typed one in the identify step
        if (!string.IsNullOrWhiteSpace(Context.IdentificationCode) && string.IsNullOrWhiteSpace(draft.IdentificationCode))
        {
            draft.IdentificationCode = Context.IdentificationCode;
        }

        // Pre-fill name from advanced search query. Assumes Western name order
        // (first-name last-name); receptionist can correct the split before saving.
        if (!string.IsNullOrWhiteSpace(Context.SearchQuery) && string.IsNullOrWhiteSpace(draft.LastName))
        {
            string[] parts = Context.SearchQuery.Trim().Split(' ', 2);
            draft.LastName = parts.Length > 1 ? parts[1] : parts[0];
            if (parts.Length > 1)
            {
                draft.FirstName = parts[0];
            }
        }
    }

    private async Task SaveAsync()
    {
        validationError = null;

        if(string.IsNullOrWhiteSpace(draft.LastName))
        {
            validationError = Localizer["RequiredItem", Localizer["LastName"]].Value;
            return;
        }

        saving = true;
        await InvokeAsync(StateHasChanged);

        draft.Name = $"{draft.FirstName} {draft.LastName}".TrimEnd(' ', ',');

        EntityResult<ProjectReadDto> result = await ProjectsService.AddAsync(draft, CancellationToken.None);

        saving = false;

        if(result.IsFailure || result.Value is null)
        {
            validationError = result.Errors.FirstOrDefault()?.Message ?? Localizer["Error"].Value;
            await InvokeAsync(StateHasChanged);
            return;
        }

        Context.NewPatientDraft = draft;
        await OnCreated.InvokeAsync(result.Value);
    }

    private string GetCandidateHelperText(ProjectReadDto project)
    {
        PatientReadDto patient = project.ToPatientRead();
        List<string> parts = [];

        if(!string.IsNullOrWhiteSpace(project.IdentificationCode))
        {
            parts.Add($"{Localizer["IdentificationCode"]}: {project.IdentificationCode}");
        }

        if(patient.DateOfBirth.HasValue)
        {
            parts.Add(patient.DateOfBirth.Value.ToShortDateString());
        }

        if(!string.IsNullOrWhiteSpace(patient.Phone))
        {
            parts.Add(patient.Phone);
        }
        else if(!string.IsNullOrWhiteSpace(patient.Email))
        {
            parts.Add(patient.Email);
        }

        return string.Join(" · ", parts);
    }

    private async Task SelectExistingAsync(ProjectReadDto patient)
    {
        await OnSelectExisting.InvokeAsync(patient);
    }
}
