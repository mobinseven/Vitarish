@inherits Vitarish.Modules.Base.TenantCommonBase

@if (patient is not null)
{
    <Stack>
        <StackButton OnClick="@(() => OnClicked.InvokeAsync(Project.Id))"
                     Label="@Project.Name"
                     HelperText="@(!string.IsNullOrWhiteSpace(Project.IdentificationCode) ? $"{Localizer["IdentificationCode"]}: {Project.IdentificationCode}" : null)">
            @if (patient.DateOfSurgery.HasValue)
            {
                <MudText Typo="Typo.caption">@Localizer["DateOf", Localizer["Surgery"]]: @patient.DateOfSurgery.Value.ToShortDateString()</MudText>
            }
            @if (Project.Stats is not null)
            {
                <StatsDisplay Stats="Project.Stats" />
            }
        </StackButton>
    </Stack>
}

@code {
    [Parameter, EditorRequired] public ProjectReadDto Project { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnClicked { get; set; }

    private PatientReadDto? patient;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        patient = Project.ToPatientRead();
    }
}
