@inherits Vitarish.Modules.Base.TenantCommonBase

@if (patient is not null)
{
    <Stack>
        <StackField Label="@Localizer["Overview"]">
            @if (patient.Gender != Gender.Unspecified)
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["Gender"]: @Localizer[patient.Gender.ToString()]</MudText>
            }
            @if (patient.DateOfBirth.HasValue)
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["DateOfBirth"]: @patient.DateOfBirth.Value.ToShortDateString() (@AgeText)</MudText>
            }
            @if (patient.DateOfSurgery.HasValue)
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["DateOf", Localizer["Surgery"]]: @patient.DateOfSurgery.Value.ToShortDateString()</MudText>
            }
            @if (Project.Stats is not null)
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["Procedures"]: @Project.Stats.Procedures</MudText>
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["Events"]: @Project.Stats.Events</MudText>
                @if (Project.Stats.LastUpdate.HasValue)
                {
                    <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["LastUpdate"]: @Project.Stats.LastUpdate.Value.ToLocalTime().DateTime.ToShortDateString()</MudText>
                }
            }
            @if (!string.IsNullOrWhiteSpace(linkedUserId))
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["LinkedUser"]: @GetUserFullNameById(linkedUserId)</MudText>
            }
        </StackField>
    </Stack>
}

@code {
    [Parameter, EditorRequired] public ProjectReadDto Project { get; set; } = default!;

    private PatientReadDto? patient;
    private string? linkedUserId;

    private string AgeText => patient?.DateOfBirth.HasValue == true
        ? $"{(int)((DateTime.Today - patient.DateOfBirth.Value).TotalDays / 365.25)} {Localizer["Years"]}"
        : string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        patient = Project.ToPatientRead();
        linkedUserId = Project.Metadata.TryGetValue(MetadataKeys.LinkedUserId, out object? v) ? v?.ToString() : null;
    }
}
