@inherits ProjectDetails

<Stack>
    <StackField Label="@Project.Name">
        <ProjectAvatar AvatarFileId="@Project.AvatarFileId" Size="96" Style="margin-bottom: 0.5rem;" />
        @if(!string.IsNullOrWhiteSpace(Project.IdentificationCode))
        {
            <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["IdentificationCode"]: @Project.IdentificationCode</MudText>
        }
        @if(!string.IsNullOrWhiteSpace(Project.Description))
        {
            <MudText HtmlTag="p" Typo="Typo.caption" Class="py-3">@Project.Description</MudText>
        }
        @if(patient is not null)
        {
            @if(!string.IsNullOrWhiteSpace(patient.ClinicalNotes))
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-3">@Localizer["ClinicalNotes"]: @patient.ClinicalNotes</MudText>
            }
            @if(patient.DateOfSurgery.HasValue)
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-3">@Localizer["DateOf", Localizer["Surgery"]]: @patient.DateOfSurgery.Value.ToShortDateString()</MudText>
            }
            @if(patient.Gender != Gender.Unspecified)
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["Gender"]: @Localizer[patient.Gender.ToString()]</MudText>
            }
            @if(patient.DateOfBirth.HasValue)
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["DateOfBirth"]: @patient.DateOfBirth.Value.ToShortDateString() (@AgeText)</MudText>
            }
            @if(Project.Stats is not null)
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["Procedures"]: @Project.Stats.Procedures</MudText>
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["Events"]: @Project.Stats.Events</MudText>
                @if(Project.Stats.LastUpdate.HasValue)
                {
                    <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["LastUpdate"]: @Project.Stats.LastUpdate.Value.ToLocalTime().DateTime.ToShortDateString()</MudText>
                }
            }
            @if(!string.IsNullOrWhiteSpace(linkedUserId))
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-1">@Localizer["LinkedUser"]: @GetUserFullNameById(linkedUserId)</MudText>
            }
        }
    </StackField>

    @if(AdminMode)
    {
        <StackButton OnClick="@(() => EditProject())"
                     EndIcon="fa-regular fa-pencil"
                     Label="@Localizer["EditItem", Localizer["Project"]]" />
        <StackButton OnClick="@(() => DeleteProject())"
                     Color="Color.Error"
                     EndIcon="fa-regular fa-folder-xmark"
                     Label="@Localizer["DeleteItem", Localizer["Project"]]" />
    }
</Stack>

@code {
    PatientReadDto? patient;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        patient = Project.ToPatientRead();
        linkedUserId = Project.UserIds.FirstOrDefault();
    }
    private string? linkedUserId;

    private string AgeText
    {
        get
        {
            if(patient?.DateOfBirth is not DateTime dob)
                return string.Empty;
            DateTime today = DateTime.Today;
            int age = today.Year - dob.Year;
            if(dob.AddYears(age) > today)
                age--;
            return $"{age} {Localizer["Years"]}";
        }
    }
}
