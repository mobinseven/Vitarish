@inherits ProjectDetails

<Stack>
    <StackField Label="@Project.Name">
        @if(!string.IsNullOrWhiteSpace(Project.Description))
        {
            <MudText HtmlTag="p" Typo="Typo.caption" Class="py-3">@Project.Description</MudText>
        }
        @if(patient is not null)
        {
            @if(!string.IsNullOrWhiteSpace(patient.ClinicalNotes))
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-3">@Localizer["ClinicalNotes"]: @patient.ClinicalNotes</MudText>
            }
            @if(patient.DateOfSurgery.HasValue)
            {
                <MudText HtmlTag="p" Typo="Typo.caption" Class="py-3">@Localizer["DateOf", Localizer["Surgery"]]: @patient.DateOfSurgery.Value.ToShortDateString()</MudText>
            }
        }
    </StackField>

    @if(AdminMode)
    {
        <StackButton OnClick="@(() => EditProject())"
                     EndIcon="fa-regular fa-pencil"
                     Label="@Localizer["EditItem", Localizer["Project"]]" />
        <StackButton OnClick="@(() => DeleteProject())"
                     Color="Color.Error"
                     EndIcon="fa-regular fa-folder-xmark"
                     Label="@Localizer["DeleteItem", Localizer["Project"]]" />
    }
</Stack>

@code {
    PatientReadDto? patient;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        patient = Project.ToPatientRead();
    }
}
