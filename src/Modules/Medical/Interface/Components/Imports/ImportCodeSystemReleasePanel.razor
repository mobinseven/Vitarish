@inherits MedicalBase

<Stack>
    <StackSelect T="Guid" Label="@Localizer["CodeSystem"]" @bind-Value="writeDto.CodeSystemId">
        @foreach (var cs in codeSystems)
        {
            <StackSelectItem T="Guid" Value="cs.Id">@cs.Name (@cs.SystemKey)</StackSelectItem>
        }
    </StackSelect>
    <StackTextField @bind-Value="writeDto.ReleaseName" Label="@Localizer["ReleaseName"]" />
    <StackDatePicker @bind-DateOnlyValue="writeDto.EffectiveFrom" Label="@Localizer["EffectiveFrom"]" />
    <StackDatePicker @bind-DateOnlyValue="writeDto.EffectiveTo" Label="@Localizer["EffectiveTo"]" />
    <StackTextField @bind-Value="writeDto.SourceLocator" Label="@Localizer["SourceLocator"]" />
    <StackTextField @bind-Value="writeDto.SourceVersion" Label="@Localizer["SourceVersion"]" />
    <StackTextField @bind-Value="writeDto.SourceChecksum" Label="@Localizer["SourceChecksum"]" />
    <StackSelect T="ImportSourceType" Label="@Localizer["SourceType"]" @bind-Value="writeDto.SourceType">
        @foreach (var st in Enum.GetValues<ImportSourceType>())
        {
            <StackSelectItem T="ImportSourceType" Value="st">@Localizer[st.ToString()]</StackSelectItem>
        }
    </StackSelect>
    <StackCheckbox @bind-Value="writeDto.DryRun" Label="@Localizer["DryRun"]" />
</Stack>

@if (lastResult is not null)
{
    <Stack>
        <StackField Label="@lastResult.Status.ToString()" HelperText="@Localizer["Status"]" />
        <StackField Label="@lastResult.RecordsProcessed.ToString()" HelperText="@Localizer["RecordsProcessed"]" />
        <StackField Label="@lastResult.RecordsImported.ToString()" HelperText="@Localizer["RecordsImported"]" />
        <StackField Label="@lastResult.RecordsSkipped.ToString()" HelperText="@Localizer["RecordsSkipped"]" />
        @if (lastResult.Warnings.Count > 0)
        {
            <StackField Label="@Localizer["Warnings"]" />
            @foreach (var w in lastResult.Warnings)
            {
                <StackField Label="@w" />
            }
        }
        @if (lastResult.Errors.Count > 0)
        {
            <StackField Label="@Localizer["Errors"]" />
            @foreach (var e in lastResult.Errors)
            {
                <StackField Label="@e" />
            }
        }
    </Stack>

    <Stack>
        <ImportBatchDetail ImportBatchId="lastResult.ImportBatchId" />
    </Stack>
}

<Stack>
    <StackButton Label="@Localizer["RunImport"]" OnClick="RunAsync" Color="Color.Primary"
                 Disabled="running" EndIcon="fa-solid fa-file-import" />
</Stack>
