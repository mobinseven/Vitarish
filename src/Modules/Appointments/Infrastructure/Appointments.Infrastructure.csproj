		<PackageReference Include="Finbuckle.MultiTenant.EntityFrameworkCore" Version="9.*" />
		<PackageReference Include="MediatR" Version="14.0.*" />
		<PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.*" />
