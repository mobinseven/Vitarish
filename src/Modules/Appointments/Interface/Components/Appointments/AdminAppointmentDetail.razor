@inherits AppointmentsBase

@if (current is null)
{
    return;
}

<Stack>
    @if (current.Session is not null)
    {
        <StackField Label="@current.Session.DateTime.ToString("f")" HelperText="@Localizer["SessionDateTime"]">
            <AppointmentStatusBadge Status="@current.Status" />
        </StackField>
    }
    else
    {
        <StackField Label="@current.Id.ToString()" HelperText="@Localizer["Appointment"]">
            <AppointmentStatusBadge Status="@current.Status" />
        </StackField>
    }
    @if (!string.IsNullOrWhiteSpace(current.UserId))
    {
        <StackField Label="@GetUserFullNameById(current.UserId)" HelperText="@Localizer["User"]" />
    }
</Stack>

@switch(current.Status)
{
    case AppointmentStatus.Pending:
    <Stack>
        <StackButton Color="Color.Success"
                     Label="@Localizer["ConfirmAppointment"]"
                     EndIcon="fa-regular fa-calendar-check"
                     OnClick="@(() => ChangeStatusAsync(AppointmentStatus.Confirmed))" />
        <StackButton Color="Color.Error"
                     Label="@Localizer["CancelAppointment"]"
                     EndIcon="fa-regular fa-calendar-xmark"
                     OnClick="@(() => ChangeStatusAsync(AppointmentStatus.Cancelled))" />
    </Stack>
    break;

    case AppointmentStatus.Confirmed:
    <Stack>
        <StackButton Color="Color.Secondary"
                     Label="@Localizer["PresentAppointment"]"
                     EndIcon="fa-regular fa-person-check"
                     OnClick="@(() => ChangeStatusAsync(AppointmentStatus.Present))" />
        <StackButton Color="Color.Error"
                     Label="@Localizer["CancelAppointment"]"
                     EndIcon="fa-regular fa-calendar-xmark"
                     OnClick="@(() => ChangeStatusAsync(AppointmentStatus.Cancelled))" />
    </Stack>
    break;

    case AppointmentStatus.Present:
    <Stack>
        <StackButton Color="Color.Secondary"
                     Label="@Localizer["CompleteAppointment"]"
                     EndIcon="fa-regular fa-check"
                     OnClick="@(() => ChangeStatusAsync(AppointmentStatus.Completed))" />
    </Stack>
    break;

    case AppointmentStatus.Completed:
    case AppointmentStatus.Cancelled:
        // No action buttons for terminal states
        break;

    default:
        break;
}
