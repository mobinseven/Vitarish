@inherits AppointmentsBase

@if(current is null)
{
    return;
}

<Stack>
    <StackField Label="@current.ScheduledAt.ToString("f")" HelperText="@Localizer["ScheduledAt"]">
        <AppointmentStatusBadge Status="@current.Status" />
    </StackField>
    @if(!string.IsNullOrWhiteSpace(current.Notes))
    {
        <StackField Label="@current.Notes" HelperText="@Localizer["Notes"]" />
    }
</Stack>

@switch(current.Status)
{
    case AppointmentStatus.Present:
        return;

    case AppointmentStatus.Pending:
    <Stack>
        <StackButton Color="Color.Error"
                     Label="@Localizer["CancelAppointment"]"
                     EndIcon="fa-regular fa-calendar-xmark"
                     OnClick="CancelAppointmentAsync" />
    </Stack>
    break;
    case AppointmentStatus.Confirmed:
    <Stack>
        <StackButton Label="@Localizer["Reschedule"]"
                     EndIcon="fa-regular fa-calendar-clock"
                     OnClick="OnReschedule" />
        <StackButton Color="Color.Error"
                     Label="@Localizer["CancelAppointment"]"
                     EndIcon="fa-regular fa-calendar-xmark"
                     OnClick="CancelAppointmentAsync" />
    </Stack>
    break;

    case AppointmentStatus.Completed:
    case AppointmentStatus.Cancelled:
        // No actions for terminal statuses
        break;

    default:
        break;
}
