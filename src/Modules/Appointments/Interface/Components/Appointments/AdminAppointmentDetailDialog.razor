@inherits AppointmentsBase

<MudDialog>
    <DialogContent>
        <AdminAppointmentDetail Appointment="@Appointment"
                                OnEdit="EditAndClose"
                                OnDeleted="DeleteAndClose"
                                OnStatusChanged="StatusChangedAndClose" />
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public AppointmentReadDto Appointment { get; set; } = default!;

    private void EditAndClose()
    {
        MudDialog.Cancel();
        NavigationManager.NavigateTo($"/appointments/admin/{Appointment.Id}/edit");
    }

    private void DeleteAndClose() => MudDialog.Close(DialogResult.Ok(true));

    private void StatusChangedAndClose() => MudDialog.Close(DialogResult.Ok(true));
}
