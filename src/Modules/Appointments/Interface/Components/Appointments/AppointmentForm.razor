@inherits AppointmentsBase

@if (Plugin is null)
{
    <Stack>
        <StackSelect T="Guid?"
                     Value="@appointmentWriteDto.SessionId"
                     ValueChanged="@(id => SelectSession(id))"
                     Label="@Localizer["Session"]">
            @foreach (var session in availableSessions)
            {
                int available = session.Capacity - session.ReservationCount;
                <MudSelectItem T="Guid?" Value="@((Guid?)session.Id)">
                    @(string.IsNullOrWhiteSpace(session.Name) ? session.ScheduledAt.ToString("f") : session.Name)
                    — @session.ScheduledAt.ToString("f")
                    (@available @Localizer["Available"])
                </MudSelectItem>
            }
        </StackSelect>
        @if (selectedSession is not null)
        {
            <StackField Label="@selectedSession.ScheduledAt.ToString("f")" HelperText="@Localizer["ScheduledAt"]" />
            <StackField Label="@((selectedSession.Capacity - selectedSession.ReservationCount).ToString())" HelperText="@Localizer["AvailableSeats"]" />
        }
        <StackTextField @bind-Value="appointmentWriteDto.Notes" AutoGrow Lines=3 Label="@Localizer["Notes"]" />
    </Stack>
    <Stack>
        <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" EndIcon="fa-regular fa-save" />
        <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" EndIcon="fa-regular fa-xmark" />
    </Stack>
}
else
{
    @Plugin.Render(new AppointmentFormPluginContext(appointmentWriteDto, OnSaved, OnCancelled))
}
