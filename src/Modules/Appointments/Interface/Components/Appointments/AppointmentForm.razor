@inherits AppointmentsBase

@if (Plugin is null)
{
    <Stack>
        <StackDatePicker @bind-Date="scheduledAtDate" Label="@Localizer["Date"]" />
        <StackTimePicker @bind-Time="scheduledAtTime" Label="@Localizer["Time"]" />
        <StackTextField @bind-Value="appointmentWriteDto.Notes" AutoGrow Lines=3 Label="@Localizer["Notes"]" />
    </Stack>
    <Stack>
        <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" EndIcon="fa-regular fa-save" />
        <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" EndIcon="fa-regular fa-xmark" />
    </Stack>
}
else
{
    @Plugin.Render(new AppointmentFormPluginContext(appointmentWriteDto, OnSaved, OnCancelled))
}
