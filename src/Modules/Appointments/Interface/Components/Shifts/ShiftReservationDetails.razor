@inherits CommonBase
<StackField Label="@ShiftReservation.Date.ToShortDateString()" />
<StackField Label="@($"{Localizer["Count", Localizer["Reservations"]]}: {ShiftReservation.ReservationCount}")" />
<ShiftReservationList ShiftReservation="ShiftReservation" />
<StackButton Label="@Localizer["AddItem", Localizer["Reservation"]]" OnClick="AddReservationAsync" EndIcon="fa-regular fa-plus" Color="Color.Primary" />

@code {
    [Parameter, EditorRequired] public ShiftReservationReadDto ShiftReservation { get; set; }
    [Parameter] public EventCallback OnStatusChanged { get; set; }

    private async Task AddReservationAsync()
    {
        DialogParameters parameters = new()
        {
            { nameof(ReservationForShiftDialog.ShiftId), ShiftReservation.ShiftId },
            { nameof(ReservationForShiftDialog.Date), ShiftReservation.Date }
        };

        IDialogReference dialog = await DialogService.ShowAsync<ReservationForShiftDialog>(Localizer["AddItem", Localizer["Reservation"]], parameters);
        DialogResult? result = await dialog.Result;

        if(result is not null && !result.Canceled)
        {
            await OnStatusChanged.InvokeAsync();
        }
    }
}
