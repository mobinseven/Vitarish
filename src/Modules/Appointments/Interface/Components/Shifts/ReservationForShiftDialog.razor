@inherits ReservationsBase

<MudDialog>
    <DialogContent>
        <Stack>
            <UserFindOrCreate Value="@selectedUserId"
                              ValueChanged="OnSelectedUserChangedAsync"
                              Options="@UserPickerOptions" />
            @if (AdminMode)
            {
                <StackTimePicker Label="@Localizer["EstimatedSessionLengthOverride"]"
                                 HelperText="@Localizer["EstimatedSessionLengthOverrideHelp"]"
                                 @bind-Value="estimatedSessionLengthOverride" />
            }
        </Stack>
        <Stack>
            <StackButton Color="Color.Primary"
                         Label="@Localizer["Save"]"
                         EndIcon="fa-solid fa-save"
                         OnClick="SaveAsync" />
            <StackButton Label="@Localizer["Cancel"]"
                         EndIcon="fa-solid fa-xmark"
                         OnClick="Cancel" Color="Color.Secondary" />
        </Stack>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public Guid ShiftId { get; set; }
    [Parameter, EditorRequired] public DateOnly Date { get; set; }

    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private static readonly UserFindOrCreateOptions UserPickerOptions = new()
    {
        AllowCreate = true,
        AllowUnlink = true,
        ShowSearchScopeSelector = true,
        DefaultSearchScope = UserSearchScope.TenantUsers,
        AutoLinkExistingUser = true,
        AllowAutoLinkToggle = true,
        EnsureTenantUserRoleOnLink = true
    };

    private string? selectedUserId;
    private TimeSpan? estimatedSessionLengthOverride;

    private Task OnSelectedUserChangedAsync(string? userId)
    {
        selectedUserId = userId;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if(selectedUserId is null)
        {
            _ = Snackbar.Add(Localizer["UserSelectionRequired"].Value, Severity.Warning);
            return;
        }

        await ReservationManager.ReserveAsync(ShiftId, Date, selectedUserId, estimatedSessionLengthOverride, CancellationToken.None);
        _ = Snackbar.Add(Localizer["Saved"], Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
