@inherits ShiftReminderPoliciesBase
@using Vitarish.Communications.Domain.Enums

<Stack>
    <StackField Label="@Localizer["Channel"]">
        <MudRadioGroup T="ReminderKind" @bind-Value="dto.Channel">
            <MudRadio T="ReminderKind" Value="ReminderKind.Email" Label="@Localizer["Email"]" />
            <MudRadio T="ReminderKind" Value="ReminderKind.Sms" Label="@Localizer["Sms"]" />
        </MudRadioGroup>
    </StackField>

    <StackTimePicker Label="@Localizer["Offset"]"
                     HelperText="@Localizer["ShiftReminderOffsetHelp"]"
                     @bind-Value="dto.OffsetBefore" />

    <StackField Label="@Localizer["QualifyingStatuses"]">
        @foreach(ReservationStatus status in Enum.GetValues<ReservationStatus>())
        {
            <MudCheckBox T="bool"
                         Label="@Localizer[status.ToString()]"
                         Value="@dto.QualifyingStatuses.Contains(status)"
                         ValueChanged="@(v => ToggleStatus(status, v))" />
        }
    </StackField>

    <MudTextField Label="@Localizer["SubjectTemplate"]"
                  @bind-Value="dto.SubjectTemplate"
                  Variant="Variant.Outlined"
                  HelperText="@Localizer["ReminderTemplateHelp"]" />

    <MudTextField Label="@Localizer["BodyTemplate"]"
                  @bind-Value="dto.BodyTemplate"
                  Variant="Variant.Outlined"
                  Lines="4"
                  HelperText="@Localizer["ReminderTemplateHelp"]" />

    <MudSwitch T="bool"
               @bind-Value="dto.IsEnabled"
               Label="@Localizer["Enabled"]" />

    <StackButton Label="@Localizer["Save"]"
                 EndIcon="fa-regular fa-floppy-disk"
                 OnClick="SaveAsync" />
</Stack>
