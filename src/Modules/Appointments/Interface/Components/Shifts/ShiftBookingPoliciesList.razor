@inherits ShiftBookingPoliciesBase

@if(policies.Count == 0)
{
    <StackField Label="@Localizer["NoItems", Localizer["BookingPolicy"]]" />
}
else
{
    @foreach(var policy in policies)
    {
        <StackField Label="@policy.Date.ToString("d")"
                    HelperText="@(policy.Closed ? Localizer["Closed"] : Localizer["Open"])">
            @if (policy.EstimatedSessionLength.HasValue)
            {
                <StackField Label="@policy.EstimatedSessionLength.Value.ToString(@"hh\:mm")"
                            HelperText="@Localizer["EstimatedSessionLength"]" />
            }
            <MudStack Row>
                <MudFab Label="@Localizer["EditItem", Localizer["BookingPolicy"]]"
                        EndIcon="fa-regular fa-pen"
                        OnClick="@(() => EditAsync(policy))"
                        DropShadow="false" />
                <MudFab Color="Color.Error"
                        Label="@Localizer["RemoveItem", Localizer["BookingPolicy"]]"
                        EndIcon="fa-regular fa-trash"
                        OnClick="@(() => RemoveAsync(policy))"
                        DropShadow="false" />
            </MudStack>
        </StackField>
    }
}

<StackButton Label="@Localizer["AddItem", Localizer["BookingPolicy"]]"
             EndIcon="fa-regular fa-plus"
             OnClick="AddAsync" />
