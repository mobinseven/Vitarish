@inherits ShiftsBase

@if(occurrences.Count == 0)
{
    <StackButton OnClick="ReloadRequired" Label="@Localizer["NoItems", Localizer["ShiftOccurrence"]]" HelperText="@Localizer["NoItemsHelp", Localizer["ShiftOccurrence"]]" EndIcon="fa-regular fa-refresh">
        @Localizer["Reload"]
    </StackButton>
}
else
{
    <StackCalendar MinDate="@DateTime.Today">
        <DayTemplate Context="day">
            @{
                var occurrence = occurrences.FirstOrDefault(i => i.Date == DateOnly.FromDateTime(day.Date));
            }
            <MudButton OnClick="() => OnSelected.InvokeAsync(occurrence)" Variant="@(occurrence is not null ? Variant.Outlined : Variant.Text)" Color="occurrence?.ReservationCount > 0 ? Color.Primary : Color.Default">
                @day.DayNumber
            </MudButton>
        </DayTemplate>
    </StackCalendar>
}
