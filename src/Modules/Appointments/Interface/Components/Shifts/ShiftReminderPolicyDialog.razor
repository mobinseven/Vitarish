@inherits ShiftReminderPoliciesBase

<MudDialog>
    <DialogContent>
        <ShiftReminderPolicyForm ShiftId="@ShiftId"
                                   Policy="@Policy"
                                   OnSaved="OnSavedInternal" />
        <Stack>
            <StackButton Label="@Localizer["Cancel"]"
                         EndIcon="fa-solid fa-xmark"
                         OnClick="Close" Color="Color.Secondary" />
        </Stack>
    </DialogContent>
</MudDialog>
