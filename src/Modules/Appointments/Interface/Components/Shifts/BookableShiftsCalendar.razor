@inherits Vitarish.Modules.Base.TenantCommonBase

@if(loading)
{
    <StackField Label="@Localizer["Loading"]" AdornmentIcon="fa-regular fa-circle-notch fa-spin" />
}
else if(slots.Count == 0)
{
    <StackField Label="@Localizer["NoItems", Localizer["AppointmentShift"]]"
                HelperText="@Localizer["NoItemsHelp", Localizer["AppointmentShift"]]" />
}
else
{
    <StackCalendar MinDate="@DateTime.Today">
        <DayTemplate Context="day">
            @day.DayNumber
            @{
                var slot = slots.FirstOrDefault(i => i.Occurrence?.Date == DateOnly.FromDateTime(day.Date));
            }
            @if(SlotActions is not null)
            {
                @SlotActions(slot)
            }
        </DayTemplate>
    </StackCalendar>
}
