@inherits ShiftsBase

@if(Plugin is null)
{
    @if(shifts.Count == 0)
    {
        <Stack>
            <StackButton OnClick="ReloadRequired" Label="@Localizer["NoItems", Localizer["Shift"]]" HelperText="@Localizer["NoItemsHelp", Localizer["Shift"]]" EndIcon="fa-regular fa-refresh">
                @Localizer["Reload"]
            </StackButton>
        </Stack>
    }
    @foreach(var day in Enum.GetValues<DayOfWeek>().OrderBy(d => ((int)d - (int)DayOfWeek.Saturday + 7) % 7))
    {
        <Stack>
            <StackField Label="@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(day)" />
            @foreach(var shift in shifts.Where(s => s.DayOfWeek == day))
            {
                <StackButton OnClick="() => OnClicked.InvokeAsync(shift.Id)"
                             Label="@shift.Title"
                             HelperText="@($"{shift.TotalSeats} {Localizer["TotalSeats"]}")"
                             HighlightString="@SearchString">
                    <ShiftStatusBadge Status="shift.Status" />
                </StackButton>
            }
            @if(AdminMode)
            {
                <StackButton Color="Color.Primary"
                             Label="@Localizer["AddItem", Localizer["Shift"]]"
                             EndIcon="fa-regular fa-calendar-plus"
                             OnClick="() => OnAdd.InvokeAsync(day)" />
            }
        </Stack>
    }
}
else
{
    @Plugin.Render(new ShiftsGridPluginContext(OnClicked, OnAdd))
}
