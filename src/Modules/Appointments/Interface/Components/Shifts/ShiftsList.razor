@inherits ShiftsBase

@if(Plugin is null)
{
    @if(shifts.Count == 0)
    {
        <Stack>
            <StackButton OnClick="ReloadRequired" Label="@Localizer["Reload"]" HelperText="@Localizer["NoItemsHelp", Localizer["Shift"]]" EndIcon="fa-solid fa-refresh" Color="Color.Secondary"/>
        </Stack>
    }
    @foreach(var day in Enum.GetValues<DayOfWeek>().OrderBy(d => ((int)d - (int)DayOfWeek.Saturday + 7) % 7))
    {
        <Stack>
            <StackField Label="@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(day)" />
            @foreach(var shift in shifts.Where(s => s.DayOfWeek == day))
            {
                <StackExpandable OnClick="() => OnClicked.InvokeAsync(shift.Id)"
                                 Label="@shift.Title"
                                 HighlightString="@SearchString"
                                 Color="@shift.Status.ToColor()">
                    <ShiftReservationsCalendar ShiftId="shift.Id" OnSelected="OnShiftOccurrenceSelected" />
                </StackExpandable>
            }
            @if(AdminMode)
            {
                <StackButton Color="Color.Primary"
                             Label="@Localizer["AddItem", Localizer["Shift"]]"
                             EndIcon="fa-solid fa-calendar-plus"
                             OnClick="() => OnAdd.InvokeAsync(day)" />
            }
        </Stack>
    }
}
else
{
    @Plugin.Render(new ShiftsGridPluginContext(OnClicked, OnAdd))
}
