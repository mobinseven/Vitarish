@inherits ShiftsBase

@if (Plugin is null)
{
    <Stack>
        <StackSelect T="DayOfWeek" Label="@Localizer["DayOfWeek"]" @bind-Value="shiftWriteDto.DayOfWeek">
            @foreach (var day in Enum.GetValues<DayOfWeek>())
            {
                <StackSelectItem T="DayOfWeek" Value="day">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(day)</StackSelectItem>
            }
        </StackSelect>
        <StackTimePicker TimeOnlyValue="shiftWriteDto.StartTime"
                         TimeOnlyValueChanged="SetStartTime"
                         Label="@Localizer["StartTime"]"
                         MinuteStep="ShiftTimeStepMinutes" />
        <StackTimePicker @bind-TimeOnlyValue="shiftWriteDto.EndTime"
                         Label="@Localizer["EndTime"]"
                         Min="MinimumEndTime"
                         MinuteStep="ShiftTimeStepMinutes" />
        @* <StackTextField @bind-Value="shiftWriteDto.TimeZone" Label="@Localizer["TimeZone"]" /> *@
        <StackNumericField @bind-Value="shiftWriteDto.TotalSeats" Label="@Localizer["TotalSeats"]" Min="1" />
        <MudNumericField T="int?" Class="stack-item" @bind-Value="shiftWriteDto.BookingOpensBefore" Label="@Localizer["BookingOpensBefore"]" Min="0" Variant="Variant.Outlined" Underline="false" />
        <MudNumericField T="int?" Class="stack-item" @bind-Value="shiftWriteDto.BookingCloseBefore" Label="@Localizer["BookingCloseBefore"]" Min="0" Variant="Variant.Outlined" Underline="false" />
        <StackSelect T="ShiftStatus" Label="@Localizer["Status"]" @bind-Value="shiftWriteDto.Status">
            @foreach (var status in Enum.GetValues<ShiftStatus>())
            {
                <StackSelectItem T="ShiftStatus" Value="status">@Localizer[status.ToString()]</StackSelectItem>
            }
        </StackSelect>
        <StackSelect T="ShiftVisibility" Label="@Localizer["Visibility"]" @bind-Value="shiftWriteDto.Visibility">
            @foreach (var visibility in Enum.GetValues<ShiftVisibility>())
            {
                <StackSelectItem T="ShiftVisibility" Value="visibility">@Localizer[visibility.ToString()]</StackSelectItem>
            }
        </StackSelect>
        @if (serviceProviders.Count > 0)
        {
            <StackSelect T="Guid?" Label="@Localizer["ServiceProvider"]" @bind-Value="shiftWriteDto.ServiceProviderId">
                <StackSelectItem T="Guid?" Value="@((Guid?)null)">@Localizer["None"]</StackSelectItem>
                @foreach (var sp in serviceProviders)
                {
                    <StackSelectItem T="Guid?" Value="@((Guid?)sp.Id)">@sp.Name</StackSelectItem>
                }
            </StackSelect>
        }
        @if (availableServices.Count > 0)
        {
            <StackSelect T="Guid?" Label="@Localizer["Service"]" @bind-Value="shiftWriteDto.ServiceId">
                <StackSelectItem T="Guid?" Value="@((Guid?)null)">@Localizer["None"]</StackSelectItem>
                @foreach (var svc in availableServices)
                {
                    <StackSelectItem T="Guid?" Value="@((Guid?)svc.Id)">@svc.Name</StackSelectItem>
                }
            </StackSelect>
        }
    </Stack>
    <Stack>
        <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" EndIcon="fa-solid fa-save" />
        <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" EndIcon="fa-solid fa-xmark" Color="Color.Secondary" />
    </Stack>
}
else
{
    @Plugin.Render(new ShiftFormPluginContext(shiftWriteDto, OnSaved, OnCancelled))
}
