@inherits ShiftsBase

@if(Shift is null || AdminMode == false)
{
    return;
}

<Stack>
    <StackField Label="@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(Shift.DayOfWeek)" HelperText="@Localizer["DayOfWeek"]" />
    <StackField Label="@Shift.StartTime.ToString("t")" HelperText="@Localizer["StartTime"]" />
    <StackField Label="@Shift.EndTime.ToString("t")" HelperText="@Localizer["EndTime"]" />
    <StackField Label="@Shift.TotalSeats.ToString()" HelperText="@Localizer["Capacity"]" />
    <StackField Label="@Localizer["Status"]">
        <ShiftStatusBadge Status="@Shift.Status" />
    </StackField>
    @if (!string.IsNullOrWhiteSpace(serviceProviderName))
    {
        <StackField Label="@serviceProviderName" HelperText="@Localizer["ServiceProvider"]" />
    }
    @if (!string.IsNullOrWhiteSpace(serviceName))
    {
        <StackField Label="@serviceName" HelperText="@Localizer["Service"]" />
    }
</Stack>

@switch (Shift.Status)
{
    case ShiftStatus.Draft:
    <Stack>
        <StackButton Color="Color.Success"
                     Label="@Localizer["ActivateItem", Localizer["Shift"]]"
                     EndIcon="fa-regular fa-play"
                     OnClick="@(() => ChangeStatusAsync(ShiftStatus.Active))" />
        <StackButton Label="@Localizer["EditItem", Localizer["Shift"]]"
                     EndIcon="fa-regular fa-pen"
                     OnClick="OnEdit" />
        <StackButton Color="Color.Error"
                     Label="@Localizer["CancelItem", Localizer["Shift"]]"
                     EndIcon="fa-regular fa-xmark"
                     OnClick="@(() => ChangeStatusAsync(ShiftStatus.Cancelled))" />
    </Stack>
    break;

    case ShiftStatus.Active:
    <Stack>
        <StackButton Label="@Localizer["EditItem", Localizer["Shift"]]"
                     EndIcon="fa-regular fa-pen"
                     OnClick="OnEdit" />
        <StackButton Color="Color.Warning"
                     Label="@Localizer["PauseItem", Localizer["Shift"]]"
                     EndIcon="fa-regular fa-pause"
                     OnClick="@(() => ChangeStatusAsync(ShiftStatus.Paused))" />
        <StackButton Color="Color.Dark"
                     Label="@Localizer["CloseItem", Localizer["Shift"]]"
                     EndIcon="fa-regular fa-lock"
                     OnClick="@(() => ChangeStatusAsync(ShiftStatus.Closed))" />
        <StackButton Color="Color.Error"
                     Label="@Localizer["CancelItem", Localizer["Shift"]]"
                     EndIcon="fa-regular fa-xmark"
                     OnClick="@(() => ChangeStatusAsync(ShiftStatus.Cancelled))" />
    </Stack>
    break;

    case ShiftStatus.Paused:
    <Stack>
        <StackButton Color="Color.Success"
                     Label="@Localizer["ActivateItem", Localizer["Shift"]]"
                     EndIcon="fa-regular fa-play"
                     OnClick="@(() => ChangeStatusAsync(ShiftStatus.Active))" />
        <StackButton Color="Color.Dark"
                     Label="@Localizer["CloseItem", Localizer["Shift"]]"
                     EndIcon="fa-regular fa-lock"
                     OnClick="@(() => ChangeStatusAsync(ShiftStatus.Closed))" />
        <StackButton Color="Color.Error"
                     Label="@Localizer["CancelItem", Localizer["Shift"]]"
                     EndIcon="fa-regular fa-xmark"
                     OnClick="@(() => ChangeStatusAsync(ShiftStatus.Cancelled))" />
    </Stack>
    break;

    case ShiftStatus.Closed:
    case ShiftStatus.Cancelled:
    <Stack>
        <StackButton Color="Color.Dark"
                     Label="@Localizer["ArchiveItem", Localizer["Shift"]]"
                     EndIcon="fa-regular fa-box-archive"
                     OnClick="@(() => ChangeStatusAsync(ShiftStatus.Archived))" />
    </Stack>
    break;

    case ShiftStatus.Archived:
        // No actions for archived
        break;

    default:
        break;
}

@if (Shift.Status == ShiftStatus.Active)
{
    <Stack>
        <StackField Label="@Localizer["Reservations"]" />
        <ShiftReservationsCalendar ShiftId="@Shift.Id" OnSelected="OnShiftOccurrenceSelected" />
    </Stack>
}
<Stack>
    <StackField Label="@Localizer["ReminderPolicies"]" />
    <ShiftReminderPoliciesList ShiftId="@Shift.Id" />
</Stack>
