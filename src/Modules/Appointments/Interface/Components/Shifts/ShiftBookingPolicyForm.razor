@inherits ShiftBookingPoliciesBase

@if(Shift is null)
{
    return;
}

<Stack>
    <MudDatePicker Label="@Localizer["Date"]"
                   Date="@model.Date.ToDateTime(TimeOnly.MinValue)"
                   IsDateDisabledFunc="d=> Shift.DayOfWeek != d.DayOfWeek"
                   DateChanged="@(v => model = model with { Date = v.HasValue ? DateOnly.FromDateTime(v.Value) : default })"
                   HelperText="@Localizer["ShiftBookingPolicyDateHelp"]" />

    <MudSwitch T="bool"
               @bind-Value="model.Closed"
               Label="@Localizer["Closed"]" />

    <MudNumericField T="int?" Class="stack-item" @bind-Value="model.Capacity" Label="@Localizer["CapacityOverride"]" Min="1" Variant="Variant.Outlined" Underline="false" />
    <MudNumericField T="int?" Class="stack-item" @bind-Value="model.BookingOpensBefore" Label="@Localizer["BookingOpensBefore"]" Min="0" Variant="Variant.Outlined" Underline="false" />
    <MudNumericField T="int?" Class="stack-item" @bind-Value="model.BookingCloseBefore" Label="@Localizer["BookingCloseBefore"]" Min="0" Variant="Variant.Outlined" Underline="false" />
    <StackTimePicker Label="@Localizer["EstimatedSessionLength"]"
                     HelperText="@Localizer["EstimatedSessionLengthHelp"]"
                     @bind-Value="model.EstimatedSessionLength" />

    <StackCheckbox @bind-Value="model.RequiresApproval" Label="@Localizer["RequiresApproval"]" />
    <StackCheckbox @bind-Value="model.AllowRescheduling" Label="@Localizer["AllowRescheduling"]" />

    <StackButton Label="@Localizer["Save"]"
                 EndIcon="fa-solid fa-floppy-disk"
                 OnClick="SaveAsync" Color="Color.Primary" />
</Stack>
