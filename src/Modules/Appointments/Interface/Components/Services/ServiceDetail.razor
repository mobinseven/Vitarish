@inherits ServicesBase

@if (current is null)
{
    return;
}

<Stack>
    <StackField Label="@current.Name" HelperText="@Localizer["Service"]" />
    @if (!string.IsNullOrWhiteSpace(current.Description))
    {
        <StackField Label="@current.Description" HelperText="@Localizer["Description"]" />
    }
    @if (!string.IsNullOrWhiteSpace(current.ServiceTypeName))
    {
        <StackField Label="@current.ServiceTypeName" HelperText="@Localizer["ServiceType"]" />
    }
</Stack>
<Stack>
    @if (AdminMode)
    {
        <StackButton Label="@Localizer["EditItem", Localizer["Service"]]"
                     EndIcon="fa-solid fa-pen"
                     OnClick="OnEdit" />
        <StackButton Color="Color.Error"
                     Label="@Localizer["DeleteItem", Localizer["Service"]]"
                     EndIcon="fa-solid fa-trash"
                     OnClick="DeleteAsync" />
    }
</Stack>
