@inherits ServicesBase

<Stack>
    @if(services.Count == 0)
    {
        <StackButton OnClick="ReloadRequired"
                     Label="@Localizer["Reload"]"
                     HelperText="@Localizer["NoItemsHelp", Localizer["Service"]]"
                     EndIcon="fa-solid fa-refresh" Color="Color.Secondary"/>
    }
    else
    {
        @foreach(var item in services)
        {
            <StackExpandable Label="@item.Name"
                             HelperText="@item.ServiceTypeName"
                             HighlightString="@SearchString">
                <ExpandableContent>
                    <ServiceForm Service="@item" OnCancelled="() => context.CloseAsync()" OnSaved="() => context.CloseAsync()" />
                </ExpandableContent>
            </StackExpandable>
        }
    }
    @if(AdminMode)
    {
        <StackExpandable Color="Color.Primary"
                         Label="@Localizer["AddItem", Localizer["Service"]]"
                         EndIcon="fa-solid fa-plus">
            <ExpandableContent>
                <ServiceForm OnCancelled="() => context.CloseAsync()" OnSaved="() => context.CloseAsync()" />
            </ExpandableContent>
        </StackExpandable>
    }
</Stack>
