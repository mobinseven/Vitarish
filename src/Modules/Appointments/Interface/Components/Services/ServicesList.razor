@inherits ServicesBase

<Stack>
    @if (services.Count == 0)
    {
        <StackButton OnClick="ReloadRequired"
                     Label="@Localizer["NoItems", Localizer["Service"]]"
                     HelperText="@Localizer["NoItemsHelp", Localizer["Service"]]"
                     EndIcon="fa-regular fa-refresh">
            @Localizer["Reload"]
        </StackButton>
    }
    else
    {
        @foreach (var item in services)
        {
            <StackButton OnClick="() => OnClicked.InvokeAsync(item.Id)"
                         Label="@item.Name"
                         HelperText="@item.ServiceTypeName"
                         HighlightString="@SearchString" />
        }
    }
    @if (AdminMode)
    {
        <StackButton Color="Color.Primary"
                     Label="@Localizer["AddItem", Localizer["Service"]]"
                     EndIcon="fa-regular fa-plus"
                     OnClick="() => OnAdd.InvokeAsync()" />
    }
</Stack>
