@inherits ServiceTypesBase

<Stack>
    <StackTextField @bind-Value="writeDto.Name" Label="@Localizer["Name"]" />
    <StackTextField @bind-Value="writeDto.Description" Label="@Localizer["Description"]" />
</Stack>
<Stack>
    <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" EndIcon="fa-solid fa-save" />
    <StackButton Label="@Localizer["Cancel"]" OnClick="() => OnCancelled.InvokeAsync()" EndIcon="fa-solid fa-xmark" />
</Stack>
