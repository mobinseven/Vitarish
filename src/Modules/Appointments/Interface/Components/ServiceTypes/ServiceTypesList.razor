@inherits ServiceTypesBase

<Stack>
    @if(serviceTypes.Count == 0)
    {
        <StackButton OnClick="ReloadRequired"
                     Label="@Localizer["NoItems", Localizer["ServiceType"]]"
                     HelperText="@Localizer["NoItemsHelp", Localizer["ServiceType"]]"
                     EndIcon="fa-solid fa-refresh" Color="Color.Secondary">
            @Localizer["Reload"]
        </StackButton>
    }
    else
    {
        @foreach(var item in serviceTypes)
        {
            <StackExpandable Label="@item.Name"
                             HelperText="@item.Description"
                             HighlightString="@SearchString">
                <ExpandableContent>
                    <ServiceTypeForm ServiceType="@item" OnCancelled="() => context.CloseAsync()" OnSaved="() => context.CloseAsync()" />
                </ExpandableContent>
            </StackExpandable>
        }
    }
    @if(AdminMode)
    {
        <StackExpandable Color="Color.Primary"
                         Label="@Localizer["AddItem", Localizer["ServiceType"]]"
                         EndIcon="fa-solid fa-plus">
            <ExpandableContent>
                <ServiceTypeForm OnCancelled="() => context.CloseAsync()" OnSaved="() => context.CloseAsync()" />
            </ExpandableContent>
        </StackExpandable>
    }
</Stack>
