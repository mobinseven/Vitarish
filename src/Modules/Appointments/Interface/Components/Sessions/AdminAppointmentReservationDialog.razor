@inherits AppointmentSessionsBase

<MudDialog>
    <DialogContent>
        <Stack>
            <StackSelect T="string?" Label="@Localizer["User"]" @bind-Value="selectedUserId">
                @foreach (var user in GetUsers())
                {
                    <MudSelectItem T="string?" Value="user.Id">@user.FullName</MudSelectItem>
                }
            </StackSelect>
        </Stack>
    </DialogContent>
    <DialogActions>
        <Stack>
            <StackButton Color="Color.Primary"
                         Label="@Localizer["Save"]"
                         EndIcon="fa-regular fa-save"
                         OnClick="SaveAsync" />
            <StackButton Label="@Localizer["Cancel"]"
                         EndIcon="fa-regular fa-xmark"
                         OnClick="Cancel" />
        </Stack>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public AppointmentSessionReadDto Session { get; set; } = default!;

    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string? selectedUserId;

    private async Task SaveAsync()
    {
        if (selectedUserId is null)
        {
            _ = Snackbar.Add(Localizer["UserSelectionRequired"].Value, Severity.Warning);
            return;
        }

        await SessionsService.ReserveForUserAsync(Session.Id, selectedUserId, CancellationToken.None);
        _ = Snackbar.Add(Localizer["Saved"], Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
