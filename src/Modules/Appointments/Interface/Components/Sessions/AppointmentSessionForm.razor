@inherits AppointmentSessionsBase

<Stack>
    <StackDatePicker @bind-Date="sessionAtDate" Label="@Localizer["Date"]" />
    <StackTimePicker @bind-Time="sessionAtTime" Label="@Localizer["Time"]" />
    <StackNumericField @bind-Value="sessionWriteDto.Capacity" Label="@Localizer["Capacity"]" Min="1" />
    @if (IsAdmin)
    {
        <StackSelect T="AppointmentSessionStatus" Label="@Localizer["Status"]" @bind-Value="sessionWriteDto.Status">
            @foreach (var status in Enum.GetValues<AppointmentSessionStatus>())
            {
                <MudSelectItem T="AppointmentSessionStatus" Value="status">@Localizer[status.ToString()]</MudSelectItem>
            }
        </StackSelect>
    }
</Stack>
<Stack>
    <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" EndIcon="fa-regular fa-save" />
    <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" EndIcon="fa-regular fa-xmark" />
</Stack>
