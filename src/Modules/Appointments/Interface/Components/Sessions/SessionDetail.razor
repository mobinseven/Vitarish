@inherits SessionsBase

@if (Session is null)
{
    return;
}

<Stack>
    <StackField Label="@Session.Title" HelperText="@Localizer["Session"]">
        <SessionStatusBadge Status="@Session.Status" />
    </StackField>
    @if (Session.StartAt is not null)
    {
        <StackField Label="@Session.StartAt.Value.ToString("f")" HelperText="@Localizer["StartTime"]" />
    }
    @if (Session.EndAt is not null)
    {
        <StackField Label="@Session.EndAt.Value.ToString("f")" HelperText="@Localizer["EndTime"]" />
    }
    <StackField Label="@Session.TimeZone" HelperText="@Localizer["TimeZone"]" />
    <StackField Label="@Session.TotalSeats.ToString()" HelperText="@Localizer["TotalSeats"]" />
    <StackField Label="@($"{Session.Stats.ReservationCount} {Localizer["Reservations"]}")" HelperText="@Localizer["Reservations"]" />
</Stack>

@if (Session.Status == SessionStatus.Active && !hasReservation)
{
    <Stack>
        <SessionOccurrencesList SessionId="@Session.Id" OnClicked="ReserveAsync" />
    </Stack>
}
else if (hasReservation)
{
    <Stack>
        <StackButton Color="Color.Error"
                     Label="@Localizer["CancelItem", Localizer["Reservation"]]"
                     EndIcon="fa-regular fa-calendar-xmark"
                     OnClick="CancelReservationAsync" />
    </Stack>
}
