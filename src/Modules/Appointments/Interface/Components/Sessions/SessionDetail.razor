@inherits SessionsBase

@if (current is null)
{
    return;
}

<Stack>
    <StackField Label="@current.ScheduledAt.ToString("f")" HelperText="@Localizer["ScheduledAt"]">
        <SessionStatusBadge Status="@current.Status" />
    </StackField>
    <StackField Label="@((current.Capacity - current.ReservationCount).ToString())" HelperText="@Localizer["AvailableSeats"]" />
</Stack>

@if (current.Status is SessionStatus.Active && current.Capacity > current.ReservationCount)
{
    <Stack>
        <StackButton Color="Color.Primary"
                     Label="@Localizer["ReserveASeat"]"
                     EndIcon="fa-regular fa-calendar-plus"
                     OnClick="OnReserve" />
    </Stack>
}
