@inherits SessionsBase

@if (Plugin is null)
{
    @if (IsAdmin)
    {
        <Stack>
            <SessionFilters @bind-Descriptor="Descriptor" />
        </Stack>
    }
    @if (sessions.Count == 0)
    {
        <Stack>
            <StackButton OnClick="ReloadRequired"
                         Label="@Localizer["NoItems", Localizer["Session"]]"
                         HelperText="@Localizer["NoItemsHelp", Localizer["Session"]]"
                         EndIcon="fa-regular fa-refresh">
                @Localizer["Reload"]
            </StackButton>
        </Stack>
    }
    else
    {
        <Stack>
            @foreach (var session in sessions)
            {
                <StackButton OnClick="() => OnClicked.InvokeAsync(session.Id)"
                             Label="@session.ScheduledAt.ToString("f")"
                             HelperText="@session.ScheduledAt.ToString("f")"
                             HighlightString="@SearchString">
                    <SessionStatusBadge Status="@session.Status" />
                    <MudChip T="string" Size="Size.Small">@((session.Capacity - session.ReservationCount).ToString()) @Localizer["Available"]</MudChip>
                </StackButton>
            }
        </Stack>
    }
}
else
{
    @Plugin.Render(new SessionsGridPluginContext(OnClicked, OnAdd))
}
