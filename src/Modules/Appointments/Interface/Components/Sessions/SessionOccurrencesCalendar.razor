@inherits SessionsBase

@if(occurrences.Count == 0)
{
    <StackButton OnClick="ReloadRequired" Label="@Localizer["NoItems", Localizer["SessionOccurrence"]]" HelperText="@Localizer["NoItemsHelp", Localizer["SessionOccurrence"]]" EndIcon="fa-regular fa-refresh">
        @Localizer["Reload"]
    </StackButton>
}
else
{
    <StackCalendar MinDate="@DateTime.Today">

        <DayTemplate Context="day">
            @{
                var occurrence = occurrences.FirstOrDefault(i => i.Date == DateOnly.FromDateTime(day.Date));
            }
            <MudBadge Dot Visible="occurrence is not null" Color="occurrence?.Stats.ReservationCount > 0 ? Color.Primary : Color.Default">
                <span @onclick="() => OnSelected.InvokeAsync(occurrence)">@day.DayNumber</span>
            </MudBadge>
        </DayTemplate>

        <MonthTemplate Context="month">
            <span>@month.ShortName</span>
        </MonthTemplate>

        <YearTemplate Context="year">
            <span>@year.Year</span>
        </YearTemplate>
    </StackCalendar>
}
