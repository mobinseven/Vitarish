@inherits AppointmentSessionsBase

@if (Plugin is null)
{
    @if (IsAdmin)
    {
        <Stack>
            <StackButton Color="Color.Primary"
                         Label="@Localizer["AddItem", Localizer["AppointmentSession"]]"
                         EndIcon="fa-regular fa-calendar-plus"
                         OnClick="AddSession" />
        </Stack>
    }
    @if (sessions.Count == 0)
    {
        <Stack>
            <StackButton OnClick="ReloadRequired" Label="@Localizer["NoItems", Localizer["AppointmentSession"]]" HelperText="@Localizer["NoItemsHelp", Localizer["AppointmentSession"]]" EndIcon="fa-regular fa-refresh">
                @Localizer["Reload"]
            </StackButton>
        </Stack>
    }
    else
    {
        <Stack>
            @foreach (var session in sessions)
            {
                <StackButton OnClick="() => OnClicked.InvokeAsync(session.Id)"
                             Label="@session.DateTime.ToString("g")"
                             HelperText="@($"{session.Stats.ReservationCount}/{session.Capacity}")"
                             HighlightString="@SearchString">
                    <AppointmentSessionStatusBadge Status="session.Status" />
                </StackButton>
            }
        </Stack>
    }
}
else
{
    @Plugin.Render(new SessionsGridPluginContext(OnClicked, OnAdd))
}
