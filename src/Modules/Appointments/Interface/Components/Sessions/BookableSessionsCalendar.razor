@inherits Vitarish.Modules.Base.TenantCommonBase

@if(loading)
{
    <StackField Label="@Localizer["Loading"]" AdornmentIcon="fa-regular fa-circle-notch fa-spin" />
}
else if(slots.Count == 0)
{
    <StackField Label="@Localizer["NoItems", Localizer["AppointmentSession"]]"
                HelperText="@Localizer["NoItemsHelp", Localizer["AppointmentSession"]]" />
}
else
{
    <StackCalendar MinDate="@DateTime.Today">
        <DayTemplate Context="day">
            <button type="button"
                    class="@day.CssClass"
                    disabled="@day.IsDisabledForInteraction"
                    aria-current="@(day.IsToday ? "date" : null)"
                    aria-selected="@day.IsSelected"
                    @onclick="day.SelectAsync">
                @day.DayNumber
                @{
                    var slot = slots.FirstOrDefault(i => i.Occurrence?.Date == DateOnly.FromDateTime(day.Date));
                }
                @if(SlotActions is not null && slot is not null)
                {
                    @SlotActions(slot)
                }
            </button>
        </DayTemplate>
    </StackCalendar>
}
