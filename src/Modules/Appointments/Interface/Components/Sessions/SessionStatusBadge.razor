@inherits CommonBase

<MudChip T="string" Color="@StatusColor" Size="Size.Small" Variant="Variant.Filled">
    @Localizer[Status.ToString()]
</MudChip>

@code {
    [Parameter, EditorRequired] public AppointmentSessionStatus Status { get; set; }

    private Color StatusColor => Status switch
    {
        AppointmentSessionStatus.Open => Color.Success,
        AppointmentSessionStatus.Full => Color.Warning,
        AppointmentSessionStatus.Cancelled => Color.Error,
        AppointmentSessionStatus.Completed => Color.Dark,
        _ => Color.Default
    };
}
