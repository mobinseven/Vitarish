@inherits AppointmentSessionsBase

@if(Session is null)
{
    return;
}

<Stack>
    <StackField Label="@Session.DateTime.ToString("f")" HelperText="@Localizer["SessionDateTime"]">
        <AppointmentSessionStatusBadge Status="@Session.Status" />
    </StackField>
    <StackField Label="@($"{Session.Stats.ReservationCount} / {Session.Capacity}")" HelperText="@Localizer["Capacity"]" />
</Stack>

@if(Session.Status == AppointmentSessionStatus.Open)
{
    @if (hasReservation)
    {
        <Stack>
            <StackButton Color="Color.Error"
                         Label="@Localizer["CancelReservation"]"
                         EndIcon="fa-regular fa-calendar-xmark"
                         OnClick="CancelReservationAsync" />
        </Stack>
    }
    else if(Session.Stats.ReservationCount < Session.Capacity)
    {
        <Stack>
            <StackButton Color="Color.Primary"
                         Label="@Localizer["Reserve"]"
                         EndIcon="fa-regular fa-calendar-check"
                         OnClick="ReserveAsync" />
        </Stack>
    }
}
