@inherits SessionsBase

@if (current is null)
{
    return;
}

<Stack>
    @if (!string.IsNullOrWhiteSpace(current.AvatarUrl))
    {
        <MudImage Src="@current.AvatarUrl" Alt="@current.Name" Class="mx-auto" Height="100" ObjectFit="ObjectFit.Cover" />
    }
    @if (!string.IsNullOrWhiteSpace(current.Name))
    {
        <StackField Label="@current.Name" HelperText="@Localizer["Name"]">
            <SessionStatusBadge Status="@current.Status" />
        </StackField>
    }
    @if (!string.IsNullOrWhiteSpace(current.Description))
    {
        <StackField Label="@current.Description" HelperText="@Localizer["Description"]" />
    }
    <StackField Label="@current.ScheduledAt.ToString("f")" HelperText="@Localizer["ScheduledAt"]" />
    <StackField Label="@current.Capacity.ToString()" HelperText="@Localizer["Capacity"]" />
    <StackField Label="@current.ReservationCount.ToString()" HelperText="@Localizer["ReservationCount"]" />
</Stack>

<Stack>
    <StackButton Label="@Localizer["EditItem", Localizer["Session"]]"
                 EndIcon="fa-regular fa-calendar-pen"
                 OnClick="OnEdit" />
</Stack>

@if (current.Status is SessionStatus.Active)
{
    <Stack>
        <StackButton Color="Color.Error"
                     Label="@Localizer["CancelSession"]"
                     EndIcon="fa-regular fa-calendar-xmark"
                     OnClick="CancelSessionAsync" />
    </Stack>
}

<Stack>
    <StackButton Color="Color.Error"
                 Label="@Localizer["DeleteItem", Localizer["Session"]]"
                 EndIcon="fa-regular fa-trash"
                 OnClick="DeleteSessionAsync" />
</Stack>
