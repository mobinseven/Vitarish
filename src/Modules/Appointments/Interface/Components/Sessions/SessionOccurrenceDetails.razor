@inherits CommonBase
<StackField Label="@SessionOccurrence.Date.ToShortDateString()" />
<StackField Label="@($"{Localizer["Count", Localizer["Reservations"]]}: {SessionOccurrence.Stats.ReservationCount}")" />
<SessionReservationList SessionOccurrence="SessionOccurrence" />
<StackButton Label="@Localizer["AddItem", Localizer["Reservation"]]" OnClick="AddReservationAsync" EndIcon="fa-regular fa-plus" Color="Color.Primary" />

@code {
    [Parameter, EditorRequired] public SessionOccurrenceReadDto SessionOccurrence { get; set; }
    [Parameter] public EventCallback OnStatusChanged { get; set; }

    private async Task AddReservationAsync()
    {
        DialogParameters parameters = new()
        {
            { nameof(ReservationForSessionDialog.SessionId), SessionOccurrence.SessionId },
            { nameof(ReservationForSessionDialog.Date), SessionOccurrence.Date }
        };

        IDialogReference dialog = await DialogService.ShowAsync<ReservationForSessionDialog>(Localizer["AddItem", Localizer["Reservation"]], parameters);
        DialogResult? result = await dialog.Result;

        if(result is not null && !result.Canceled)
        {
            await OnStatusChanged.InvokeAsync();
        }
    }
}
