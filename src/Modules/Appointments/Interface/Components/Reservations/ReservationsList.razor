@inherits ReservationsBase

@if (Plugin is null)
{
    @if (AdminMode)
    {
        <Stack>
            <ReservationFilters @bind-Descriptor="Descriptor" />
        </Stack>
    }

    <Stack>
        @if (reservations.Count == 0)
        {
            <StackButton OnClick="ReloadRequired" Label="@Localizer["Reload"]" HelperText="@Localizer["NoItemsHelp", Localizer["Reservation"]]" EndIcon="fa-solid fa-refresh" Color="Color.Info"/>
        }
        else
        {
            @foreach (var reservation in reservations)
            {
                <StackButton OnClick="() => OnClicked.InvokeAsync(reservation.Id)"
                             Label="@($"{reservation.Date:d}")"
                             HighlightString="@SearchString" Color="Color.Info">
                    <ReservationStatusBadge Status="reservation.Status" />
                </StackButton>
            }
        }
    </Stack>
}
else
{
    @Plugin.Render(new AppointmentsGridPluginContext(OnClicked, OnAdd))
}
