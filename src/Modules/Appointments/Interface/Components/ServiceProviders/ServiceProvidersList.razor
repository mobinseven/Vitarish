@inherits ServiceProvidersBase

<Stack>
    @if(providers.Count == 0)
    {
        <StackButton OnClick="ReloadRequired"
                     Label="@Localizer["NoItems", Localizer["ServiceProvider"]]"
                     HelperText="@Localizer["NoItemsHelp", Localizer["ServiceProvider"]]"
                     EndIcon="fa-solid fa-refresh" Color="Color.Secondary">
            @Localizer["Reload"]
        </StackButton>
    }
    else
    {
        @foreach(var item in providers)
        {
            <StackExpandable Label="@item.Name"
                             HelperText="@item.Description"
                             HighlightString="@SearchString">
                    <ExpandableContent>
                        <ServiceProviderForm ServiceProvider="@item" OnCancelled="() => context.CloseAsync()" OnSaved="() => context.CloseAsync()" />
                    </ExpandableContent>
            </StackExpandable>
        }
    }
    @if(AdminMode)
    {
        <StackExpandable Color="Color.Primary"
                         Label="@Localizer["AddItem", Localizer["ServiceProvider"]]"
                         EndIcon="fa-solid fa-plus"
                         OnClick="() => OnAdd.InvokeAsync()">
            <ExpandableContent>
                <ServiceProviderForm OnCancelled="() => context.CloseAsync()" OnSaved="() => context.CloseAsync()" />
            </ExpandableContent>
        </StackExpandable>
    }
</Stack>
