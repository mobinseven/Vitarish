@inherits RemindersBase

<MudDialog>
    <DialogContent>

        <Stack>
            <StackField Label="@Localizer["Kind"]">
                <MudRadioGroup T="ReminderKind" @bind-Value=kind>
                    <MudRadio T="ReminderKind" Value="ReminderKind.Sms" Label="@Localizer["Sms"]" />
                    <MudRadio T="ReminderKind" Value="ReminderKind.Email" Label="@Localizer["Email"]" />
                </MudRadioGroup>
            </StackField>
            <ReminderSchedulePicker DateLabel="@Localizer["Date"]"
                                    TimeLabel="@Localizer["Time"]"
                                    @bind-Value="remindAt" />
            <StackButton Label="@Localizer["Recipients"]" OnClick="AddRecipientAsync" Color="@(recipients.Count == 0 ? Color.Warning : Color.Default)">
                @if(recipients.Count > 0)
                {
                    @recipients.Count
                }
            </StackButton>
        </Stack>

        <Stack>
            <StackButton Label="@Localizer["Save"]" OnClick="SaveAsync" Color="Color.Primary" Disabled="recipients.Count == 0" EndIcon="fa-solid fa-save" />
            <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" EndIcon="fa-solid fa-xmark" />
        </Stack>

    </DialogContent>
</MudDialog>
