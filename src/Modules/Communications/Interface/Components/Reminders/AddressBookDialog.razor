@inherits RemindersBase

<MudDialog>
    <DialogContent>
        <Stack>
            @foreach(var user in GetUsers().Where(u => !string.IsNullOrEmpty(GetUserAddressById(u.Id, Kind))))
            {
                <StackCheckbox ValueChanged="() => ToggleUser(user)" Value="IsSelected(user)" Label="@user.FullName" />
            }
            @foreach(var recipient in selected.Where(r => r.RecipientUserId is null))
            {
                <StackCheckbox ValueChanged="() => RemoveRecipient(recipient)" Value="true" Label="@recipient.Recipient" />
            }
            <StackTextField @bind-Value="customAddress" Label="@AddressLabel" Adornment="Adornment.End" AdornmentIcon="fa-solid fa-plus" OnAdornmentClick="AddCustom" />
        </Stack>
        <Stack>
            <StackButton Color="Color.Primary" OnClick="Confirm" Label="@Localizer["Confirm"]" EndIcon="fa-solid fa-check" />
            <StackButton EndIcon="fa-solid fa-xmark" Label="@Localizer["Cancel"]" OnClick="Cancel" />
        </Stack>
    </DialogContent>
</MudDialog>
