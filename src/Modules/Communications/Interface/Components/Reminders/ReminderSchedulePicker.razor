<StackDatePicker Label="@DateLabel"
                 Date="@remindDate"
                 DateChanged="SetDateAsync"
                 MinDate="@DateTime.Now.Date" />
<StackTimePicker Label="@TimeLabel"
                 Time="@remindTime"
                 TimeChanged="SetTimeAsync" />

@code {
    [Parameter, EditorRequired]
    public string DateLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string TimeLabel { get; set; } = string.Empty;

    [Parameter]
    public DateTime Value { get; set; }

    [Parameter]
    public EventCallback<DateTime> ValueChanged { get; set; }

    private DateTime? remindDate;
    private TimeSpan? remindTime;
    private DateTime lastValue;

    protected override void OnParametersSet()
    {
        DateTime value = Value == default ? DateTime.Now.ToUniversalTime() : EnsureUtc(Value);
        if (remindDate.HasValue && remindTime.HasValue && value == lastValue)
        {
            return;
        }

        DateTime localValue = value.ToLocalTime();
        remindDate = localValue.Date;
        remindTime = localValue.TimeOfDay;
        lastValue = value;
    }

    private async Task SetDateAsync(DateTime? value)
    {
        remindDate = value;
        await PublishValueAsync();
    }

    private async Task SetTimeAsync(TimeSpan? value)
    {
        remindTime = value;
        await PublishValueAsync();
    }

    private async Task PublishValueAsync()
    {
        if (!remindDate.HasValue || !remindTime.HasValue)
        {
            return;
        }

        DateTime localSelection = DateTime.SpecifyKind(remindDate.Value.Date + remindTime.Value, DateTimeKind.Local);
        lastValue = localSelection.ToUniversalTime();
        await ValueChanged.InvokeAsync(lastValue);
    }

    private static DateTime EnsureUtc(DateTime value)
        => value.Kind switch
        {
            DateTimeKind.Utc => value,
            DateTimeKind.Local => value.ToUniversalTime(),
            _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
        };
}
