@inherits CommonBase
<Stack>
    <StackField Label="@Localizer["CommunicationsMessages"]" />
    <StackTextField Label="@Localizer["Recipient"]" @bind-Value="recipient" />
    <StackTextField Label="@Localizer["Subject"]" @bind-Value="subject" />
    <StackTextField Label="@Localizer["Body"]" @bind-Value="body" Lines="4" />
    <StackTextField Label="@Localizer["HtmlBody"]" @bind-Value="htmlBody" Lines="4" />
    <StackTextField Label="@Localizer["Project"]" @bind-Value="reminderProject" />
    <StackTextField Label="@Localizer["Procedure"]" @bind-Value="reminderProcedure" />
    <StackTextField Label="@Localizer["Event"]" @bind-Value="reminderEvent" />
    <StackTextField Label="@Localizer["Tenant"]" @bind-Value="reminderTenant" />

    <StackButton Label="@Localizer["SendEmail"]"
                 EndIcon="fa-solid fa-envelope"
                 Color="Color.Primary"
                 OnClick="SendEmailAsync" />
    <StackButton Label="@Localizer["SendSms"]"
                 EndIcon="fa-solid fa-message-sms"
                 Color="Color.Primary"
                 OnClick="SendSmsAsync" />
    <StackButton Label="@Localizer["SendSmsCode"]"
                 EndIcon="fa-solid fa-key"
                 Color="Color.Default"
                 OnClick="SendSmsCodeAsync" />
    <StackButton Label="@Localizer["SendSmsReminder"]"
                 EndIcon="fa-solid fa-bell-ring"
                 Color="Color.Default"
                 OnClick="SendSmsReminderAsync" />

    @if (!string.IsNullOrWhiteSpace(lastSmsMessageId))
    {
        <StackTextField Label="@Localizer["MessageId"]" @bind-Value="lastSmsMessageId" />
        <StackButton Label="@Localizer["CheckSmsDeliveryState"]"
                     EndIcon="fa-solid fa-chart-line-up-down"
                     OnClick="CheckDeliveryStateAsync" Color="Color.Secondary" />
    }

    @if (!string.IsNullOrWhiteSpace(status))
    {
        <MudAlert Severity="@statusSeverity">@status</MudAlert>
    }
</Stack>

@code {
    private readonly CancellationTokenSource componentCancellation = new();
    [Inject] private ICommunicationsClient CommunicationsClient { get; set; } = default!;
    private CancellationToken ComponentCancellationToken => componentCancellation.Token;

    private string recipient = string.Empty;
    private string subject = "Manual Communications Test";
    private string body = "Manual communications message test.";
    private string htmlBody = "<p>Manual communications message test.</p>";
    private string? reminderProject;
    private string? reminderProcedure;
    private string? reminderEvent;
    private string? reminderTenant;

    private string? lastSmsMessageId;
    private string? status;
    private Severity statusSeverity = Severity.Info;

    private async Task SendEmailAsync()
    {
        if (string.IsNullOrWhiteSpace(recipient))
        {
            SetStatus(Localizer["RecipientIsRequired"].Value, Severity.Warning);
            return;
        }

        CommunicationsCommandResult result = await CommunicationsClient.SendEmailAsync(new SendEmailRequest(recipient, subject, body, htmlBody), ComponentCancellationToken);
        SetCommandStatus(result, GetLocalizedText("EmailQueued", "Email queued."));
    }

    private async Task SendSmsAsync()
    {
        if (string.IsNullOrWhiteSpace(recipient))
        {
            SetStatus(Localizer["RecipientIsRequired"].Value, Severity.Warning);
            return;
        }

        CommunicationsCommandResult result = await CommunicationsClient.SendSmsAsync(new SendSmsRequest(recipient, body), ComponentCancellationToken);
        lastSmsMessageId = result.MessageId;
        SetCommandStatus(result, GetLocalizedText("SmsQueued", "SMS queued."));
    }

    private async Task SendSmsCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(recipient))
        {
            SetStatus(Localizer["RecipientIsRequired"].Value, Severity.Warning);
            return;
        }

        CommunicationsCommandResult result = await CommunicationsClient.SendSmsCodeAsync(new SendSmsCodeRequest(recipient, body), ComponentCancellationToken);
        SetCommandStatus(result, GetLocalizedText("SmsCodeQueued", "SMS code queued."));
    }

    private async Task SendSmsReminderAsync()
    {
        if (string.IsNullOrWhiteSpace(recipient))
        {
            SetStatus(Localizer["RecipientIsRequired"].Value, Severity.Warning);
            return;
        }

        CommunicationsCommandResult result = await CommunicationsClient.SendSmsReminderAsync(new SendSmsReminderRequest(recipient, reminderProject, reminderProcedure, reminderEvent, reminderTenant), ComponentCancellationToken);
        SetCommandStatus(result, GetLocalizedText("SmsReminderQueued", "SMS reminder queued."));
    }

    private async Task CheckDeliveryStateAsync()
    {
        if (!long.TryParse(lastSmsMessageId, out long messageId))
        {
            SetStatus(Localizer["InvalidMessageId"].Value, Severity.Warning);
            return;
        }

        CommunicationsQueryResult<Vitarish.Communications.Contracts.Responses.SmsDeliveryStateResponse> result = await CommunicationsClient.GetSmsDeliveryStateAsync(messageId, ComponentCancellationToken);
        if (!result.IsSuccess || result.Value is null)
        {
            SetStatus(result.Error?.Message ?? GetLocalizedText("DeliveryStateUnavailable", "Delivery state is unavailable."), Severity.Error);
            return;
        }

        string stateStatus = result.Value.Status ?? Localizer["Unknown"].Value;
        string stateMessage = string.IsNullOrWhiteSpace(result.Value.MessageText)
            ? stateStatus
            : $"{stateStatus}: {result.Value.MessageText}";
        SetStatus(stateMessage, Severity.Info);
    }

    private void SetCommandStatus(CommunicationsCommandResult result, string successMessage)
    {
        SetStatus(result.IsSuccess ? successMessage : result.Error?.Message ?? result.Status.ToString(), result.IsSuccess ? Severity.Success : Severity.Error);
    }

    private void SetStatus(string message, Severity severity)
    {
        status = message;
        statusSeverity = severity;
    }

    public void Dispose()
    {
        componentCancellation.Cancel();
        componentCancellation.Dispose();
    }

    private string GetLocalizedText(string key, string fallback)
    {
        LocalizedString localized = Localizer[key];
        return localized.ResourceNotFound ? fallback : localized.Value;
    }
}
