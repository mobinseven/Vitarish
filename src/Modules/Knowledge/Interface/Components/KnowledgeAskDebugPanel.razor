<Stack>
    <StackTextField Label="Question" @bind-Value="question" />
    <StackNumericField Label="TopK" @bind-Value="topK" Min="1" Max="20" />
    <StackSelect T="KnowledgeRetrievalMode" Label="Retrieval mode" @bind-Value="retrievalMode">
        <StackSelectItem T="KnowledgeRetrievalMode" Value="KnowledgeRetrievalMode.Balanced">Balanced</StackSelectItem>
        <StackSelectItem T="KnowledgeRetrievalMode" Value="KnowledgeRetrievalMode.Broad">Broad</StackSelectItem>
    </StackSelect>
    <StackButton Label="Debug ask" Color="Color.Primary" OnClick="DebugAsync" />
    @if (result is not null)
    {
        <StackCard Label="Failure stage" HelperText="@result.FailureReason"><MudText>@result.FailureStage</MudText></StackCard>
        <StackCard Label="Packed context chunk ids"><MudText>@string.Join(", ", result.ContextChunkIds)</MudText></StackCard>
        <StackCard Label="Generated answer" HelperText="@(result.Answer.MissingInformation ?? "No missing information")"><MudText Style="white-space: pre-wrap">@result.Answer.Answer</MudText></StackCard>
        <StackCard Label="Citations"><MudText>@string.Join(", ", result.Answer.Citations.Select(citation => citation.ChunkId))</MudText></StackCard>
        @foreach (KnowledgeRetrievalHit hit in result.RetrievedHits)
        {
            <StackCard Label="@(hit.Title ?? hit.ChunkId.ToString())" Caption="@hit.ChunkId.ToString()" HelperText="@($"Score {hit.Score:0.###} · Cited {result.Answer.Citations.Any(citation => citation.ChunkId == hit.ChunkId)}")">
                <MudText Typo="Typo.body2">@Preview(hit.Text)</MudText>
            </StackCard>
        }
    }
</Stack>

@code {
    [Parameter, EditorRequired] public string CorpusId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string TenantId { get; set; } = string.Empty;
    [Inject] private IKnowledgeClient KnowledgeClient { get; set; } = default!;
    private string question = string.Empty;
    private int topK = 8;
    private KnowledgeRetrievalMode retrievalMode = KnowledgeRetrievalMode.Balanced;
    private KnowledgeAskDebugModel? result;
    private async Task DebugAsync()
    {
        if (string.IsNullOrWhiteSpace(question)) return;
        var response = await KnowledgeClient.DebugAskAsync(new AskKnowledgeRequest(ParseId(CorpusId), question.Trim(), topK, retrievalMode), CancellationToken.None);
        result = response.Value;
    }
    private static Guid ParseId(string id) => Guid.TryParse(id?.Trim(), out Guid value) ? value : throw new InvalidOperationException("CorpusId must be a GUID.");
    private static string Preview(string text) => text.Length <= 240 ? text : text[..240];
}
