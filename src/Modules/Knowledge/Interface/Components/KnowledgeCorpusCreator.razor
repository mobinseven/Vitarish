@inherits CommonBase
@using Microsoft.AspNetCore.Components

<StackButton Label="@Localizer["AddItem", Localizer["Corpus"]]" OnClick="OpenCreateCorpusDialog" EndIcon="fa-solid fa-plus" Color="Color.Success" />
<MudDialog @bind-Visible="createCorpusDialogOpen" Options="@ActiveDialogOptions">
    <DialogContent>
        <Stack>
            <StackField Label="Create corpus" HelperText="Use a meaningful name and optional description. The system creates the internal identifier automatically." />
            <StackTextField @bind-Value="name" Label="Name" />
            <StackTextField @bind-Value="description" Label="Description" Lines="2" />
            @* <StackCheckbox @bind-Value="isActive" Label="Enabled" /> *@
        </Stack>
        <Stack>
            <StackButton Label="@Localizer["AddItem", Localizer["Corpus"]]" EndIcon="fa-solid fa-plus" Color="Color.Primary" OnClick="CreateAsync" Disabled="@IsBusy" />
            <StackButton Label="Close" Color="Color.Secondary" OnClick="CloseCreateCorpusDialog" EndIcon="fa-solid fa-xmark" Disabled="@IsBusy" />
        </Stack>
    </DialogContent>
</MudDialog>

@code {
    private string name = string.Empty;
    private string? description;
    private bool isActive = true;
    private int observedResetVersion = -1;


    private DialogOptions ActiveDialogOptions => new() { BackdropClick = !IsBusy, CloseOnEscapeKey = !IsBusy };
    private bool createCorpusDialogOpen;
    private void OpenCreateCorpusDialog() { createCorpusDialogOpen = true; }
    private void CloseCreateCorpusDialog() => createCorpusDialogOpen = false;

    [Parameter, EditorRequired]
    public bool IsBusy { get; set; }

    [Parameter]
    public int ResetVersion { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<CreateKnowledgeCorpusRequest> CreateRequested { get; set; }

    protected override void OnParametersSet()
    {
        if (observedResetVersion == ResetVersion)
        {
            return;
        }

        observedResetVersion = ResetVersion;
        ResetForm();
    }

    private async Task CreateAsync()
    {
        await CreateRequested.InvokeAsync(new CreateKnowledgeCorpusRequest(name, description, isActive));
        CloseCreateCorpusDialog();
    }

    private void ResetForm()
    {
        name = string.Empty;
        description = null;
        isActive = true;
    }
}
