@inherits CommonBase
@using Vitarish.Knowledge.Contracts.Enums

<StackButton Label="@Localizer["AddItem", Localizer["Source"]]" EndIcon="fa-solid fa-plus" OnClick="OpenImportSourceDialog" />

<MudDialog @bind-Visible="importSourceDialogOpen" Options="@ActiveDialogOptions">
    <DialogContent>
        <Stack>
            <StackTextField @bind-Value="sourceName" Label="@Localizer["NameItem", Localizer["Source"]]" />

            <StackSelect T="KnowledgeSourceInputFormat" @bind-Value="format" Label="Source file format">
                @foreach(KnowledgeSourceInputFormat option in KnowledgeSourceInputFormatLabels.Formats)
                {
                    <StackSelectItem T="KnowledgeSourceInputFormat" Value="@option">@option.Label()</StackSelectItem>
                }
            </StackSelect>

            <StackFileInput @ref="fileTransfer" @bind-FileInfo="uploadedFile" Label="@Localizer["FileItem", Localizer["Source"]]" />

            @if(uploadedFile is not null)
            {
                <StackField Label="Selected file" HelperText="@DescribeUploadedFile()" Color="Color.Info" />
            }
        </Stack>
        <Stack>
            <StackButton Label="@Localizer["Import"]" EndIcon="fa-solid fa-cloud-arrow-up" Color="@Color.Primary" OnClick="StartFileUploadAsync" Disabled="@(IsBusy || isUploading)" />
            <StackButton Label="Close" Color="Color.Secondary" EndIcon="fa-solid fa-xmark" OnClick="CloseImportSourceDialog" Disabled="@IsBusy" />
        </Stack>
    </DialogContent>
</MudDialog>

@code {
    private StackFileInput? fileTransfer;
    private bool importSourceDialogOpen;
    private FileInformationDto? uploadedFile;
    private string sourceName = "Uploaded file";
    private KnowledgeSourceInputFormat format = KnowledgeSourceInputFormat.Markdown;
    private DialogOptions ActiveDialogOptions => new() { BackdropClick = !IsBusy, CloseOnEscapeKey = !IsBusy };

    private void OpenImportSourceDialog() { importSourceDialogOpen = true; }
    private void CloseImportSourceDialog() => importSourceDialogOpen = false;

    [Parameter, EditorRequired]
    public bool IsBusy { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<KnowledgeSourcePayload> SubmitRequested { get; set; }

    private bool isUploading;

    private async Task StartFileUploadAsync()
    {
        if (fileTransfer is not null)
        {
            try
            {
                isUploading = true;
                await fileTransfer.Upload();
                await SubmitAsync();
            }
            finally
            {
                isUploading = false;
            }
        }
    }

    private async Task SubmitAsync()
    {
        if(uploadedFile is null)
        {
            return;
        }
        await SubmitRequested.InvokeAsync(new KnowledgeSourcePayload(sourceName, format, uploadedFile.Id));
        CloseImportSourceDialog();
    }

    private string DescribeUploadedFile() => uploadedFile is null ? string.Empty : $"{uploadedFile.Tag ?? uploadedFile.Id.ToString()} ({uploadedFile.ContentType})";
}
