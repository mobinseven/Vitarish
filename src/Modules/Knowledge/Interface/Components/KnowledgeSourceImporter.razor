@using Vitarish.Modules.Base
@using Vitarish.Knowledge.Application.Owner
@using Microsoft.AspNetCore.Components

<Stack>
    <StackField Label="Import" HelperText="Imported content is added to the selected corpus." />

    @if(SelectedCorpus is null)
    {
        <StackCard Label="Select or create a corpus first" HelperText="Choose a corpus above before importing content." />
    }
    else
    {
        <StackCard Label="Importing into" HelperText="@SelectedCorpus.Label" />
    }

    <KnowledgeSourcePayloadEditor ActionLabel="Import pasted content into selected corpus"
                                  ActionColor="Color.Primary"
                                  ImportFormats="@ImportFormats"
                                  IsBusy="@IsBusy"
                                  SubmitRequested="ImportAsync" />

    <StackCard Label="Import uploaded file" HelperText="Upload through Files, then import without copying bytes into the pasted content payload.">
        <KnowledgeSourcePayloadEditor ActionLabel="Import selected file into selected corpus"
                                      ActionColor="Color.Secondary"
                                      ImportFormats="@ImportFormats"
                                      IsBusy="@(IsBusy || uploadedFile is null)"
                                      SubmitRequested="ImportFileAsync" />
        <StackFileInput @ref="fileTransfer" @bind-FileInfo="uploadedFile" />
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="@IsBusy" OnClick="StartFileUploadAsync">Upload selected file</MudButton>
        @if(uploadedFile is not null)
        {
            <StackField Label="Selected file" HelperText="@DescribeUploadedFile()" Color="Color.Info" />
        }
    </StackCard>

    @if(!string.IsNullOrWhiteSpace(ImportSummary))
    {
        <StackField Label="Import result" HelperText="@ImportSummary" Color="Color.Success" />
    }
</Stack>

@code {
    [Parameter]
    public KnowledgeOwnerCorpusOption? SelectedCorpus { get; set; }

    [Parameter, EditorRequired]
    public KnowledgeOwnerImportFormats ImportFormats { get; set; } = new([]);

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? ImportSummary { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ImportKnowledgeSourceInput> ImportRequested { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ImportKnowledgeSourceFromFileInput> FileImportRequested { get; set; }

    private StackFileInput? fileTransfer;
    private FileInformationReadDto? uploadedFile;

    private async Task ImportAsync(KnowledgeSourcePayload payload)
    {
        await ImportRequested.InvokeAsync(new ImportKnowledgeSourceInput(SelectedCorpus?.CorpusId, payload.SourceName, payload.FormatName, payload.Content));
    }

    private async Task StartFileUploadAsync()
    {
        if(fileTransfer is not null)
        {
            await fileTransfer.Upload();
        }
    }

    private Task FileUploadedAsync(FileInformationReadDto file)
    {
        uploadedFile = file;
        return Task.CompletedTask;
    }

    private async Task ImportFileAsync(KnowledgeSourcePayload payload)
    {
        await FileImportRequested.InvokeAsync(new ImportKnowledgeSourceFromFileInput(SelectedCorpus?.CorpusId, uploadedFile?.Id, payload.SourceName, payload.FormatName));
    }

    private string DescribeUploadedFile() => uploadedFile is null ? string.Empty : $"{uploadedFile.Tag ?? uploadedFile.Id.ToString()} ({uploadedFile.ContentType})";
}
