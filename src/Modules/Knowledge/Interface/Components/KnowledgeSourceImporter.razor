@using Vitarish.Modules.Base
@using Vitarish.Knowledge.Application.Owner
@using Microsoft.AspNetCore.Components

<Stack>
    <StackField Label="Import" HelperText="Imported file content is added to the selected corpus." />

    @if(SelectedCorpus is null)
    {
        <StackCard Label="Select or create a corpus first" HelperText="Choose a corpus above before importing content." />
    }
    else
    {
        <StackCard Label="Importing into" HelperText="@SelectedCorpus.Label" />
    }

    <StackCard Label="Import uploaded file" HelperText="Upload a markdown, text, or JSON source file, then import it into the selected corpus.">
        <KnowledgeSourcePayloadFileInput ActionLabel="Import selected file into selected corpus"
                                         ActionColor="Color.Secondary"
                                         IsBusy="@IsBusy"
                                         FileUploaded="FileUploadedAsync"
                                         SubmitRequested="ImportFileAsync" />
    </StackCard>

    @if(!string.IsNullOrWhiteSpace(ImportSummary))
    {
        <StackField Label="Import result" HelperText="@ImportSummary" Color="Color.Success" />
    }
</Stack>

@code {
    [Parameter]
    public KnowledgeOwnerCorpusOption? SelectedCorpus { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? ImportSummary { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ImportKnowledgeSourceFromFileInput> FileImportRequested { get; set; }

    private FileInformationReadDto? uploadedFile;

    private Task FileUploadedAsync(FileInformationReadDto file)
    {
        uploadedFile = file;
        return Task.CompletedTask;
    }

    private async Task ImportFileAsync(KnowledgeSourcePayload payload)
    {
        await FileImportRequested.InvokeAsync(new ImportKnowledgeSourceFromFileInput(SelectedCorpus?.CorpusId, uploadedFile?.Id, payload.SourceName, payload.Format));
    }
}
