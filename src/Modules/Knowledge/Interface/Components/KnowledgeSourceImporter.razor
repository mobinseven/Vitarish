@using Microsoft.AspNetCore.Components
@inherits CommonBase
@using CorpusItemModel = Vitarish.Knowledge.Contracts.Models.KnowledgeOwnerCorpusCollectionItem
<Stack>
    <StackField Label="@Localizer["ImportSource"]" HelperText="@Localizer["ImportSourceHelp"]" />
    <StackCard Label="@Localizer["SelectedItem", Localizer["Corpus"]]" HelperText="@SelectedCorpus.CorpusName" />
    <KnowledgeSourcePayloadFileInput IsBusy="@IsBusy"
                                     SubmitRequested="ImportFileAsync" />
</Stack>

@code {
    [Parameter, EditorRequired]
    public CorpusItemModel SelectedCorpus { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? ImportSummary { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ImportKnowledgeSourceFromFileRequest> FileImportRequested { get; set; }


    private async Task ImportFileAsync(KnowledgeSourcePayload payload)
    {
        await FileImportRequested.InvokeAsync(new ImportKnowledgeSourceFromFileRequest(SelectedCorpus?.CorpusId, payload.FileId, payload.SourceName, payload.Format));
    }
}
