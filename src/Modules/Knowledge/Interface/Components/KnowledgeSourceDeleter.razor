@using Vitarish.Interfaces.Base.Common
@using Vitarish.Modules.Base
@using Microsoft.AspNetCore.Components
@using SourceItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerSourceCollectionItem
@inherits CommonBase

<MudButton Color="Color.Error" EndIcon="@(IsBusy ? "fa-solid fa-circle-notch fa-spin" : "fa-solid fa-trash")" Disabled="@(IsBusy)" OnClick="ConfirmDeleteAsync">
    @Localizer["Delete"]
</MudButton>

@code {

    [Parameter, EditorRequired]
    public SourceItemModel Source { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> DeleteRequested { get; set; }

    [Parameter, EditorRequired]
    public bool IsBusy { get; set; }

    private async Task ConfirmDeleteAsync()
    {
        if(Source is null)
        {
            return;
        }

        DialogParameters parameters = new()
        {
            { nameof(StrictConfirmDialog.ContentText), Localizer["DeleteItemConfirmation", Localizer["Source"]].Value },
            { nameof(StrictConfirmDialog.ItemName), Source.SourceName },
            { nameof(StrictConfirmDialog.ButtonText), Localizer["Delete"].Value },
            { nameof(StrictConfirmDialog.Color), Color.Error }
        };

        IDialogReference dialog = await DialogService.ShowAsync<StrictConfirmDialog>(null, parameters);
        DialogResult? result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        await DeleteRequested.InvokeAsync(Source.SourceId);
    }
}
