@inherits CommonBase
@using Microsoft.AspNetCore.Components
@using CorpusItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerCorpusCollectionItem
@using SourceItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerSourceCollectionItem
@using SourceFileItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerSourceFileCollectionItem

<MudExpansionPanel Text="@Item.CorpusName" Class="glass" HeaderClass="glass">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText>@Item.CorpusName</MudText>
            @if(Item.IsActive)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@Localizer["Active"]</MudChip>
            }
            @if(IsSelected)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@Localizer["Selected"]</MudChip>
            }
        </MudStack>
    </TitleContent>
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(Item.CorpusDescription))
        {
            <MudText Typo="Typo.body2">@Item.CorpusDescription</MudText>
        }
        @if(!IsSelected)
        {
            <Stack>
                <StackButton Label="@Localizer["SelectItem", Localizer["Corpus"]]" EndIcon="fa-solid fa-check" OnClick="SelectCorpusAsync" Color="Color.Primary" />
            </Stack>
        }
        @if (Item.Sources.Count == 0)
        {
            <MudText Typo="Typo.body2">No sources have been imported into this corpus.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Class="stack">
                @foreach (SourceItemModel source in Item.Sources)
                {
                    <KnowledgeOwnerSourceCollectionItem Item="source" IsSelected="@(SelectedSourceId == source.SourceId)" SelectedSourceChanged="SelectedSourceChanged" />
                }
            </MudExpansionPanels>
        }
    </ChildContent>
</MudExpansionPanel>

@code {
    [Parameter, EditorRequired]
    public CorpusItemModel Item { get; set; } = new(Guid.Empty, string.Empty, null, false, []);

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public Guid? SelectedSourceId { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> SelectedCorpusChanged { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> SelectedSourceChanged { get; set; }

    private async Task SelectCorpusAsync() => await SelectedCorpusChanged.InvokeAsync(Item.CorpusId);
}
