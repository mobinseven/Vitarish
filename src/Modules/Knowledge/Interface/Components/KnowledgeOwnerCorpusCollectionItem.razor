@inherits CommonBase
@using Microsoft.AspNetCore.Components
@using CorpusItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerCorpusCollectionItem
@using SourceItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerSourceCollectionItem

<StackExpandable Label="@Item.CorpusName" HelperText="@Localizer["Corpus"]">
    <TitleContent>
        <StackButton OnClick="context.ToggleAsync">
            <MudText>@Item.CorpusName</MudText>
            @if(Item.IsActive)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@Localizer["Active"]</MudChip>
            }

        </StackButton>
    </TitleContent>
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(Item.CorpusDescription))
        {
            <MudText Typo="Typo.body2">@Item.CorpusDescription</MudText>
        }
        @if (Item.Sources.Count == 0)
        {
            <MudText Typo="Typo.body2">No sources have been imported into this corpus.</MudText>
        }
        else
        {
            @foreach(SourceItemModel source in Item.Sources)
            {
                <KnowledgeOwnerSourceCollectionItem Item="source" DeleteRequested="sourceId => DeleteRequested.InvokeAsync(new DeleteKnowledgeSourceInput(Item.CorpusId, sourceId))" IndexRequested="IndexRequested" IsBusy="IsBusy" />
            }
        }
        <KnowledgeSourcePayloadFileInput IsBusy="@IsBusy"
                                         SubmitRequested="ImportFileAsync" />
    </ChildContent>
</StackExpandable>

@code {

    [Parameter, EditorRequired]
    public bool IsBusy { get; set; }

    [Parameter, EditorRequired]
    public CorpusItemModel Item { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<DeleteKnowledgeSourceInput> DeleteRequested { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> IndexRequested { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ImportKnowledgeSourceFromFileInput> ImportRequested { get; set; }

    private async Task ImportFileAsync(KnowledgeSourcePayload payload)
    {
        await ImportRequested.InvokeAsync(new ImportKnowledgeSourceFromFileInput(Item.CorpusId, payload.FileId, payload.SourceName, payload.Format));
    }
}
