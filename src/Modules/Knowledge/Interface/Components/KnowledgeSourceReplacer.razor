@if (Sources.Count > 0)
{
    <Stack>
        <StackField Label="Replace source" HelperText="Replace the focused or chosen source in the selected corpus with uploaded file content." />

        <StackSelect T="KnowledgeOwnerSourceOption" @bind-Value="source" Label="Focused source to replace">
            @foreach (KnowledgeOwnerSourceOption option in Sources)
            {
                <MudSelectItem T="KnowledgeOwnerSourceOption" Value="@option">@option.Label</MudSelectItem>
            }
        </StackSelect>

        <KnowledgeSourcePayloadFileInput ActionLabel="Replace selected source with selected file"
                                         ActionColor="Color.Warning"
                                         IsBusy="@IsBusy"
                                         SubmitRequested="ReplaceFileAsync" />
    </Stack>
}

@code {
    private KnowledgeOwnerSourceOption? source;
    private int observedSourcesVersion = -1;
    private Guid? observedFocusedSourceId;

    [Parameter]
    public KnowledgeOwnerCorpusOption? SelectedCorpus { get; set; }

    [Parameter]
    public KnowledgeOwnerSourceOption? FocusedSource { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<KnowledgeOwnerSourceOption> Sources { get; set; } = [];

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public int SourcesVersion { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ReplaceKnowledgeSourceFromFileInput> ReplaceRequested { get; set; }

    protected override void OnParametersSet()
    {
        if (observedSourcesVersion == SourcesVersion && observedFocusedSourceId == FocusedSource?.SourceId)
        {
            return;
        }

        observedSourcesVersion = SourcesVersion;
        observedFocusedSourceId = FocusedSource?.SourceId;
        source = Sources.FirstOrDefault(option => option.SourceId == FocusedSource?.SourceId);
    }

    private async Task ReplaceFileAsync(KnowledgeSourcePayload payload)
    {
        await ReplaceRequested.InvokeAsync(new ReplaceKnowledgeSourceFromFileInput(SelectedCorpus?.CorpusId, source?.SourceId, payload.FileId, payload.SourceName, payload.Format));
    }
}
