@using Vitarish.Modules.Base
@using Vitarish.Knowledge.Application.Enums
@using Vitarish.Knowledge.Application.Owner
@using Microsoft.AspNetCore.Components

@if (Sources.Count > 0)
{
    <Stack>
        <StackField Label="Replace source" HelperText="Replace an existing source in the selected corpus with new pasted content." />

        <StackSelect T="KnowledgeOwnerSourceOption" @bind-Value="source" Label="Existing source to replace">
            @foreach (KnowledgeOwnerSourceOption option in Sources)
            {
                <MudSelectItem T="KnowledgeOwnerSourceOption" Value="@option">@option.Label</MudSelectItem>
            }
        </StackSelect>

        <StackTextField @bind-Value="sourceName" Label="Source name" />

        <StackSelect T="KnowledgeSourceInputFormat" @bind-Value="format" Label="Replacement content format">
            @foreach (KnowledgeSourceInputFormat option in KnowledgeSourceInputFormatLabels.Formats)
            {
                <MudSelectItem T="KnowledgeSourceInputFormat" Value="@option">@option.Label()</MudSelectItem>
            }
        </StackSelect>

        <StackTextField @bind-Value="content" Label="Paste replacement content" Lines="10" />

        <StackButton Label="Replace selected source" Color="Color.Warning" OnClick="ReplaceAsync" Disabled="@IsBusy" />
    </Stack>
}

@code {
    private KnowledgeOwnerSourceOption? source;
    private int observedSourcesVersion = -1;
    private string sourceName = "Replacement content";
    private KnowledgeSourceInputFormat format = KnowledgeSourceInputFormat.Markdown;
    private string content = string.Empty;

    [Parameter]
    public KnowledgeOwnerCorpusOption? SelectedCorpus { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<KnowledgeOwnerSourceOption> Sources { get; set; } = [];

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public int SourcesVersion { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ReplaceKnowledgeSourceInput> ReplaceRequested { get; set; }

    protected override void OnParametersSet()
    {
        if (observedSourcesVersion == SourcesVersion)
        {
            return;
        }

        observedSourcesVersion = SourcesVersion;
        source = null;
    }

    private async Task ReplaceAsync()
    {
        await ReplaceRequested.InvokeAsync(new ReplaceKnowledgeSourceInput(SelectedCorpus?.CorpusId, source?.SourceId, sourceName, format, content));
    }
}
