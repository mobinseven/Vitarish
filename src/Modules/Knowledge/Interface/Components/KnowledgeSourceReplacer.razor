@if (Sources.Count > 0)
{
    <Stack>
        <StackField Label="Replace source" HelperText="Replace the focused or chosen source in the selected corpus with uploaded file content." />

        <KnowledgeSourceSelector Label="Focused source to replace"
                                 FocusedSource="@FocusedSource"
                                 Sources="@Sources"
                                 SourcesVersion="@SourcesVersion"
                                 SelectedSourceChanged="SelectSource" />

        <KnowledgeSourcePayloadFileInput ActionLabel="Replace selected source with selected file"
                                         ActionColor="Color.Warning"
                                         IsBusy="@IsBusy"
                                         SubmitRequested="ReplaceFileAsync" />
    </Stack>
}

@code {
    private KnowledgeOwnerSourceOption? source;
    [Parameter]
    public KnowledgeOwnerCorpusOption? SelectedCorpus { get; set; }

    [Parameter]
    public KnowledgeOwnerSourceOption? FocusedSource { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<KnowledgeOwnerSourceOption> Sources { get; set; } = [];

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public int SourcesVersion { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ReplaceKnowledgeSourceFromFileRequest> ReplaceRequested { get; set; }

    private Task SelectSource(KnowledgeOwnerSourceOption? selected)
    {
        source = selected;
        return Task.CompletedTask;
    }

    private async Task ReplaceFileAsync(KnowledgeSourcePayload payload)
    {
        await ReplaceRequested.InvokeAsync(new ReplaceKnowledgeSourceFromFileRequest(SelectedCorpus?.CorpusId, source?.SourceId, payload.FileId, payload.SourceName, payload.Format));
    }
}
