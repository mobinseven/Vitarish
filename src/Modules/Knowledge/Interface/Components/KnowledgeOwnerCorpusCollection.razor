@inherits CommonBase
@using Microsoft.AspNetCore.Components
@using CorpusItemModel = Vitarish.Knowledge.Contracts.Models.KnowledgeOwnerCorpusCollectionItem

    @if(Model.Corpora.Count == 0)
{
    <StackCard Label="No corpora yet" HelperText="Create a corpus to start importing knowledge content." />
}
else
{
    @foreach(CorpusItemModel corpus in Model.Corpora)
    {
        <Stack>
            <KnowledgeOwnerCorpusCollectionItem Item="corpus" DeleteRequested="DeleteRequested" IndexRequested="IndexRequested" ImportRequested="ImportRequested" IsBusy="IsBusy" />
        </Stack>
    }
}

<KnowledgeCorpusCreator CreateRequested="CreateRequested" IsBusy="IsBusy" />

@code {

    [Parameter, EditorRequired]
    public bool IsBusy { get; set; }

    [Parameter, EditorRequired]
    public KnowledgeOwnerCollectionModel Model { get; set; } = KnowledgeOwnerCollectionModel.Empty;

    [Parameter, EditorRequired]
    public EventCallback<DeleteKnowledgeSourceRequest> DeleteRequested { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> IndexRequested { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ImportKnowledgeSourceFromFileRequest> ImportRequested { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<CreateKnowledgeCorpusRequest> CreateRequested { get; set; }
}
