@inherits CommonBase
@using Microsoft.AspNetCore.Components
@using CorpusItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerCorpusCollectionItem
@using SourceItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerSourceCollectionItem
@using SourceFileItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerSourceFileCollectionItem

    @if(Model.Corpora.Count == 0)
{
    <StackCard Label="No corpora yet" HelperText="Create a corpus to start importing knowledge content." />
}
else
{
    @foreach(CorpusItemModel corpus in Model.Corpora)
    {
        <Stack>
            <KnowledgeOwnerCorpusCollectionItem Item="corpus" IsSelected="@(Model.SelectedCorpusId == corpus.CorpusId)" FocusedSourceId="Model.FocusedSourceId" SelectedCorpusChanged="SelectedCorpusChanged" SelectedSourceChanged="SelectedSourceChanged" />
        </Stack>
    }
}

@code {
    [Parameter, EditorRequired]
    public KnowledgeOwnerCollectionReadModel Model { get; set; } = KnowledgeOwnerCollectionReadModel.Empty;

    [Parameter, EditorRequired]
    public EventCallback<Guid> SelectedCorpusChanged { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> SelectedSourceChanged { get; set; }
}
