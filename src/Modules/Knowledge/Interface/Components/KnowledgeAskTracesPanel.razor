<Stack>
    <StackSelect T="bool?" Label="Answered" @bind-Value="answered">
        <StackSelectItem T="bool?" Value="null">All</StackSelectItem>
        <StackSelectItem T="bool?" Value="true">Answered</StackSelectItem>
        <StackSelectItem T="bool?" Value="false">Refused</StackSelectItem>
    </StackSelect>
    <StackTextField Label="Trace kind" @bind-Value="traceKind" />
    <StackTextField Label="Question contains" @bind-Value="questionContains" />
    <StackButton Label="Apply trace filters" Color="Color.Primary" OnClick="LoadAsync" />
    @foreach (KnowledgeAskTraceDiagnostics trace in traces)
    {
        <StackCard Label="@trace.Question" Caption="@trace.CreatedAt.ToString("u")" HelperText="@($"Answered {trace.IsAnswered} · Retrieved {trace.RetrievedChunkIds.Count} · Citations {trace.Citations.Count} · Kind {trace.TraceKind ?? "-"}")">
            <MudText>@trace.MissingInformation</MudText>
            <MudButton Variant="Variant.Text" OnClick="@(() => opened = trace)">Open trace</MudButton>
        </StackCard>
    }
    @if (opened is not null)
    {
        <StackCard Label="Trace detail" HelperText="@opened.TraceId.ToString()">
            <MudText Typo="Typo.subtitle2">Question</MudText><MudText>@opened.Question</MudText>
            <MudText Typo="Typo.subtitle2">Retrieved chunks</MudText><MudText>@string.Join(", ", opened.RetrievedChunkIds)</MudText>
            <MudText Typo="Typo.subtitle2">Generated answer</MudText><MudText Style="white-space: pre-wrap">@opened.GeneratedAnswer</MudText>
            <MudText Typo="Typo.subtitle2">Citations</MudText><MudText Style="white-space: pre-wrap">@CitationSummary(opened.Citations)</MudText>
            <MudText Typo="Typo.subtitle2">Missing information</MudText><MudText>@opened.MissingInformation</MudText>
            <MudButton Variant="Variant.Text" OnClick="@(() => opened = null)">Close</MudButton>
        </StackCard>
    }
</Stack>

@code {
    [Parameter, EditorRequired] public string CorpusId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string TenantId { get; set; } = string.Empty;
    [Inject] private IKnowledgeDiagnosticsService Diagnostics { get; set; } = default!;
    private IReadOnlyList<KnowledgeAskTraceDiagnostics> traces = [];
    private KnowledgeAskTraceDiagnostics? opened;
    private bool? answered;
    private string? traceKind;
    private string? questionContains;
    protected override async Task OnParametersSetAsync() => await LoadAsync();
    private async Task LoadAsync() => traces = await Diagnostics.GetAskTracesAsync(ParseId(CorpusId), TenantId, new KnowledgeAskTraceDiagnosticsQuery { IsAnswered = answered, TraceKind = Blank(traceKind), QuestionContains = Blank(questionContains) }, CancellationToken.None);
    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static Guid ParseId(string id) => Guid.TryParse(id?.Trim(), out Guid value) ? value : throw new InvalidOperationException("CorpusId must be a GUID.");
    private static string CitationSummary(IReadOnlyList<KnowledgeCitation> citations) => citations.Count == 0 ? "None" : string.Join("\n", citations.Select(citation => $"{citation.ChunkId} · {citation.SourceId} · {citation.DocumentId}"));
}
