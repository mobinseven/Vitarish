@inherits CommonBase
@using Microsoft.AspNetCore.Components
@using CorpusItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerCorpusCollectionItem
@using SourceItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerSourceCollectionItem
@using SourceFileItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerSourceFileCollectionItem

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="stack-item">
    <MudText Typo="Typo.caption">@Localizer["Source"]</MudText>
    <MudText>@Item.SourceName</MudText>
    <MudChip T="string" Size="Size.Small" Color="Color.Info">@Item.SourceType</MudChip>
    @if(IsFocused)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Success">@Localizer["Focused for source actions"]</MudChip>
    }
    else
    {
        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" OnClick="SelectAsync">Focus source</MudButton>
    }
</MudStack>

@code {
    [Parameter, EditorRequired]
    public SourceItemModel Item { get; set; } = new(Guid.Empty, string.Empty, string.Empty, DateTimeOffset.MinValue, null, []);

    [Parameter]
    public bool IsFocused { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> SelectedSourceChanged { get; set; }

    private async Task SelectAsync() => await SelectedSourceChanged.InvokeAsync(Item.SourceId);
}
