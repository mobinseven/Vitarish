@inherits CommonBase
@using Microsoft.AspNetCore.Components
@using SourceItemModel = Vitarish.Knowledge.Contracts.Models.KnowledgeOwnerSourceCollectionItem

<StackButton>
    <MudText Typo="Typo.caption">@Localizer["Source"]</MudText>
    <MudText>@Item.SourceName</MudText>
    <MudChip T="string" Size="Size.Small" Color="Color.Info">@Item.SourceType</MudChip>
    <MudButton Disabled="IsBusy" EndIcon="fa-brands fa-searchengin" OnClick="() => IndexRequested.InvokeAsync(Item.SourceId)">@Localizer["Index"]</MudButton>
    <KnowledgeSourceDeleter Source="@Item" DeleteRequested="DeleteRequested" IsBusy="IsBusy" />
</StackButton>

@code {

    [Parameter, EditorRequired]
    public bool IsBusy { get; set; }

    [Parameter, EditorRequired]
    public SourceItemModel Item { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> DeleteRequested { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> IndexRequested { get; set; }
}
