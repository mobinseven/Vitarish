@inherits CommonBase
@if(Answer is not null)
{
    @if(!string.IsNullOrWhiteSpace(Answer.Answer))
    {
        <PaletteCard>
            @Answer.Answer
        </PaletteCard>
    }
    @if(Answer.RetrievedContext.Count > 0 || Answer.Citations.Count > 0 || !string.IsNullOrWhiteSpace(Answer.MissingInformation))
    {
        <Stack>
            @if(!string.IsNullOrWhiteSpace(Answer.MissingInformation))
            {
                <StackExpandable Size="Size.Small" Label="@Localizer["MissingInfo"]">
                    @Answer.MissingInformation
                </StackExpandable>
            }
            @if(Answer.RetrievedContext.Count > 0)
            {
                <StackExpandable Size="Size.Small" Label="@Localizer["RetrievedContext"]">
                    @foreach(KnowledgeHit hit in Answer.RetrievedContext)
                    {
                        <StackCard Size="Size.Small" Label="@ReadableTitle(hit.Title)" HelperText="@($"Score {hit.Score:0.###} · {Preview(hit.Text)}")" />
                    }
                </StackExpandable>
            }

            @if(Answer.Citations.Count > 0)
            {
                <StackExpandable Size="Size.Small" Label="@Localizer["Citations"]">
                    @foreach(KnowledgeCitation citation in Answer.Citations)
                    {
                        <StackCard Size="Size.Small" Label="@ReadableTitle(citation.Title)" HelperText="@(citation.Quote ?? "No quote")" />
                    }
                </StackExpandable>
            }
        </Stack>
    }
}


@code {

    [Parameter] public KnowledgeAnswer? Answer { get; set; }


    private static string CorpusLabel(KnowledgeOwnerCorpusOption corpus) => string.IsNullOrWhiteSpace(corpus.Details) ? corpus.Label : $"{corpus.Label} — {corpus.Details}";
    private static string ReadableTitle(string? title) => string.IsNullOrWhiteSpace(title) ? "Untitled source" : title;
    private static string Preview(string? text) => string.IsNullOrEmpty(text) ? string.Empty : (text.Length <= 240 ? text : string.Concat(text.AsSpan(0, 240), "…"));
}
