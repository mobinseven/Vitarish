@using System.Globalization
@using Vitarish.Modules.Base
@inherits TenantCommonBase
@inject IKnowledgeService KnowledgeService

<Stack>
    <StackField Label="@Localizer["Knowledge"]" HelperText="Create, import, index, and evaluate one corpus at a time." />

    <StackField Label="Corpus" />
    <StackTextField Value="@RequestContext.TenantId" Label="TenantId" ReadOnly />
    <StackTextField @bind-Value="corpusId" Label="CorpusId" />
    <StackTextField @bind-Value="name" Label="Name" />
    <StackTextField @bind-Value="description" Label="Description" Lines="2" />
    <StackCheckbox @bind-Value="isActive" Label="Active" />
    <StackButton Label="Save corpus" Color="Color.Primary" OnClick="SaveCorpusAsync" Disabled="@isBusy" />

</Stack>
<Stack>
    <StackField Label="Import" />
    <StackSelect T="string" @bind-Value="selectedImportCorpusId" Label="Select corpus">
        @foreach(KnowledgeCorpus corpus in corpora)
        {
            <MudSelectItem T="string" Value="@corpus.Id.ToString()">@corpus.Id</MudSelectItem>
        }
    </StackSelect>
    <StackTextField @bind-Value="sourceName" Label="Source name" />
    <StackSelect T="string" @bind-Value="format" Label="Format">
        <MudSelectItem T="string" Value='"markdown"'>markdown</MudSelectItem>
        <MudSelectItem T="string" Value='"plain-text"'>plain-text</MudSelectItem>
    </StackSelect>
    <StackTextField @bind-Value="importText" Label="Paste text" Lines="10" />
    <StackButton Label="Import" Color="Color.Primary" OnClick="ImportAsync" Disabled="@isBusy" />
    @if(importResult is not null)
    {
        <StackField Label="Import result" HelperText="@($"Sources {importResult.Sources.Count} · Documents {importResult.Documents.Count} · Chunks {importResult.Chunks.Count}")" Color="Color.Success" />
    }
</Stack>
<Stack>

    <StackField Label="Index" />
    <StackSelect T="string" @bind-Value="selectedIndexCorpusId" Label="Select corpus">
        @foreach(KnowledgeCorpus corpus in corpora)
        {
            <MudSelectItem T="string" Value="@corpus.Id.ToString()">@corpus.Id</MudSelectItem>
        }
    </StackSelect>
    <StackButton Label="Index corpus" Color="Color.Primary" OnClick="IndexAsync" Disabled="@isBusy" />
    @if(indexResult is not null)
    {
        <StackField Label="Index result" HelperText="@($"Indexed chunks {indexResult.IndexedChunkCount}")" Color="Color.Success" />
    }

</Stack>
<Stack>
    <StackField Label="Evaluation" />
    <StackSelect T="string" @bind-Value="selectedEvaluationCorpusId" Label="Select corpus">
        @foreach(KnowledgeCorpus corpus in corpora)
        {
            <MudSelectItem T="string" Value="@corpus.Id.ToString()">@corpus.Id</MudSelectItem>
        }
    </StackSelect>
    <StackButton Label="Run evaluation" Color="Color.Primary" OnClick="EvaluateAsync" Disabled="@isBusy" />
    @if(evaluationRun is not null)
    {
        <StackField Label="Evaluation result" HelperText="@EvaluationSummary" Color="Color.Success" />
    }

    @if(!string.IsNullOrWhiteSpace(status))
    {
        <StackField Label="Status" HelperText="@status" Color="@statusColor" />
    }
</Stack>

@code {
    private string tenantId = "current";
    private string corpusId = Guid.NewGuid().ToString("D");
    private string name = "Test Knowledge";
    private string? description;
    private bool isActive = true;
    private string selectedImportCorpusId = string.Empty;
    private string selectedIndexCorpusId = string.Empty;
    private string selectedEvaluationCorpusId = string.Empty;
    private string sourceName = "Manual paste";
    private string format = "markdown";
    private string importText = string.Empty;
    private IReadOnlyList<KnowledgeCorpus> corpora = [];
    private KnowledgeImportResult? importResult;
    private KnowledgeIndexResult? indexResult;
    private KnowledgeEvaluationRun? evaluationRun;
    private bool isBusy;
    private string? status;
    private Color statusColor = Color.Info;

    private string EvaluationSummary => evaluationRun is null
        ? string.Empty
        : string.Create(CultureInfo.InvariantCulture, $"recall@5 {evaluationRun.RecallAt5:0.###} · recall@10 {evaluationRun.RecallAt10:0.###} · average expected rank {evaluationRun.AverageExpectedChunkRank:0.###}");

    protected override async Task OnInitializedAsync() => await RefreshCorporaAsync();

    private async Task SaveCorpusAsync() => await RunAsync(async () =>
    {
        ValidateCorpus();
        await KnowledgeService.SaveCorpusAsync(new KnowledgeCorpus { Id = ParseId(corpusId), TenantId = tenantId.Trim(), Name = name.Trim(), Description = description, IsActive = isActive }, CancellationToken.None);
        await RefreshCorporaAsync();
        SelectCorpus(corpusId.Trim());
        status = "Corpus saved.";
    });

    private async Task ImportAsync() => await RunAsync(async () =>
    {
        ValidateTenantAndCorpus(selectedImportCorpusId);
        if(string.IsNullOrWhiteSpace(importText))
            throw new InvalidOperationException("Paste text before importing.");
        await using MemoryStream content = new(Encoding.UTF8.GetBytes(importText));
        importResult = await KnowledgeService.ImportAsync(new KnowledgeImportRequest { CorpusId = ParseId(selectedImportCorpusId), TenantId = tenantId.Trim(), Content = content, Format = format, SourceName = sourceName }, CancellationToken.None);
        status = "Import complete.";
    });

    private async Task IndexAsync() => await RunAsync(async () =>
    {
        ValidateTenantAndCorpus(selectedIndexCorpusId);
        indexResult = await KnowledgeService.IndexAsync(ParseId(selectedIndexCorpusId), tenantId.Trim(), CancellationToken.None);
        status = "Index complete.";
    });

    private async Task EvaluateAsync() => await RunAsync(async () =>
    {
        ValidateTenantAndCorpus(selectedEvaluationCorpusId);
        evaluationRun = await KnowledgeService.EvaluateAsync(new KnowledgeEvaluationRequest(ParseId(selectedEvaluationCorpusId), tenantId.Trim()), CancellationToken.None);
        status = "Evaluation complete.";
    });

    private async Task RefreshCorporaAsync() => corpora = string.IsNullOrWhiteSpace(tenantId) ? [] : await KnowledgeService.ListCorporaAsync(tenantId.Trim(), CancellationToken.None);
    private void SelectCorpus(string id) => selectedImportCorpusId = selectedIndexCorpusId = selectedEvaluationCorpusId = id;
    private void ValidateCorpus() { ValidateTenantAndCorpus(corpusId); if(string.IsNullOrWhiteSpace(name)) throw new InvalidOperationException("Name is required."); }
    private void ValidateTenantAndCorpus(string id) { if(string.IsNullOrWhiteSpace(tenantId)) throw new InvalidOperationException("TenantId is required."); _ = ParseId(id); }
    private static Guid ParseId(string id) => Guid.TryParse(id?.Trim(), out Guid value) ? value : throw new InvalidOperationException("CorpusId must be a GUID.");
    private async Task RunAsync(Func<Task> action) { try { isBusy = true; status = null; statusColor = Color.Info; await action(); statusColor = Color.Success; } catch(Exception ex) { status = ex.Message; statusColor = Color.Error; } finally { isBusy = false; } }
}
