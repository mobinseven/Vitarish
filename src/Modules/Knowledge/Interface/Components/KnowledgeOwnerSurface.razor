@using Vitarish.Modules.Base
@using Vitarish.Knowledge.Application.Owner
@inherits TenantCommonBase
@implements IDisposable
@inject KnowledgeOwnerSurfaceState OwnerState

<Stack>
    <StackField Label="@Localizer["Knowledge"]" HelperText="Create or select a corpus, import content, index it, and evaluate it without copying identifiers." />
</Stack>

<KnowledgeCorpusSelector Model="@OwnerState.Current.Model" IsBusy="@OwnerState.Current.IsBusy" SelectedCorpusChanged="SelectCorpusAsync" />

<KnowledgeCorpusCreator IsBusy="@OwnerState.Current.IsBusy" ResetVersion="@OwnerState.Current.CreateCorpusResetVersion" CreateRequested="CreateCorpusAsync" />

<KnowledgeSourceImporter
    SelectedCorpus="@OwnerState.Current.Model.SelectedCorpus"
    ImportFormats="@OwnerState.Current.ImportFormats"
    IsBusy="@OwnerState.Current.IsBusy"
    ImportRequested="ImportSourceAsync"
    ImportSummary="@OwnerState.Current.ImportSummary" />

<KnowledgeSourceReplacer
    SelectedCorpus="@OwnerState.Current.Model.SelectedCorpus"
    Sources="@OwnerState.Current.Model.Sources"
    ImportFormats="@OwnerState.Current.ImportFormats"
    IsBusy="@OwnerState.Current.IsBusy"
    SourcesVersion="@OwnerState.Current.SourcesVersion"
    ReplaceRequested="ReplaceSourceAsync" />

<KnowledgeCorpusIndexer SelectedCorpus="@OwnerState.Current.Model.SelectedCorpus" IsBusy="@OwnerState.Current.IsBusy" IndexRequested="IndexCorpusAsync" />

<KnowledgeCorpusEvaluator
    IsBusy="@OwnerState.Current.IsBusy"
    EvaluationSummary="@OwnerState.Current.EvaluationSummary"
    EvaluateRequested="EvaluateCorpusAsync" />

<KnowledgeOwnerStatus Status="@OwnerState.Current.Status" Color="@OwnerState.Current.StatusColor" />

@code {
    private readonly CancellationTokenSource disposal = new();

    protected override async Task OnInitializedAsync()
    {
        await OwnerState.LoadAsync(RequestContext.TenantId, disposal.Token);
    }

    private async Task CreateCorpusAsync(CreateKnowledgeCorpusInput input) => await OwnerState.CreateCorpusAsync(RequestContext.TenantId, input, disposal.Token);

    private async Task SelectCorpusAsync(KnowledgeOwnerCorpusOption? corpus) => await OwnerState.SelectCorpusAsync(RequestContext.TenantId, corpus, disposal.Token);

    private async Task ImportSourceAsync(ImportKnowledgeSourceInput input) => await OwnerState.ImportSourceAsync(RequestContext.TenantId, input, disposal.Token);

    private async Task ReplaceSourceAsync(ReplaceKnowledgeSourceInput input) => await OwnerState.ReplaceSourceAsync(RequestContext.TenantId, input, disposal.Token);

    private async Task IndexCorpusAsync() => await OwnerState.IndexCorpusAsync(RequestContext.TenantId, disposal.Token);

    private async Task EvaluateCorpusAsync() => await OwnerState.EvaluateCorpusAsync(RequestContext.TenantId, disposal.Token);

    public void Dispose()
    {
        disposal.Cancel();
        disposal.Dispose();
    }
}
