@using Microsoft.Extensions.Logging
@using Vitarish.Modules.Base
@using Vitarish.Knowledge.Application.Owner
@inherits TenantCommonBase
@implements IDisposable
@inject MediatR.ISender Sender
@inject ILogger<KnowledgeOwnerSurface> Logger

<Stack>
    <StackField Label="@Localizer["Knowledge"]" HelperText="Create or select a corpus, import content, index it, and evaluate it without copying identifiers." />
</Stack>

<KnowledgeCorpusSelector Model="@model" IsBusy="@isBusy" SelectedCorpusChanged="SelectCorpusAsync" />

<KnowledgeCorpusCreator IsBusy="@isBusy" ResetVersion="@createCorpusResetVersion" CreateRequested="CreateCorpusAsync" />

<KnowledgeSourceImporter
    SelectedCorpus="@model.SelectedCorpus"
    IsBusy="@isBusy"
    FileImportRequested="ImportSourceFromFileAsync"
    ImportSummary="@importSummary" />

<KnowledgeSourceReplacer
    SelectedCorpus="@model.SelectedCorpus"
    Sources="@model.Sources"
    IsBusy="@isBusy"
    SourcesVersion="@sourcesVersion"
    ReplaceRequested="ReplaceSourceAsync" />

<KnowledgeCorpusIndexer SelectedCorpus="@model.SelectedCorpus" IsBusy="@isBusy" IndexRequested="IndexCorpusAsync" />

<KnowledgeCorpusEvaluator
    IsBusy="@isBusy"
    EvaluationSummary="@evaluationSummary"
    EvaluateRequested="EvaluateCorpusAsync" />

<KnowledgeOwnerStatus Status="@status" Color="@statusColor" />

@code {
    private readonly CancellationTokenSource disposal = new();

    private KnowledgeOwnerReadModel model = new([], null, []);
    private string? importSummary;
    private string? evaluationSummary;
    private string? status;
    private Color statusColor = Color.Info;
    private bool isBusy;
    private int createCorpusResetVersion;
    private int sourcesVersion;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            model = await Sender.Send(new KnowledgeOwnerReadModelQuery(RequestContext.TenantId, null), disposal.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Failed to load knowledge owner workspace for tenant {TenantId}.", RequestContext.TenantId);
            Apply(false, KnowledgeOwnerFailureMessages.LoadWorkspaceFailed);
        }
    }

    private async Task CreateCorpusAsync(CreateKnowledgeCorpusInput input) => await RunAsync(async token =>
    {
        KnowledgeOwnerCreateCorpusResult result = await Sender.Send(new CreateKnowledgeCorpusCommand(RequestContext.TenantId, input), token);
        Apply(result.Succeeded, result.Message);

        if (!result.Succeeded || result.Corpus is null)
        {
            return;
        }

        model = await Sender.Send(new KnowledgeOwnerReadModelQuery(RequestContext.TenantId, result.Corpus.CorpusId), token);
        createCorpusResetVersion++;
        ClearCorpusScopedResults();
    });

    private async Task SelectCorpusAsync(KnowledgeOwnerCorpusOption? corpus) => await RunAsync(async token =>
    {
        model = await Sender.Send(new KnowledgeOwnerReadModelQuery(RequestContext.TenantId, corpus?.CorpusId), token);
        ClearCorpusScopedResults();
    });

    private async Task ImportSourceFromFileAsync(ImportKnowledgeSourceFromFileInput input) => await RunAsync(async token =>
    {
        KnowledgeOwnerImportCommandResult result = await Sender.Send(new ImportKnowledgeSourceFromFileCommand(RequestContext.TenantId, input), token);
        Apply(result.Succeeded, result.Message);
        importSummary = result.Summary;

        if (result.Succeeded)
        {
            await ReloadSelectedCorpusAsync(token);
        }
    });

    private async Task ReplaceSourceAsync(ReplaceKnowledgeSourceInput input) => await RunAsync(async token =>
    {
        KnowledgeOwnerImportCommandResult result = await Sender.Send(new ReplaceKnowledgeSourceCommand(RequestContext.TenantId, input), token);
        Apply(result.Succeeded, result.Message);
        importSummary = result.Summary;

        if (result.Succeeded)
        {
            await ReloadSelectedCorpusAsync(token);
        }
    });

    private async Task IndexCorpusAsync() => await RunAsync(async token =>
    {
        KnowledgeOwnerCommandResult result = await Sender.Send(new IndexKnowledgeCorpusCommand(RequestContext.TenantId, new IndexKnowledgeCorpusInput(model.SelectedCorpus?.CorpusId)), token);
        Apply(result);
    });

    private async Task EvaluateCorpusAsync() => await RunAsync(async token =>
    {
        KnowledgeOwnerEvaluationCommandResult result = await Sender.Send(new EvaluateKnowledgeCorpusCommand(RequestContext.TenantId, new EvaluateKnowledgeCorpusInput(model.SelectedCorpus?.CorpusId, Application.Enums.KnowledgeEvaluationScope.RandomSample)), token);
        Apply(result.Succeeded, result.Message);
        evaluationSummary = result.Summary;
    });

    private async Task ReloadSelectedCorpusAsync(CancellationToken token)
    {
        model = await Sender.Send(new KnowledgeOwnerReadModelQuery(RequestContext.TenantId, model.SelectedCorpus?.CorpusId), token);
        sourcesVersion++;
    }

    private void ClearCorpusScopedResults()
    {
        importSummary = null;
        evaluationSummary = null;
        sourcesVersion++;
    }

    private async Task RunAsync(Func<CancellationToken, Task> action)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        status = null;
        statusColor = Color.Info;

        try
        {
            await action(disposal.Token);
        }
        catch (OperationCanceledException) when (disposal.IsCancellationRequested)
        {
            status = Localizer["The operation was canceled."];
            statusColor = Color.Info;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void Apply(KnowledgeOwnerCommandResult result) => Apply(result.Succeeded, result.Message);

    private void Apply(bool succeeded, string message)
    {
        status = Localizer[message];
        statusColor = succeeded ? Color.Success : Color.Error;
    }

    public void Dispose()
    {
        disposal.Cancel();
        disposal.Dispose();
    }
}
