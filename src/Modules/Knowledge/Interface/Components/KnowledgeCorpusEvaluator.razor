@using Vitarish.Modules.Aggregator.Core
@using Microsoft.AspNetCore.Components

<Stack>
    <StackField Label="Corpus evaluation" HelperText="Run evaluation against the selected corpus. Source focus does not limit this corpus-level operation." />
    @if (SelectedCorpus is not null)
    {
        <StackCard Label="Evaluation corpus" HelperText="@SelectedCorpus.Label" />
    }
    <StackButton Label="Run evaluation for selected corpus" Color="Color.Primary" OnClick="EvaluateAsync" Disabled="@(IsBusy || SelectedCorpus is null)" />

    @if (!string.IsNullOrWhiteSpace(EvaluationSummary))
    {
        <StackField Label="Evaluation result" HelperText="@EvaluationSummary" Color="Color.Success" />
    }
</Stack>

@code {
    [Parameter]
    public KnowledgeOwnerCorpusOption? SelectedCorpus { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? EvaluationSummary { get; set; }

    [Parameter, EditorRequired]
    public EventCallback EvaluateRequested { get; set; }

    private async Task EvaluateAsync()
    {
        await EvaluateRequested.InvokeAsync();
    }
}
