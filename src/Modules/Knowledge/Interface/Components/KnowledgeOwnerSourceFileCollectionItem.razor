@using Microsoft.AspNetCore.Components
@inject Microsoft.Extensions.Localization.IStringLocalizer Localizer
@using SourceFileItemModel = Vitarish.Knowledge.Contracts.Models.KnowledgeOwnerSourceFileCollectionItem

<StackCard Label="@Item.FileName" HelperText="@FileDetails" />

@code {
    [Parameter, EditorRequired]
    public SourceFileItemModel Item { get; set; } = new(Guid.Empty, string.Empty, null, null, 0, null);

    private string FileDetails => string.IsNullOrWhiteSpace(Item.ContentType)
        ? $"{ChunkText} · {SizeText}"
        : $"{ChunkText} · {SizeText} · {Item.ContentType}";

    private string ChunkText => $"{Item.ChunkCount:N0} {Localizer["chunks"]}";
    private string SizeText => Item.Size is null ? Localizer["unknown size"] : $"{Item.Size.Value:N0} {Localizer["chars"]}";
}
