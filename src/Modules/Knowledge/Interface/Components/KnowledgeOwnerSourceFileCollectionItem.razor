@using Microsoft.AspNetCore.Components
@using CorpusItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerCorpusCollectionItem
@using SourceItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerSourceCollectionItem
@using SourceFileItemModel = Vitarish.Knowledge.Application.Contracts.KnowledgeOwnerSourceFileCollectionItem

<MudListItem T="SourceFileItemModel" Dense="true">
    <MudText Typo="Typo.body2">@Item.FileName</MudText>
    <MudText Typo="Typo.caption">@Item.ChunkCount chunks · @FormatSize(Item.Size)@ContentTypeText</MudText>
</MudListItem>

@code {
    [Parameter, EditorRequired]
    public SourceFileItemModel Item { get; set; } = new(Guid.Empty, string.Empty, null, null, 0, null);

    private string ContentTypeText => string.IsNullOrWhiteSpace(Item.ContentType) ? string.Empty : $" · {Item.ContentType}";

    private static string FormatSize(long? size) => size is null ? "unknown size" : $"{size.Value:N0} chars";
}
