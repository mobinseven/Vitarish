<Stack>
    <StackField Label="Index" HelperText="Build the searchable index for the selected corpus. Source focus does not limit this corpus-level operation." />

    @if (SelectedCorpus is not null)
    {
        <StackCard Label="Ready to index" HelperText="@SelectedCorpus.Label" />
    }

    <StackButton Label="Index selected corpus" Color="Color.Primary" OnClick="IndexAsync" Disabled="@(IsBusy || SelectedCorpus is null)" />
</Stack>

@code {
    [Parameter]
    public KnowledgeOwnerCorpusOption? SelectedCorpus { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter, EditorRequired]
    public EventCallback IndexRequested { get; set; }

    private async Task IndexAsync()
    {
        await IndexRequested.InvokeAsync();
    }
}
