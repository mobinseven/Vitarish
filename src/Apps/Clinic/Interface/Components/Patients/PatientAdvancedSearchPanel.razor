@namespace Vitarish.Clinic.Interface.Components.Patients
@using System.Threading
@inherits Vitarish.Modules.Base.Interface.TenantCommonBase
@implements IDisposable

<Stack>
    <PatientAdvancedSearchForm Context="@Context"
                               CanRunSearch="@CanRunAdvancedSearch"
                               OnSearchRequested="@RunAdvancedSearchAsync" />

</Stack>

@if(Context.AdvancedSearchInProgress)
{
    <Stack>
        <StackProgress />
    </Stack>
}
else
{
    <Stack>
        <PatientAdvancedSearchResults Context="@Context"
                                      OnPatientSelected="@OnPatientSelected" />
    </Stack>
}

@code {
    [Parameter, EditorRequired] public PatientAdvancedSearchContext Context { get; set; } = default!;
    [Parameter] public EventCallback<ProjectReadDto> OnPatientSelected { get; set; }

    [Inject] private IClinicClient ClinicClient { get; set; } = default!;

    private CancellationTokenSource? searchCts;
    private int searchVersion;
    private bool disposed;

    private bool CanRunAdvancedSearch
        => !Context.AdvancedSearchInProgress
           && !Context.IdentificationLookupInProgress
           && PatientAdvancedSearchCriteria.HasAny(Context);

    private async Task RunAdvancedSearchAsync()
    {
        if(!CanRunAdvancedSearch)
        {
            return;
        }

        PatientAdvancedSearchCriteria criteria = PatientAdvancedSearchCriteria.From(Context);
        if(!PatientAdvancedSearchCriteria.HasAny(Context))
        {
            return;
        }

        int version = Interlocked.Increment(ref searchVersion);
        ResetSearchCancellation();
        searchCts = new CancellationTokenSource();
        CancellationToken ct = searchCts.Token;

        Context.BeginAdvancedSearch();
        await RenderLatestSearchAsync(version);

        try
        {
            IReadOnlyList<ProjectReadDto> candidates = await LoadCandidatesAsync(criteria, ct);
            if(IsStale(version, ct))
            {
                return;
            }

            IReadOnlyList<ProjectReadDto> results = [.. candidates
                .Where(project => PatientSearchMatcher.MatchesAdvancedSearch(project, criteria))
                .Take(PatientSearchDefaults.MaxSearchResults)];

            Context.CompleteAdvancedSearch(results);
        }
        catch(OperationCanceledException)
        {
            // A newer exact-id lookup or advanced search has superseded this request.
        }
        catch
        {
            if(version == searchVersion)
            {
                Context.FailAdvancedSearch();
            }
        }
        finally
        {
            await RenderLatestSearchAsync(version);
        }
    }

    private async Task<IReadOnlyList<ProjectReadDto>> LoadCandidatesAsync(PatientAdvancedSearchCriteria criteria, CancellationToken ct)
    {
        PatientSearchRequest request = new(
            Search: criteria.IdentificationCode is null ? criteria.Name : criteria.IdentificationCode,
            Skip: 0,
            Take: criteria.NeedsLargeClientSideSearch
                ? PatientSearchDefaults.MaxAdvancedSearchCandidates
                : PatientSearchDefaults.MaxSearchResults,
            Template: false);

        ClinicResult<IReadOnlyList<PatientViewDto>> result = await ClinicClient.SearchPatientsAsync(request, ct);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException(result.Error?.Message ?? "Failed to search patients.");
        }
        return result.Value?.Select(patient => patient.ToProjectRead()).ToList() ?? [];
    }

    private bool IsStale(int version, CancellationToken ct)
        => ct.IsCancellationRequested || version != searchVersion;

    private async Task RenderLatestSearchAsync(int version)
    {
        if(!disposed && version == searchVersion)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetSearchCancellation()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
        searchCts = null;
    }

    public void Dispose()
    {
        disposed = true;
        Interlocked.Increment(ref searchVersion);
        ResetSearchCancellation();
    }
}
