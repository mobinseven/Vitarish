@inherits Vitarish.Modules.Base.Interface.TenantCommonBase


@if(showCreateForm)
{
    @if(CreateContext.DuplicateCandidates.Count > 0)
    {
        <Stack>
            <StackField Label="@Localizer["DuplicateWarning"]"
                        HelperText="@Localizer["DuplicateWarningHelp"]"
                        AdornmentIcon="fa-solid fa-triangle-exclamation"
                        AdornmentColor="Color.Warning"
                        Color="Color.Warning" />

            @foreach(var candidate in CreateContext.DuplicateCandidates)
            {
                <StackButton Label="@candidate.Name"
                             HelperText="@GetCandidateHelperText(candidate)"
                             Color="Color.Warning"
                             EndIcon="fa-solid fa-user-check"
                             OnClick="@(() => SelectPatientAsync(candidate))" />
            }
        </Stack>
    }
    <PatientEditForm @key="createFormKey"
                     InitialProject="draft"
                     OnCreate="OnPatientCreatedAsync"
                     OnCancel="ShowLookup" />
}
else
{
    <PatientAdvancedSearch Context="SearchContext"
                           OnPatientSelected="SelectPatientAsync">
        <NotFoundContent>
            <StackButton Label="@Localizer["CreateNewPatient"]"
                         HelperText="@context"
                         EndIcon="fa-solid fa-user-plus"
                         Color="Color.Primary"
                         OnClick="ShowCreate" />
        </NotFoundContent>
    </PatientAdvancedSearch>
}

@code {
    [Parameter, EditorRequired] public PatientAdvancedSearchContext SearchContext { get; set; } = default!;
    [Parameter, EditorRequired] public PatientCreateContext CreateContext { get; set; } = default!;
    [Parameter] public EventCallback<ProjectReadDto> OnPatientSelected { get; set; }
    [Parameter] public EventCallback<ProjectReadDto> OnPatientCreated { get; set; }

    [Inject] private ISeaClient ProjectsService { get; set; } = default!;

    private bool showCreateForm;
    private PatientFindOrCreateRequest draft = new();
    private int createFormKey;

    private async Task SelectPatientAsync(ProjectReadDto patient)
    {
        await OnPatientSelected.InvokeAsync(patient);
    }

    private void ShowCreate()
    {
        CreateContext.DuplicateCandidates = SearchContext.SearchResults;
        draft = CreateContext.NewPatientDraft as PatientWriteDto ?? new PatientWriteDto();
        PrefillDraft();
        createFormKey++;
        showCreateForm = true;
        StateHasChanged();
    }

    private void ShowLookup()
    {
        CreateContext.NewPatientDraft = draft;
        showCreateForm = false;
        StateHasChanged();
    }

    private void PrefillDraft()
    {
        string? identificationCode = !string.IsNullOrWhiteSpace(SearchContext.SearchIdentificationCode)
            ? SearchContext.SearchIdentificationCode
            : SearchContext.IdentificationCode;

        if(!string.IsNullOrWhiteSpace(identificationCode) && string.IsNullOrWhiteSpace(draft.IdentificationCode))
        {
            draft.IdentificationCode = identificationCode;
        }

        if(!string.IsNullOrWhiteSpace(SearchContext.SearchQuery) && string.IsNullOrWhiteSpace(draft.LastName))
        {
            string[] parts = SearchContext.SearchQuery.Trim().Split(' ', 2);
            draft.LastName = parts.Length > 1 ? parts[1] : parts[0];
            if(parts.Length > 1)
            {
                draft.FirstName = parts[0];
            }
        }

        if(SearchContext.SearchDateOfBirth.HasValue && !draft.DateOfBirth.HasValue)
        {
            draft.DateOfBirth = SearchContext.SearchDateOfBirth;
        }

        if(!string.IsNullOrWhiteSpace(SearchContext.SearchPhone) && string.IsNullOrWhiteSpace(draft.Phone))
        {
            draft.Phone = SearchContext.SearchPhone;
        }

        if(!string.IsNullOrWhiteSpace(SearchContext.SearchEmail) && string.IsNullOrWhiteSpace(draft.Email))
        {
            draft.Email = SearchContext.SearchEmail;
        }
    }

    private async Task OnPatientCreatedAsync(Guid patientId)
    {
        ProjectReadDto created = await ProjectsService.GetAsync(patientId, CancellationToken.None).EnsureValueAsync();
        CreateContext.NewPatientDraft = draft;
        await OnPatientCreated.InvokeAsync(created);
    }

    private string GetCandidateHelperText(ProjectReadDto project)
    {
        PatientReadDto patient = project.ToPatientRead();
        List<string> parts = [];

        if(!string.IsNullOrWhiteSpace(project.IdentificationCode))
        {
            parts.Add($"{Localizer["IdentificationCode"]}: {project.IdentificationCode}");
        }

        if(patient.DateOfBirth.HasValue)
        {
            parts.Add(patient.DateOfBirth.Value.ToShortDateString());
        }

        if(!string.IsNullOrWhiteSpace(patient.Phone))
        {
            parts.Add(patient.Phone);
        }
        else if(!string.IsNullOrWhiteSpace(patient.Email))
        {
            parts.Add(patient.Email);
        }

        return string.Join(" · ", parts);
    }
}
