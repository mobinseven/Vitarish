@namespace Vitarish.Clinic.Interface.Components.Patients
@inherits Vitarish.Modules.Base.TenantCommonBase

<Stack>
    @if(NotFoundContent is not null)
    {
        @NotFoundContent(IdentificationCode)
    }
    else
    {
        <StackField Label="@Localizer["PatientNotFound", IdentificationCode]" />
    }
</Stack>

@code {
    [Parameter, EditorRequired] public string IdentificationCode { get; set; } = string.Empty;
    [Parameter] public RenderFragment<string>? NotFoundContent { get; set; }
}
