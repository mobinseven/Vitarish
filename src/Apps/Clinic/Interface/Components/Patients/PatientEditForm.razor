@inherits ProjectEditForm


@if(projectWriteDto is null)
{
    return;
}
<Stack>

    @if(TemplateMode)
    {
        <StackTextField @bind-Value="projectWriteDto.Name"
                        Required
                        Label="@Localizer["Title"]" />

        <StackTextField @bind-Value="projectWriteDto.Description"
                        Lines="4"
                        Label="@Localizer["Description"]" />
    }
    else
    {
        <StackTextField @bind-Value="projectWriteDto.FirstName"
                        Label="@Localizer["FirstName"]" />

        <StackTextField @bind-Value="projectWriteDto.LastName"
                        DebounceInterval="500"
                        Required
                        Label="@Localizer["LastName"]" />

        <StackTextField @bind-Value="projectWriteDto.IdentificationCode"
                        Label="@Localizer["IdentificationCode"]"
                        HelperText="@Localizer["IdentificationCodeHelp"]"
                        AdornmentIcon="@(string.IsNullOrWhiteSpace(projectWriteDto.IdentificationCode) ? "fa-regular fa-triangle-exclamation" : "fa-regular fa-id-card")"
                        AdornmentColor="@(string.IsNullOrWhiteSpace(projectWriteDto.IdentificationCode) ? Color.Warning : Color.Default)" />

        <StackTextField @bind-Value="projectWriteDto.Description"
                        AutoGrow
                        Label="@Localizer["Description"]" />

        <StackDatePicker @bind-Date="projectWriteDto.DateOfBirth"
                         Label="@Localizer["DateOfBirth"]" />

        <StackDatePicker @bind-Date="projectWriteDto.DateOfSurgery"
                         Label="@Localizer["DateOf", Localizer["Surgery"]]" />
        <StackField Label="@Localizer["Gender"]">
            <MudRadioGroup T="Gender"
                           @bind-Value="projectWriteDto.Gender">
                <MudRadio Value="@Gender.Female">@Localizer["Female"]</MudRadio>
                <MudRadio Value="@Gender.Male">@Localizer["Male"]</MudRadio>
            </MudRadioGroup>
        </StackField>

        <StackTextField @bind-Value="projectWriteDto.ClinicalNotes"
                        AutoGrow
                        Label="@Localizer["Notes"]" />

        <UserFindOrCreate Value="@LinkedUserId"
                          ValueChanged="OnLinkedUserChangedAsync"
                          Options="@LinkedUserPickerOptions" />
        <StackField Label="@Localizer["Image"]">
            <ProjectAvatar AvatarFileId="@projectWriteDto.AvatarFileId" Size="96" Style="margin-bottom: 0.5rem;" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <Vitarish.Files.Interface.Components.StreamTransfer OnFileUploaded="OnAvatarUploaded">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="fa-regular fa-upload" Color="Color.Primary">@Localizer["Select"]</MudButton>
                    </ActivatorContent>
                </Vitarish.Files.Interface.Components.StreamTransfer>
                @if(projectWriteDto.AvatarFileId.HasValue)
                {
                    <MudButton Variant="Variant.Text" StartIcon="fa-regular fa-xmark" Color="Color.Error" OnClick="RemoveAvatar">@Localizer["Remove"]</MudButton>
                }
            </MudStack>
        </StackField>
        <StackExpandable Label="@Localizer["ClinicalData"]">
            <StackTextField @bind-Value="projectWriteDto.PlaceOfBirth"
                            Label="@Localizer["PlaceOfBirth"]" />
            <StackTextField @bind-Value="projectWriteDto.Email"
                            Label="@Localizer["Email"]"
                            InputType="InputType.Email" />
            <StackTextField @bind-Value="projectWriteDto.Phone"
                            Label="@Localizer["Phone"]"
                            InputType="InputType.Telephone" />
            <StackTextField @bind-Value="projectWriteDto.InsuranceProvider"
                            Label="@Localizer["InsuranceProvider"]" />
            <StackTextField @bind-Value="projectWriteDto.VisitReason"
                            Label="@Localizer["VisitReason"]" />
            <StackTextField @bind-Value="projectWriteDto.Allergies"
                            Label="@Localizer["Allergies"]" />
            <StackTextField @bind-Value="projectWriteDto.CurrentMedications"
                            Label="@Localizer["CurrentMedications"]" />
            <StackTextField @bind-Value="projectWriteDto.EmergencyContactName"
                            Label="@Localizer["EmergencyContactName"]" />
            <StackTextField @bind-Value="projectWriteDto.EmergencyContactPhone"
                            Label="@Localizer["EmergencyContactPhone"]" />
        </StackExpandable>
    }
    <StackButton Label="@Localizer["Save"]" EndIcon="fa-regular fa-save" Color="Color.Primary" OnClick="SaveAsync" />
    @if(OnCancel.HasDelegate)
    {
        <StackButton Label="@Localizer["Cancel"]" EndIcon="fa-regular fa-xmark" OnClick="() => OnCancel.InvokeAsync()" />
    }
</Stack>

@code {
    [Parameter] public ProjectWriteDto? InitialProject { get; set; }

    private PatientWriteDto projectWriteDto = new();
    private static readonly UserFindOrCreateOptions LinkedUserPickerOptions = new()
    {
        AllowCreate = true,
        AllowUnlink = true,
        ShowSearchScopeSelector = true,
        DefaultSearchScope = UserSearchScope.TenantUsers,
        AutoLinkExistingUser = true,
        AllowAutoLinkToggle = true,
        EnsureTenantUserRoleOnLink = true
    };

    private string? LinkedUserId
    {
        get => projectWriteDto.UserIds?.FirstOrDefault();
        set => projectWriteDto.UserIds = value is null ? [] : [value];
    }

    private Task OnAvatarUploaded(Vitarish.Files.Domain.Models.FileInformationReadDto fileInfo)
    {
        projectWriteDto.AvatarFileId = fileInfo.Id;
        return InvokeAsync(StateHasChanged);
    }

    private Task RemoveAvatar()
    {
        projectWriteDto.AvatarFileId = null;
        return InvokeAsync(StateHasChanged);
    }

    private Task OnLinkedUserChangedAsync(string? userId)
    {
        LinkedUserId = userId;
        return InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if(Project is not null)
        {
            projectWriteDto = Project.ToPatientWrite()!;
        }
        else if(InitialProject is PatientWriteDto initialPatient)
        {
            projectWriteDto = initialPatient;
        }
        else if(InitialProject is not null)
        {
            projectWriteDto = new PatientWriteDto
            {
                Id = InitialProject.Id,
                Name = InitialProject.Name,
                Description = InitialProject.Description,
                AvatarFileId = InitialProject.AvatarFileId,
                IdentificationCode = InitialProject.IdentificationCode,
                Template = InitialProject.Template,
                UserIds = InitialProject.UserIds,
                Metadata = InitialProject.Metadata,
                MetadataValues = InitialProject.MetadataValues
            };
        }

        if(Project is not null && string.IsNullOrWhiteSpace(projectWriteDto.LastName))
        {
            projectWriteDto.LastName = Project.Name;
        }
        StateHasChanged();
    }

    protected override async Task SaveAsync()
    {
        projectWriteDto.Name = $"{projectWriteDto.FirstName} {projectWriteDto.LastName}".TrimEnd(' ', ',');
        if(string.IsNullOrWhiteSpace(projectWriteDto.Name))
        {
            await DialogService.ShowMessageBox(null, Localizer["RequiredItem", Localizer["LastName"]]);
            return;
        }
        if(Project is null)
        {
            var created = await ProjectsService.AddAsync(projectWriteDto, CancellationToken.None).EnsureValueAsync();
            await OnCreate.InvokeAsync(created.Id);
        }
        else
        {
            await ProjectsService.UpdateAsync(projectWriteDto, CancellationToken.None);
            await OnUpdate.InvokeAsync(Project.Id);
        }
    }
}
