@inherits ProjectEditForm

@if(patient is null)
{
    return;
}

<Stack>
    <StackField>
        <MudGrid Spacing="3" Class="mt-2">
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 h-100" Elevation="0">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <StackFileImageInput @ref="stackFileInput"
                                             Label="@Localizer["Photo"]"
                                             FileId="@patient.AvatarFileId"
                                             FileIdChanged="@AvatarUploaded" />
                    </MudStack>

                    <MudDivider Class="my-4" />

                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <StackPersonIdField @bind-Value="patient.IdentificationCode"
                                                Adornment="Adornment.End"
                                                AdornmentIcon="@RequiredIcon(patient.IdentificationCode, "fa-solid fa-id-card")"
                                                AdornmentColor="@RequiredColor(patient.IdentificationCode)" />
                        </MudItem>

                        <MudItem xs="12">
                            <StackTextField @bind-Value="patient.FirstName"
                                            Label="@Localizer["FirstName"]"
                                            Adornment="Adornment.End"
                                            AdornmentIcon="@RequiredIcon(patient.FirstName)"
                                            AdornmentColor="@RequiredColor(patient.FirstName)" />
                        </MudItem>

                        <MudItem xs="12">
                            <StackTextField @bind-Value="patient.LastName"
                                            Label="@Localizer["LastName"]"
                                            DebounceInterval="500"
                                            Adornment="Adornment.End"
                                            AdornmentIcon="@RequiredIcon(patient.LastName)"
                                            AdornmentColor="@RequiredColor(patient.LastName)" />
                        </MudItem>

                        <MudItem xs="12">
                            <StackPhoneField @bind-Value="patient.Phone"
                                             Adornment="Adornment.End"
                                             AdornmentIcon="@RequiredIcon(patient.Phone, "fa-solid fa-phone")"
                                             AdornmentColor="@RequiredColor(patient.Phone)" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudGrid Spacing="3">
                    <MudItem xs="12" lg="6">
                        <MudPaper Class="pa-4 h-100" Elevation="0">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                @Localizer["PersonalDetails"]
                            </MudText>

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <StackTextField @bind-Value="patient.FatherName"
                                                    Label="@Localizer["FatherName"]" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <StackField Label="@Localizer["Gender"]">
                                        <MudRadioGroup T="Gender"
                                                       @bind-Value="patient.Gender">
                                            <MudRadio Value="@Gender.Unspecified">@Localizer["Unspecified"]</MudRadio>
                                            <MudRadio Value="@Gender.Female">@Localizer["Female"]</MudRadio>
                                            <MudRadio Value="@Gender.Male">@Localizer["Male"]</MudRadio>
                                        </MudRadioGroup>
                                    </StackField>
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <StackDatePicker @bind-Date="patient.DateOfBirth"
                                                     Label="@Localizer["DateOfBirth"]" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <StackTextField @bind-Value="patient.PlaceOfBirth"
                                                    Label="@Localizer["PlaceOfBirth"]" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <StackSelect @bind-Value="patient.Education"
                                                 Label="@Localizer["Education"]">
                                        <StackSelectItem Value="@Education.Unspecified">@Localizer["Unspecified"]</StackSelectItem>
                                        <StackSelectItem Value="@Education.NoFormalEducation">@Localizer["NoFormalEducation"]</StackSelectItem>
                                        <StackSelectItem Value="@Education.PrimarySchool">@Localizer["PrimarySchool"]</StackSelectItem>
                                        <StackSelectItem Value="@Education.HighSchool">@Localizer["HighSchool"]</StackSelectItem>
                                        <StackSelectItem Value="@Education.AssociateDegree">@Localizer["AssociateDegree"]</StackSelectItem>
                                        <StackSelectItem Value="@Education.BachelorDegree">@Localizer["BachelorDegree"]</StackSelectItem>
                                        <StackSelectItem Value="@Education.MasterDegree">@Localizer["MasterDegree"]</StackSelectItem>
                                        <StackSelectItem Value="@Education.Doctorate">@Localizer["Doctorate"]</StackSelectItem>
                                        <StackSelectItem Value="@Education.Professional">@Localizer["Professional"]</StackSelectItem>
                                    </StackSelect>
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <StackTextField @bind-Value="patient.Occupation"
                                                    Label="@Localizer["Occupation"]" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <StackNumericField @bind-Value="patient.Height"
                                                       Label="@Localizer["Height"]" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <StackNumericField @bind-Value="patient.Weight"
                                                       Label="@Localizer["Weight"]" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <StackAutocomplete @bind-Value="patient.Referrer"
                                                       Items="@ReferrerItems"
                                                       Label="@Localizer["Referrer"]" />
                                </MudItem>

                                <MudItem xs="12">
                                    <StackTextField @bind-Value="patient.Address"
                                                    Label="@Localizer["Address"]"
                                                    Lines="2" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" lg="6">
                        <MudPaper Class="pa-4 h-100" Elevation="0">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                @Localizer["ClinicalData"]
                            </MudText>

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <StackDatePicker @bind-Date="patient.DateOfSurgery"
                                                     Label="@Localizer["DateOf", Localizer["Surgery"]]" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <StackTextField @bind-Value="patient.InsuranceProvider"
                                                    Label="@Localizer["InsuranceProvider"]" />
                                </MudItem>

                                <MudItem xs="12">
                                    <StackTextField @bind-Value="patient.VisitReason"
                                                    Label="@Localizer["VisitReason"]"
                                                    Lines="2" />
                                </MudItem>

                                <MudItem xs="12">
                                    <StackTextField @bind-Value="patient.Allergies"
                                                    Label="@Localizer["Allergies"]"
                                                    Lines="2" />
                                </MudItem>

                                <MudItem xs="12">
                                    <StackTextField @bind-Value="patient.CurrentMedications"
                                                    Label="@Localizer["CurrentMedications"]"
                                                    Lines="2" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <StackTextField @bind-Value="patient.EmergencyContactName"
                                                    Label="@Localizer["EmergencyContactName"]" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <StackTextField @bind-Value="patient.EmergencyContactPhone"
                                                    Label="@Localizer["EmergencyContactPhone"]"
                                                    Adornment="Adornment.End"
                                                    AdornmentIcon="fa-solid fa-phone" />
                                </MudItem>

                                <MudItem xs="12">
                                    <StackTextField @bind-Value="patient.ClinicalNotes"
                                                    Label="@Localizer["ClinicalNotes"]"
                                                    Lines="3" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </StackField>

    <StackButton Label="@Localizer["Save"]"
                 EndIcon="fa-solid fa-save"
                 Color="Color.Primary"
                 OnClick="Proceed" />

    @if(OnCancel.HasDelegate)
    {
        <StackButton Label="@Localizer["Cancel"]"
                     EndIcon="fa-solid fa-xmark"
                     Color="Color.Secondary"
                     OnClick="CancelAsync" />
    }
</Stack>
