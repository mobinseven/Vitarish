@namespace Vitarish.Clinic.Interface.Components.Patients
@using System.Threading
@inherits Vitarish.Modules.Base.Interface.TenantCommonBase
@implements IDisposable

<PatientIdentificationCodeInput Value="@Context.IdentificationCode"
                                ValueChanged="@OnIdentificationCodeChangedAsync" />

@if(Context.IsIdentificationLookupLookingUp)
{
    <Stack>
        <StackProgress />
    </Stack>
}
else if(Context.IsIdentificationLookupFound && Context.ExactIdentificationCodeMatch is ProjectReadDto exactMatch)
{
    <PatientIdentificationCodeFound Patient="@exactMatch"
                                    OnPatientSelected="@OnPatientSelected" />
}
else if(Context.IsIdentificationLookupNotFound)
{
    string identificationCode = PatientSearchText.GetCurrentIdentificationCode(Context);

    <PatientIdentificationCodeNotFound IdentificationCode="@identificationCode"
                                       NotFoundContent="@NotFoundContent" />

    <PatientAdvancedSearchPanel Context="@Context"
                                OnPatientSelected="@OnPatientSelected" />
}
else if(Context.IsIdentificationLookupFailed)
{
    <PatientIdentificationCodeLookupFailure IdentificationCode="@PatientSearchText.GetCurrentIdentificationCode(Context)"
                                            Error="@Context.IdentificationLookupError"
                                            CanRetry="@Context.HasIdentificationCode"
                                            OnRetry="@RetryIdentificationLookupAsync" />
}

@code {
    [Parameter, EditorRequired] public PatientAdvancedSearchContext Context { get; set; } = default!;
    [Parameter] public EventCallback<ProjectReadDto> OnPatientSelected { get; set; }
    [Parameter] public RenderFragment<string>? NotFoundContent { get; set; }

    [Inject] private IClinicClient ClinicClient { get; set; } = default!;

    private CancellationTokenSource? lookupCts;
    private int lookupVersion;
    private bool disposed;

    private async Task OnIdentificationCodeChangedAsync(string? value)
    {
        int version = Interlocked.Increment(ref lookupVersion);
        ResetLookupCancellation();
        lookupCts = new CancellationTokenSource();
        CancellationToken ct = lookupCts.Token;

        Context.PrepareForIdentificationCodeInput(value);

        string? code = PatientSearchText.Normalize(value);
        if(code is null)
        {
            await RenderLatestLookupAsync(version);
            return;
        }

        Context.BeginIdentificationLookup(code);
        await RenderLatestLookupAsync(version);

        try
        {
            await Task.Delay(PatientSearchDefaults.IdentificationLookupDebounceMs, ct);

            ProjectReadDto? exactMatch = await FindExactIdentificationCodeMatchAsync(code, ct);
            if(IsStale(version, ct))
            {
                return;
            }

            Context.CompleteIdentificationLookup(exactMatch, code);
        }
        catch(OperationCanceledException)
        {
            if(version == lookupVersion)
            {
                Context.CancelIdentificationLookup();
            }
        }
        catch(Exception ex)
        {
            if(version == lookupVersion)
            {
                Context.FailIdentificationLookup(code, ex.Message);
            }
        }
        finally
        {
            await RenderLatestLookupAsync(version);
        }
    }

    private async Task RetryIdentificationLookupAsync()
        => await OnIdentificationCodeChangedAsync(Context.IdentificationCode);

    private async Task<ProjectReadDto?> FindExactIdentificationCodeMatchAsync(string code, CancellationToken ct)
    {
        ClinicResult<PatientViewDto> result = await ClinicClient.LookupPatientByIdentificationCodeAsync(new PatientIdentificationLookupRequest(code), ct);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException(result.Error?.Message ?? "Failed to lookup patient.");
        }
        IReadOnlyList<ProjectReadDto> results = result.Value is null ? [] : [result.Value.ToProjectRead()];

        return results.FirstOrDefault(project => PatientSearchMatcher.IsExactIdentificationCode(project, code));
    }

    private bool IsStale(int version, CancellationToken ct)
        => ct.IsCancellationRequested || version != lookupVersion;

    private async Task RenderLatestLookupAsync(int version)
    {
        if(!disposed && version == lookupVersion)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetLookupCancellation()
    {
        lookupCts?.Cancel();
        lookupCts?.Dispose();
        lookupCts = null;
    }

    public void Dispose()
    {
        disposed = true;
        ResetLookupCancellation();
    }
}
