@inherits ProjectsGrid

<Stack>
    <StackPersonIdField />
</Stack>

@if(AdminMode)
{
    <Stack>
        <StackButton Color="Color.Primary"
                     OnClick="AddProject"
                     EndIcon="fa-solid fa-folder-plus"
                     Label="@Localizer["AddItem", Localizer["Project"]]" />
@*         <StackButton Color="Color.Primary"
                     OnClick="@(() => MassEditMode = !MassEditMode)"
                     EndIcon="@(MassEditMode ? "fa-solid fa-check" : "fa-solid fa-edit")"
                     Label="@(MassEditMode ? Localizer["EndItem", Localizer["MassEditMode"]] : Localizer["MassEditMode"])" /> *@
    </Stack>

    @if(MassEditMode)
    {
        <StackPaged QueryItems="QueryPatientsAsync" CountItems="CountPatientsAsync" QueryKey="PatientsQueryKey" Context="patient" PageSize="5">
            <StackItemTemplate>
                <PatientEditForm @key="patient.Id" Project="patient" OnUpdate="ReloadRequired" />
            </StackItemTemplate>
        </StackPaged>
        return;
    }

}

<Stack>
    <StackSort Methods="SortMethods" />

    <StackPaged QueryItems="QueryPatientsAsync" CountItems="CountPatientsAsync" QueryKey="PatientsQueryKey" Context="patient">
        <StackItemTemplate>
            <StackButton OnClick="() => OnClicked.InvokeAsync(patient.Id)"
                         Label="@patient.Name"
                         HighlightString="@SearchString">
                <MudStack Row AlignItems="AlignItems.Center">
                    @if(patient.DateOfSurgery.HasValue)
                    {
                        <div>
                            <MudChip T="string" Text="@($"{Localizer["DateOf", Localizer["Surgery"]]}: {patient.DateOfSurgery.Value.ToShortDateString()}")" />
                        </div>
                    }
                    <div>
                        <StatsDisplay Stats="patient.Stats" />
                    </div>
                </MudStack>
            </StackButton>
        </StackItemTemplate>
    </StackPaged>
</Stack>
