@inherits CommonBase
<PaletteCard>
    <Stack>
        <StackPersonIdField Value="@Value"
                            ValueChanged="@NotifyValueChangedAsync" />
    </Stack>
    <PaletteButton OnClick="@(() => ValueChanged.InvokeAsync(Value))" Label="@Localizer["Search"]" />
</PaletteCard>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private async Task NotifyValueChangedAsync(string? value)
        => await ValueChanged.InvokeAsync(value);
}
