@inherits ProjectDetails

<Stack>
    <StackField>
        <MudGrid Spacing="2" Class="mt-2">

            <MudItem xs="12" md="6">
                <MudText HtmlTag="p">
                    <FileImageAvatar FileId="@Project.AvatarFileId" />
                </MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText HtmlTag="p" Typo="Typo.caption">
                    <span class="font-weight-medium">@Localizer["IdentificationCode"]: </span>
                    @Project.IdentificationCode
                </MudText>
            </MudItem>

            @if(patient is not null)
            {

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.FirstName))"
                                  Label="@Localizer["FirstName"]">
                    @patient.FirstName
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.LastName))"
                                  Label="@Localizer["LastName"]">
                    @patient.LastName
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@patient.DateOfSurgery.HasValue"
                                  Label="@Localizer["DateOf", Localizer["Surgery"]]">
                    @patient.DateOfSurgery?.ToShortDateString()
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(patient.Gender != Gender.Unspecified)"
                                  Label="@Localizer["Gender"]">
                    @Localizer[patient.Gender.ToString()]
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@patient.DateOfBirth.HasValue"
                                  Label="@Localizer["DateOfBirth"]">
                    @patient.DateOfBirth?.ToShortDateString() (@AgeText)
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.FatherName))"
                                  Label="@Localizer["FatherName"]">
                    @patient.FatherName
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.PlaceOfBirth))"
                                  Label="@Localizer["PlaceOfBirth"]">
                    @patient.PlaceOfBirth
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.Address))"
                                  Label="@Localizer["Address"]"
                                  Md="12">
                    @patient.Address
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(patient.Education != Education.Unspecified)"
                                  Label="@Localizer["Education"]">
                    @Localizer[patient.Education.ToString()]
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.Occupation))"
                                  Label="@Localizer["Occupation"]">
                    @patient.Occupation
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(patient.Height > 0)"
                                  Label="@Localizer["Height"]">
                    @patient.Height
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(patient.Weight > 0)"
                                  Label="@Localizer["Weight"]">
                    @patient.Weight
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.Phone))"
                                  Label="@Localizer["Phone"]">
                    @patient.Phone
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.Referrer))"
                                  Label="@Localizer["Referrer"]">
                    @patient.Referrer
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.InsuranceProvider))"
                                  Label="@Localizer["InsuranceProvider"]">
                    @patient.InsuranceProvider
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.VisitReason))"
                                  Label="@Localizer["VisitReason"]"
                                  Md="12">
                    @patient.VisitReason
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.Allergies))"
                                  Label="@Localizer["Allergies"]"
                                  Md="12">
                    @patient.Allergies
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.CurrentMedications))"
                                  Label="@Localizer["CurrentMedications"]"
                                  Md="12">
                    @patient.CurrentMedications
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.EmergencyContactName))"
                                  Label="@Localizer["EmergencyContactName"]">
                    @patient.EmergencyContactName
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.EmergencyContactPhone))"
                                  Label="@Localizer["EmergencyContactPhone"]">
                    @patient.EmergencyContactPhone
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(linkedUserId))"
                                  Label="@Localizer["LinkedUser"]">
                    @GetUserFullNameById(linkedUserId!)
                </ProjectInfoValue>

                <MudDivider />

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(Project.Description))"
                                  Md="12"
                                  Class="py-3">
                    @Project.Description
                </ProjectInfoValue>

                <ProjectInfoValue Visible="@(!string.IsNullOrWhiteSpace(patient.ClinicalNotes))"
                                  Label="@Localizer["ClinicalNotes"]"
                                  Md="12"
                                  Class="py-3">
                    @patient.ClinicalNotes
                </ProjectInfoValue>

                <MudDivider />

                @if(Project.Stats is not null)
                {
                    <ProjectInfoValue Label="@Localizer["Procedures"]"
                                      Color="Color.Secondary">
                        @Project.Stats.Procedures
                    </ProjectInfoValue>

                    <ProjectInfoValue Label="@Localizer["Events"]"
                                      Color="Color.Secondary">
                        @Project.Stats.Events
                    </ProjectInfoValue>

                    <ProjectInfoValue Visible="@Project.Stats.LastUpdate.HasValue"
                                      Label="@Localizer["LastUpdate"]"
                                      Color="Color.Secondary">
                        @Project.Stats.LastUpdate?.ToLocalTime().ToShortDateString()
                    </ProjectInfoValue>
                }
            }

        </MudGrid>
    </StackField>

    @if(AdminMode)
    {
        <StackButton OnClick="@(() => EditProject())"
                     EndIcon="fa-solid fa-pencil"
                     Label="@Localizer["EditItem", Localizer["Project"]]" Color="Color.Secondary" />
        <StackButton OnClick="@(() => DeleteProject())"
                     Color="Color.Error"
                     EndIcon="fa-solid fa-folder-xmark"
                     Label="@Localizer["DeleteItem", Localizer["Project"]]" />
    }
</Stack>

@code {
    PatientReadDto? patient;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        patient = Project.ToPatientRead();
        linkedUserId = Project.UserIds.FirstOrDefault();
    }
    private string? linkedUserId;

    private string AgeText
    {
        get
        {
            if(patient?.DateOfBirth is not DateTime dob)
                return string.Empty;
            DateTime today = DateTime.Today;
            int age = today.Year - dob.Year;
            if(dob.AddYears(age) > today)
                age--;
            return $"{age} {Localizer["Years"]}";
        }
    }
}
