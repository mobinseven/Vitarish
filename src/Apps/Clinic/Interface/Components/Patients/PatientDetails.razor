@inherits TenantCommonBase

@if(patient is null)
{
    return;
}

<Stack>
    <StackField>
        <MudGrid Spacing="3" Class="mt-2">
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 h-100" Elevation="0">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <FileImageAvatar FileId="@Patient.AvatarFileId" />

                        <MudText Typo="Typo.h6" Align="Align.Center">
                            @PatientDisplayName
                        </MudText>

                        <MudText Typo="Typo.caption" Align="Align.Center">
                            @DisplayValue(patient.Phone)
                        </MudText>
                    </MudStack>

                    <MudDivider Class="my-4" />

                    <MudGrid Spacing="2">
                        <ItemValue Label="@Localizer["IdentificationCode"]" Md="12">
                            @DisplayValue(Patient.IdentificationCode)
                        </ItemValue>

                        <ItemValue Label="@Localizer["FirstName"]" Md="12">
                            @DisplayValue(patient.FirstName)
                        </ItemValue>

                        <ItemValue Label="@Localizer["LastName"]" Md="12">
                            @DisplayValue(patient.LastName)
                        </ItemValue>

                        <ItemValue Label="@Localizer["Phone"]" Md="12">
                            @DisplayValue(patient.Phone)
                        </ItemValue>

                        <ItemValue Visible="@HasValue(linkedUserId)"
                                   Label="@Localizer["LinkedUser"]"
                                   Md="12">
                            @LinkedUserText
                        </ItemValue>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudGrid Spacing="3">
                    <MudItem xs="12" lg="6">
                        <MudPaper Class="pa-4 h-100" Elevation="0">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                @Localizer["PersonalDetails"]
                            </MudText>

                            <MudGrid Spacing="2">
                                <ItemValue Label="@Localizer["FatherName"]">
                                    @DisplayValue(patient.FatherName)
                                </ItemValue>

                                <ItemValue Label="@Localizer["Gender"]">
                                    @GenderText
                                </ItemValue>

                                <ItemValue Label="@Localizer["DateOfBirth"]">
                                    @DateOfBirthText
                                </ItemValue>

                                <ItemValue Label="@Localizer["PlaceOfBirth"]">
                                    @DisplayValue(patient.PlaceOfBirth)
                                </ItemValue>

                                <ItemValue Label="@Localizer["Education"]">
                                    @EducationText
                                </ItemValue>

                                <ItemValue Label="@Localizer["Occupation"]">
                                    @DisplayValue(patient.Occupation)
                                </ItemValue>

                                <ItemValue Label="@Localizer["Height"]">
                                    @HeightText
                                </ItemValue>

                                <ItemValue Label="@Localizer["Weight"]">
                                    @WeightText
                                </ItemValue>

                                <ItemValue Label="@Localizer["Referrer"]">
                                    @DisplayValue(patient.Referrer)
                                </ItemValue>

                                <ItemValue Label="@Localizer["Address"]" Md="12">
                                    @DisplayValue(patient.Address)
                                </ItemValue>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" lg="6">
                        <MudPaper Class="pa-4 h-100" Elevation="0">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                @Localizer["ClinicalData"]
                            </MudText>

                            <MudGrid Spacing="2">
                                <ItemValue Label="@Localizer["DateOf", Localizer["Surgery"]]">
                                    @FormatDate(patient.DateOfSurgery)
                                </ItemValue>

                                <ItemValue Label="@Localizer["InsuranceProvider"]">
                                    @DisplayValue(patient.InsuranceProvider)
                                </ItemValue>

                                <ItemValue Label="@Localizer["VisitReason"]" Md="12">
                                    @DisplayValue(patient.VisitReason)
                                </ItemValue>

                                <ItemValue Label="@Localizer["Allergies"]" Md="12">
                                    @DisplayValue(patient.Allergies)
                                </ItemValue>

                                <ItemValue Label="@Localizer["CurrentMedications"]" Md="12">
                                    @DisplayValue(patient.CurrentMedications)
                                </ItemValue>

                                <ItemValue Label="@Localizer["EmergencyContactName"]">
                                    @DisplayValue(patient.EmergencyContactName)
                                </ItemValue>

                                <ItemValue Label="@Localizer["EmergencyContactPhone"]">
                                    @DisplayValue(patient.EmergencyContactPhone)
                                </ItemValue>

                                <ItemValue Label="@Localizer["ClinicalNotes"]" Md="12" Class="py-3">
                                    @DisplayValue(patient.ClinicalNotes)
                                </ItemValue>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    @if(HasValue(Patient.Description) || Patient.Stats is not null)
                    {
                        <MudItem xs="12">
                            <MudPaper Class="pa-4" Elevation="0">
                                <MudText Typo="Typo.h6" Class="mb-3">
                                    @Localizer["Summary"]
                                </MudText>

                                <MudGrid Spacing="2">
                                    <ItemValue Visible="@HasValue(Patient.Description)"
                                               Md="12"
                                               Class="py-3">
                                        @Patient.Description
                                    </ItemValue>

                                    @if(Patient.Stats is not null)
                                    {
                                        <ItemValue Label="@Localizer["Procedures"]"
                                                   Color="Color.Secondary">
                                            @Patient.Stats.Procedures
                                        </ItemValue>

                                        <ItemValue Label="@Localizer["Events"]"
                                                   Color="Color.Secondary">
                                            @Patient.Stats.Events
                                        </ItemValue>

                                        <ItemValue Label="@Localizer["LastUpdate"]"
                                                   Color="Color.Secondary">
                                            @LastUpdateText
                                        </ItemValue>
                                    }
                                </MudGrid>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudItem>
        </MudGrid>
    </StackField>

    @if(AdminMode)
    {
        <StackButton OnClick="@(() => OnEdit.InvokeAsync(Patient.Id))"
                     EndIcon="fa-solid fa-pencil"
                     Label="@Localizer["EditItem", Localizer["Patient"]]"
                     Color="Color.Secondary" />

        <StackButton 
                     OnClick="@(() => OnDeleted.InvokeAsync())"
                     Color="Color.Error"
                     EndIcon="fa-solid fa-folder-xmark"
                     Label="@Localizer["DeleteItem", Localizer["Patient"]]" />
    }
</Stack>

    @code {

    [Parameter, EditorRequired] public PatientViewDto Patient { get; set; }
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }

    private const string EmptyText = "—";

    private PatientViewDto? patient;
    private string? linkedUserId;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        patient = Patient;
        linkedUserId = Patient.UserIds.FirstOrDefault();
    }

    private string PatientDisplayName
    {
        get
        {
            string fullName = string.Join(" ", new[] { patient?.FirstName, patient?.LastName }
                .Where(HasValue));

            return HasValue(fullName) ? fullName : Localizer["Patient"].Value;
        }
    }

    private string LinkedUserText
        => HasValue(linkedUserId) ? GetUserFullNameById(linkedUserId!) : EmptyText;

    private string DateOfBirthText
        => patient?.DateOfBirth is DateTime dateOfBirth
            ? $"{FormatDate(dateOfBirth)} ({AgeText})"
            : EmptyText;

    private string GenderText
        => patient is null || patient.Gender == Gender.Unspecified
            ? EmptyText
            : Localizer[patient.Gender.ToString()].Value;

    private string EducationText
        => patient is null || patient.Education == Education.Unspecified
            ? EmptyText
            : Localizer[patient.Education.ToString()].Value;

    private string HeightText
        => patient is not null && patient.Height > 0 ? patient.Height.ToString() : EmptyText;

    private string WeightText
        => patient is not null && patient.Weight > 0 ? patient.Weight.ToString() : EmptyText;

    private string LastUpdateText
        => Patient.Stats?.LastUpdate is DateTime lastUpdate
            ? lastUpdate.ToLocalTime().ToShortDateString()
            : EmptyText;

    private string AgeText
    {
        get
        {
            if(patient?.DateOfBirth is not DateTime dob)
                return EmptyText;

            DateTime today = DateTime.Today;
            int age = today.Year - dob.Year;

            if(dob.AddYears(age) > today)
                age--;

            return $"{age} {Localizer["Years"]}";
        }
    }

    private static bool HasValue(string? value)
        => !string.IsNullOrWhiteSpace(value);

    private static string DisplayValue(string? value)
        => HasValue(value) ? value! : EmptyText;

    private static string FormatDate(DateTime? value)
        => value?.ToShortDateString() ?? EmptyText;
}
