@namespace Vitarish.Clinic.Interface.Components.Patients
@inherits Vitarish.Modules.Aggregator.Interface.TenantCommonBase

<Stack>
    <StackField Label="@Localizer["PatientFound"]" />

    <StackButton Label="@Patient.Name"
                 HelperText="@HelperText"
                 EndIcon="fa-solid fa-arrow-right"
                 Color="Color.Success"
                 OnClick="@SelectPatientAsync" />
</Stack>

@code {
    [Parameter, EditorRequired] public ProjectReadDto Patient { get; set; } = default!;
    [Parameter] public EventCallback<ProjectReadDto> OnPatientSelected { get; set; }

    private string HelperText
        => PatientDisplayText.GetPatientHelperText(Patient, Localizer["IdentificationCode"].Value);

    private async Task SelectPatientAsync()
        => await OnPatientSelected.InvokeAsync(Patient);
}
