@using System.Threading
@inherits Vitarish.Modules.Base.TenantCommonBase
@implements IDisposable

<PaletteCard>
    <Stack>
        <StackPersonIdField Value="@Context.IdentificationCode"
                            ValueChanged="OnIdentificationCodeChangedAsync" />

    
    </Stack>
</PaletteCard>
@if(Context.IsIdentificationLookupLookingUp)
{
    <Stack>
        <StackProgress />
    </Stack>
}
else if(Context.ExactIdentificationCodeMatch is ProjectReadDto exactMatch)
{
    <Stack>
        <StackField Label="@Localizer["PatientFound"]" />

        <StackButton Label="@exactMatch.Name"
                     HelperText="@GetPatientHelperText(exactMatch)"
                     EndIcon="fa-solid fa-arrow-right"
                     Color="Color.Success"
                     OnClick="@(() => SelectPatientAsync(exactMatch))" />
    </Stack>
}
else if(Context.IsIdentificationLookupNotFound)
{
    string notFoundIdentificationCode = GetNotFoundIdentificationCode();

    <Stack>
        @if(NotFoundContent is not null)
        {
            @NotFoundContent(notFoundIdentificationCode)
        }
        else
        {
            <StackField Label="@Localizer["PatientNotFound", notFoundIdentificationCode]" />
        }
    </Stack>

    @RenderAdvancedSearch()
}
else if(Context.IsIdentificationLookupFailed)
{
    <Stack>
        <StackField Label="@GetIdentificationLookupFailureText()" />

        <StackButton Label="@Localizer["Retry"]"
                     EndIcon="fa-solid fa-rotate-right"
                     Color="Color.Secondary"
                     Disabled="@(!Context.HasIdentificationCode)"
                     OnClick="RetryIdentificationLookupAsync" />
    </Stack>
}
@code {
    [Parameter, EditorRequired] public PatientAdvancedSearchContext Context { get; set; } = default!;
    [Parameter] public EventCallback<ProjectReadDto> OnPatientSelected { get; set; }

    /// <summary>
    /// Optional placeholder for the not-found flow. The string argument is the normalized person id.
    /// Use this later to render create/register-patient content without changing this component again.
    /// </summary>
    [Parameter] public RenderFragment<string>? NotFoundContent { get; set; }

    [Inject] private IAccessControlledProjectsService ProjectsService { get; set; } = default!;

    private const int IdentificationLookupDebounceMs = 160;
    private const int MaxSearchResults = 50;
    private const int MaxAdvancedSearchCandidates = 500;

    private CancellationTokenSource? identificationLookupCts;
    private CancellationTokenSource? advancedSearchCts;
    private int identificationLookupVersion;
    private int advancedSearchVersion;
    private bool disposed;

    private RenderFragment RenderAdvancedSearch() => @<Stack>
        <StackTextField @bind-Value="Context.SearchQuery"
                        Label="@Localizer["PatientName"]"
                        Adornment="Adornment.End"
                        HelperText="@Localizer["PatientNameHelp"]" />

        <StackTextField @bind-Value="Context.SearchIdentificationCode"
                        Label="@Localizer["IdentificationCode"]"
                        HelperText="@Localizer["PatientIdentificationCodeHelp"]" />

        <StackDatePicker @bind-Date="Context.SearchDateOfBirth"
                         Label="@Localizer["DateOfBirth"]" />

        <StackTextField @bind-Value="Context.SearchPhone"
                        Label="@Localizer["Phone"]"
                        InputType="InputType.Telephone" />

        <StackTextField @bind-Value="Context.SearchEmail"
                        Label="@Localizer["Email"]"
                        InputType="InputType.Email" />

        <StackButton Label="@Localizer["AdvancedSearch"]"
                     Color="Color.Primary"
                     EndIcon="@(Context.AdvancedSearchInProgress ? "fa-solid fa-circle-notch fa-spin" : "fa-solid fa-magnifying-glass")"
                     Disabled="@(!CanRunAdvancedSearch)"
                     OnClick="OnContinueWithSearchAsync" />

        @if(Context.AdvancedSearchInProgress)
        {
            <StackProgress />
        }
        else if(Context.SearchResults.Count > 0)
        {
            @foreach(ProjectReadDto result in Context.SearchResults)
            {
                <StackButton @key="result"
                             Label="@result.Name"
                             HelperText="@GetPatientHelperText(result)"
                             EndIcon="fa-solid fa-user-check"
                             Color="Color.Primary"
                             OnClick="@(() => SelectPatientAsync(result))" />
            }
        }
        else if(Context.AdvancedSearchDone)
        {
            <StackField Label="@Localizer["NoSearchItems", GetAdvancedSearchSummary()]" />
        }
    </Stack>;

    private bool CanRunAdvancedSearch
        => !Context.AdvancedSearchInProgress
           && !Context.IdentificationLookupInProgress
           && HasAdvancedSearchCriteria();

    private async Task OnIdentificationCodeChangedAsync(string? value)
    {
        int version = Interlocked.Increment(ref identificationLookupVersion);
        identificationLookupCts?.Cancel();
        identificationLookupCts?.Dispose();
        identificationLookupCts = new CancellationTokenSource();
        CancellationToken ct = identificationLookupCts.Token;

        Context.PrepareForIdentificationCodeInput(value);
        CancelAdvancedSearch();

        string? code = NormalizeText(value);
        if(code is null)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        Context.BeginIdentificationLookup(code);
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(IdentificationLookupDebounceMs, ct);

            ProjectReadDto? exactMatch = await FindExactIdentificationCodeMatchAsync(code, ct);
            if(IsStaleIdentificationLookup(version, ct))
            {
                return;
            }

            Context.CompleteIdentificationLookup(exactMatch, code);
        }
        catch(OperationCanceledException)
        {
            if(version == identificationLookupVersion)
            {
                Context.CancelIdentificationLookup();
            }
        }
        catch(Exception ex)
        {
            if(version == identificationLookupVersion)
            {
                Context.FailIdentificationLookup(code, ex.Message);
            }
        }
        finally
        {
            if(!disposed && version == identificationLookupVersion)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task RetryIdentificationLookupAsync()
    {
        await OnIdentificationCodeChangedAsync(Context.IdentificationCode);
    }

    private async Task<ProjectReadDto?> FindExactIdentificationCodeMatchAsync(string code, CancellationToken ct)
    {
        // IdentificationCode is the primary gate. Take = 1 keeps the roundtrip and allocation cost minimal.
        ProjectDescriptorDto descriptor = new()
        {
            IdentificationCode = code,
            Template = false,
            Skip = 0,
            Take = 1
        };

        IReadOnlyList<ProjectReadDto> results = await ProjectsService
            .GetListAsync(descriptor, ct)
            .GetValueOrDefaultAsync() ?? [];

        return results.FirstOrDefault(project => IsExactIdentificationCode(project, code));
    }

    private async Task OnContinueWithSearchAsync()
    {
        if(!CanRunAdvancedSearch)
        {
            return;
        }

        int version = Interlocked.Increment(ref advancedSearchVersion);
        advancedSearchCts?.Cancel();
        advancedSearchCts?.Dispose();
        advancedSearchCts = new CancellationTokenSource();
        CancellationToken ct = advancedSearchCts.Token;

        Context.BeginAdvancedSearch();
        await InvokeAsync(StateHasChanged);

        try
        {
            AdvancedSearchCriteria criteria = AdvancedSearchCriteria.From(Context);
            IReadOnlyList<ProjectReadDto> candidates = await LoadAdvancedSearchCandidatesAsync(criteria, ct);

            if(IsStaleAdvancedSearch(version, ct))
            {
                return;
            }

            IReadOnlyList<ProjectReadDto> results = [.. candidates
                .Where(project => MatchesAdvancedSearch(project, criteria))
                .Take(MaxSearchResults)];

            Context.CompleteAdvancedSearch(results);
        }
        catch(OperationCanceledException)
        {
            // A newer search or new identification-code lookup has superseded this search.
        }
        catch
        {
            if(version == advancedSearchVersion)
            {
                Context.FailAdvancedSearch();
            }
        }
        finally
        {
            if(!disposed && version == advancedSearchVersion)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task SelectPatientAsync(ProjectReadDto patient)
    {
        await OnPatientSelected.InvokeAsync(patient);
    }

    private async Task<IReadOnlyList<ProjectReadDto>> LoadAdvancedSearchCandidatesAsync(AdvancedSearchCriteria criteria, CancellationToken ct)
    {
        ProjectDescriptorDto descriptor = new()
        {
            IdentificationCode = criteria.IdentificationCode,
            Search = criteria.IdentificationCode is null ? criteria.Name : null,
            Template = false,
            Skip = 0,
            Take = criteria.NeedsLargeClientSideSearch ? MaxAdvancedSearchCandidates : MaxSearchResults
        };

        return await ProjectsService
            .GetListAsync(descriptor, ct)
            .GetValueOrDefaultAsync() ?? [];
    }

    private bool HasAdvancedSearchCriteria()
        => !string.IsNullOrWhiteSpace(Context.SearchQuery)
           || !string.IsNullOrWhiteSpace(Context.SearchIdentificationCode)
           || Context.SearchDateOfBirth.HasValue
           || !string.IsNullOrWhiteSpace(Context.SearchPhone)
           || !string.IsNullOrWhiteSpace(Context.SearchEmail);

    private static bool MatchesAdvancedSearch(ProjectReadDto project, AdvancedSearchCriteria criteria)
        => MatchesName(project.Name, criteria.NameTokens)
           && MatchesIdentificationCode(project, criteria.IdentificationCode)
           && MatchesDate(project.GetField<DateTime?>(nameof(PatientReadDto.DateOfBirth)), criteria.DateOfBirth)
           && MatchesPhone(project.GetField<string>(nameof(PatientReadDto.Phone)), criteria)
           && MatchesText(project.GetField<string>(nameof(PatientReadDto.Email)), criteria.Email);

    private static bool MatchesName(string? value, IReadOnlyList<string> expectedTokens)
    {
        if(expectedTokens.Count == 0)
        {
            return true;
        }

        if(string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        return expectedTokens.All(token => value.Contains(token, StringComparison.OrdinalIgnoreCase));
    }

    private static bool MatchesIdentificationCode(ProjectReadDto project, string? identificationCode)
        => identificationCode is null || IsExactIdentificationCode(project, identificationCode);

    private static bool IsExactIdentificationCode(ProjectReadDto project, string identificationCode)
        => string.Equals(project.IdentificationCode?.Trim(), identificationCode, StringComparison.OrdinalIgnoreCase);

    private static bool MatchesDate(DateTime? value, DateTime? expected)
        => !expected.HasValue || (value.HasValue && value.Value.Date == expected.Value.Date);

    private static bool MatchesText(string? value, string? expected)
        => expected is null
           || (!string.IsNullOrWhiteSpace(value) && value.Contains(expected, StringComparison.OrdinalIgnoreCase));

    private static bool MatchesPhone(string? value, AdvancedSearchCriteria criteria)
    {
        if(criteria.Phone is null)
        {
            return true;
        }

        if(string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        if(criteria.PhoneDigits.Length > 0)
        {
            string valueDigits = DigitsOnly(value);
            return valueDigits.Contains(criteria.PhoneDigits, StringComparison.Ordinal);
        }

        return value.Contains(criteria.Phone, StringComparison.OrdinalIgnoreCase);
    }

    private static string DigitsOnly(string value) => new(value.Where(char.IsDigit).ToArray());

    private static string? NormalizeText(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static IReadOnlyList<string> Tokenize(string? value)
        => NormalizeText(value)?
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

    private sealed record AdvancedSearchCriteria(
        string? Name,
        IReadOnlyList<string> NameTokens,
        string? IdentificationCode,
        DateTime? DateOfBirth,
        string? Phone,
        string PhoneDigits,
        string? Email)
    {
        public bool NeedsLargeClientSideSearch
            => DateOfBirth.HasValue
               || Phone is not null
               || Email is not null;

        public static AdvancedSearchCriteria From(PatientAdvancedSearchContext context)
        {
            string? name = NormalizeText(context.SearchQuery);
            string? phone = NormalizeText(context.SearchPhone);

            return new(
                name,
                Tokenize(name),
                NormalizeText(context.SearchIdentificationCode),
                context.SearchDateOfBirth?.Date,
                phone,
                phone is null ? string.Empty : DigitsOnly(phone),
                NormalizeText(context.SearchEmail));
        }
    }

    private string GetNotFoundIdentificationCode()
        => NormalizeText(Context.LastLookedUpIdentificationCode)
           ?? NormalizeText(Context.IdentificationCode)
           ?? string.Empty;

    private string GetIdentificationLookupFailureText()
    {
        string identificationCode = GetNotFoundIdentificationCode();

        return string.IsNullOrWhiteSpace(Context.IdentificationLookupError)
            ? Localizer["PatientIdentificationLookupFailed", identificationCode]
            : Localizer["PatientIdentificationLookupFailed", identificationCode, Context.IdentificationLookupError];
    }

    private string GetAdvancedSearchSummary()
    {
        List<string> parts = [];

        AddCriteria(parts, Localizer["PatientName"].Value, Context.SearchQuery);
        AddCriteria(parts, Localizer["IdentificationCode"].Value, Context.SearchIdentificationCode);
        AddCriteria(parts, Localizer["DateOfBirth"].Value, Context.SearchDateOfBirth?.ToShortDateString());
        AddCriteria(parts, Localizer["Phone"].Value, Context.SearchPhone);
        AddCriteria(parts, Localizer["Email"].Value, Context.SearchEmail);

        return parts.Count == 0 ? Localizer["NoCriteria"].Value : string.Join(" · ", parts);
    }

    private static void AddCriteria(List<string> parts, string label, string? value)
    {
        if(!string.IsNullOrWhiteSpace(value))
        {
            parts.Add($"{label}: {value.Trim()}");
        }
    }

    private string GetPatientHelperText(ProjectReadDto project)
    {
        PatientReadDto patient = project.ToPatientRead();
        List<string> parts = [];

        if(!string.IsNullOrWhiteSpace(project.IdentificationCode))
        {
            parts.Add($"{Localizer["IdentificationCode"]}: {project.IdentificationCode}");
        }

        if(patient.DateOfBirth.HasValue)
        {
            parts.Add(patient.DateOfBirth.Value.ToShortDateString());
        }

        if(!string.IsNullOrWhiteSpace(patient.Phone))
        {
            parts.Add(patient.Phone);
        }

        if(!string.IsNullOrWhiteSpace(patient.Email))
        {
            parts.Add(patient.Email);
        }

        return string.Join(" · ", parts);
    }

    private bool IsStaleIdentificationLookup(int version, CancellationToken ct)
        => ct.IsCancellationRequested || version != identificationLookupVersion;

    private bool IsStaleAdvancedSearch(int version, CancellationToken ct)
        => ct.IsCancellationRequested || version != advancedSearchVersion;

    private void CancelAdvancedSearch()
    {
        Interlocked.Increment(ref advancedSearchVersion);
        advancedSearchCts?.Cancel();
        advancedSearchCts?.Dispose();
        advancedSearchCts = null;
    }

    public void Dispose()
    {
        disposed = true;
        identificationLookupCts?.Cancel();
        identificationLookupCts?.Dispose();
        advancedSearchCts?.Cancel();
        advancedSearchCts?.Dispose();
    }
}
