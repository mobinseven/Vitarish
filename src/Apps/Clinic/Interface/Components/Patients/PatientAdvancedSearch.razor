@namespace Vitarish.Clinic.Interface.Components.Patients
@inherits Vitarish.Modules.Base.Interface.TenantCommonBase

<PatientIdentificationCodeLookup Context="@Context"
                                 NotFoundContent="@NotFoundContent"
                                 OnPatientSelected="@OnPatientSelected" />

@code {
    [Parameter, EditorRequired] public PatientAdvancedSearchContext Context { get; set; } = default!;
    [Parameter] public EventCallback<ProjectReadDto> OnPatientSelected { get; set; }

    /// <summary>
    /// Optional placeholder for the not-found flow. The string argument is the normalized person id.
    /// Use this later to render create/register-patient content without changing the lookup flow again.
    /// </summary>
    [Parameter] public RenderFragment<string>? NotFoundContent { get; set; }
}
