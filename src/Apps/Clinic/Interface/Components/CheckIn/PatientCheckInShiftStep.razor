@inherits Vitarish.Modules.Base.TenantCommonBase

<Stack>
    <StackField Label="@Localizer["SelectShift"]"
                HelperText="@(Context.SelectedPatient?.Name ?? string.Empty)" />
</Stack>

<Stack>

    @if(loadingReservations)
    {
        <StackField Label="@Localizer["Loading"]" AdornmentIcon="fa-regular fa-circle-notch fa-spin" />
    }
    else
    {
        <StackCalendar MinDate="@DateTime.Today" DayCount="3">
            <DayTemplate Context="day">
                @{
                    var thisDaySlots = slots.Where(i => i.Occurrence?.Date == DateOnly.FromDateTime(day.Date));
                }
                <div style="height: 100%">
                    <div style="place-self: center;">
                        @day.DayNumber
                    </div>
                    @foreach(var slot in thisDaySlots)
                    {
                        bool alreadyBooked = patientReservations.Any(r =>
                        DateOnly.FromDateTime(day.Date) == r.Date &&
                        r.ShiftId == slot?.Shift.Id &&
                        r.Status != ReservationStatus.Cancelled &&
                        r.Status != ReservationStatus.Rejected &&
                        r.Status != ReservationStatus.Expired);
                        bool shiftIsFull = slot?.Occurrence is not null && slot.Occurrence.AvailableSeats == 0;

                        if(alreadyBooked)
                        {
                            <MudButton Color="Color.Success">
                                <span>
                                    @slot!.Shift.StartTime.ToShortTimeString()
                                </span>
                                -
                                <span>
                                    @slot!.Shift.EndTime.ToShortTimeString()
                                </span>
                            </MudButton>
                        }
                        else if(slot?.Occurrence?.AvailableSeats > 0)
                        {
                            <MudButton Color="Color.Primary" FullWidth OnClick="() => BookSlotAsync(slot!.Shift, slot.Occurrence!)">
                                <span>
                                    @slot!.Shift.StartTime.ToShortTimeString()
                                </span>
                                -
                                <span>
                                    @slot!.Shift.EndTime.ToShortTimeString()
                                </span>
                            </MudButton>
                        }
                        else if(shiftIsFull)
                        {
                            <MudButton Color="Color.Warning" Disabled="true">
                                <span>
                                    @slot!.Shift.StartTime.ToShortTimeString()
                                </span>
                                -
                                <span>
                                    @slot!.Shift.EndTime.ToShortTimeString()
                                </span>
                            </MudButton>
                            @if(AdminMode)
                            {
                                <MudButton Color="Color.Warning" Variant="Variant.Outlined" OnClick="() => BookSlotAsync(slot!.Shift, slot.Occurrence!, true)">
                                    @Localizer["OverrideCapacity"]
                                </MudButton>
                            }
                            @if(waitlistEnabled && !HasSameDayCapacity(slot!.Occurrence!.Date))
                            {
                                <MudButton Color="Color.Info" Variant="Variant.Text" OnClick="() => JoinWaitlistAsync(slot!.Shift, slot.Occurrence!)">
                                    @Localizer["JoinWaitlist"]
                                </MudButton>
                            }
                        }

                    }
                </div>
            </DayTemplate>
        </StackCalendar>
    }

    @if(!string.IsNullOrWhiteSpace(bookingError))
    {
        <StackField Label="@bookingError"
                    AdornmentIcon="fa-regular fa-circle-xmark"
                    AdornmentColor="Color.Error"
                    Color="Color.Error" />
    }

    <StackButton Label="@Localizer["Back"]"
                 EndIcon="fa-regular fa-arrow-left"
                 OnClick="OnBack" />
</Stack>
