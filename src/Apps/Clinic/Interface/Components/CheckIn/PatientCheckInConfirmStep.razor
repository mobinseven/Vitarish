@inherits Vitarish.Modules.Base.TenantCommonBase
<Stack>
    <StackField Label="@Localizer["CheckInComplete"]"
                AdornmentIcon="fa-solid fa-circle-check"
                AdornmentColor="@(Context.Outcome == CheckInOutcome.CurrentShift ? Color.Success : Color.Info)" />
    @if (Context.ConfirmedReservation is not null)
    {
        <StackField Label="@Localizer["ReservationSuccessful"]"
                    AdornmentIcon="fa-solid fa-calendar-check"
                    AdornmentColor="Color.Success"
                    Color="Color.Success" />
    }

    @if (Context.SelectedPatient is not null)
    {
        <StackField Label="@Localizer["Patient"]" />
        <StackButton Label="@Context.SelectedPatient.Name"
                     EndIcon="fa-solid fa-user"
                     OnClick="HandleGoToPatientAsync" Color="Color.Secondary" />
    }

    @if (Context.Outcome == CheckInOutcome.CurrentShift)
    {
        <StackField Label="@Localizer["CheckedInToday"]"
                    HelperText="@GetOutcomeHelperText()"
                    AdornmentIcon="fa-solid fa-hospital"
                    AdornmentColor="Color.Success"
                    Color="Color.Success" />
    }
    else if (Context.Outcome == CheckInOutcome.FutureShift)
    {
        <StackField Label="@Localizer["BookedForFuture"]"
                    HelperText="@GetOutcomeHelperText()"
                    AdornmentIcon="fa-solid fa-calendar-check"
                    AdornmentColor="Color.Info"
                    Color="Color.Info" />
    }

    @if (!string.IsNullOrWhiteSpace(Context.OperationalWarning))
    {
        <StackField Label="@Context.OperationalWarning"
                    AdornmentIcon="fa-solid fa-triangle-exclamation"
                    AdornmentColor="Color.Warning"
                    Color="Color.Warning" />
    }

    @if (Context.NotificationStatus != CheckInNotificationStatus.None)
    {
        <StackField Label="@GetNotificationLabel()"
                    HelperText="@Context.NotificationMessage"
                    AdornmentIcon="@(Context.NotificationStatus == CheckInNotificationStatus.Sent ? "fa-solid fa-paper-plane" : "fa-solid fa-circle-xmark")"
                    AdornmentColor="@(Context.NotificationStatus == CheckInNotificationStatus.Sent ? Color.Success : Color.Error)"
                    Color="@(Context.NotificationStatus == CheckInNotificationStatus.Sent ? Color.Success : Color.Error)" />
    }

    @if (Context.ConfirmedReservation is not null)
    {
        <StackField Label="@Localizer["Appointment"]" />
        <StackField Label="@GetShiftLabel()"
                    HelperText="@GetDateTimeLabel()">
            <ReservationStatusBadge Status="Context.ConfirmedReservation.Status" />
        </StackField>
    }
</Stack>

<Stack>
    @if(Context.SelectedPatient is not null)
    {
        <StackButton Label="@Localizer["GoToPatient"]"
                     EndIcon="fa-solid fa-arrow-right"
                     Color="Color.Primary"
                     OnClick="HandleGoToPatientAsync" />
        <StackButton Label="@Localizer["SendSmsConfirmation"]"
                     EndIcon="fa-solid fa-paper-plane"
                     Variant="Variant.Outlined"
                     OnClick="SendConfirmationAsync" Color="Color.Primary" />
    }

    <StackButton Label="@Localizer["StartAnotherCheckIn"]"
                 EndIcon="fa-solid fa-rotate-right"
                 OnClick="OnStartAnother" Color="Color.Primary" />
</Stack>

@code {
    [Parameter, EditorRequired] public PatientCheckInContext Context { get; set; } = default!;
    [Parameter] public EventCallback OnStartAnother { get; set; }
    [Parameter] public EventCallback<Guid> OnGoToPatient { get; set; }
    [Inject] private ICommunicationCommandQueue CommunicationCommandQueue { get; set; } = default!;

    private string GetNotificationLabel() => Context.NotificationStatus == CheckInNotificationStatus.Sent
        ? Localizer["SmsConfirmationSent"]
        : Localizer["SmsConfirmationFailed"];

    private string GetOutcomeHelperText()
    {
        if (Context.SelectedShift is null || Context.SelectedOccurrence is null)
        {
            return string.Empty;
        }

        return $"{GetShiftLabel()} · {Context.SelectedOccurrence.Date:d} {Context.SelectedOccurrence.StartTime:t}";
    }

    private string GetShiftLabel()
    {
        if (Context.SelectedShift is null)
        {
            return string.Empty;
        }

        return $"{Localizer[Context.SelectedShift.DayOfWeek.ToString()]} {Context.SelectedShift.StartTime:t}-{Context.SelectedShift.EndTime:t}";
    }

    private string GetDateTimeLabel()
    {
        if (Context.SelectedOccurrence is null)
        {
            return string.Empty;
        }

        return $"{Context.SelectedOccurrence.Date:d} {Context.SelectedOccurrence.StartTime:t}–{Context.SelectedOccurrence.EndTime:t}";
    }

    private Task HandleGoToPatientAsync()
    {
        return Context.SelectedPatient is null
            ? Task.CompletedTask
            : OnGoToPatient.InvokeAsync(Context.SelectedPatient.Id);
    }

    private async Task SendConfirmationAsync()
    {
        if (Context.NotificationChannel != CheckInNotificationChannel.Sms || Context.SelectedPatient is null || Context.SelectedOccurrence is null)
        {
            Context.NotificationStatus = CheckInNotificationStatus.Failed;
            Context.NotificationMessage = Localizer["SmsConfirmationFailedMissingRecipient"];
            return;
        }

        string? linkedUserId = Context.SelectedPatient.UserIds.FirstOrDefault();
        string? phoneNumber = TenantService.Users?.FirstOrDefault(u => u.Id == linkedUserId)?.PhoneNumber;

        if (string.IsNullOrWhiteSpace(phoneNumber))
        {
            Context.NotificationStatus = CheckInNotificationStatus.Failed;
            Context.NotificationMessage = Localizer["SmsConfirmationFailedMissingRecipient"];
            return;
        }

        try
        {
            string body = Localizer["SmsConfirmationBody", Context.SelectedPatient.Name, GetDateTimeLabel()];
            CommunicationCommandQueue.Enqueue(new SmsCommunicationCommand(phoneNumber, body));
            Context.NotificationStatus = CheckInNotificationStatus.Sent;
            Context.NotificationMessage = GetLocalizedText("SmsConfirmationQueued", "SMS confirmation queued.");
        }
        catch (Exception)
        {
            Context.NotificationStatus = CheckInNotificationStatus.Failed;
            Context.NotificationMessage = Localizer["SmsConfirmationSendFailed"];
        }

        await InvokeAsync(StateHasChanged);
    }

    private string GetLocalizedText(string key, string fallback)
    {
        LocalizedString localized = Localizer[key];
        return localized.ResourceNotFound ? fallback : localized.Value;
    }
}
