@inherits Vitarish.Modules.Base.Interface.TenantCommonBase

<Stack>
    <StackField Label="@Localizer["Appointments"]" />
    @if (AdminMode)
    {
        <StackButton Color="Color.Primary"
                     OnClick="OpenBookingDialogAsync"
                     EndIcon="fa-solid fa-calendar-plus"
                     Label="@Localizer["AddItem", Localizer["Appointment"]]" />
    }
    @if (reservations is not null && reservations.Count > 0)
    {
        @foreach (var reservation in reservations)
        {
            <StackButton OnClick="@(() => OpenDetailDialogAsync(reservation))"
                         Label="@GetReservationLabel(reservation)" Color="Color.Info">
                <ReservationStatusBadge Status="reservation.Status" />
            </StackButton>
        }
    }
</Stack>

    @code {
    [Parameter, EditorRequired] public ProjectReadDto Patient { get; set; } = default!;
    [Parameter] public EventCallback OnEdit { get; set; }

    [Inject] private IAccessControlledReservationManager ReservationManager { get; set; } = default!;
    [Inject] private IAccessControlledShiftManager ShiftsService { get; set; } = default!;

    private List<ReservationReadDto> reservations = [];
    private Dictionary<Guid, ShiftReadDto> reservationShifts = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Prefer the linked user ID; fall back to the patient's own project ID as a stable
        // party identifier — the Appointments module treats it as an opaque string.
        string? userId = Patient.UserIds.FirstOrDefault();
        string reservingPartyId = !string.IsNullOrWhiteSpace(userId)
            ? userId
            : Patient.Id.ToString();

        ReservationDescriptorDto descriptor = new() { ReservingPartyId = reservingPartyId, Skip = 0, Take = int.MaxValue };
        IReadOnlyList<ReservationReadDto> all = await ReservationManager.GetListAsync(descriptor, CancellationToken.None).GetValueOrDefaultAsync() ?? [];
        reservationShifts = await LoadReservationShiftsAsync(all);
        reservations = [.. all.OrderBy(r => r.Date).ThenBy(r => GetShiftStartTime(r.ShiftId)).ThenBy(r => GetShiftEndTime(r.ShiftId))];
        await InvokeAsync(StateHasChanged);
    }

    private async Task<Dictionary<Guid, ShiftReadDto>> LoadReservationShiftsAsync(IReadOnlyList<ReservationReadDto> reservationItems)
    {
        Dictionary<Guid, ShiftReadDto> shiftsById = [];

        foreach (Guid shiftId in reservationItems.Select(r => r.ShiftId).Distinct())
        {
            ShiftReadDto? shift = await ShiftsService.GetAsync(shiftId, CancellationToken.None).GetValueOrDefaultAsync();
            if (shift is not null)
            {
                shiftsById[shift.Id] = shift;
            }
        }

        return shiftsById;
    }

    private string GetReservationLabel(ReservationReadDto reservation)
    {
        if (!reservationShifts.TryGetValue(reservation.ShiftId, out ShiftReadDto? shift))
        {
            return $"{reservation.Date:d} {Localizer["ShiftUnavailable"].Value}";
        }

        return $"{reservation.Date:d} {Localizer[shift.DayOfWeek.ToString()]} {shift.StartTime:t}-{shift.EndTime:t}";
    }

    private TimeOnly GetShiftStartTime(Guid shiftId)
        => reservationShifts.TryGetValue(shiftId, out ShiftReadDto? shift) ? shift.StartTime : TimeOnly.MinValue;

    private TimeOnly GetShiftEndTime(Guid shiftId)
        => reservationShifts.TryGetValue(shiftId, out ShiftReadDto? shift) ? shift.EndTime : TimeOnly.MinValue;

    private async Task OpenBookingDialogAsync()
    {
        DialogParameters parameters = new()
        {
            { nameof(PatientAppointmentBookingDialog.Patient), Patient }
        };

        IDialogReference dialog = await DialogService.ShowAsync<PatientAppointmentBookingDialog>(
            Localizer["AddItem", Localizer["Appointment"]], parameters);
        _ = await dialog.Result;
        await LoadAsync();
    }

    private async Task OpenDetailDialogAsync(ReservationReadDto reservation)
    {
        DialogParameters parameters = new()
        {
            { nameof(ReservationDetailDialog.Reservation), reservation }
        };

        IDialogReference dialog = await DialogService.ShowAsync<ReservationDetailDialog>(null, parameters);
        _ = await dialog.Result;
        await LoadAsync();
    }
}
