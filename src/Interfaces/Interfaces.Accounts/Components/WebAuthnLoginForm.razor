@if(IsSupported)
{
    <Stack>
        @if(!string.IsNullOrEmpty(ErrorMessage))
        {
            <StackField Label="@ErrorMessage" />
        }
        <StackTextField @bind-Value="Username"
                        Label="@Localizer["UserName"]"
                        UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "username webauthn" }, { "aria-required", "true" } })"
                        Disabled="@IsAuthenticating" />
        <StackButton Color="Color.Primary"
        Label="@Localizer["Continue"]"
                     OnClick="@AuthenticateAsync"
                     Disabled="@(IsAuthenticating || string.IsNullOrWhiteSpace(Username))" />
    </Stack>
}
else
{
    <Stack>
        <StackField Label="@Localizer["PasskeyNotSupported"]" />
    </Stack>
}
