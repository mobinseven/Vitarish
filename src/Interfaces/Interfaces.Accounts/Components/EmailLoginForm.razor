@if(Email is null)
{
    <Stack>
        <StackField Label="@Localizer["Login"]" Align="Align.Center" />
        <EmailVerificationSend OnValidSubmit="@ValidSendCodeSubmit" />
    </Stack>
}
else if(User is not null && Email is not null)
{
    <form method="post" action="@VerificationEndpoint">
        <Stack>
            <StackField Label="@Localizer["Login"]" Align="Align.Center" />
            <EmailVerificationVerify Email="@Email" User="@User" />
        </Stack>
    </form>
}
