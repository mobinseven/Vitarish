@using Microsoft.AspNetCore.Identity
@inherits CommonBase
@if(VerifyCodeInput is not null)
{
    <AntiforgeryToken />
    <input type="hidden" name="Input.UserId" value="@User.Id" />
    <input type="hidden" name="Input.Provider" value="@TokenOptions.DefaultEmailProvider" />
    <input type="hidden" name="Input.Email" value="@Email" />
    <StackTextField @bind-Value="VerifyCodeInput.Code"
                    name="Input.Code"
                    For="@(() => VerifyCodeInput.Code)"
                    Label="@Localizer["Code"]"
                    Placeholder="XXXXXX"
                    HelperText="@Localizer["CodeSent", VerifyCodeInput.Email]"
                    InputMode="@InputMode.numeric"
                    InputType="InputType.Text"
                    Immediate="true"
                    Maxlength="6"
                    Pattern="\\d{6}"
                    autocomplete="one-time-code"
                    Centered />
    <StackButton Label="@Localizer["Continue"]"
                 ButtonType="ButtonType.Submit"
                 Disabled="!IsValid"
                 Color="Color.Primary" />
}
