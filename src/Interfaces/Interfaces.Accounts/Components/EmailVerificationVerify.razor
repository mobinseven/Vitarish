@using Microsoft.AspNetCore.Identity
@inherits CommonBase
@if(VerifyCodeInput is not null)
{
    <MudAlert Severity="Severity.Success">@Localizer["CodeSent", VerifyCodeInput.Email]</MudAlert>
    <AntiforgeryToken />
    <input type="hidden" name="Input.UserId" value="@User.Id" />
    <input type="hidden" name="Input.Provider" value="@TokenOptions.DefaultEmailProvider" />
    <input type="hidden" name="Input.Email" value="@Email" />
    <input type="hidden" name="Input.ReturnUrl" value="@ReturnUrl" />
    <input type="hidden" name="Input.FailureUrl" value="@FailureUrl" />
    <StackField Style="direction: ltr;">
        <MudStack AlignItems="AlignItems.Center" Style="width: 100%;">
            <input name="Input.Code"
                   @bind="VerifyCodeInput.Code"
                   @bind:event="oninput"
                   type="text"
                   autocomplete="one-time-code"
                   inputmode="numeric"
                   maxlength="6"
                   autofocus>
        </MudStack>
    </StackField>
    <StackButton Label="@Localizer["Continue"]"
                 ButtonType="ButtonType.Submit"
                 Color="Color.Primary" />
}
