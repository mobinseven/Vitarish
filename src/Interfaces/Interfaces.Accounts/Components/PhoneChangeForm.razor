@if(User is null)
{
    return;
}

@if(!string.IsNullOrEmpty(User.PhoneNumber))
{
    <Stack>
        <StackField Label="@User.PhoneNumber" HelperText="@Localizer["CurrentItem", Localizer["Phone"]]" />
    </Stack>
}

<Stack>
    <StackField Label="@Localizer["EditItem", Localizer["Phone"]]" />
    @if(!string.IsNullOrEmpty(error))
    {
        <MudAlert Severity="Severity.Error">@error</MudAlert>
        <MudButton OnClick="() => NavigationManager.Refresh(true)" FullWidth Color="Color.Info">@Localizer["TryAgain"]</MudButton>
    }
    @if(PhoneNumber is null)
    {
        <PhoneVerificationSend OnValidSubmit="@ValidSendCodeSubmit" />
    }
    else if(User is not null && PhoneNumber is not null)
    {
        <form method="post" action="/Account/Manage/Phone/Submit">
            <PhoneVerificationVerify PhoneNumber="@PhoneNumber"
                                     User="@User"
                                     Action="/Account/Manage/Phone/Submit" />
        </form>
    }
</Stack>
