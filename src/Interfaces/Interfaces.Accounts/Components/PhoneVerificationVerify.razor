@using Microsoft.AspNetCore.Identity

@if(VerifyCodeInput is not null)
{
    <input type="hidden" name="Input.UserId" value="@User.Id" />
    <input type="hidden" name="Input.Provider" value="@TokenOptions.DefaultPhoneProvider" />
    <input type="hidden" name="Input.PhoneNumber" value="@PhoneNumber" />
    <AntiforgeryToken />
    <StackTextField @bind-Value="VerifyCodeInput.Code"
                    name="Input.Code"
                    Label="@Localizer["Code"]"
                    Placeholder="XXXXXX"
                    For="@(() => VerifyCodeInput.Code)"
                    HelperText="@Localizer["CodeSent", VerifyCodeInput.PhoneNumber]"
                    InputMode="@InputMode.numeric"
                    InputType="InputType.Text"
                    Immediate="true"
                    Maxlength="6"
                    Pattern="\\d{6}"
                    autocomplete="one-time-code"
                    Centered />
    <StackButton Label="@Localizer["Continue"]"
                 Color="Color.Primary"
                 Disabled="!IsValid"
                 ButtonType="ButtonType.Submit" />
}
