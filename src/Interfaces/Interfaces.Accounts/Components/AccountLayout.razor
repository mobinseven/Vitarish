@inherits LayoutComponentBase

@inject IStringLocalizer Localizer


<ThemeConnector>

    <MudRTLProvider RightToLeft="@System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft" Style="height: 100%">
        <MudPopoverProvider @rendermode=InteractiveServer />
        <MudSnackbarProvider @rendermode=InteractiveServer />
        <div style="height: 10dvh;">
            <hr />
        </div>
        <WidthControlled>
            @* <TitleContainer @rendermode=InteractiveServer /> *@
            <div class="stack sticky-top">
                <StackField>
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Style="width: 100%;">
                        <MudImage Src="/logo/brandmark-opacity50.webp" Height="100" />
                    </MudStack>
                </StackField>
            </div>
            @Body

            <Stack>
                <StackField>
                    <CultureSelector @rendermode=InteractiveServer />
                </StackField>
                <StackButton Label="@Localizer["Home"]" EndIcon="fa-regular fa-home" Href="@AppRoutes.Home" />
            </Stack>

        </WidthControlled>

        <div style="height: 20dvh;">
            <hr />
        </div>

    </MudRTLProvider>
</ThemeConnector>
<AntiforgeryToken />
