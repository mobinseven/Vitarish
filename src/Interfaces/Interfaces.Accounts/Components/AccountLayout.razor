@inherits LayoutComponentBase

@inject IStringLocalizer Localizer


<ThemeConnector>

    <MudRTLProvider RightToLeft="@System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft" Style="height: 100%">
        <MudPopoverProvider @rendermode=InteractiveServer />
        <MudSnackbarProvider @rendermode=InteractiveServer />
        <div style="height: 10dvh;">
            <hr />
        </div>
        <WidthControlled>
            <TitleContainer />

            @Body

            <Stack>
                <StackField>
                    <CultureSelector @rendermode=InteractiveServer />
                </StackField>
                <StackButton Label="@Localizer["Home"]" EndIcon="fa-regular fa-home" Href="/" />
            </Stack>

        </WidthControlled>

        <div style="height: 20dvh;">
            <hr />
        </div>

    </MudRTLProvider>
</ThemeConnector>
<AntiforgeryToken />
