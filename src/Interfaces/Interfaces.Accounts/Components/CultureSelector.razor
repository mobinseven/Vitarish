@using System.Globalization
@inject UserProfileCultureInfoProvider CultureProvider
@inject IStringLocalizer<CultureSelector> Strings
@inject NavigationManager NavManager

<StackSelect T="string" HelperText="@Localizer["Language"]" Value="@cultureName" ValueChanged="s => OnCultureChanged(s)">
    @foreach(CultureInfo culture in SupportedCultures)
    {
        <StackSelectItem value="@culture.Name">@culture.NativeName</StackSelectItem>
    }
</StackSelect>

@code {
    private string cultureName = CultureInfo.CurrentUICulture.Name;
    private static readonly IReadOnlyList<CultureInfo> SupportedCultures =
    [
    new("fa-IR"),
        new("en-US"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var cookieculture = await CultureProvider.GetCultureFromCookieAsync();
        if(cookieculture is not null)
        {
            cultureName = cookieculture.Name;
            return;
        }

        if(User is null)
        {
            return;
        }

        string? existingCulture = await UserService.GetCultureAsync(User.Id);
        if(!string.IsNullOrWhiteSpace(existingCulture))
        {
            cultureName = existingCulture;
            if(await CultureProvider.TryApplyCultureAsync(existingCulture))
            {
                NavManager.Refresh(forceReload: true);
                return;
            }
        }

        await CultureProvider.ApplyRequestedCultureAsync();
        CultureInfo? requestedCulture = await CultureProvider.GetRequestedCultureAsync();
        if(requestedCulture is not null)
        {
            cultureName = requestedCulture.Name;
        }
    }

    private async Task OnCultureChanged(string value)
    {
        if(string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        cultureName = value;
        await CultureProvider.SetCultureAsync(value);
        NavManager.Refresh(forceReload: true);
    }
}
