<StackTextField @bind-Value="@PhoneNumber"
                Label="@Localizer["PhoneNumber"]"
                Placeholder="09---------"
                MaxLength="11"
                Style="text-align: center"
                UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "tel" }, { "aria-required", "true" } } )"
                Margin="Margin.Normal"
                DebounceInterval="500"
                Immediate />
<StackButton Disabled="!isValid"
             Label="@Localizer["Continue"]"
             Color="Color.Primary"
             OnClick="ValidSubmit" />
