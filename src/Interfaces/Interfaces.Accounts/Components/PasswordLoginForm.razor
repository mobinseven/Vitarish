
<form method="post" action="/Account/Login/Password/Submit">
    <AntiforgeryToken />
    <Stack>
        <StackField Label="@Localizer["Login"]" Align="Align.Center" />
        <StackTextField @bind-Value="@Model.Username"
                        Label="@Localizer["UserName"]"
                        Placeholder="example.name"
                        UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "username" }, { "aria-required", "true" }, { "name", nameof(PasswordLoginModel.Username) } })"
                        OnlyValidateIfDirty
                        Clearable
                        Centered />
        <StackTextField For="@(() => Model.Password)"
                        @bind-Value="@Model.Password"
                        Label="@Localizer["Password"]"
                        Placeholder="**********"
                        UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "current-password" }, { "aria-required", "true" }, { "name", nameof(PasswordLoginModel.Password) } })"
                        OnlyValidateIfDirty
                        Margin="Margin.Normal"
                        InputType="InputType.Password"
                        Clearable
                        Centered />
        <StackButton Label="@Localizer["Continue"]"
                     Color="Color.Primary"
                     Disabled="!IsValid"
                     ButtonType="ButtonType.Submit" />
    </Stack>
</form>
