@inherits IdentityCommonBase
<StackTextField @bind-Value="@Email"
                Label="@Localizer["Email"]"
                Placeholder="email@example.com"
                UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "email" }, { "aria-required", "true" } } )"
                ShrinkLabel=true
                DebounceInterval="500"
                Immediate
                Centered />
<StackButton Label="@Localizer["Continue"]"
             Disabled="!IsValid"
             OnClick="ValidSubmit"
             Color="Color.Primary" />
