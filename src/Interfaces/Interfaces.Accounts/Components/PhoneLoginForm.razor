@if(PhoneNumber is null)
{
    <Stack>
        <StackField Label="@Localizer["Login"]" Align="Align.Center" />
        <PhoneVerificationSend OnValidSubmit="@ValidSendCodeSubmit" />
    </Stack>
}
else if(User is not null && PhoneNumber is not null)
{
    <form method="post" action="/Account/Login/Phone/Submit" dir="@(@System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
        <Stack>
            <StackField Label="@Localizer["Login"]" Align="Align.Center" />
            <PhoneVerificationVerify PhoneNumber="@PhoneNumber"
                                     User="@User" />
        </Stack>
    </form>
}

<AntiforgeryToken />
