@inherits AdminCommonBase
@using Vitarish.Users.Domain.Models
@using Vitarish.Parties.Application.Dtos

<Stack>
    <StackField>
        <MudSelect T="string"
                   Dense="true"
                   Label="@Localizer["SelectTenant"]"
                   @bind-Value="selectedTenantId"
                   Disabled="isLoading || tenants.Count == 0"
                   Class="flex-grow-1">
            @if(tenants.Count == 0)
            {
                <MudSelectItem Value="string.Empty">@Localizer["NoTenants"]</MudSelectItem>
            }
            else
            {
                @foreach(TenantReadDto tenant in tenants)
                {
                    string tenantLabel = string.IsNullOrWhiteSpace(tenant.Name)
                        ? tenant.Id.ToString()
                        : tenant.Name;

                    <MudSelectItem Value="@tenant.Id.ToString()">@tenantLabel</MudSelectItem>
                }
            }
        </MudSelect>
    </StackField>
</Stack>


<Stack>
    @if(isLoading)
    {
        <MudProgressLinear Indeterminate Color="Color.Default" />
    }
    else if(roles.Count == 0)
    {
        <MudText Typo="Typo.body2">@Localizer["NoRoles"]</MudText>
    }
    else
    {
        @foreach(var role in tenantRoles)
        {
            <StackField Label="@role.Name">
                <MudFab DropShadow="false" StartIcon="fa-regular fa-xmark" OnClick="async () => await DeleteRoleAsync(role)" />
            </StackField>
        }

    }
    <StackField Label="@Localizer["RoleName"]">
        <MudTextField @bind-Value="newRoleName"
                      Variant="Variant.Filled"
                      Underline="false"
                      Immediate="true"
                      Disabled="isLoading"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Security"
                      Class="flex-grow-1" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="isLoading || string.IsNullOrWhiteSpace(newRoleName) || string.IsNullOrWhiteSpace(selectedTenantId)"
                   OnClick="CreateRoleAsync">
            @Localizer["AddRole"]
        </MudButton>
    </StackField>
</Stack>
