@inherits AdminCommonBase

@if(Tenant is null)
{
    return;
}

<Stack>
    @foreach(var indicator in Indicators)
    {
        <StackButton Label="@indicator.Value" StartIcon="@GetStatusIcon(indicator.Status)" OnClick="() => EditIndicator(indicator)" />
    }
</Stack>

<Stack>
    <StackButton OnClick="AddIndicator" StartIcon="fa-regular fa-plus" Color="Color.Primary" Label="@Localizer["AddItem", Localizer["TenantIndicator"]]" />
</Stack>
