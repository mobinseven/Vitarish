@using Microsoft.JSInterop
@implements IAsyncDisposable

<div class="@CssClass" aria-live="polite" aria-label="Loading Vitarish">
    <div class="splash-screen__logo">
        <img src="https://assets.vitarish.ir/logo/512.webp" alt="Vitarish logo" loading="eager" decoding="async" />
    </div>
    <div class="splash-screen__brandmark">
        <img src="https://assets.vitarish.ir/logo/brandmark-opacity50.webp" alt="Vitarish wordmark" loading="eager" decoding="async" />
    </div>
</div>

@code {
    private bool _isVisible = true;
    private IJSObjectReference? _module;
    private IJSObjectReference? _registration;
    private DotNetObjectReference<SplashScreen>? _dotNetRef;

    private string CssClass => _isVisible ? "splash-screen splash-screen--visible" : "splash-screen splash-screen--hidden";

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;

    [Parameter]
    public TimeSpan AutoHideDelay { get; set; } = TimeSpan.Zero;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Base/SplashScreen.razor.js");
        _dotNetRef = DotNetObjectReference.Create(this);
        _registration = await _module.InvokeAsync<IJSObjectReference>("registerSplashScreenLoadedHandler", _dotNetRef);
    }

    [JSInvokable]
    public async Task HideAfterLoadAsync()
    {
        if (!_isVisible)
        {
            return;
        }

        if (AutoHideDelay > TimeSpan.Zero)
        {
            await Task.Delay(AutoHideDelay);
        }

        _isVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();

        if (_registration is not null)
        {
            await _registration.DisposeAsync();
        }

        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
