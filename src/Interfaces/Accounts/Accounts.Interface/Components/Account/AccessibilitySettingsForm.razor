@inherits CommonBase
@inject IThemeService ThemeService

<MudStack Spacing="2" Style="@($"direction:{Direction};")">
    <MudStack Spacing="0">
        <MudText Typo="Typo.subtitle1">@Localizer["AccessibilitySettings"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["AccessibilitySettingsDescription"]</MudText>
    </MudStack>

    @if (loading)
    {
        <MudProgressLinear Indeterminate />
    }
    else if (User is null)
    {
        <MudAlert Severity="Severity.Warning">@Localizer["UserNotFound"]</MudAlert>
    }
    else
    {
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.caption">@Localizer["FontScale"]</MudText>
                <MudSlider T="double"
                           @bind-Value="settings.FontScale"
                           @bind-Value:after="ApplyAfterChangeAsync"
                           Min="0.85"
                           Max="1.4"
                           Step="0.05"
                           Immediate="true"
                           ValueLabel="true"
                           ValueLabelFormat="{0:0.00}x" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.caption">@Localizer["FontWeight"]</MudText>
                <MudSlider T="int"
                           @bind-Value="settings.FontWeight"
                           @bind-Value:after="ApplyAfterChangeAsync"
                           Min="300"
                           Max="800"
                           Step="50"
                           Immediate="true"
                           ValueLabel="true"
                           ValueLabelFormat="{0:0}" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.caption">@Localizer["LineHeight"]</MudText>
                <MudSlider T="double"
                           @bind-Value="settings.LineHeight"
                           @bind-Value:after="ApplyAfterChangeAsync"
                           Min="1.2"
                           Max="1.9"
                           Step="0.05"
                           Immediate="true"
                           ValueLabel="true"
                           ValueLabelFormat="{0:0.00}" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.caption">@Localizer["SurfaceTransparency"]</MudText>
                <MudSlider T="double"
                           @bind-Value="settings.SurfaceOpacity"
                           @bind-Value:after="ApplyAfterChangeAsync"
                           Min="0.2"
                           Max="0.95"
                           Step="0.05"
                           Immediate="true"
                           ValueLabel="true"
                           ValueLabelFormat="{0:P0}" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.caption">@Localizer["SurfaceBlur"]</MudText>
                <MudSlider T="double"
                           @bind-Value="settings.SurfaceBlur"
                           @bind-Value:after="ApplyAfterChangeAsync"
                           Min="0"
                           Max="30"
                           Step="1"
                           Immediate="true"
                           ValueLabel="true"
                           ValueLabelFormat="{0:0}px" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.caption">@Localizer["SurfaceBrightness"]</MudText>
                <MudSlider T="double"
                           @bind-Value="settings.Brightness"
                           @bind-Value:after="ApplyAfterChangeAsync"
                           Min="80"
                           Max="135"
                           Step="1"
                           Immediate="true"
                           ValueLabel="true"
                           ValueLabelFormat="{0:0}%" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSwitch T="bool"
                           @bind-Value="settings.HighContrast"
                           @bind-Value:after="ApplyAfterChangeAsync"
                           Color="Color.Primary"
                           Label="@Localizer["HighContrastMode"]" />
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-3" Elevation="1" Style="@PreviewStyle">
            <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle2">@Localizer["Preview"]</MudText>
                <MudText Typo="Typo.body1">@Localizer["AccessibilityPreviewText"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["AccessibilityPreviewHint"]</MudText>
            </MudStack>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
            <MudButton Variant="Variant.Text"
                       Disabled="@saving"
                       OnClick="ResetAsync">
                @Localizer["ResetToDefaults"]
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@saving"
                       OnClick="SaveAsync">
                @Localizer["Save"]
            </MudButton>
        </MudStack>
    }
</MudStack>
