@if (User is not null)
{
    <MudStack Spacing="3">
        <MudPaper Elevation="0" Class="pa-4" Outlined>
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">@Localizer["AccountDetails"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@User.UserName</MudText>
                    </MudStack>
                </MudStack>
                <MudStack Spacing="2">
                    <MudTextField Value="@User.UserName"
                                  Label="@Localizer["UserName"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  ReadOnly />
                    <MudTextField Value="@User.Email"
                                  Label="@Localizer["Email"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  ReadOnly
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Edit"
                                  AdornmentAriaLabel="@Localizer["EditEmail"]"
                                  OnAdornmentClick="NavigateToEmail" />
                    <MudTextField Value="@User.PhoneNumber"
                                  Label="@Localizer["PhoneNumber"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  ReadOnly
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Edit"
                                  AdornmentAriaLabel="@Localizer["EditPhone"]"
                                  OnAdornmentClick="NavigateToPhone" />
                </MudStack>
                <MudDivider />
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Lock"
                               OnClick="NavigateToPassword">
                        @Localizer["EditPassword"]
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.VpnKey"
                               OnClick="NavigateToTokens">
                        @Localizer["ManagePersonalAccessTokens"]
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudPaper Elevation="0" Class="pa-4" Outlined>
            <MudStack Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@Localizer["PersonalDetails"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["UpdateYourNameDetails"]</MudText>
                </MudStack>
                <MudForm @ref="_form" @bind-IsValid="_isValid">
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="User.FirstName"
                                      Label="@Localizer["FirstName"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Required="true" />
                        <MudTextField @bind-Value="User.LastName"
                                      Label="@Localizer["LastName"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Required="true" />
                    </MudStack>
                </MudForm>
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Filled"
                               Disabled="!_isValid || _isBusy"
                               OnClick="UpdateUser"
                               Color="Color.Primary">
                        @Localizer["Save"]
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudPaper Elevation="0" Class="pa-4" Outlined>
            <MudStack Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@Localizer["Language"]</MudText>
                </MudStack>
                <CultureSelector />
                <MudDivider />
            </MudStack>
        </MudPaper>
        <ThemeSettingsForm SettingsSaved="@(s => UserService.SetThemeAsync(User.Id, s))" />
    </MudStack>
}
else
{
    <MudProgressLinear Indeterminate />
}
