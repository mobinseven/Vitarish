<div>
    <MudTextField @bind-Value="@PhoneNumber"
                  Label="@Localizer["PhoneNumber"]"
                  Placeholder="09123456789"
                  MaxLength="11"
                  Style="text-align: center"
                  UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "tel" }, { "aria-required", "true" } } )"
                  Variant="ThemeService.SecondaryVariant"
                  Margin="Margin.Normal"
                  Underline="false"
                  ShrinkLabel=true
                  AutoFocus=true
                  DebounceInterval="500"
                  Immediate />
    <MudButton Disabled="!isValid"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               OnClick="ValidSubmit">
        @Localizer["Continue"]
    </MudButton>
</div>
