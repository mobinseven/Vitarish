@inherits CommonBase
@if(User is null)
{
    <MudProgressLinear Indeterminate />
    return;
}
<form method="post" action="/Account/Manage/Password/Submit">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    <input type="hidden" name="FailureUrl" value="@FailureUrl" />
    <MudTextField @bind-Value="User.UserName"
                  Label="@Localizer["UserName"]"
                  UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "username" }, { "aria-required", "true" } })"
                  Variant="Variant.Outlined" Disabled />
    @if(hasPass)
    {
        <MudFocusTrap>
            <MudTextField @bind-Value="ChangePasswordInput.CurrentPassword"
                          InputType="InputType.Password"
                          Placeholder="@Localizer["CurrentPassword"]"
                          UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "current-password" }, { "aria-required", "true" }, { "id", "currentPassword" }, { "name", nameof(PasswordChangeModel.CurrentPassword) } })"
                          Class="my-2"
                          Variant="Variant.Outlined" />
        </MudFocusTrap>
    }
    <MudTextField @bind-Value="ChangePasswordInput.NewPassword"
                  InputType="InputType.Password"
                  Placeholder="@Localizer["NewPassword"]"
                  UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "new-password" }, { "aria-required", "true" }, { "id", "newPassword" }, { "name", nameof(PasswordChangeModel.NewPassword) } })"
                  Class="my-2"
                  Variant="Variant.Outlined" />
    <MudTextField @bind-Value="ChangePasswordInput.ConfirmPassword"
                  InputType="InputType.Password"
                  Placeholder="@Localizer["ConfirmPassword"]"
                  UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "new-password" }, { "aria-required", "true" }, { "id", "confirmPassword" }, { "name", nameof(PasswordChangeModel.ConfirmPassword) } })"
                  Class="my-2"
                  Variant="Variant.Outlined" />
    <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" ButtonType="ButtonType.Submit">@Localizer["Ok"]</MudButton>
</form>