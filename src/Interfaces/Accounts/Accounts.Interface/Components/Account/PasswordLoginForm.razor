
<form method="post" action="/Account/Login/Password/Submit">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    <MudFocusTrap>
        <MudTextField @bind-Value="@Model.Username"
                      Label="@Localizer["UserName"]"
                      UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "username" }, { "aria-required", "true" }, { "name", nameof(PasswordLoginModel.Username) } })"
                      Variant="ThemeService.SecondaryVariant"
                      Margin="Margin.Normal"
                      OnlyValidateIfDirty
                      ShrinkLabel=true
                      AutoFocus=true Clearable />
    </MudFocusTrap>
    <MudTextField For="@(() => Model.Password)"
                  @bind-Value="@Model.Password"
                  Label="@Localizer["Password"]"
                  UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "current-password" }, { "aria-required", "true" }, { "name", nameof(PasswordLoginModel.Password) } })"
                  Variant="ThemeService.SecondaryVariant"
                  OnlyValidateIfDirty
                  Margin="Margin.Normal"
                  InputType="InputType.Password"
                  ShrinkLabel=true Clearable />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Large"
               FullWidth="true"
               ButtonType="ButtonType.Submit">
        @Localizer["Continue"]
    </MudButton>
</form>
