@inherits IdentityCommonBase

<Stack>
    <StackField Label="@Localizer["Workspaces"]">
        <MudText Typo="Typo.h6"></MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["ChooseWorkspaceToContinue"]</MudText>
    </StackField>

    @foreach(TenantAccessEntry entry in tenantEntries)
    {
        <StackButton Color="Color.Primary" Label="@entry.TenantDisplayName" OnClick="@(() => NavigateToTenant(entry))" StartIcon="fa-thin fa-building" />
    }
</Stack>
