@inherits IdentityCommonBase
@using Vitarish.Parties.Domain.Entities
@using Vitarish.ApiClients.Domain.Entities

<MudStack Spacing="3">
    <MudPaper Elevation="0" Class="pa-4" Outlined>
        @if(isLoading)
        {
            <MudProgressLinear Indeterminate Color="Color.Default" />
        }
        else if(tenantEntries.Count == 0)
        {
            @*             <MudStack Spacing="1">
                <MudText Typo="Typo.h6">@Localizer["Workspaces"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["NoWorkspacesAssigned"]</MudText>
            </MudStack> *@
        }
        else
        {
            <MudStack Spacing="3">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@Localizer["Workspaces"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["ChooseWorkspaceToContinue"]</MudText>
                </MudStack>
                <MudGrid Spacing="3">
                    @foreach(TenantAccessEntry entry in tenantEntries)
                    {
                        <MudItem xs="12">
                            <MudPaper Class="pa-4" Elevation="0">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2" StretchItems="StretchItems.Middle">
                                    <div>
                                        <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled">
                                            @if(entry.Tenant?.LogoUrl is not null)
                                            {
                                                <MudImage Src="entry.Tenant.LogoUrl" />
                                            }
                                            else
                                            {
                                                @entry.Initials
                                            }
                                        </MudAvatar>
                                    </div>
                                    <div>
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.h6">@entry.TenantDisplayName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @entry.OwnerDisplayName
                                            </MudText>
                                        </MudStack>
                                    </div>
                                    <div>
                                        <MudFab Color="Color.Primary"
                                        DropShadow="false"
                                                Size="Size.Large"
                                                StartIcon="@Icons.Material.Filled.OpenInNew"
                                                OnClick="@(() => NavigateToTenant(entry))" />
                                    </div>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudStack>
        }
    </MudPaper>
</MudStack>
