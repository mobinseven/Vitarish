@inherits CommonBase
@using Vitarish.Parties.Domain.Entities
@using Vitarish.ApiClients.Domain.Entities

<MudStack Spacing="3">
    <MudPaper Elevation="1" Class="pa-4">
        @if (isLoading)
        {
            <MudProgressLinear Indeterminate Color="Color.Default" />
        }
        else if (tenantEntries.Count == 0)
        {
            <MudStack Spacing="1">
                <MudText Typo="Typo.h6">@Localizer["Workspaces"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["NoWorkspacesAssigned"]</MudText>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="3">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@Localizer["Workspaces"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["ChooseWorkspaceToContinue"]</MudText>
                </MudStack>
                <MudGrid Spacing="3">
                @foreach (TenantAccessEntry entry in tenantEntries)
                {
                    <MudItem xs="12" sm="6" lg="4">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudStack Spacing="2">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled">
                                        @entry.Initials
                                    </MudAvatar>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.h6">@entry.TenantDisplayName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @entry.OwnerDisplayName
                                        </MudText>
                                    </MudStack>
                                </MudStack>

                                <MudStack Row Spacing="1" Wrap="Wrap.Wrap">
                                    @if (entry.RoleDisplay.Count == 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @Localizer["NoRoles"]
                                        </MudChip>
                                    }
                                    else
                                    {
                                        @foreach (string role in entry.RoleDisplay)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                                @role
                                            </MudChip>
                                        }
                                    }
                                </MudStack>

                                <MudDivider />

                                <MudStack Spacing="1">
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Small" Color="Color.Default" />
                                        <MudText Typo="Typo.body2">@entry.ClientDisplay</MudText>
                                    </MudStack>
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Color="Color.Default" />
                                        @if (entry.HasPrimaryIdentifier)
                                        {
                                            <MudLink Href="@entry.PrimaryUrl" Target="_blank">
                                                <MudText Typo="Typo.body2">@entry.PrimaryLabel</MudText>
                                            </MudLink>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                @Localizer["Primary address not set"]
                                            </MudText>
                                        }
                                    </MudStack>
                                </MudStack>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                           FullWidth="true"
                                           Disabled="!entry.HasPrimaryIdentifier"
                                           OnClick="@(() => NavigateToTenant(entry))">
                                    @Localizer["Enter workspace"]
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
                </MudGrid>
            </MudStack>
        }
    </MudPaper>
</MudStack>
