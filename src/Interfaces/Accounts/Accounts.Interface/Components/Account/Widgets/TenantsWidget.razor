@inherits CommonBase
@using Vitarish.Parties.Domain.Entities
@using Vitarish.ApiClients.Domain.Entities

<MudStack Spacing="4">
    <MudPaper Elevation="0" Class="pa-4" Style="border-radius: 20px;">
        @if (isLoading)
        {
            <MudProgressLinear Indeterminate Color="Color.Default" />
        }
        else if (tenantEntries.Count == 0)
        {
            @* nothing to display *@
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (TenantAccessEntry entry in tenantEntries)
                {
                    <MudItem xs="12" sm="6" lg="4">
                        <MudPaper Class="pa-4" Elevation="0" Style="border: 1px solid rgba(0, 0, 0, 0.08); border-radius: 20px;">
                            <MudStack Spacing="3">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled">
                                        @entry.Initials
                                    </MudAvatar>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.h6">@entry.TenantDisplayName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @entry.OwnerDisplayName
                                        </MudText>
                                    </MudStack>
                                </MudStack>

                                <MudStack Row Spacing="1" Wrap="Wrap.Wrap">
                                    @if (entry.RoleDisplay.Count == 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @Localizer["NoRoles"]
                                        </MudChip>
                                    }
                                    else
                                    {
                                        @foreach (string role in entry.RoleDisplay)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                                @role
                                            </MudChip>
                                        }
                                    }
                                </MudStack>

                                <MudDivider />

                                <MudStack Spacing="1">
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Small" Color="Color.Primary" />
                                        <MudText Typo="Typo.body2">@entry.ClientDisplay</MudText>
                                    </MudStack>
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Color="Color.Primary" />
                                        @if (entry.HasPrimaryIdentifier)
                                        {
                                            <MudLink Href="@entry.PrimaryUrl" Target="_blank">
                                                <MudText Typo="Typo.body2">@entry.PrimaryLabel</MudText>
                                            </MudLink>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                @Localizer["Primary address not set"]
                                            </MudText>
                                        }
                                    </MudStack>
                                </MudStack>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                           Class="text-capitalize"
                                           FullWidth="true"
                                           Disabled="!entry.HasPrimaryIdentifier"
                                           OnClick="@(() => NavigateToTenant(entry))">
                                    @Localizer["Enter workspace"]
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudPaper>
</MudStack>
