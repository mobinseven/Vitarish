@inherits CommonBase

@if(tenantEntries.Count > 0)
{
    <Stack>
        <StackField Label="@Localizer["Workspaces"]" />

        @foreach(TenantAccessEntry entry in tenantEntries)
        {
            <StackButton Size="Size.Large" Color="Color.Primary" Label="@entry.TenantDisplayName" OnClick="@(() => NavigateToTenant(entry))" StartIcon="fa-regular fa-building" />
        }
    </Stack>
}
