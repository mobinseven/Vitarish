@inherits IdentityCommonBase

<Stack>
    <StackField Label="@Localizer["Workspaces"]"/>

    @foreach(TenantAccessEntry entry in tenantEntries)
    {
        <StackButton Color="Color.Primary" Label="@entry.TenantDisplayName" OnClick="@(() => NavigateToTenant(entry))" StartIcon="fa-regular fa-building" />
    }
</Stack>
