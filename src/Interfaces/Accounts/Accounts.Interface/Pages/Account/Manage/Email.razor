@page "/Account/Manage/Email"
@inherits IdentityBase

<StatusMessage />

<MudText Typo="Typo.h4" GutterBottom="true" Align="Align.Center">@Localizer["Email"]</MudText>
@if (User is not null)
{
    @if(!string.IsNullOrEmpty(User.Email))
    {
        <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Start">@Localizer["CurrentEmail"]: @User.Email</MudAlert>
    }

    @if (FailureMessage is not null)
    {
        <MudAlert Severity="Severity.Error">@FailureMessage</MudAlert>
        <MudButton OnClick="() => NavigationManager.Refresh(true)">@Localizer["TryAgain"]</MudButton>
    }
    else
    {
        <EmailChangeForm @rendermode=@InteractiveServer ReturnUrl="@returnUrl" FailureUrl="@failureUrl" />
    }
}
else
{
    <MudProgressCircular />
}
<form method="get" action="/Account/Manage">
    <MudButton FullWidth="true" ButtonType="ButtonType.Submit">@Localizer["Cancel"]</MudButton>
</form>
