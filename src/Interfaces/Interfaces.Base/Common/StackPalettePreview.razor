<div class="stack-item" style="display:flex;gap:.35rem;align-items:center;min-height:2.25rem;">
    @foreach (string color in Colors)
    {
        <span title="@color" style="display:inline-block;width:1.4rem;height:1.4rem;border-radius:.4rem;border:1px solid rgba(0,0,0,.16);background:@color;"></span>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<string> Colors { get; set; } = [];
}
