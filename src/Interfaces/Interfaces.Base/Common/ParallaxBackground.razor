@using Microsoft.JSInterop
@implements IAsyncDisposable

<div @ref="_anchor" style="display:none"></div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private IJSObjectReference? _module, _instance;
    private ElementReference _anchor;

    [Parameter, EditorRequired] public string ImageUrl { get; set; } = default!;
    [Parameter] public string BackgroundPosition { get; set; } = "center";
    [Parameter] public int ZIndex { get; set; } = 0;

    [Parameter] public double MaxShiftVh { get; set; } = 6;
    [Parameter] public int MinShiftPx { get; set; } = 12;
    [Parameter] public int MaxShiftPx { get; set; } = 60;
    [Parameter] public int SafetyPx { get; set; } = 40;

    [Parameter] public bool RespectReducedMotion { get; set; } = true;
    [Parameter] public bool EnablePollingFallback { get; set; } = true;
    [Parameter] public int PollMs { get; set; } = 1200;

    // NEW: set this if your app scrolls inside a wrapper (e.g., ".app-scroll")
    [Parameter] public string? ScrollTargetSelector { get; set; }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)
            return;
        _module = await JS.RegisterJsModule(this);

        _instance = await _module.InvokeAsync<IJSObjectReference>("attachParallaxGlobal", _anchor, new
        {
            imageUrl = ImageUrl,
            backgroundPosition = BackgroundPosition,
            zIndex = ZIndex,
            maxShiftVh = MaxShiftVh,
            minShiftPx = MinShiftPx,
            maxShiftPx = MaxShiftPx,
            safetyPx = SafetyPx,
            respectReducedMotion = RespectReducedMotion,
            enablePolling = EnablePollingFallback,
            pollMs = PollMs,
            scrollTargetSelector = ScrollTargetSelector
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        if(_instance is not null)
        {
            await _instance.InvokeVoidAsync("updateOptions", new
            {
                imageUrl = ImageUrl,
                backgroundPosition = BackgroundPosition,
                zIndex = ZIndex,
                maxShiftVh = MaxShiftVh,
                minShiftPx = MinShiftPx,
                maxShiftPx = MaxShiftPx,
                safetyPx = SafetyPx,
                respectReducedMotion = RespectReducedMotion,
                enablePolling = EnablePollingFallback,
                pollMs = PollMs,
                scrollTargetSelector = ScrollTargetSelector
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        if(_instance is not null)
        { try { await _instance.InvokeVoidAsync("dispose"); } catch { } }
        if(_module is not null)
        { try { await _module.DisposeAsync(); } catch { } }
    }
}
