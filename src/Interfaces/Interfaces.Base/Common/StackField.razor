@inherits MudField

<MudField Variant="Variant.Text"
          Class="stack-item"
          Style="cursor: pointer"
          Underline="false"
          FullWidth>

    @if(PageBreakpoint >= Breakpoint.Sm)
    {
        <MudStack Row Style="width: 100%;" StretchItems="StretchItems.Start" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h6" Color="@Color">@Label</MudText>
                @if(!string.IsNullOrWhiteSpace(HelperText))
                {
                    <MudText Typo="Typo.caption">@HelperText</MudText>
                }
            </div>
            <div>@EndContent</div>
        </MudStack>
        @ChildContent
    }
    else if(PageBreakpoint < Breakpoint.Sm)
    {
        <MudStack Style="width: 100%;" AlignItems="AlignItems.Start">
            <div>
                <MudText Color="@Color" Typo="Typo.h6">@Label</MudText>
                @if(!string.IsNullOrWhiteSpace(HelperText))
                {
                    <MudText Typo="Typo.caption">@HelperText</MudText>
                }
            </div>
            @if(EndContent is not null)
            {
                <div>@EndContent</div>
            }
            @if(ChildContent is not null)
            {
                @ChildContent
            }
        </MudStack>
    }
</MudField>

    @code {
    [CascadingParameter] public Breakpoint PageBreakpoint { get; set; }
    [Parameter] public RenderFragment? EndContent { get; set; }
    [Parameter] public Color Color { get; set; }
}
