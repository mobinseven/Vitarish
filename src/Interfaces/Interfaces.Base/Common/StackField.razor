@inherits MudField

<MudField Variant="Variant.Text"
          Class="stack-item"
          Style="cursor: pointer"
          Underline="false"
          AdornmentIcon="@AdornmentIcon"
          AdornmentColor="@AdornmentColor"
          OnAdornmentClick="@OnAdornmentClick"
          Adornment="@Adornment.Start"
          FullWidth>

    @if(PageBreakpoint >= Breakpoint.Sm)
    {
        <MudStack Row Style="width: 100%;" StretchItems="StretchItems.Start" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="@Typo" Color="@Color" Align="@Align">@Label</MudText>
                @if(!string.IsNullOrWhiteSpace(HelperText))
                {
                    <MudText Typo="Typo.caption" Color="@Color" Align="@Align">@HelperText</MudText>
                }
            </div>
            <div>@EndContent</div>
        </MudStack>
        @ChildContent
    }
    else if(PageBreakpoint < Breakpoint.Sm)
    {
        <div>
            <MudText Color="@Color" Typo="@Typo" Align="@Align">@Label</MudText>
            @if(!string.IsNullOrWhiteSpace(HelperText))
            {
                <MudText Typo="Typo.caption" Align="@Align">@HelperText</MudText>
            }
        </div>
        <MudStack Style="width: 100%;" AlignItems="AlignItems.Start" StretchItems="StretchItems.Start">
            @if(EndContent is not null)
            {
                <div>@EndContent</div>
            }
            @if(ChildContent is not null)
            {
                @ChildContent
            }
        </MudStack>
    }
</MudField>

    @code {
    [CascadingParameter] public Breakpoint PageBreakpoint { get; set; }
    [Parameter] public RenderFragment? EndContent { get; set; }
    [Parameter] public Color Color { get; set; }
    [Parameter] public Align Align { get; set; }
}
