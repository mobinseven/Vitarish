@using MudBlazor.State
@inherits MudTextField<string>

<MudTextField @bind-Value:get="@_valueState.Value"
              @bind-Value:set="@_valueState.SetValueAsync"
              AdornmentColor="@AdornmentColor"
              AdornmentIcon="@AdornmentIcon"
              Adornment="@Adornment"
              AutoFocus="@AutoFocus"
              OnAdornmentClick="@OnAdornmentClick"
              Style="@Style"
              Class="@($"stack-item {(Centered ? "centered" : "")}")"
              Underline="false"
              Variant="Variant.Filled"
              Required="@Required"
              RequiredError="@RequiredError"
              Placeholder="@Placeholder"
              DebounceInterval="@DebounceInterval"
              Immediate="@Immediate"
              HelperText="@Label"
              InputType="@InputType"
              Lines="@Lines"
              MaxLines="@MaxLines"
              MaxLength="@MaxLength"
              InputMode="@InputMode"
              UserAttributes="@UserAttributes"
              ReadOnly="@ReadOnly"
              Disabled="@Disabled" />
@code {
    [Parameter] public bool Centered { get; set; }
    private readonly ParameterState<string?> _valueState;
    public StackTextField()
    {
        using var registerScope = CreateRegisterScope();
        this._valueState = registerScope.RegisterParameter<string?>(nameof(Value))
            .WithParameter(() => Value)
            .WithEventCallback(() => ValueChanged);
    }
}
