@using Microsoft.AspNetCore.Components.Web
@using MudBlazor.State
@inherits MudTextField<string>

<span @attributes="TriggerAttributes"
      class="@EffectiveTriggerClass"
      role="button"
      tabindex="@EffectiveTriggerTabIndex"
      aria-label="@EffectiveTriggerAriaLabel()"
      aria-haspopup="dialog"
      aria-expanded="@AriaExpanded"
      @onclick="OpenAsync"
      @onpointerdown="SuppressFocusOpen"
      @onfocusin="OnTriggerFocusIn"
      @onkeydown="OnTriggerKeyDown">
    <MudChip T="string"
             Icon="@Icon"
             Disabled="@Disabled"
             Size="@ChipSize"
             Text="@EffectiveLabel()" />
</span>

<MudDialog Visible="@_open" VisibleChanged="@OnDialogVisibleChanged">
    <DialogContent>
        <MudTextField @key="_fieldKey"
                      @ref="_editorTextField"
                      @bind-Value:get="@_valueState.Value"
                      @bind-Value:set="@_valueState.SetValueAsync"
                      AdornmentColor="@DoneAdornmentColor"
                      AdornmentIcon="@DoneIcon"
                      Adornment="@Adornment.End"
                      AutoFocus="@AutoFocus"
                      OnAdornmentClick="@CloseAsync"
                      OnKeyDown="@OnEditorKeyDown"
                      Style="@Style"
                      Class="@EffectiveFieldClass"
                      Underline="false"
                      Variant="@EditorVariant"
                      Required="@Required"
                      RequiredError="@RequiredError"
                      Placeholder="@EffectivePlaceholder"
                      DebounceInterval="@DebounceInterval"
                      Immediate="@Immediate"
                      Label="@null"
                      HelperText="@HelperText"
                      InputType="@InputType"
                      Lines="@Lines"
                      MaxLines="@MaxLines"
                      MaxLength="@MaxLength"
                      InputMode="@InputMode"
                      UserAttributes="@UserAttributes"
                      ReadOnly="@ReadOnly"
                      Disabled="@Disabled" />
    </DialogContent>
</MudDialog>


@code {
    [Parameter] public bool Centered { get; set; }
    [Parameter] public string? Icon { get; set; }

    [Parameter] public string EmptyText { get; set; } = "Click To Edit";
    [Parameter] public string DoneText { get; set; } = "Done";
    [Parameter] public string DoneIcon { get; set; } = "fa-solid fa-circle-check";
    [Parameter] public Color DoneAdornmentColor { get; set; } = Color.Primary;
    [Parameter] public Variant EditorVariant { get; set; } = Variant.Filled;
    [Parameter] public Size ChipSize { get; set; } = Size.Large;
    [Parameter] public int ChipTextMaxLength { get; set; } = 80;

    [Parameter] public string? TriggerAriaLabel { get; set; }
    [Parameter] public string? TriggerClass { get; set; }
    [Parameter] public int TriggerTabIndex { get; set; } = 0;
    [Parameter] public IReadOnlyDictionary<string, object>? TriggerAttributes { get; set; }

    [Parameter] public bool OpenOnTabFocus { get; set; }
    [Parameter] public int FocusOpenCooldownMilliseconds { get; set; } = 250;

    [Parameter] public bool FocusEditorOnOpen { get; set; } = true;
    [Parameter] public int EditorFocusDelayMilliseconds { get; set; } = 75;

    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public bool CloseOnEnter { get; set; } = true;
    [Parameter] public bool CloseOnCtrlEnter { get; set; } = true;

    [Parameter] public EventCallback Opened { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private bool _open;
    private bool _pendingEditorFocus;
    private MudTextField<string>? _editorTextField;
    private bool _suppressFocusOpen;
    private DateTime _lastClosedAtUtc = DateTime.MinValue;
    private Guid _fieldKey = Guid.NewGuid();
    private readonly ParameterState<string?> _valueState;

    public StackTextField()
    {
        using var registerScope = CreateRegisterScope();
        _valueState = registerScope.RegisterParameter<string?>(nameof(Value))
            .WithParameter(() => Value)
            .WithEventCallback(() => ValueChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!_open || !_pendingEditorFocus || !FocusEditorOnOpen || Disabled || ReadOnly)
        {
            return;
        }

        _pendingEditorFocus = false;
        await FocusEditorAsync();
    }

    private async Task FocusEditorAsync()
    {

        if (EditorFocusDelayMilliseconds > 0)
        {
            await Task.Delay(EditorFocusDelayMilliseconds);
        }

        if(_editorTextField is null)
        {
            return;
        }

        if (_open && !Disabled && !ReadOnly)
        {
            await _editorTextField.FocusAsync();
        }
    }

    private string EffectiveTriggerClass => $"stack-field-trigger stack-text-field-trigger {(Disabled ? "stack-field-disabled" : string.Empty)} {TriggerClass}".Trim();
    private string EffectiveFieldClass => $"stack-item stack-field-input stack-text-field-input {(Centered ? "centered" : string.Empty)} {Class}".Trim();
    private string EffectivePlaceholder => string.IsNullOrWhiteSpace(Placeholder) ? Label ?? string.Empty : Placeholder!;
    private string AriaExpanded => _open ? "true" : "false";
    private int EffectiveTriggerTabIndex => Disabled ? -1 : TriggerTabIndex;
    private bool IsMultiline => Lines > 1 || MaxLines > 1;

    private async Task OpenAsync()
    {
        if (Disabled || _open)
        {
            return;
        }

        _fieldKey = Guid.NewGuid();
        _pendingEditorFocus = FocusEditorOnOpen;
        _open = true;
        await Opened.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        if (!_open)
        {
            return;
        }

        _open = false;
        _pendingEditorFocus = false;
        _lastClosedAtUtc = DateTime.UtcNow;
        await Closed.InvokeAsync();
    }

    private async Task OnDialogVisibleChanged(bool visible)
    {
        if (visible)
        {
            await OpenAsync();
            return;
        }

        await CloseAsync();
    }

    private async Task OnTriggerFocusIn(FocusEventArgs args)
    {
        if (!OpenOnTabFocus || Disabled || _open)
        {
            _suppressFocusOpen = false;
            return;
        }

        if (_suppressFocusOpen || IsInsideFocusOpenCooldown())
        {
            _suppressFocusOpen = false;
            return;
        }

        await OpenAsync();
    }

    private void SuppressFocusOpen()
        => _suppressFocusOpen = true;

    private bool IsInsideFocusOpenCooldown()
        => FocusOpenCooldownMilliseconds > 0
            && (DateTime.UtcNow - _lastClosedAtUtc).TotalMilliseconds < FocusOpenCooldownMilliseconds;

    private async Task OnTriggerKeyDown(KeyboardEventArgs args)
    {
        if (Disabled || args.Repeat || !IsActivationKey(args))
        {
            return;
        }

        await OpenAsync();
    }

    private async Task OnEditorKeyDown(KeyboardEventArgs args)
    {
        if (Disabled)
        {
            return;
        }

        if (CloseOnEscape && args.Key == "Escape")
        {
            await CloseAsync();
            return;
        }

        if (IsEnterKey(args) && CloseOnCtrlEnter && (args.CtrlKey || args.MetaKey))
        {
            await CloseAsync();
            return;
        }

        if (IsEnterKey(args) && CloseOnEnter && !IsMultiline && !args.ShiftKey && !args.AltKey && !args.CtrlKey && !args.MetaKey)
        {
            await CloseAsync();
        }
    }

    private static bool IsActivationKey(KeyboardEventArgs args)
        => IsEnterKey(args) || args.Key is " " or "Space" or "Spacebar" || args.Code == "Space";

    private static bool IsEnterKey(KeyboardEventArgs args)
        => args.Key == "Enter" || args.Code is "Enter" or "NumpadEnter";

    private string EffectiveTriggerAriaLabel()
    {
        if (!string.IsNullOrWhiteSpace(TriggerAriaLabel))
        {
            return TriggerAriaLabel!;
        }

        string target = !string.IsNullOrWhiteSpace(Label) ? Label! : "text value";
        return _open ? $"Editing {target}" : $"Edit {target}";
    }

    private string EffectiveLabel()
    {
        bool labelGiven = !string.IsNullOrWhiteSpace(Label);
        bool valueGiven = !string.IsNullOrWhiteSpace(_valueState.Value);
        bool helpGiven = !string.IsNullOrWhiteSpace(HelperText);

        string text;
        if (labelGiven && valueGiven)
        {
            text = $"{Label}: {_valueState.Value}";
        }
        else if (valueGiven)
        {
            text = _valueState.Value!;
        }
        else if (labelGiven && helpGiven)
        {
            text = $"{Label}: {HelperText}";
        }
        else if (labelGiven)
        {
            text = Label!;
        }
        else if (helpGiven)
        {
            text = HelperText!;
        }
        else
        {
            text = EmptyText;
        }

        return Truncate(text, ChipTextMaxLength);
    }

    private static string Truncate(string text, int maxLength)
    {
        if (maxLength <= 0 || text.Length <= maxLength)
        {
            return text;
        }

        return string.Concat(text.AsSpan(0, Math.Max(0, maxLength - 1)), "…");
    }
}
