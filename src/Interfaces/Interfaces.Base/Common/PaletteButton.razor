@inherits MudButton
<MudButton Variant="Variant.Text"
           HtmlTag="div"
           ButtonType="@ButtonType"
           Disabled="@Disabled"
           Class="@CssClass"
           FullWidth
           Style="@Style"
           Href="@Href"
           Color="@Color"
           data-tone="@ToneAttribute"
           StartIcon="@StartIcon"
           IconColor="@Color"
           IconSize="@Size"
           OnClick="@OnClick"
           DropShadow="false">
    <MudStack Row Style="width: 100%" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" StretchItems="StretchItems.Middle">
        @if(ChildContent is null)
        {
            <MudStack Justify="Justify.Center">
                <div>
                    @Label
                </div>
                @if(!string.IsNullOrWhiteSpace(HelperText))
                {
                    <MudText Typo="Typo.caption">@HelperText</MudText>
                }
            </MudStack>
            <div />
            <div>
                @if(RendererInfo.IsInteractive)
                {
                    <MudFab HtmlTag="div"
                            Disabled="@Disabled"
                            StartIcon="@ContinueIcon"
                            DropShadow="false"
                            Color="@Color"
                            Class="@CssClass"
                            Size="Size" />
                }
                else
                {
                    <MudIcon Disabled="@Disabled"
                             Icon="@ContinueIcon"
                             Color="@Color"
                             Size="Size" />
                }
            </div>
        }
        else
        {
            @ChildContent
        }
    </MudStack>
</MudButton>
@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HighlightString { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool AutoTone { get; set; } = true;
    [Parameter] public string? Tone { get; set; }

    private string ContinueIcon => EndIcon is null ? CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "fa-solid fa-chevron-left" : "fa-solid fa-chevron-right" : EndIcon;

    private Typo LabelSize => Size switch
    {
        Size.Small => Typo.caption,
        Size.Large => Typo.h3,
        _ => Typo.body1
    };


    private string? ToneAttribute =>
            !string.IsNullOrWhiteSpace(Tone) ? Tone : null;

    private string CssClass =>
        string.Join(" ", new[]
        {
            "palette-button",
            AutoTone ? null : "palette-button--no-auto-tone",
            !string.IsNullOrWhiteSpace(Tone) ? $"palette-button--{Tone}" : null,
            Class
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
