@using System.Text.RegularExpressions
@inherits Chip
<Chip Color="@Color">
    <MudText Typo="Typo.body1">
        @if(string.IsNullOrEmpty(Text))
        {
            @ChildContent
        }
        else
        {
            @CreateComponents(Text)
        }
    </MudText>
</Chip>
@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    private RenderFragment CreateComponents(string content) => builder =>
    {
        builder.AddContent(0, ConvertUrlsToAnchors(content));
    };
    private static readonly Regex UrlRegex = new(
    @"https?://\S+",
    RegexOptions.Compiled | RegexOptions.CultureInvariant | RegexOptions.IgnoreCase,
    TimeSpan.FromMilliseconds(200));

    static RenderFragment ConvertUrlsToAnchors(string? text) => builder =>
    {
        if(string.IsNullOrEmpty(text))
            return;

        int lastIndex = 0;
        int seq = 0;

        foreach(Match m in UrlRegex.Matches(text))
        {
            // Trim trailing punctuation common in prose
            string raw = m.Value.TrimEnd('.', ',', ';', ':', '!', '?', ')', ']');

            if(!Uri.TryCreate(raw, UriKind.Absolute, out var uri))
                continue;

            if(m.Index > lastIndex)
                builder.AddContent(seq++, text[lastIndex..m.Index]);

            // Prefer a dedicated <UrlChip/> component so you can use literal sequences inside it.
            builder.OpenComponent<UrlChip>(seq++);                     // <- move to a child component for ASP0006
            builder.AddAttribute(seq++, "Href", uri.ToString());
            builder.AddAttribute(seq++, "Text", uri.Host);             // or a nicer formatter
            builder.CloseComponent();

            // Adjust lastIndex by the *consumed* portion (after trimming)
            int consumed = raw.Length;
            lastIndex = m.Index + consumed;
        }

        if(lastIndex < text.Length)
            builder.AddContent(seq++, text[lastIndex..]);
    };

}
