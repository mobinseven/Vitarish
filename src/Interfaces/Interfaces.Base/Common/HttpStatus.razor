@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@if(!string.IsNullOrEmpty(Status))
{
    <Stack>
        <StackField Label="@Status" Color="Color.Warning" />
    </Stack>
}

@code {
    private string? Status;
    [Parameter, EditorRequired] public string CookieName { get; set; }
    protected override void OnInitialized()
    {
        Status = HttpContextAccessor.HttpContext?
            .Request
            .Cookies[CookieName];
    }
}
