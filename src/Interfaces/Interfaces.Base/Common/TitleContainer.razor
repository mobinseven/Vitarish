@inherits CommonBase
@if(NavService.Breadcrumbs.Length > 1)
{
    string title = Localizer[NavService.Breadcrumbs.Last().Text];
    if(string.IsNullOrWhiteSpace(title))
    {
        return;
    }
    string cut = title.Length > 50 ? title.Substring(0, 50) + "..." : title;
    <Stack>
        @* Class="sticky-top my-6"*@
        @ChildContent
        <StackField Typo="Typo.h6" Align="Align.Center" Label="@cut" />
    </Stack>
}
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
