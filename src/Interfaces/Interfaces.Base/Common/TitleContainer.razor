@inherits CommonBase
@if(NavService.Breadcrumbs.Length > 1)
{
    string title = Localizer[NavService.Breadcrumbs.Last().Text];
    if(string.IsNullOrWhiteSpace(title))
    {
        return;
    }
    string cut = title.Length > 50 ? title.Substring(0, 50) + "..." : title;
    <div class="stack sticky-top mx-1 fade">
        <StackField Typo="Typo.h6" Label="@cut" Align="Align.Center" />
    </div>
}
