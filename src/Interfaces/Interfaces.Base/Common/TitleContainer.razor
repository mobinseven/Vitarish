@inherits CommonBase
@if(NavService.Breadcrumbs.Length > 1)
{
    <MudPaper Class="sticky-top pa-3 mb-3 glass mx-1" Elevation="0">
        <MudText Typo="Typo.h4" GutterBottom="true" Align="Align.Center">
            @Localizer[NavService.Breadcrumbs.Last().Text]
        </MudText>
    </MudPaper>
}
