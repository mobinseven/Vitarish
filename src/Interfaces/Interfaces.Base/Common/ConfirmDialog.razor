@inherits CommonBase
<MudDialog>
    <DialogContent>
        <Stack>
            <StackField Label="@ContentText" />
        </Stack>
        <Stack>
            <StackButton Label="@(ButtonText is null ? Localizer["Confirm"] : ButtonText)" Color="@Color" OnClick="Submit" />
            <StackButton Label="@Localizer["Close"]" OnClick="Cancel" EndIcon="fa-solid fa-xmark" />
        </Stack>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? ContentText { get; set; }

    [Parameter] public string? ButtonText { get; set; }

    [Parameter] public Color Color { get; set; } = Color.Error;

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();
}
