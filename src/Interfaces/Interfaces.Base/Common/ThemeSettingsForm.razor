@inherits CommonBase
@implements IDisposable

<Stack>
    <StackField Label="@Localizer["Appearance"]" />

    <StackField Label="@Localizer["Theme"]">
        <EndContent>
            <MudSelect T="ThemePreference"
                       Variant="Variant.Filled"
                       Value="@_settings.Theme"
                       ValueChanged="OnThemeChanged"
                       Underline="false">
                <MudSelectItem T="ThemePreference" Value="ThemePreference.Light">@Localizer["Light"]</MudSelectItem>
                <MudSelectItem T="ThemePreference" Value="ThemePreference.Dark">@Localizer["Dark"]</MudSelectItem>
                <MudSelectItem T="ThemePreference" Value="ThemePreference.Auto">@Localizer["Auto"]</MudSelectItem>
            </MudSelect>
        </EndContent>

    </StackField>

    <StackField Label="@Localizer["Typography"]">
        <EndContent>
            <MudSelect T="TypographySize"
                       Variant="Variant.Filled"
                       Value="@_settings.Typography"
                       ValueChanged="OnTypographyChanged"
                       Underline="false">
                <MudSelectItem T="TypographySize" Value="TypographySize.Compact">@Localizer["Compact"]</MudSelectItem>
                <MudSelectItem T="TypographySize" Value="TypographySize.Normal">@Localizer["Normal"]</MudSelectItem>
                <MudSelectItem T="TypographySize" Value="TypographySize.Large">@Localizer["Large"]</MudSelectItem>
                <MudSelectItem T="TypographySize" Value="TypographySize.ExtraLarge">@Localizer["ExtraLarge"]</MudSelectItem>
            </MudSelect>
        </EndContent>

    </StackField>

    <StackField Label="@Localizer["Transparency"]">
        <EndContent>
            <MudSelect T="ThemeSurfaceType"
                       Variant="Variant.Filled"
                       Value="@_settings.Surface"
                       ValueChanged="OnSurfaceChanged"
                       Underline="false">
                <MudSelectItem T="ThemeSurfaceType" Value="ThemeSurfaceType.Opaque">@Localizer["Opaque"]</MudSelectItem>
                <MudSelectItem T="ThemeSurfaceType" Value="ThemeSurfaceType.Translucent">@Localizer["Translucent"]</MudSelectItem>
                <MudSelectItem T="ThemeSurfaceType" Value="ThemeSurfaceType.Transparent">@Localizer["Transparent"]</MudSelectItem>
            </MudSelect>
        </EndContent>

    </StackField>

    <StackField Label="@Localizer["Preview"]">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h3">
                @Localizer["PreviewOf",Localizer["Heading"]]
            </MudText>
            <MudText Typo="Typo.body1">
                @Localizer["PreviewOf", Localizer["TextBody"]]
            </MudText>
            <MudText Typo="Typo.caption">
                @Localizer["PreviewOf",Localizer["Caption"]]
            </MudText>

            <MudStack Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth>
                    @Localizer["PreviewOf", Localizer["Action"]]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth>
                    @Localizer["PreviewOf", Localizer["Action"]]
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Tertiary" FullWidth>
                    @Localizer["PreviewOf", Localizer["Action"]]
                </MudButton>
            </MudStack>
        </MudStack>
    </StackField>

    <StackField>
        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ResetAsync">@Localizer["Reset"]</MudButton>
    </StackField>
</Stack>

@code {

    // Export callback: called on *every* update
    [Parameter] public EventCallback<string> SettingsSaved { get; set; }

    private ThemeSettings _settings = ThemeSettings.Default;

    protected override void OnInitialized()
    {
        // Always track changes so Auto/system toggles can be exported too.
        ThemeService.SettingsChanged += HandleServiceSettingsChangedAsync;
        _settings = ThemeService.Settings;
        StateHasChanged();
    }

    private async Task OnThemeChanged(ThemePreference pref)
        => await ThemeService.SetThemePreferenceAsync(pref);

    private async Task OnTypographyChanged(TypographySize size)
        => await ThemeService.SetTypographySizeAsync(size);

    private Task OnSurfaceChanged(ThemeSurfaceType s)
        => ThemeService.SetSurfaceAsync(s);

    private async Task ResetAsync()
        => await ThemeService.InitializeAsync(Models.ThemeSettings.Default with { LastKnownIsDarkMode = ThemeService.IsDarkMode });

    private async Task HandleServiceSettingsChangedAsync(Models.ThemeSettings s)
    {
        _settings = s;
        await InvokeAsync(StateHasChanged);

        if(SettingsSaved.HasDelegate)
            await SettingsSaved.InvokeAsync(s.ToJson());
    }

    public void Dispose()
    {
        ThemeService.SettingsChanged -= HandleServiceSettingsChangedAsync;
    }
}
