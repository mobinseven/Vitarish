@inherits CommonBase
@implements IDisposable

<Stack>

    <StackField Label="@Localizer["Appearance"]" />

    <StackSelect T="ThemePreference"
                 Label="@Localizer["Theme"]"
                 Value="@_settings.Theme"
                 ValueChanged="OnThemeChanged">
        <StackSelectItem T="ThemePreference" Value="ThemePreference.Light">@Localizer["Light"]</StackSelectItem>
        <StackSelectItem T="ThemePreference" Value="ThemePreference.Dark">@Localizer["Dark"]</StackSelectItem>
        <StackSelectItem T="ThemePreference" Value="ThemePreference.Auto">@Localizer["Auto"]</StackSelectItem>
    </StackSelect>

    <StackSelect T="TypographySize"
                 Label="@Localizer["Typography"]"
                 Value="@_settings.Typography"
                 ValueChanged="OnTypographyChanged">
        <StackSelectItem T="TypographySize" Value="TypographySize.Compact">@Localizer["Compact"]</StackSelectItem>
        <StackSelectItem T="TypographySize" Value="TypographySize.Normal">@Localizer["Normal"]</StackSelectItem>
        <StackSelectItem T="TypographySize" Value="TypographySize.Large">@Localizer["Large"]</StackSelectItem>
        <StackSelectItem T="TypographySize" Value="TypographySize.ExtraLarge">@Localizer["ExtraLarge"]</StackSelectItem>
    </StackSelect>

    <StackSelect Label="@Localizer["Transparency"]"
                 T="ThemeSurfaceType"
                 Value="@_settings.Surface"
                 ValueChanged="OnSurfaceChanged">
        <StackSelectItem T="ThemeSurfaceType" Value="ThemeSurfaceType.Opaque">@Localizer["Opaque"]</StackSelectItem>
        <StackSelectItem T="ThemeSurfaceType" Value="ThemeSurfaceType.Translucent">@Localizer["Translucent"]</StackSelectItem>
        <StackSelectItem T="ThemeSurfaceType" Value="ThemeSurfaceType.Transparent">@Localizer["Transparent"]</StackSelectItem>
    </StackSelect>


    <StackButton OnClick="ResetAsync" Label="@Localizer["Reset"]" Color="Color.Warning" />

</Stack>

@code {

    // Export callback: called on *every* update
    [Parameter] public EventCallback<string> SettingsSaved { get; set; }

    private ThemeSettings _settings = ThemeSettings.Default;

    protected override void OnInitialized()
    {
        // Always track changes so Auto/system toggles can be exported too.
        ThemeService.SettingsChanged += HandleServiceSettingsChangedAsync;
        _settings = ThemeService.Settings;
        StateHasChanged();
    }

    private async Task OnThemeChanged(ThemePreference pref)
        => await ThemeService.SetThemePreferenceAsync(pref);

    private async Task OnTypographyChanged(TypographySize size)
        => await ThemeService.SetTypographySizeAsync(size);

    private Task OnSurfaceChanged(ThemeSurfaceType s)
        => ThemeService.SetSurfaceAsync(s);

    private async Task ResetAsync()
        => await ThemeService.InitializeAsync(Models.ThemeSettings.Default with { LastKnownIsDarkMode = ThemeService.IsDarkMode });

    private async Task HandleServiceSettingsChangedAsync(Models.ThemeSettings s)
    {
        _settings = s;
        await InvokeAsync(StateHasChanged);

        if(SettingsSaved.HasDelegate)
            await SettingsSaved.InvokeAsync(s.ToJson());
    }

    public void Dispose()
    {
        ThemeService.SettingsChanged -= HandleServiceSettingsChangedAsync;
    }
}
