@using System.Globalization
@using MudBlazor

@inherits MudComponentBase

<div Class="@($"mud-calendar stack-item {Class}")" style="align-self: anchor-center;"
          dir="@RootDirection">

    <div class="mud-calendar__header">
        <MudIconButton Icon="@PreviousIcon"
                       Size="Size.Small"
                       Disabled="@Disabled"
                       OnClick="GoPreviousAsync" />

        <MudButton Variant="Variant.Text"
                   Disabled="@Disabled"
                   OnClick="MoveUpView">
            @HeaderText
        </MudButton>

        <MudIconButton Icon="@NextIcon"
                       Size="Size.Small"
                       Disabled="@Disabled"
                       OnClick="GoNextAsync" />
    </div>

    @if(_view == OpenTo.Date)
    {
        <div class="mud-calendar__weekdays">
            @foreach(var dayOfWeek in GetDayOfWeekContexts())
            {
                <div class="mud-calendar__weekday">
                    @if(DayOfWeekTemplate is null)
                    {
                        @dayOfWeek.ShortName
                    }
                    else
                    {
                        @DayOfWeekTemplate(dayOfWeek)
                    }
                </div>
            }
        </div>

        <div class="mud-calendar__days" role="grid">
            @foreach(var day in GetDayContexts())
            {
                @if(!IsWeekView && !ShowAdjacentMonthDays && day.IsOutsideMonth)
                {
                    <span class="mud-calendar__day-empty"></span>
                }
                else
                {
                    <button type="button"
                            class="@day.CssClass"
                            disabled="@(Disabled || day.IsDisabled)"
                            aria-current="@(day.IsToday ? "date" : null)"
                            aria-selected="@day.IsSelected"
                            @onclick="() => SelectDayAsync(day)">
                        @if(DayTemplate is null)
                        {
                            @day.DisplayDayNumber
                        }
                        else
                        {
                            @DayTemplate(day)
                        }
                    </button>
                }
            }
        </div>
    }
    else if(_view == OpenTo.Month)
    {
        <div class="mud-calendar__months" role="grid">
            @foreach(var month in GetMonthContexts())
            {
                <button type="button"
                        class="@month.CssClass"
                        disabled="@(Disabled || month.IsDisabled)"
                        aria-selected="@month.IsSelected"
                        @onclick="() => SelectMonthAsync(month)">
                    @if(MonthTemplate is null)
                    {
                        @month.ShortName
                    }
                    else
                    {
                        @MonthTemplate(month)
                    }
                </button>
            }
        </div>
    }
    else if(_view == OpenTo.Year)
    {
        <div class="mud-calendar__years" role="grid">
            @foreach(var year in GetYearContexts())
            {
                <button type="button"
                        class="@year.CssClass"
                        disabled="@(Disabled || year.IsDisabled)"
                        aria-selected="@year.IsSelected"
                        @onclick="() => SelectYearAsync(year)">
                    @if(YearTemplate is null)
                    {
                        @year.DisplayName
                    }
                    else
                    {
                        @YearTemplate(year)
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    private DateTime? _currentDate;
    private DateTime _visibleDate;
    private OpenTo _view;
    private bool _initialized;

    [Parameter] public DateTime? Date { get; set; }
    [Parameter] public EventCallback<DateTime?> DateChanged { get; set; }

    [Parameter] public DateTime? PickerMonth { get; set; }
    [Parameter] public EventCallback<DateTime?> PickerMonthChanged { get; set; }

    [Parameter] public DateTime? MinDate { get; set; }
    [Parameter] public DateTime? MaxDate { get; set; }

    [Parameter] public OpenTo OpenTo { get; set; } = OpenTo.Date;
    [Parameter] public StackCalendarViewMode ViewMode { get; set; } = StackCalendarViewMode.Month;
    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; } = DayOfWeek.Saturday;
    [Parameter] public CultureInfo? Culture { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Square { get; set; }
    [Parameter] public bool Outlined { get; set; }
    [Parameter] public int Elevation { get; set; } = 1;

    [Parameter] public bool ShowAdjacentMonthDays { get; set; } = true;

    [Parameter] public Func<DateTime, bool>? IsDateDisabledFunc { get; set; }
    [Parameter] public Func<DateTime, string?>? AdditionalDateClassesFunc { get; set; }

    [Parameter] public RenderFragment<CalendarDayContext>? DayTemplate { get; set; }
    [Parameter] public RenderFragment<CalendarMonthContext>? MonthTemplate { get; set; }
    [Parameter] public RenderFragment<CalendarYearContext>? YearTemplate { get; set; }
    [Parameter] public RenderFragment<CalendarDayOfWeekContext>? DayOfWeekTemplate { get; set; }

    private CultureInfo EffectiveCulture => Culture ?? CultureInfo.CurrentCulture;

    private DateTimeFormatInfo EffectiveDateTimeFormat => EffectiveCulture.DateTimeFormat;

    private Calendar EffectiveCalendar => EffectiveDateTimeFormat.Calendar;

    private DayOfWeek ResolvedFirstDayOfWeek =>
        FirstDayOfWeek ?? EffectiveDateTimeFormat.FirstDayOfWeek;

    private bool IsRtl => EffectiveCulture.TextInfo.IsRightToLeft;

    private string RootDirection => IsRtl ? "rtl" : "ltr";

    private string PreviousIcon =>
        IsRtl
            ? Icons.Material.Filled.ChevronRight
            : Icons.Material.Filled.ChevronLeft;

    private string NextIcon =>
        IsRtl
            ? Icons.Material.Filled.ChevronLeft
            : Icons.Material.Filled.ChevronRight;

    private bool IsWeekView => ViewMode == StackCalendarViewMode.Week;

    private int VisibleEra => EffectiveCalendar.GetEra(_visibleDate);

    private int VisibleCalendarYear => EffectiveCalendar.GetYear(_visibleDate);

    private int VisibleCalendarMonth => EffectiveCalendar.GetMonth(_visibleDate);

    private int YearPageStart => VisibleCalendarYear - ((VisibleCalendarYear - 1) % 12);

    private string HeaderText =>
        _view switch
        {
            OpenTo.Date => IsWeekView ? FormatWeekHeader() : _visibleDate.ToString("MMMM yyyy", EffectiveCulture),
            OpenTo.Month => FormatYear(VisibleCalendarYear),
            OpenTo.Year => $"{FormatYear(YearPageStart)} - {FormatYear(YearPageStart + 11)}",
            _ => _visibleDate.ToString("MMMM yyyy", EffectiveCulture)
        };

    protected override void OnParametersSet()
    {
        _currentDate = Date?.Date;

        if(!_initialized)
        {
            _view = OpenTo;
            _visibleDate = NormalizeVisibleDate(PickerMonth ?? Date ?? DateTime.Today);
            _initialized = true;
        }
        else if(PickerMonth.HasValue)
        {
            var normalizedPickerMonth = StartOfMonth(PickerMonth.Value);

            if(normalizedPickerMonth != StartOfMonth(_visibleDate))
                _visibleDate = NormalizeVisibleDate(PickerMonth.Value);
        }
    }

    private void MoveUpView()
    {
        if(_view == OpenTo.Date)
            _view = OpenTo.Month;
        else if(_view == OpenTo.Month)
            _view = OpenTo.Year;
    }

    private async Task GoPreviousAsync()
    {
        if(_view == OpenTo.Date)
            await SetVisibleDateAsync(IsWeekView ? _visibleDate.AddDays(-7) : AddCalendarMonths(_visibleDate, -1));
        else if(_view == OpenTo.Month)
            await SetVisibleDateAsync(AddCalendarYears(_visibleDate, -1));
        else if(_view == OpenTo.Year)
            await SetVisibleDateAsync(AddCalendarYears(_visibleDate, -12));
    }

    private async Task GoNextAsync()
    {
        if(_view == OpenTo.Date)
            await SetVisibleDateAsync(IsWeekView ? _visibleDate.AddDays(7) : AddCalendarMonths(_visibleDate, 1));
        else if(_view == OpenTo.Month)
            await SetVisibleDateAsync(AddCalendarYears(_visibleDate, 1));
        else if(_view == OpenTo.Year)
            await SetVisibleDateAsync(AddCalendarYears(_visibleDate, 12));
    }

    private async Task SelectDayAsync(CalendarDayContext day)
    {
        if(day.IsDisabled)
            return;

        _currentDate = day.Date.Date;

        if(!IsWeekView && day.IsOutsideMonth)
            await SetVisibleDateAsync(day.Date);

        await DateChanged.InvokeAsync(_currentDate);
    }

    private async Task SelectMonthAsync(CalendarMonthContext month)
    {
        if(month.IsDisabled)
            return;

        await SetVisibleDateAsync(month.Month);
        _view = OpenTo.Date;
    }

    private async Task SelectYearAsync(CalendarYearContext year)
    {
        if(year.IsDisabled)
            return;

        var targetMonth = VisibleCalendarMonth;
        var monthsInTargetYear = EffectiveCalendar.GetMonthsInYear(year.Year, year.Era);

        if(targetMonth > monthsInTargetYear)
            targetMonth = monthsInTargetYear;

        var newVisibleMonth = ToCalendarDate(year.Year, targetMonth, 1, year.Era);

        await SetVisibleDateAsync(newVisibleMonth);
        _view = OpenTo.Month;
    }

    private async Task SetVisibleDateAsync(DateTime date)
    {
        _visibleDate = NormalizeVisibleDate(date);
        await PickerMonthChanged.InvokeAsync(StartOfMonth(_visibleDate));
    }

    private IEnumerable<CalendarDayOfWeekContext> GetDayOfWeekContexts()
    {
        var names = EffectiveDateTimeFormat.AbbreviatedDayNames;
        var first = ResolvedFirstDayOfWeek;

        for(var i = 0; i < 7; i++)
        {
            var day = (DayOfWeek)(((int)first + i) % 7);

            yield return new CalendarDayOfWeekContext(
                DayOfWeek: day,
                Index: i,
                ShortName: names[(int)day],
                IsWeekend: day is DayOfWeek.Saturday or DayOfWeek.Sunday
            );
        }
    }

    private IEnumerable<CalendarDayContext> GetDayContexts()
    {
        var firstCell = IsWeekView
            ? StartOfWeek(_visibleDate)
            : StartOfWeek(StartOfMonth(_visibleDate));
        var dayCount = IsWeekView ? 7 : 42;

        for(var i = 0; i < dayCount; i++)
        {
            var date = firstCell.AddDays(i).Date;

            var calendarYear = EffectiveCalendar.GetYear(date);
            var calendarMonth = EffectiveCalendar.GetMonth(date);
            var calendarDay = EffectiveCalendar.GetDayOfMonth(date);

            var outsideMonth =
                calendarYear != VisibleCalendarYear ||
                calendarMonth != VisibleCalendarMonth;

            var disabled = IsDisabledDate(date);

            var css = new List<string> { "mud-calendar__day" };

            if(outsideMonth)
                css.Add("mud-calendar__day--outside");

            if(date == DateTime.Today)
                css.Add("mud-calendar__day--today");

            if(_currentDate?.Date == date)
                css.Add("mud-calendar__day--selected");

            if(disabled)
                css.Add("mud-calendar__day--disabled");

            var extra = AdditionalDateClassesFunc?.Invoke(date);
            if(!string.IsNullOrWhiteSpace(extra))
                css.Add(extra);

            yield return new CalendarDayContext(
                Date: date,
                DayNumber: calendarDay,
                DisplayDayNumber: calendarDay.ToString(EffectiveCulture),
                CalendarYear: calendarYear,
                CalendarMonth: calendarMonth,
                IsToday: date == DateTime.Today,
                IsSelected: _currentDate?.Date == date,
                IsOutsideMonth: outsideMonth,
                IsDisabled: disabled,
                CssClass: string.Join(" ", css)
            );
        }
    }

    private IEnumerable<CalendarMonthContext> GetMonthContexts()
    {
        var era = VisibleEra;
        var calendarYear = VisibleCalendarYear;
        var monthsInYear = EffectiveCalendar.GetMonthsInYear(calendarYear, era);

        for(var month = 1; month <= monthsInYear; month++)
        {
            var date = ToCalendarDate(calendarYear, month, 1, era);

            var selected =
                _currentDate.HasValue &&
                EffectiveCalendar.GetEra(_currentDate.Value) == era &&
                EffectiveCalendar.GetYear(_currentDate.Value) == calendarYear &&
                EffectiveCalendar.GetMonth(_currentDate.Value) == month;

            var disabled = IsDisabledMonth(date);

            var css = new List<string> { "mud-calendar__month" };

            if(selected)
                css.Add("mud-calendar__month--selected");

            if(disabled)
                css.Add("mud-calendar__month--disabled");

            yield return new CalendarMonthContext(
                Month: date,
                MonthNumber: month,
                ShortName: date.ToString("MMM", EffectiveCulture),
                Name: date.ToString("MMMM", EffectiveCulture),
                CalendarYear: calendarYear,
                Era: era,
                IsSelected: selected,
                IsDisabled: disabled,
                CssClass: string.Join(" ", css)
            );
        }
    }

    private IEnumerable<CalendarYearContext> GetYearContexts()
    {
        var era = VisibleEra;

        for(var calendarYear = YearPageStart; calendarYear < YearPageStart + 12; calendarYear++)
        {
            var selected =
                _currentDate.HasValue &&
                EffectiveCalendar.GetEra(_currentDate.Value) == era &&
                EffectiveCalendar.GetYear(_currentDate.Value) == calendarYear;

            var disabled = IsDisabledYear(calendarYear, era);

            var css = new List<string> { "mud-calendar__year" };

            if(selected)
                css.Add("mud-calendar__year--selected");

            if(disabled)
                css.Add("mud-calendar__year--disabled");

            yield return new CalendarYearContext(
                Year: calendarYear,
                DisplayName: FormatYear(calendarYear),
                Era: era,
                IsSelected: selected,
                IsDisabled: disabled,
                CssClass: string.Join(" ", css)
            );
        }
    }

    private bool IsDisabledDate(DateTime date)
    {
        if(MinDate.HasValue && date < MinDate.Value.Date)
            return true;

        if(MaxDate.HasValue && date > MaxDate.Value.Date)
            return true;

        return IsDateDisabledFunc?.Invoke(date) == true;
    }

    private bool IsDisabledMonth(DateTime monthStart)
    {
        var era = EffectiveCalendar.GetEra(monthStart);
        var year = EffectiveCalendar.GetYear(monthStart);
        var month = EffectiveCalendar.GetMonth(monthStart);
        var daysInMonth = EffectiveCalendar.GetDaysInMonth(year, month, era);

        var start = ToCalendarDate(year, month, 1, era).Date;
        var end = ToCalendarDate(year, month, daysInMonth, era).Date;

        if(MinDate.HasValue && end < MinDate.Value.Date)
            return true;

        if(MaxDate.HasValue && start > MaxDate.Value.Date)
            return true;

        return false;
    }

    private bool IsDisabledYear(int calendarYear, int era)
    {
        try
        {
            var monthsInYear = EffectiveCalendar.GetMonthsInYear(calendarYear, era);
            var daysInLastMonth = EffectiveCalendar.GetDaysInMonth(calendarYear, monthsInYear, era);

            var start = ToCalendarDate(calendarYear, 1, 1, era).Date;
            var end = ToCalendarDate(calendarYear, monthsInYear, daysInLastMonth, era).Date;

            if(MinDate.HasValue && end < MinDate.Value.Date)
                return true;

            if(MaxDate.HasValue && start > MaxDate.Value.Date)
                return true;

            return false;
        }
        catch(ArgumentOutOfRangeException)
        {
            return true;
        }
    }

    private DateTime NormalizeVisibleDate(DateTime date) =>
        IsWeekView ? StartOfWeek(date) : StartOfMonth(date);

    private DateTime StartOfWeek(DateTime date)
    {
        var offset = ((int)date.DayOfWeek - (int)ResolvedFirstDayOfWeek + 7) % 7;

        return date.Date.AddDays(-offset);
    }

    private string FormatWeekHeader()
    {
        var start = StartOfWeek(_visibleDate);
        var end = start.AddDays(6);

        return $"{FormatShortDate(start)} - {FormatShortDate(end)}";
    }

    private string FormatShortDate(DateTime date) =>
        date.ToString("d", EffectiveCulture);

    private DateTime StartOfMonth(DateTime date)
    {
        var era = EffectiveCalendar.GetEra(date);
        var year = EffectiveCalendar.GetYear(date);
        var month = EffectiveCalendar.GetMonth(date);

        return ToCalendarDate(year, month, 1, era);
    }

    private DateTime ToCalendarDate(int year, int month, int day, int era)
    {
        return EffectiveCalendar.ToDateTime(
            year,
            month,
            day,
            0,
            0,
            0,
            0,
            era);
    }

    private DateTime AddCalendarMonths(DateTime date, int months) =>
        StartOfMonth(EffectiveCalendar.AddMonths(date, months));

    private DateTime AddCalendarYears(DateTime date, int years) =>
        StartOfMonth(EffectiveCalendar.AddYears(date, years));

    private string FormatYear(int calendarYear) =>
        calendarYear.ToString(EffectiveCulture);

    public sealed record CalendarDayContext(
        DateTime Date,
        int DayNumber,
        string DisplayDayNumber,
        int CalendarYear,
        int CalendarMonth,
        bool IsToday,
        bool IsSelected,
        bool IsOutsideMonth,
        bool IsDisabled,
        string CssClass);

    public sealed record CalendarMonthContext(
        DateTime Month,
        int MonthNumber,
        string ShortName,
        string Name,
        int CalendarYear,
        int Era,
        bool IsSelected,
        bool IsDisabled,
        string CssClass);

    public sealed record CalendarYearContext(
        int Year,
        string DisplayName,
        int Era,
        bool IsSelected,
        bool IsDisabled,
        string CssClass);

    public sealed record CalendarDayOfWeekContext(
        DayOfWeek DayOfWeek,
        int Index,
        string ShortName,
        bool IsWeekend);
}
