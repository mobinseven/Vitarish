@implements IDisposable

@inject IThemeService ThemeService

@if(ThemeService.IsDarkMode)
{
    <div style="width: 100dvw; height: 100dvh; background-image: url('/bg/bg.webp'); background-size: cover; background-color: black; position: fixed; top: 0; right: 0; z-index: -100; pointer-events: none; opacity: .2;"></div>
}
else
{
    <div style="width: 100dvw; height: 100dvh; background-image: url('/bg/bg.webp'); background-size: cover; position: fixed; top: 0; right: 0; z-index: -100; pointer-events: none; opacity: .2;"></div>
}

@if(RendererInfo.IsInteractive)
{
    <MudThemeProvider @ref="_provider"
                      @key="@($"theme-{ThemeService.ThemeVersion}")"
                      @rendermode="InteractiveServer"
                      Theme="@ThemeService.Theme"
                      IsDarkMode="@ThemeService.IsDarkMode"
                      IsDarkModeChanged="OnDarkModeChanged"
                      ObserveSystemDarkModeChange="@ThemeService.ObserveSystemThemeChange" />
}
else
{
    <MudThemeProvider @key="@($"theme-{ThemeService.ThemeVersion}")"
                      @rendermode="InteractiveServer"
                      Theme="@ThemeService.Theme"
                      IsDarkMode="@ThemeService.IsDarkMode"
                      IsDarkModeChanged="OnDarkModeChanged" 
                      ObserveSystemDarkModeChange="@ThemeService.ObserveSystemThemeChange" />
}

@* <ThemeSurfaceConfigurator @rendermode="InteractiveServer" /> *@

<div style="height: 100%" class="glass-theme glass--transparent">
    @ChildContent
</div>

@code {

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private MudThemeProvider? _provider;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.VisualStateChanged += OnVisualStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender || _provider is null)
            return;

        if(ThemeService.Settings.Theme == ThemePreference.Auto)
        {
            var systemIsDark = await _provider.GetSystemDarkModeAsync(); 
            await ThemeService.UpdateSystemDarkModeAsync(systemIsDark);
        }
    }

    private Task OnDarkModeChanged(bool isDarkMode)
        => ThemeService.UpdateSystemDarkModeAsync(isDarkMode);

    private void OnVisualStateChanged()
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeService.VisualStateChanged -= OnVisualStateChanged;
    }
}
