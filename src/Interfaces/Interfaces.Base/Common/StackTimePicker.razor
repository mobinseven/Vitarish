@inherits MudTimePicker
@inject IStringLocalizer Localizer
<StackField Label="@Label">
    <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Reverse="@(Culture.TextInfo.IsRightToLeft ? true : false)">
        <MudSelect T="int" Value="hour" ValueChanged="h => SetHour(h)" Underline="false" Variant="Variant.Outlined" Label="@Localizer["Hour"]">
            @for(int i = 0; i < 24; i++)
            {
                var item = i;
                <MudSelectItem @key="item" Value="item">@item</MudSelectItem>
            }
        </MudSelect>
        <MudText Typo="Typo.caption">:</MudText>
        <MudSelect T="int"
                   Value="@minute"
                   ValueChanged="@(m => SetMinute(m))"
                   Underline="false"
                   Variant="Variant.Outlined"
                   Label="@Localizer["Minute"]">

            @for(int i = 0; i < 60; i += 15)
            {
                var item = i;

                <MudSelectItem T="int" @key="item" Value="@item">
                    @item
                </MudSelectItem>
            }
        </MudSelect>
    </MudStack>
</StackField>

@code {

    private int hour = 0;
    private int minute = 0;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        hour = Time?.Hours ?? 0;
        minute = Time?.Minutes ?? 0;
    }

    private async void SetHour(int h)
    {
        hour = h;
        Time = new TimeSpan(hour, minute, 0);
        await TimeChanged.InvokeAsync(Time);
    }

    private async Task SetMinute(int m)
    {
        minute = m;
        Time = new TimeSpan(hour, minute, 0);
        await TimeChanged.InvokeAsync(Time);
    }
}
