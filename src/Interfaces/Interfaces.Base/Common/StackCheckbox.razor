@inherits MudCheckBox<bool>

<MudCheckBox T="bool"
             LabelPlacement="@LabelPlacement"
             Class="stack-item"
             Value="@Value"
             ValueChanged="@ValueChanged"
             Color="@(Color == default ? Color.Primary : Color)"
             Size="@Size"
             UncheckedIcon="fa-solid fa-circle"
             UncheckedColor="@(UncheckedColor == default ? Color.Default : UncheckedColor)"
             CheckedIcon="fa-solid fa-check"
             Label="@Label">
    @if(ChildContent is not null)
    {
        @ChildContent
    }
</MudCheckBox>
