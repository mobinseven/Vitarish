@inherits MudStack

@*
    `<Stack>` is a container component for wrapping other `<Stack*>` group of components. (`<StackButton>`, `<StackField>`, etc.)

    - Multiple `<Stack>` components should not be nested into each other. 
*@
<MudStack Spacing="0" Class="@cssClass" Style="@Style">
    @ChildContent
</MudStack>
@code {
    private string cssClass => $"glass stack fade {(Class is null ? "my-6" : Class)}";
}
