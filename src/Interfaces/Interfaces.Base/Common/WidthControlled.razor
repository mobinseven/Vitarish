<MudStack AlignItems=AlignItems.Center Justify=Justify.Center Style="width: 100%;" Spacing="0">
    <div style="@ContentWidth">
        @ChildContent
    </div>
</MudStack>
@code {
    /// <summary>
    /// Width to use when the current viewport is below the configured <see cref="PageBreakpoint"/>.
    /// Example: "100%" to use full width on small screens.
    /// </summary>
    [Parameter]
    public string FullWidth { get; set; } = "100%";

    /// <summary>
    /// Width to use when the current viewport is at or above the configured <see cref="PageBreakpoint"/>.
    /// Example: "60dvw" to constrain content on larger screens.
    /// </summary>
    [Parameter]
    public string ControlledWidth { get; set; } = "50dvw"; 

    /// <summary>
    /// The breakpoint used to switch between <see cref="FullWidth"/> and <see cref="ControlledWidth"/>.
    /// </summary>
    [CascadingParameter]
    public Breakpoint PageBreakpoint { get; set; } = Breakpoint.Md;

    /// <summary>
    /// Child content will be rendered inside the width-controlled container.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets the computed inline style string for the container's width, based on the current breakpoint.
    /// </summary>
    protected string ContentWidth => "width: " + (PageBreakpoint < Breakpoint.Md ? FullWidth : ControlledWidth);
}
