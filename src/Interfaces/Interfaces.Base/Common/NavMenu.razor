@inherits CommonBase
@implements IDisposable
<div>
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceAround" Style="width: 100%;">
        @if(SearchActive)
        {
            <Stack>
                <StackTextField @bind-Value="NavService.SearchString" DebounceInterval="500" Adornment="Adornment.End" AdornmentIcon="fa-solid fa-xmark" OnAdornmentClick="Close" />
            </Stack>
        }
        else
        {
            @if(ScrollToTopVisible)
            {
                <MudFab Size="Size" StartIcon="fa-solid fa-chevron-up" DropShadow="false" OnClick="OnScrollToTopClick" Color="Color.Tertiary" />
            }
            else
            {
                <MudFab Size=Size StartIcon="fa-solid fa-house-blank" DropShadow=false OnClick="HandleHomeClick" Color="Color.Tertiary" />
            }
            <MudFab Size=Size StartIcon="fa-solid fa-magnifying-glass" DropShadow=false OnClick="Open" Color="@(Search ? Color.Success : Color.Default)" />
            <MudFab Size=Size StartIcon="fa-solid fa-level-up-alt" DropShadow=false OnClick="HandleBackClick" Disabled="@(NavigationManager.Uri == NavigationManager.BaseUri)" Color="Color.Info" />
            <MudFab Size=Size StartIcon="fa-solid fa-gear" DropShadow=false OnClick="HandleProfileClick" Color="Color.Secondary" />
        }
    </MudStack>
</div>
