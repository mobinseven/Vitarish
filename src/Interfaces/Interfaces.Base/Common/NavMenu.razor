@implements IDisposable
<div>
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceAround" Style="width: 100%;">
        @if(searchActive)
        {
            <MudFab Size=Size StartIcon="fa-thin fa-xmark" DropShadow=false OnClick="Close" />
            <MudTextField T="string" @bind-Value="query" Style="border-radius: 70px; width: 100%;" AutoFocus Immediate Variant="Variant.Text" Clearable />
            <MudFab Size=Size StartIcon="fa-thin fa-magnifying-glass" DropShadow=false OnClick="Search" />
        }
        else
        {
            @if(BackAction is not null)
            {
                <MudFab Size=Size StartIcon="@BackAction.Icon" DropShadow=false Href="@BackHref" OnClick="HandleBackClick" />
            }
            <MudFab Size=Size StartIcon="fa-thin fa-house-blank" DropShadow=false Href="@HomeHref" />
            @if(SearchService.IsEnabled)
            {
                <MudFab Size=Size StartIcon="fa-thin fa-magnifying-glass" DropShadow=false OnClick="() => searchActive = true" />
            }
            <PwaInstall>
                <InstallButton>
                    <MudFab Size=Size IconColor="Color.Info" StartIcon="@Icons.Material.Filled.Download" DropShadow=false OnClick="context.OnInstallClicked" />
                </InstallButton>
            </PwaInstall>
            <MudFab Size=Size StartIcon="fa-thin fa-gear" DropShadow=false Href="/settings" />
        }
    </MudStack>
</div>
