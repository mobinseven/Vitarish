@implements IDisposable
<div>
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceAround" Style="width: 100%;">
        @if(searchActive)
        {
            <MudFab Size=Size StartIcon="fa-thin fa-xmark" DropShadow=false OnClick="Close" />
            <MudTextField T="string" @bind-Value="Query" Style="border-radius: 70px; width: 100%;" AutoFocus DebounceInterval="1000" Variant="Variant.Text" Clearable />
        }
        else
        {
            <MudFab Size=Size StartIcon="fa-thin fa-house-blank" DropShadow=false OnClick="HandleHomeClick" />
            @if(State.Search.Visible)
            {
                <MudFab Size=Size StartIcon="fa-thin fa-magnifying-glass" DropShadow=false Disabled="@(!State.Search.Enabled)" OnClick="HandleSearchClick" />
            }
            <MudFab Size=Size StartIcon="fa-thin fa-arrow-left" DropShadow=false OnClick="HandleBackClick" />
            <MudFab Size=Size StartIcon="fa-thin fa-gear" DropShadow=false OnClick="HandleProfileClick" />
        }
    </MudStack>
</div>
