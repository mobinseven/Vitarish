<style>
    .glass-wrapper {
        position: relative;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        color: black;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 2.2);
    }

        .glass-wrapper:hover {
            transform: scale(1.01);
        }

        .glass-wrapper::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 0;
            backdrop-filter: blur(20px);
            filter: url(#glass-distortion);
            overflow: hidden;
        }

        .glass-wrapper::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 2;
            border-radius: 24px;
        }

    .glass-content {
        z-index: 3;
        position: relative;
    }
</style>

<div class="@CssClass" @attributes="AdditionalAttributes" style="@Style">
    @if(Title is not null)
    {
        <MudText Class="my-2 liquidGlass-text" Typo="Typo.h3" Align="Align.Center">@Title</MudText>
    }
    <div class="glass-content">
        @ChildContent
    </div>
</div>

<svg style="display: none">
    <filter id="glass-distortion" x="0%" y="0%" width="100%" height="100%" filterUnits="objectBoundingBox">
        <feTurbulence type="fractalNoise" baseFrequency="0.01 0.01" numOctaves="1" seed="5" result="turbulence"></feTurbulence>
        <!-- Seeds: 14, 17,  -->

        <feComponentTransfer in="turbulence" result="mapped">
            <feFuncR type="gamma" amplitude="1" exponent="10" offset="0.5"></feFuncR>
            <feFuncG type="gamma" amplitude="0" exponent="1" offset="0"></feFuncG>
            <feFuncB type="gamma" amplitude="0" exponent="1" offset="0.5"></feFuncB>
        </feComponentTransfer>

        <feGaussianBlur in="turbulence" stdDeviation="3" result="softMap"></feGaussianBlur>

        <feSpecularLighting in="softMap" surfaceScale="5" specularConstant="1" specularExponent="100" lighting-color="white" result="specLight">
            <fePointLight x="-200" y="-200" z="300"></fePointLight>
        </feSpecularLighting>

        <feComposite in="specLight" operator="arithmetic" k1="0" k2="1" k3="1" k4="0" result="litImage"></feComposite>

        <feDisplacementMap in="SourceGraphic" in2="softMap" scale="150" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
</svg>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public Palettes? Palette { get; set; }
    [Parameter] public bool AutoTone { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass =>
        string.Join(" ", new[]
        {
            "mx-1 my-3",
            "glass-wrapper",
            "palette-card",
            "palette-surface",
            PaletteCss.GetCssClass(Palette),
            AutoTone ? null : "palette-card--no-auto-tone",
            Class
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

    protected override void OnInitialized()
    {
        // Optional: Add click handler to randomize distortion (if you want interactivity)
    }
}
