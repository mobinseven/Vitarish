@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@inherits MudNumericField<int>

<span @attributes="TriggerAttributes"
      class="@EffectiveTriggerClass"
      role="button"
      tabindex="@EffectiveTriggerTabIndex"
      aria-label="@EffectiveTriggerAriaLabel()"
      aria-haspopup="dialog"
      aria-expanded="@AriaExpanded"
      aria-disabled="@AriaDisabled"
      @onclick="OpenAsync"
      @onpointerdown="SuppressFocusOpen"
      @onfocusin="OnTriggerFocusIn"
      @onkeydown="OnTriggerKeyDown">
    <MudChip T="string"
             Icon="@Icon"
             Disabled="@IsInteractionDisabled"
             Size="@ChipSize"
             Text="@EffectiveLabel()" />
</span>

<MudDialog Visible="@_open" VisibleChanged="@OnDialogVisibleChanged">
    <DialogContent>
        <MudNumericField @key="_editorKey"
                         @ref="_editorNumericField"
                         T="int"
                         Value="@Value"
                         ValueChanged="@ValueChanged"
                         Adornment="@Adornment.End"
                         AdornmentColor="@DoneAdornmentColor"
                         AdornmentIcon="@DoneIcon"
                         OnAdornmentClick="@CloseAsync"
                         OnKeyDown="@OnEditorKeyDown"
                         Class="@EffectiveFieldClass"
                         Style="@Style"
                         Label="@null"
                         HelperText="@HelperText"
                         Placeholder="@Placeholder"
                         Max="@Max"
                         Min="@Min"
                         Variant="@EditorVariant"
                         Underline="false"
                         Required="@Required"
                         RequiredError="@RequiredError"
                         Immediate="@Immediate"
                         DebounceInterval="@DebounceInterval"
                         ReadOnly="@ReadOnly"
                         Disabled="@Disabled"
                         UserAttributes="@UserAttributes" />
    </DialogContent>
</MudDialog>

@code {
    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "Click To Edit";

    [Parameter]
    public string DoneText { get; set; } = "Done";

    [Parameter]
    public string DoneIcon { get; set; } = "fa-solid fa-circle-check";

    [Parameter]
    public Color DoneAdornmentColor { get; set; } = Color.Primary;

    [Parameter]
    public Variant EditorVariant { get; set; } = Variant.Filled;

    [Parameter]
    public Size ChipSize { get; set; } = Size.Large;

    [Parameter]
    public int ChipTextMaxLength { get; set; } = 80;

    [Parameter]
    public string? ChipNumberFormat { get; set; }

    [Parameter]
    public string? TriggerAriaLabel { get; set; }

    [Parameter]
    public string? TriggerClass { get; set; }

    [Parameter]
    public int TriggerTabIndex { get; set; } = 0;

    [Parameter]
    public IReadOnlyDictionary<string, object>? TriggerAttributes { get; set; }

    [Parameter]
    public bool OpenOnTabFocus { get; set; }

    [Parameter]
    public int FocusOpenCooldownMilliseconds { get; set; } = 250;

    [Parameter]
    public bool FocusEditorOnOpen { get; set; } = true;

    [Parameter]
    public int EditorFocusDelayMilliseconds { get; set; } = 75;

    [Parameter]
    public int EditorFocusRetryCount { get; set; } = 8;

    [Parameter]
    public int EditorFocusRetryDelayMilliseconds { get; set; } = 50;

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    [Parameter]
    public bool CloseOnEnter { get; set; } = true;

    [Parameter]
    public bool CloseOnCtrlEnter { get; set; } = true;

    [Parameter]
    public EventCallback Opened { get; set; }

    [Parameter]
    public EventCallback Closed { get; set; }

    private bool _open;
    private bool _pendingEditorFocus;
    private bool _suppressFocusOpen;
    private int _editorFocusAttempts;
    private DateTime _lastClosedAtUtc = DateTime.MinValue;
    private Guid _editorKey = Guid.NewGuid();
    private MudNumericField<int>? _editorNumericField;

    private string AriaExpanded => _open ? "true" : "false";
    private string AriaDisabled => IsInteractionDisabled ? "true" : "false";
    private int EffectiveTriggerTabIndex => IsInteractionDisabled ? -1 : TriggerTabIndex;
    private bool IsInteractionDisabled => Disabled || ReadOnly;
    private string? EffectiveEditorLabel => string.IsNullOrWhiteSpace(Label) ? null : Label;

    private string EffectiveTriggerClass
        => $"stack-field-trigger stack-numeric-field-trigger {(Disabled ? "stack-field-disabled" : string.Empty)} {(ReadOnly ? "stack-field-readonly" : string.Empty)} {TriggerClass}".Trim();

    private string EffectiveFieldClass
        => $"stack-item stack-field-input stack-numeric-field-input {Class}".Trim();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if(!_open || !_pendingEditorFocus || !FocusEditorOnOpen || IsInteractionDisabled)
        {
            return;
        }

        await FocusEditorAsync();
    }

    private async Task FocusEditorAsync()
    {
        if(EditorFocusDelayMilliseconds > 0 && _editorFocusAttempts == 0)
        {
            await Task.Delay(EditorFocusDelayMilliseconds);
        }

        if(!_open || !_pendingEditorFocus || IsInteractionDisabled)
        {
            return;
        }

        if(_editorNumericField is null)
        {
            await RetryOrStopEditorFocusAsync();
            return;
        }

        try
        {
            await _editorNumericField.FocusAsync();
            CompleteEditorFocus();
        }
        catch(Exception)
        {
            await RetryOrStopEditorFocusAsync();
        }
    }

    private bool CanRetryEditorFocus()
        => _editorFocusAttempts + 1 < Math.Max(1, EditorFocusRetryCount);

    private async Task RetryOrStopEditorFocusAsync()
    {
        if(!CanRetryEditorFocus())
        {
            _pendingEditorFocus = false;
            _editorFocusAttempts = 0;
            return;
        }

        _editorFocusAttempts++;

        if(EditorFocusRetryDelayMilliseconds > 0)
        {
            await Task.Delay(EditorFocusRetryDelayMilliseconds);
        }

        if(_open && _pendingEditorFocus && !IsInteractionDisabled)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CompleteEditorFocus()
    {
        _pendingEditorFocus = false;
        _editorFocusAttempts = 0;
    }

    private async Task OpenAsync()
    {
        if(IsInteractionDisabled || _open)
        {
            return;
        }

        _editorKey = Guid.NewGuid();
        _editorFocusAttempts = 0;
        _pendingEditorFocus = FocusEditorOnOpen;
        _open = true;
        await Opened.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        if(!_open)
        {
            return;
        }

        _open = false;
        _pendingEditorFocus = false;
        _editorFocusAttempts = 0;
        _lastClosedAtUtc = DateTime.UtcNow;
        await Closed.InvokeAsync();
    }

    private async Task OnDialogVisibleChanged(bool visible)
    {
        if(visible)
        {
            await OpenAsync();
            return;
        }

        await CloseAsync();
    }

    private async Task OnTriggerFocusIn(FocusEventArgs args)
    {
        if(!OpenOnTabFocus || IsInteractionDisabled || _open)
        {
            _suppressFocusOpen = false;
            return;
        }

        if(_suppressFocusOpen || IsInsideFocusOpenCooldown())
        {
            _suppressFocusOpen = false;
            return;
        }

        await OpenAsync();
    }

    private void SuppressFocusOpen()
        => _suppressFocusOpen = true;

    private bool IsInsideFocusOpenCooldown()
        => FocusOpenCooldownMilliseconds > 0
            && (DateTime.UtcNow - _lastClosedAtUtc).TotalMilliseconds < FocusOpenCooldownMilliseconds;

    private async Task OnTriggerKeyDown(KeyboardEventArgs args)
    {
        if(IsInteractionDisabled || args.Repeat || !IsActivationKey(args))
        {
            return;
        }

        await OpenAsync();
    }

    private async Task OnEditorKeyDown(KeyboardEventArgs args)
    {
        if(IsInteractionDisabled)
        {
            return;
        }

        if(CloseOnEscape && args.Key == "Escape")
        {
            await CloseAsync();
            return;
        }

        if(IsEnterKey(args) && CloseOnCtrlEnter && (args.CtrlKey || args.MetaKey))
        {
            await CloseAsync();
            return;
        }

        if(IsEnterKey(args) && CloseOnEnter && !args.ShiftKey && !args.AltKey && !args.CtrlKey && !args.MetaKey)
        {
            await CloseAsync();
        }
    }

    private string EffectiveTriggerAriaLabel()
    {
        if(!string.IsNullOrWhiteSpace(TriggerAriaLabel))
        {
            return TriggerAriaLabel!;
        }

        var target = !string.IsNullOrWhiteSpace(Label) ? Label! : "numeric value";
        return _open ? $"Editing {target}" : $"Edit {target}";
    }

    private string EffectiveLabel()
    {
        var labelGiven = !string.IsNullOrWhiteSpace(Label);
        var helpGiven = !string.IsNullOrWhiteSpace(HelperText);
        var valueText = FormatValue();
        var valueGiven = !string.IsNullOrWhiteSpace(valueText);

        string text;
        if(labelGiven && valueGiven)
        {
            text = $"{Label}: {valueText}";
        }
        else if(valueGiven)
        {
            text = valueText;
        }
        else if(labelGiven && helpGiven)
        {
            text = $"{Label}: {HelperText}";
        }
        else if(labelGiven)
        {
            text = Label!;
        }
        else if(helpGiven)
        {
            text = HelperText!;
        }
        else
        {
            text = EmptyText;
        }

        return Truncate(text, ChipTextMaxLength);
    }

    private string FormatValue()
    {
        object? value = Value;

        if(value is null)
        {
            return string.Empty;
        }

        if(value is IFormattable formattable)
        {
            return string.IsNullOrWhiteSpace(ChipNumberFormat)
                ? formattable.ToString(null, CultureInfo.CurrentCulture)
                : formattable.ToString(ChipNumberFormat, CultureInfo.CurrentCulture);
        }

        return value.ToString() ?? string.Empty;
    }

    private static bool IsActivationKey(KeyboardEventArgs args)
        => IsEnterKey(args) || args.Key is " " or "Space" or "Spacebar" || args.Code == "Space";

    private static bool IsEnterKey(KeyboardEventArgs args)
        => args.Key == "Enter" || args.Code is "Enter" or "NumpadEnter";

    private static string Truncate(string text, int maxLength)
    {
        if(maxLength <= 0 || text.Length <= maxLength)
        {
            return text;
        }

        return string.Concat(text.AsSpan(0, Math.Max(0, maxLength - 1)), "…");
    }
}
