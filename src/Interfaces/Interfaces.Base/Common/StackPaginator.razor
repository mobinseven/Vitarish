@implements IDisposable

@if(_state is not null && _state.TotalItems > 0)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="my-2">
        <MudPagination Class="glass"
                       ShowFirstButton="true"
                       ShowLastButton="true"
                       Count="@_state.TotalPages"
                       Selected="@_state.Page"
                       SelectedChanged="OnPageChanged" />
    </MudStack>
}

@code {
    [CascadingParameter] private StackPaginationState? _state { get; set; }
    private StackPaginationState? _activeState;

    protected override void OnParametersSet()
    {
        SubscribeToState();
    }

    private void SubscribeToState()
    {
        if(_activeState == _state)
            return;

        if(_activeState is not null)
            _activeState.StateChanged -= OnPaginationStateChanged;

        _activeState = _state;

        if(_activeState is not null)
            _activeState.StateChanged += OnPaginationStateChanged;
    }

    private Task OnPageChanged(int selected)
    {
        _state?.SetPage(selected);
        return Task.CompletedTask;
    }

    private void OnPaginationStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if(_activeState is not null)
            _activeState.StateChanged -= OnPaginationStateChanged;
    }
}
