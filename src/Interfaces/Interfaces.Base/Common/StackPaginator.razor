@inherits CommonBase
@implements IDisposable

@if(State is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="stack-item">
        <MudSelect T="int" Value="PageSize" ValueChanged="v => SetPageSize(v)" Underline="false" Variant="Variant.Filled">
            <MudSelectItem T="int" Value="5">5</MudSelectItem>
            <MudSelectItem T="int" Value="10">10</MudSelectItem>
            <MudSelectItem T="int" Value="20">50</MudSelectItem>
            <MudSelectItem T="int" Value="100">100</MudSelectItem>
            <MudSelectItem T="int" Value="int.MaxValue">@Localizer["Infinite"]</MudSelectItem>
        </MudSelect>
        @if(State.TotalPages > 1)
        {
            <MudPagination Class="glass"
                           ShowFirstButton="true"
                           ShowLastButton="true"
                           Count="@State.TotalPages"
                           Selected="@State.Page"
                           SelectedChanged="OnPageChanged" />
        }
    </MudStack>
}

@code {
    private int PageSize;

    [Parameter] public StackPaginationState? State { get; set; }
    [Parameter] public EventCallback<StackPaginationState?> StateChanged { get; set; }
    private StackPaginationState? _activeState;

    protected override void OnInitialized()
    {
        SubscribeToState();
        PageSize = State.PageSize;
    }

    private void SetPageSize(int size)
    {
        PageSize = size;
        State?.Configure(State?.TotalItems ?? 0, PageSize);
    }

    private void SubscribeToState()
    {
        if(_activeState == State)
            return;

        if(_activeState is not null)
            _activeState.StateChanged -= OnPaginationStateChanged;

        _activeState = State;

        if(_activeState is not null)
            _activeState.StateChanged += OnPaginationStateChanged;
    }

    private async Task OnPageChanged(int selected)
    {
        State?.SetPage(selected);
        await StateChanged.InvokeAsync(State);
    }

    private void OnPaginationStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if(_activeState is not null)
            _activeState.StateChanged -= OnPaginationStateChanged;
    }
}
