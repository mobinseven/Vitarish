@inherits Chip
<Chip Color="Color" Style="@($"white-space: pre-wrap;height:auto; overflow: auto; background-image: url('{Src}'); background-size: cover;")">
    <MudImage Src="@Src" Width="100" Style="opacity:0;" @onclick="() => ShowDetails()" />
</Chip>
@code{
    [Inject] IDialogService DialogService { get; set; } = default!;

    [Parameter] public string Src { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClick { get; set; }

    internal RenderFragment ImgFragment => builder =>
{
    builder.OpenComponent<MudImage>(0);
    builder.AddAttribute(1, nameof(MudImage.Src), Src);
    builder.CloseComponent();
};

    private async Task ShowDetails()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(null);
            return;
        }
        DialogParameters parameters = new()
        {
            { nameof(InfoDialog.Info),  ImgFragment},
        };

        await DialogService.ShowAsync<InfoDialog>(null, parameters);
    }
}