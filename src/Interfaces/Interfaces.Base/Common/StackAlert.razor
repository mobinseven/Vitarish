@inherits MudAlert

<MudAlert Severity="@Severity"
          Class="@($"stack-item {Class}")"
          Dense="@Dense"
          Icon="@Icon"
          ShowCloseIcon="@ShowCloseIcon"
          CloseIconClicked="@CloseIconClicked"
          Elevation="@Elevation"
          Square="@Square">
    @ChildContent
</MudAlert>
