@typeparam T
@inherits MudSelect<T>

<MudSelect T="T"
           Label="@Label"
           OuterClass="stack-item"
           Variant="Variant.Outlined"
           Value="@Value"
           ValueChanged="@ValueChanged"
           AdornmentColor="@AdornmentColor"
           AdornmentIcon="@AdornmentIcon"
           Adornment="@Adornment"
           OnAdornmentClick="@OnAdornmentClick"
           Clearable="@Clearable"
           Underline="false"
           Required="@Required">
    @ChildContent
</MudSelect>
