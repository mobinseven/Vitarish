@typeparam T
@inherits MudSelect<T>

<MudChip T="T" Icon="@Icon"
         Disabled="Disabled"
         Size="Size.Large"
         Text="@(Label is not null ? Label : ToStringFunc is null ? ValueState.Value?.ToString() : ToStringFunc(ValueState.Value))"
         OnClick="ToggleOpen" />
<MudDialog @bind-Visible="_open">
    <DialogContent>
        <MudList @bind-SelectedValue:get="@ValueState.Value"
                 @bind-SelectedValue:set="@(async v => { await ValueState.SetValueAsync(v); ToggleOpen(); })" T="T">
            @ChildContent
        </MudList>
    </DialogContent>
</MudDialog>
@code {

    [Parameter] public string? Icon { get; set; }

    private bool _open;

    private void ToggleOpen() => _open = !_open;

    protected ParameterState<T?> ValueState;

    public StackSelect()
    {
        using var registerScope = CreateRegisterScope();

        ValueState = registerScope.RegisterParameter<T?>(nameof(Value))
            .WithParameter(() => Value)
            .WithEventCallback(() => ValueChanged);
    }
}
