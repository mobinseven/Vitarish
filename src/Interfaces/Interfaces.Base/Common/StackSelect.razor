@typeparam T
@inherits MudSelect<T>

<MudSelect T="T"
           HelperText="@Label"
           OuterClass="stack-item"
           Variant="Variant.Filled"
           @bind-Value:get="@ValueState.Value"
           @bind-Value:set="@ValueState.SetValueAsync"
           AdornmentColor="@AdornmentColor"
           AdornmentIcon="@AdornmentIcon"
           Adornment="@Adornment"
           OnAdornmentClick="@OnAdornmentClick"
           Clearable="@Clearable"
           Underline="false"
           Required="@Required">
    @ChildContent
</MudSelect>
@code {
    protected ParameterState<T?> ValueState;

    public StackSelect()
    {
        using var registerScope = CreateRegisterScope();

        ValueState = registerScope.RegisterParameter<T?>(nameof(Value))
            .WithParameter(() => Value)
            .WithEventCallback(() => ValueChanged);
    }
}
