@typeparam T
@inherits MudSelect<T>

<MudSelect T="T"
           HelperText="@Label"
           OuterClass="stack-item ma-3"
           Variant="Variant.Filled"
           Value="@Value"
           ValueChanged="@ValueChanged"
           AdornmentColor="@AdornmentColor"
           AdornmentIcon="@AdornmentIcon"
           Adornment="@Adornment"
           OnAdornmentClick="@OnAdornmentClick"
           Clearable="@Clearable"
           Underline="false"
           Required="@Required">
    @ChildContent
</MudSelect>
