@inherits StackSelect<SortMethod>

@if(Methods.Length > 1)
{
    <div class="stack-item">
        <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Start" StretchItems="StretchItems.Start">
            <div>
                <MudSelect T="SortMethod"
                           HelperText="@Localizer["SortBy"]"
                           OuterClass="stack-item"
                           Variant="Variant.Filled"
                           Value="selectedValue" ValueChanged="v => OnChanged(v)"
                           AdornmentColor="@AdornmentColor"
                           AdornmentIcon="@AdornmentIcon"
                           Adornment="@Adornment"
                           OnAdornmentClick="@OnAdornmentClick"
                           Clearable="@Clearable"
                           Underline="false"
                           Required="@Required">
                    @foreach(var method in Methods)
                    {
                        <StackSelectItem Value="method">@method.LabelAction()</StackSelectItem>
                    }
                </MudSelect>
            </div>
            <div>
                <MudToggleIconButton @bind-Toggled:get="descending" @bind-Toggled:set="OnToggled" Icon="fa-solid fa-arrow-down-short-wide" ToggledIcon="fa-solid fa-arrow-up-short-wide" DropShadow="false" />
            </div>
        </MudStack>
    </div>
}

@code {
    [Inject] protected IStringLocalizer Localizer { get; set; } = default!;
    private SortMethod? selectedValue => ValueState.Value ?? Methods.FirstOrDefault();

    [Parameter] public SortMethod[] Methods { get; set; } = [];

    private bool descending;

    public StackSort()
    {
        using var registerScope = CreateRegisterScope();

        ValueState = registerScope.RegisterParameter<SortMethod?>(nameof(Value))
            .WithParameter(() => Value)
            .WithEventCallback(() => ValueChanged);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if(!firstRender)
        {
            return;
        }

        selectedValue?.SortAction(descending);
    }

    private void OnToggled(bool toggle)
    {
        descending = toggle;
        selectedValue?.SortAction(descending);
    }

    private async Task OnChanged(SortMethod method)
    {
        await ValueState.SetValueAsync(method);
        await ValueChanged.InvokeAsync(ValueState.Value);
        method.SortAction(descending);
    }
}
