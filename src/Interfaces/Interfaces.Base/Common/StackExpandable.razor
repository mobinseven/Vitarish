@inherits MudButton

@if(TitleContent is not null)
{
        @TitleContent(Expansion)
}
else
{
    <StackButton Label="@Label" OnClick="Toggle" EndIcon="@ContinueIcon" Color="@Color" Size="@Size" />
}
@if(expanded)
{
    @if(ExpandableContent is not null)
    {
        @ExpandableContent(Expansion)
    }
    else
    {
        @ChildContent
    }
}


@code {
    private bool expanded;

    private ExpansionContext Expansion =>
        new(
            expanded,
            Open,
            Close,
            Toggle
        );

    private Task Toggle() => SetExpanded(!expanded);

    private Task Open() => SetExpanded(true);

    private Task Close() => SetExpanded(false);

    private Task SetExpanded(bool value)
    {
        if(expanded == value)
            return Task.CompletedTask;

        expanded = value;
        return InvokeAsync(StateHasChanged);
    }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HighlightString { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public RenderFragment<ExpansionContext>? ExpandableContent { get; set; }
    [Parameter] public RenderFragment<ExpansionContext>? TitleContent { get; set; }

    private Typo LabelSize => Size switch
    {
        Size.Small => Typo.caption,
        Size.Large => Typo.h3,
        _ => Typo.body1
    };

    private string ContinueIcon =>
        !string.IsNullOrWhiteSpace(EndIcon)
            ? EndIcon
            : expanded
                ? "fa-solid fa-chevron-up"
                : "fa-solid fa-chevron-down";

    public sealed record ExpansionContext(
        bool Expanded,
        Func<Task> OpenAsync,
        Func<Task> CloseAsync,
        Func<Task> ToggleAsync
    );
}
