@using Microsoft.AspNetCore.Components
@using MudBlazor

@if(TitleContent is not null)
{
    @TitleContent(Expansion)
}
else
{
    <StackButton Label="@Label"
                 HelperText="@HelperText"
                 OnClick="Toggle"
                 StartIcon="@StartIcon"
                 EndIcon="@ContinueIcon"
                 Color="@Color"
                 Size="@Size" />
}

@if(_expanded)
{
    @if(ExpandableContent is not null)
    {
        @ExpandableContent(Expansion)
    }
    else
    {
        @ChildContent
    }
}

@code {
    private bool _expanded;
    private bool _expandedParameterWasSupplied;
    private bool _initialized;

    private ExpansionContext Expansion =>
        new(
            _expanded,
            Open,
            Close,
            Toggle
        );

    public override Task SetParametersAsync(ParameterView parameters)
    {
        _expandedParameterWasSupplied =
            parameters.TryGetValue<bool>(nameof(Expanded), out _);

        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        if(!_initialized)
        {
            _expanded = Expanded;
            _initialized = true;
            return;
        }

        if(_expandedParameterWasSupplied && _expanded != Expanded)
        {
            _expanded = Expanded;
        }
    }

    private Task Toggle() => SetExpandedAsync(!_expanded);

    private Task Open() => SetExpandedAsync(true);

    private Task Close() => SetExpandedAsync(false);

    private async Task SetExpandedAsync(bool value)
    {
        if(_expanded == value)
        {
            return;
        }

        _expanded = value;
        await ExpandedChanged.InvokeAsync(value);
    }

    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment<ExpansionContext>? ExpandableContent { get; set; }
    [Parameter] public RenderFragment<ExpansionContext>? TitleContent { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HighlightString { get; set; }
    [Parameter] public string? HelperText { get; set; }

    [Parameter] public string? StartIcon { get; set; }
    [Parameter] public string? EndIcon { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Default;
    [Parameter] public Size Size { get; set; } = Size.Medium;

    private string ContinueIcon =>
        !string.IsNullOrWhiteSpace(EndIcon)
            ? EndIcon
            : _expanded
                ? "fa-solid fa-chevron-up"
                : "fa-solid fa-chevron-down";

    public sealed record ExpansionContext(
        bool Expanded,
        Func<Task> OpenAsync,
        Func<Task> CloseAsync,
        Func<Task> ToggleAsync
    );
}
