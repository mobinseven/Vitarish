@inherits CommonBase
<MudDialog>
    <DialogContent>
        <Stack>
            <StackField>
                @Info
            </StackField>
        </Stack>
        <Stack>
            <StackButton Label="@Localizer["Close"]" OnClick="MudDialog.Cancel" Color="Color.Secondary" />
        </Stack>
    </DialogContent>
</MudDialog>

@code {

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public RenderFragment? Info { get; set; }
}
