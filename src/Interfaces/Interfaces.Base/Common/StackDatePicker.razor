@inherits MudDatePicker
@using Microsoft.AspNetCore.Components

<StackField Label="@Label">
    <MudDatePicker Date="@PickerDate"
                   DateChanged="@OnPickerDateChanged"
                   Color="Color.Default"
                   IconSize="Size.Small"
                   OverflowBehavior="OverflowBehavior.FlipOnOpen"
                   Variant="Variant.Outlined"
                   DateFormat="dd/MM/yyyy"
                   Underline="false"
                   Elevation="0"
                   PickerVariant="@PickerVariant.Inline"
                   MinDate="@MinDate"
                   MaxDate="@MaxDate"
                   IsDateDisabledFunc="@IsDateDisabledFunc" />
</StackField>

@code {
    [Parameter]
    public DateOnly? DateOnlyValue { get; set; }

    [Parameter]
    public EventCallback<DateOnly?> DateOnlyValueChanged { get; set; }

    private bool UsesDateOnlyBinding =>
        DateOnlyValue.HasValue || DateOnlyValueChanged.HasDelegate;

    private DateTime? PickerDate =>
        UsesDateOnlyBinding
            ? DateOnlyValue?.ToDateTime(TimeOnly.MinValue)
            : Date;

    private async Task OnPickerDateChanged(DateTime? value)
    {
        // Keep existing DateTime? binding support from MudDatePicker.
        await DateChanged.InvokeAsync(value);

        // Add DateOnly? binding support.
        DateOnly? dateOnlyValue = value.HasValue
            ? System.DateOnly.FromDateTime(value.Value)
            : null;

        await DateOnlyValueChanged.InvokeAsync(dateOnlyValue);
    }
}
