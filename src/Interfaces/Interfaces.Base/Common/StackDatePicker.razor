@using MudBlazor

@inherits StackCalendar
<div class="stack-item">
    <StackExpandable>
        <TitleContent>
            <MudDatePicker HelperText="@Label"
                           Editable="true"
                           @bind-Date:get="_dateState.Value"
                           @bind-Date:set="@(v =>  ValueSet(context, v))"
                           Underline="false"
                           ShowToolbar="false"
                           Elevation="0"
                           ImmediateText
                           Clearable
                           ClearIcon="fa-solid fa-eraser"
                           AdornmentIcon=""
                           Mask="@(new DateMask("yyyy/MM/dd"))"
                           DateFormat="yyyy/MM/dd"
                           OnClick="context.ToggleAsync"
                           Variant="@(context.Expanded ? Variant.Outlined :Variant.Filled)" />
        </TitleContent>
        <ExpandableContent>
            <StackCalendar ViewMode="@ViewMode"
                           DayCount="@DayCount"
                           IsDateDisabledFunc="@IsDateDisabledFunc"
                           @bind-Date:get="_dateState.Value"
                           @bind-Date:set="_dateState.SetValueAsync" />
        </ExpandableContent>

    </StackExpandable>
</div>

@code {
    private async Task ValueSet(StackExpandable.ExpansionContext context, DateTime? value)
    {
        if(context.Expanded)
        {
            await context.ToggleAsync();
        }
        await _dateState.SetValueAsync(value);
    }
}
