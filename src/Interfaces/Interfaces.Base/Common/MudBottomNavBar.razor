@implements IDisposable
@namespace Vitarish.Interfaces.Base.Common

<div class="bottom-nav-container">
    @* Overlay for closing Create menu when clicking outside *@
    @if (_createMenuOpen && EnableCreateMenu)
    {
        <MudOverlay Visible="true" 
                    DarkBackground="false" 
                    LightBackground="false"
                    Absolute="false"
                    ZIndex="998"
                    OnClick="CloseCreateMenu" />
    }

    @* Radial action menu arc *@
    <div class="radial-menu @(_createMenuOpen ? "open" : "closed")">
        @if (CreateActions != null && CreateActions.Count > 0)
        {
            <div class="radial-arc"></div>
            
            @for (int i = 0; i < Math.Min(CreateActions.Count, 3); i++)
            {
                var action = CreateActions[i];
                var angle = -90 + (i * 45); // -90°, -45°, 0° for left-to-right arc
                var radians = angle * Math.PI / 180;
                var radius = 100;
                var x = Math.Cos(radians) * radius;
                var y = Math.Sin(radians) * radius;
                
                <div class="radial-action-wrapper" 
                     style="transform: translate(@(x)px, @(y)px);">
                    <MudIconButton Icon="@action.Icon"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   aria-label="@action.Label"
                                   OnClick="() => HandleRadialActionClick(action)"
                                   Disabled="!action.Enabled"
                                   Class="radial-action" />
                </div>
            }
        }
    </div>

    @* Bottom navigation pill *@
    <MudPaper Elevation="4" Class="bottom-nav-pill">
        <div class="bottom-nav-items">
            @* Home Button *@
            <div class="bottom-nav-item @(Active == NavButtonId.Home ? "active" : "")">
                <MudIconButton Icon="@(Active == NavButtonId.Home ? Icons.Material.Filled.Home : Icons.Material.Outlined.Home)"
                               Color="@(Active == NavButtonId.Home ? Color.Primary : Color.Default)"
                               Size="Size.Medium"
                               aria-label="Home"
                               OnClick="HandleHomeClick"
                               Disabled="!State.Home.Enabled" />
            </div>

            @* Search Button *@
            <div class="bottom-nav-item @(Active == NavButtonId.Search ? "active" : "")">
                <MudIconButton Icon="@(Active == NavButtonId.Search ? Icons.Material.Filled.Search : Icons.Material.Outlined.Search)"
                               Color="@(Active == NavButtonId.Search ? Color.Primary : Color.Default)"
                               Size="Size.Medium"
                               aria-label="Search"
                               OnClick="HandleSearchClick"
                               Disabled="!State.Search.Enabled" />
            </div>

            @* Create Button (Center FAB) *@
            @if (EnableCreateMenu)
            {
                <div class="bottom-nav-item center-item">
                    <div class="create-button @(_createMenuOpen ? "open" : "collapsed")">
                        <MudIconButton Icon="@(_createMenuOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)"
                                       Color="Color.Primary"
                                       Size="Size.Medium"
                                       aria-label="@(_createMenuOpen ? "Close" : "Create")"
                                       OnClick="ToggleCreateMenu"
                                       Class="create-fab" />
                    </div>
                </div>
            }
            else
            {
                <div class="bottom-nav-item"></div>
            }

            @* Back Button (or spacing if not visible) *@
            @if (State.Back.Visible)
            {
                <div class="bottom-nav-item @(Active == NavButtonId.Back ? "active" : "")">
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                                   Color="@(Active == NavButtonId.Back ? Color.Primary : Color.Default)"
                                   Size="Size.Medium"
                                   aria-label="Back"
                                   OnClick="HandleBackClick"
                                   Disabled="!State.Back.Enabled" />
                </div>
            }
            else
            {
                <div class="bottom-nav-item" style="visibility: hidden;">
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                                   Size="Size.Medium"
                                   Disabled="true" />
                </div>
            }

            @* Profile Button *@
            <div class="bottom-nav-item @(Active == NavButtonId.Profile ? "active" : "")">
                <MudIconButton Icon="@(Active == NavButtonId.Profile ? Icons.Material.Filled.AccountCircle : Icons.Material.Outlined.AccountCircle)"
                               Color="@(Active == NavButtonId.Profile ? Color.Primary : Color.Default)"
                               Size="Size.Medium"
                               aria-label="Profile"
                               OnClick="HandleProfileClick"
                               Disabled="!State.Profile.Enabled" />
            </div>
        </div>
    </MudPaper>
</div>
