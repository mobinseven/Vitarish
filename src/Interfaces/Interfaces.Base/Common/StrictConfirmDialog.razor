@inherits CommonBase
<MudDialog>
    <DialogContent>
        <MudText>@ContentText</MudText>
        <MudTextField @bind-Value="confirmation"
                      Label="@Localizer["TypeNameToConfirm", ItemName]"
                      Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Close"]</MudButton>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="Submit" Disabled="!IsMatch">@ButtonText</MudButton>
    </DialogActions>
</MudDialog>
