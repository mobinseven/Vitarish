@inherits CommonBase
<MudDialog>
    <DialogContent>
        <Stack>
            <StackField Label="@ContentText" />
            <StackTextField @bind-Value="confirmation"
                            Label="@Localizer["TypeNameToConfirm", ItemName]"
                            Immediate="true" />
        </Stack>
        <Stack>
            <StackButton Label="@(ButtonText is null ? Localizer["Confirm"] : ButtonText)" OnClick="Submit" Disabled="!IsMatch" />
            <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" EndIcon="fa-regular fa-xmark" />
        </Stack>
    </DialogContent>
</MudDialog>
