@inherits CommonBase
<MudDialog>
    <DialogContent>
        <Stack>
            <StackField Label="@ContentText" />
            <StackTextField @bind-Value="confirmation"
                            Immediate="true" />
            <MudText Typo="@Typo.caption">@Localizer["TypeNameToConfirm", ItemName]</MudText>
        </Stack>
        <Stack>
            <StackButton Label="@(ButtonText is null ? Localizer["Confirm"] : ButtonText)" OnClick="Submit" Disabled="!IsMatch" Color="Color.Primary" />
            <StackButton Label="@Localizer["Cancel"]" OnClick="Cancel" EndIcon="fa-solid fa-xmark" Color="Color.Secondary" />
        </Stack>
    </DialogContent>
</MudDialog>
