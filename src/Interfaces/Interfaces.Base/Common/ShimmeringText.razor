<span class="@CssClass"
      style="@ComputedStyle"
      role="@Role"
      aria-label="@AriaLabel">
    @Text
</span>

@code {
    [Parameter] public string Text { get; set; } = "Thinking";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    [Parameter] public bool IsActive { get; set; } = true;
    [Parameter] public string Duration { get; set; } = "1.8s";
    [Parameter] public string Width { get; set; } = "220%";

    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string Role { get; set; } = "status";

    private string CssClass =>
        string.Join(" ",
            "shimmering-text",
            IsActive ? "shimmering-text--active" : null,
            Class
        );

    private string ComputedStyle =>
        $"--shimmer-duration:{Duration};--shimmer-width:{Width};{Style}";
}
