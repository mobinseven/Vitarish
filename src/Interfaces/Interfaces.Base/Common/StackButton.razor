@inherits MudButton
<MudButton Variant="Variant.Text"
           Disabled="@Disabled"
           Class="stack-item"
           FullWidth
           Style="@Style"
           Href="@Href"
           Color="@Color"
           StartIcon="@StartIcon"
           IconColor="@Color"
           IconSize="Size.Small"
           EndIcon="@ContinueIcon"
           OnClick="@OnClick"
           DropShadow="false">
    <MudStack Row Style="width: 100%" AlignItems="AlignItems.Center" StretchItems="StretchItems.Middle">
        <div>
            <MudHighlighter HighlightedText="@HighlightString" Text="@Label" />
        </div>
        <div />
        <div>
            @ChildContent
        </div>
    </MudStack>
</MudButton>
@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HighlightString { get; set; }
    private string ContinueIcon => EndIcon is null ? CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "fa-regular fa-chevron-left" : "fa-regular fa-chevron-right" : EndIcon;
}
