@inherits MudButton
<MudButton Variant="Variant.Text"
           Disabled="@Disabled"
           Class="stack-item"
           FullWidth
           Style="@Style"
           Href="@Href"
           Color="@Color"
           StartIcon="@StartIcon"
           IconColor="@Color"
           IconSize="@Size"
           EndIcon="@ContinueIcon"
           OnClick="@OnClick"
           DropShadow="false">
    <MudStack Row Style="width: 100%" AlignItems="AlignItems.Center" StretchItems="StretchItems.Middle">
        <div>
            <MudText Typo="@LabelSize">
                <MudHighlighter HighlightedText="@HighlightString" Text="@Label" />
            </MudText>
        </div>
        <div />
        <div>
            @ChildContent
        </div>
    </MudStack>
</MudButton>
@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HighlightString { get; set; }
    private string ContinueIcon => EndIcon is null ? CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "fa-regular fa-chevron-left" : "fa-regular fa-chevron-right" : EndIcon;

    private Typo LabelSize => Size switch
    {
        Size.Small => Typo.caption,
        Size.Large => Typo.h3,
        _ => Typo.body1
    };

}
