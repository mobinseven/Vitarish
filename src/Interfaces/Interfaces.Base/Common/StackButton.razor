@inherits MudButton
<MudButton Variant="Variant.Text"
           HtmlTag="@(ButtonType  != ButtonType.Submit ? "div" : "button")"
           ButtonType="@ButtonType"
           Disabled="@Disabled"
           Class="stack-item"
           FullWidth
           Style="@Style"
           Href="@Href"
           Color="@Color"
           StartIcon="@StartIcon"
           IconColor="@Color"
           IconSize="@Size"
           OnClick="@OnClick"
           DropShadow="false">
    <MudStack Row Style="width: 100%" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" StretchItems="StretchItems.Middle">

        @if(ChildContent is null)
        {
            <div>
                <MudText Typo="@LabelSize" Align="Align.Start">
                    <MudHighlighter HighlightedText="@HighlightString" Text="@Label" />
                </MudText>
                @if(!string.IsNullOrWhiteSpace(HelperText))
                {
                    <MudText Typo="Typo.caption">@HelperText</MudText>
                }
            </div>
            <div />
            <div>
                @if(RendererInfo.IsInteractive)
                {
                    <MudFab HtmlTag="div"
                            Disabled="@Disabled"
                            StartIcon="@ContinueIcon"
                            DropShadow="false"
                            Color="@Color"
                            Size="Size" />
                }
                else
                {
                    <MudIcon Disabled="@Disabled"
                             Icon="@ContinueIcon"
                             Color="@Color"
                             Size="Size" />
                }
            </div>
        }
        else
        {
            @ChildContent
        }
    </MudStack>
</MudButton>

@code {

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HighlightString { get; set; }
    [Parameter] public string? HelperText { get; set; }
    private string ContinueIcon => EndIcon is null ? CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "fa-solid fa-chevron-left" : "fa-solid fa-chevron-right" : EndIcon;

    private Typo LabelSize => Size switch
    {
        Size.Small => Typo.caption,
        Size.Large => Typo.h3,
        _ => Typo.body1
    };
}
