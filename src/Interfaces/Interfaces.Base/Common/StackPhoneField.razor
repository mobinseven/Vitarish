@using MudBlazor
@using MudBlazor.State
@inherits MudTextField<string>

<StackTextField @bind-Value:get="@_displayValue"
                @bind-Value:set="@SetPhoneValueAsync"
                Centered="@Centered"
                Icon="@EffectiveIcon"
                EmptyText="@EffectiveEmptyText"
                DoneText="@DoneText"
                DoneIcon="@EffectiveDoneIcon"
                DoneAdornmentColor="@EffectiveAdornmentColor"
                EditorVariant="@Variant"
                ChipSize="@ChipSize"
                ChipTextMaxLength="@ChipTextMaxLength"
                TriggerAriaLabel="@EffectiveTriggerAriaLabel"
                TriggerClass="@TriggerClass"
                TriggerTabIndex="@TriggerTabIndex"
                TriggerAttributes="@TriggerAttributes"
                OpenOnTabFocus="@OpenOnTabFocus"
                FocusOpenCooldownMilliseconds="@FocusOpenCooldownMilliseconds"
                FocusEditorOnOpen="@FocusEditorOnOpen"
                EditorFocusDelayMilliseconds="@EditorFocusDelayMilliseconds"
                CloseOnEscape="@CloseOnEscape"
                CloseOnEnter="@CloseOnEnter"
                CloseOnCtrlEnter="@CloseOnCtrlEnter"
                Opened="@Opened"
                Closed="@Closed"
                AutoFocus="@AutoFocus"
                Mask="@_phoneMask"
                Style="@EffectiveStyle"
                Class="@Class"
                Required="@Required"
                RequiredError="@RequiredError"
                Placeholder="@Placeholder"
                DebounceInterval="@DebounceInterval"
                Immediate="@Immediate"
                HelperText="@EffectiveHelperText"
                InputType="@InputType"
                Lines="@Lines"
                MaxLines="@MaxLines"
                MaxLength="@MaxLength"
                InputMode="@InputMode"
                UserAttributes="@UserAttributes"
                ReadOnly="@ReadOnly"
                Disabled="@Disabled" />

@code {
    [Inject] protected IStringLocalizer Localizer { get; set; } = default!;

    [Parameter] public bool Centered { get; set; }

    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public string DoneText { get; set; } = "Done";
    [Parameter] public string DoneIcon { get; set; } = "fa-solid fa-circle-check";
    [Parameter] public Color DoneAdornmentColor { get; set; } = Color.Primary;
    [Parameter] public Size ChipSize { get; set; } = Size.Large;
    [Parameter] public int ChipTextMaxLength { get; set; } = 80;

    [Parameter] public string? TriggerAriaLabel { get; set; }
    [Parameter] public string? TriggerClass { get; set; }
    [Parameter] public int TriggerTabIndex { get; set; } = 0;
    [Parameter] public IReadOnlyDictionary<string, object>? TriggerAttributes { get; set; }

    [Parameter] public bool OpenOnTabFocus { get; set; }
    [Parameter] public int FocusOpenCooldownMilliseconds { get; set; } = 250;

    [Parameter] public bool FocusEditorOnOpen { get; set; } = true;
    [Parameter] public int EditorFocusDelayMilliseconds { get; set; } = 75;

    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public bool CloseOnEnter { get; set; } = true;
    [Parameter] public bool CloseOnCtrlEnter { get; set; } = true;

    [Parameter] public EventCallback Opened { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private readonly ParameterState<string?> _valueState;

    private string? _displayValue;
    private string? _lastParameterValue;
    private string? _lastValueSentByThisComponent;
    private bool _hasLocalDisplayEdit;
    private bool _hasValue;
    private bool _isValidIranPhone;

    private readonly MultiMask _phoneMask = new(
        // Default: local Iran mobile format
        "0000 000 0000",

        // 0912 345 6789
        new MaskOption("Iran", "0000 000 0000", @"^09"),

        // 912 345 6789
        new MaskOption("Iran", "000 000 0000", @"^9"),

        // 98912 345 6789
        new MaskOption("Iran", "00000 000 0000", @"^98")
    );

    private bool ShowUnknownPhoneWarning =>
        _hasValue && !_isValidIranPhone;

    private string EffectiveDefaultLabel => Localizer["Phone"].Value;

    private string? EffectiveIcon =>
        ShowUnknownPhoneWarning
            ? "fa-solid fa-triangle-exclamation"
            : Icon ?? AdornmentIcon ?? "fa-solid fa-phone";

    private string EffectiveDoneIcon =>
        ShowUnknownPhoneWarning
            ? "fa-solid fa-triangle-exclamation"
            : DoneIcon;

    private Color EffectiveAdornmentColor =>
        ShowUnknownPhoneWarning
            ? Color.Warning
            : AdornmentColor == Color.Default
                ? DoneAdornmentColor
                : AdornmentColor;

    private string EffectiveHelperText =>
        !string.IsNullOrWhiteSpace(HelperText)
            ? HelperText!
            : !string.IsNullOrWhiteSpace(Label)
                ? Label!
                : EffectiveDefaultLabel;

    private string EffectiveEmptyText =>
        !string.IsNullOrWhiteSpace(EmptyText)
            ? EmptyText!
            : EffectiveHelperText;

    private string EffectiveTriggerAriaLabel =>
        !string.IsNullOrWhiteSpace(TriggerAriaLabel)
            ? TriggerAriaLabel!
            : $"Edit {EffectiveHelperText}";

    private string EffectiveStyle => CombineStyles("direction: ltr", Style);

    public StackPhoneField()
    {
        using var registerScope = CreateRegisterScope();

        _valueState = registerScope.RegisterParameter<string?>(nameof(Value))
            .WithParameter(() => Value)
            .WithEventCallback(() => ValueChanged);

        InputType = InputType.Telephone;
        Variant = MudBlazor.Variant.Filled;
        DebounceInterval = 500;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var parameterValue = _valueState.Value;
        var parameterChanged = !StringEquals(parameterValue, _lastParameterValue);

        if(parameterChanged)
        {
            _lastParameterValue = parameterValue;

            // A parameter echo caused by this component must not overwrite the text the user is editing.
            // External value changes should still be reflected when the parent intentionally changes Value.
            if(!_hasLocalDisplayEdit || !StringEquals(parameterValue, _lastValueSentByThisComponent))
            {
                // Value is stored canonically when valid, e.g. +989123456789.
                // Display it locally, e.g. 0912 345 6789.
                _displayValue = ToIranLocalDisplay(parameterValue);
                _hasLocalDisplayEdit = false;
            }
        }
        else if(!_hasLocalDisplayEdit)
        {
            _displayValue = ToIranLocalDisplay(parameterValue);
        }

        UpdatePhoneMatchState(_displayValue);
    }

    private async Task SetPhoneValueAsync(string? input)
    {
        _displayValue = input;
        _hasLocalDisplayEdit = true;

        var normalized = NormalizeIranPhone(input);
        var valueToCommit = normalized ?? PreserveUserInput(input);

        UpdatePhoneMatchState(input);

        if(StringEquals(valueToCommit, _lastParameterValue))
        {
            _lastValueSentByThisComponent = valueToCommit;
            return;
        }

        _lastValueSentByThisComponent = valueToCommit;

        // Store valid values canonically as +989123456789.
        // Preserve invalid or partial non-empty text instead of clearing it.
        await _valueState.SetValueAsync(valueToCommit);
    }

    private void UpdatePhoneMatchState(string? value)
    {
        var digits = OnlyDigits(value);

        _hasValue = !string.IsNullOrWhiteSpace(digits);
        _isValidIranPhone = NormalizeIranPhone(value) is not null;
    }

    private static string? NormalizeIranPhone(string? value)
    {
        var digits = OnlyDigits(value);

        if(string.IsNullOrWhiteSpace(digits))
        {
            return null;
        }

        // 0912 345 6789 -> 9123456789
        if(digits.Length == 11 && digits.StartsWith("09"))
        {
            digits = digits[1..];
        }

        // 98912 345 6789 -> 9123456789
        else if(digits.Length == 12 && digits.StartsWith("98"))
        {
            digits = digits[2..];
        }

        // 0098 912 345 6789 -> 9123456789
        else if(digits.Length == 14 && digits.StartsWith("0098"))
        {
            digits = digits[4..];
        }

        // 912 345 6789 -> already national significant number
        else if(digits.Length == 10 && digits.StartsWith("9"))
        {
            digits = digits;
        }

        else
        {
            return null;
        }

        // Iran mobile national significant number should be:
        // 9xxxxxxxxx
        if(digits.Length != 10 || !digits.StartsWith("9"))
        {
            return null;
        }

        return $"+98{digits}";
    }

    private static string? PreserveUserInput(string? value)
    {
        if(string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return value.ConvertToEnglishNumerals().Trim();
    }

    private static string? ToIranLocalDisplay(string? value)
    {
        var normalized = NormalizeIranPhone(value);

        if(normalized is null)
        {
            return value;
        }

        // +989123456789 -> 09123456789
        var localDigits = $"0{normalized[3..]}";

        // 09123456789 -> 0912 345 6789
        return $"{localDigits[..4]} {localDigits[4..7]} {localDigits[7..]}";
    }

    private static string OnlyDigits(string? value)
    {
        if(string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return new string(value.ConvertToEnglishNumerals().Where(char.IsDigit).ToArray());
    }

    private static bool StringEquals(string? left, string? right) =>
        string.Equals(left, right, StringComparison.Ordinal);

    private static string CombineStyles(params string?[] styles)
    {
        var parts = styles
            .Where(style => !string.IsNullOrWhiteSpace(style))
            .Select(style => style!.Trim().TrimEnd(';'));

        return string.Join("; ", parts);
    }
}
