@using Vitarish.Intelligence.Interface.Components
@using Vitarish.Interfaces.Base.Abstractions
@inherits CommonBase
@implements IDisposable
@inject IChatService ChatService

@if(ChatActive)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="width: 100%;" Spacing="0">
        <div>
            @if(ScrollToTopVisible)
            {
                <MudFab Size="Size.Small" StartIcon="fa-solid fa-chevron-up" DropShadow="false" OnClick="OnScrollToTopClick" Color="Color.Default" />
            }
            else
            {
                <MudFab Size=Size.Small StartIcon="fa-solid fa-house" DropShadow=false OnClick="HandleHomeClick" Color="Color.Default" />
            }
            @* <MudFab Size="Size.Small" StartIcon="fa-solid fa-chevron-down" Disabled="@(!ScrollToBotVisible)" DropShadow="false" OnClick="OnScrollToBotClick" Color="Color.Default" /> *@
            <MudFab Size=Size.Small StartIcon="fa-solid fa-level-up-alt" DropShadow=false OnClick="HandleBackClick" Disabled="@(NavigationManager.Uri == NavigationManager.BaseUri)" Color="Color.Default" />
        </div>

        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceAround" Style="width: 100%;">
            <Stack Class="glass white mt-1 pa-0" Style="width: 100%;">
                <AdvancedInput FileUploadEnabled="false"
                               RewriteEnabled="false"
                               Busy="@ChatWaiting"
                               OnSubmit="@ChatService.ChatSubmit">
                    <EndContent>
                        @ChatContext
                    </EndContent>
                </AdvancedInput>
            </Stack>
        </MudStack>
    </MudStack>
}
else
{
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceAround" Style="width: 100%;" Class="glass">
        @if(SearchActive)
        {
            <Stack>
                <StackTextField @bind-Value="NavService.SearchString" DebounceInterval="500" Adornment="Adornment.End" AdornmentIcon="fa-solid fa-xmark" OnAdornmentClick="CloseSearch" />
            </Stack>
        }
        else
        {
            @if(ScrollToTopVisible)
            {
                <MudFab Size="Size.Small" StartIcon="fa-solid fa-chevron-up" DropShadow="false" OnClick="OnScrollToTopClick" Color="Color.Default" />
            }
            else
            {
                <MudFab Size=Size.Small StartIcon="fa-solid fa-house-blank" DropShadow=false OnClick="HandleHomeClick" Color="Color.Default" />
            }

            <MudFab Size="Size.Small" StartIcon="fa-solid fa-chevron-down" Disabled="@(!ScrollToBotVisible)" DropShadow="false" OnClick="OnScrollToBotClick" Color="Color.Default" />
            <MudFab Size=Size.Small StartIcon="fa-solid fa-magnifying-glass" DropShadow=false OnClick="OpenSearch" Color="@(Search ? Color.Success : Color.Default)" />
            <MudFab Size=Size.Small StartIcon="fa-solid fa-level-up-alt" DropShadow=false OnClick="HandleBackClick" Disabled="@(NavigationManager.Uri == NavigationManager.BaseUri)" Color="Color.Info" />
            <MudFab Size=Size.Small StartIcon="fa-solid fa-gear" DropShadow=false OnClick="HandleProfileClick" Color="Color.Secondary" />
        }
    </MudStack>
}
