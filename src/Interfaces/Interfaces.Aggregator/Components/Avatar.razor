@if(FileId.HasValue)
{
    <div class="@Class" style="@($"width:{_size}px;height:{_size}px;overflow:hidden;border-radius:{(Circle ? "50%" : "8px")};{Style}")">
        <FileImage FileId="@FileId.Value" />
    </div>
}
else if(FileInformation is not null)
{

    <MudAvatar Size="@MudBlazor.Size.Large">
        <MudImage Src="@FileInformation.Thumbnail" />
    </MudAvatar>
}
else
{
    <MudAvatar Size="@MudBlazor.Size.Large">
        <MudIcon Icon="fa-solid fa-camera" />
    </MudAvatar>
}

@code {
    [Parameter] public Guid? FileId { get; set; }
    [Parameter] public FileInformationReadDto? FileInformation { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public bool Circle { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private int _size => Size switch
    {
        Size.Small => 50,
        Size.Medium => 100,
        Size.Large => 150,
        _ => 100
    };
}
