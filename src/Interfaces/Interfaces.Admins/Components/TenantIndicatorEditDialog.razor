@inherits PlatformAdminCommonBase
<MudDialog>
    <DialogContent>
        <Stack>
            <StackSelect @bind-Value="newMethod" Label="@Localizer["Method"]" Required>
                <StackSelectItem Value="@IndicatorMethod.Hostname">Hostname</StackSelectItem>
                <StackSelectItem Value="@IndicatorMethod.Subdomain">Subdomain</StackSelectItem>
            </StackSelect>
            <StackTextField @bind-Value="newValue"
                            Label="@Localizer["Address"]"
                            Placeholder="e.g., app.customer.com"
                            Required />
            <StackSelect @bind-Value="newVerificationMethod" Label="@Localizer["VerificationMethod"]" Required>
                <StackSelectItem Value="@IndicatorVerificationMethod.Manual">Manual</StackSelectItem>
                <StackSelectItem Value="@IndicatorVerificationMethod.DnsTxt">DNS TXT Record</StackSelectItem>
            </StackSelect>
            <StackSelect @bind-Value="newStatus" Label="@Localizer["Status"]" Required>
                <StackSelectItem Value="@IndicatorStatus.Active">@Localizer["Active"]</StackSelectItem>
                <StackSelectItem Value="@IndicatorStatus.Verified">@Localizer["Verified"]</StackSelectItem>
                <StackSelectItem Value="@IndicatorStatus.Disabled">@Localizer["Disabled"]</StackSelectItem>
            </StackSelect>
            <StackCheckbox @bind-Value="newIsPrimary"
                           Label="@Localizer["Primary"]" />
            @if(!string.IsNullOrWhiteSpace(verificationToken) && !string.IsNullOrWhiteSpace(verificationEvidence))
            {
                <StackAlert Severity="Severity.Info">
                        <MudText Typo="Typo.body2">@Localizer["DnsTxtRecordInstruction"]</MudText>
                        <MudText Typo="Typo.body2" Class="mt-2"><strong>Hostname:</strong> @verificationEvidence</MudText>
                        <MudText Typo="Typo.body2"><strong>Value:</strong> verify=@verificationToken</MudText>
                </StackAlert>
            }
        </Stack>
        <Stack>
            <StackButton Label="@Localizer["Save"]" OnClick="Save" Color="Color.Primary" EndIcon="fa-solid fa-save" />
            <StackButton Label="@Localizer["Delete"]" OnClick="Delete" Color="Color.Error" EndIcon="fa-solid fa-trash" />
            <StackButton OnClick="MudDialog.Cancel" EndIcon="fa-solid fa-xmark" Label="@Localizer["Cancel"]" />
        </Stack>
    </DialogContent>
</MudDialog>

