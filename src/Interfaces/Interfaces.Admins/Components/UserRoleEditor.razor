@inherits PlatformAdminCommonBase

@if(userRole is null)
{
    return;
}
<Stack>
    @if(userRole.RoleDetails.Count == 0)
    {
        <StackField Label="@Localizer["NoRoles"]" />
    }
    else
    {
        <StackField Label="@Localizer["Roles"]" />
        @foreach(var role in userRole.RoleDetails)
        {
            <StackButton Label="@Localizer[role.RoleName]" HelperText="@role.TenantName" OnClick="@(() => RemoveRoleAsync(userRole, role.FullRoleName))" EndIcon="fa-solid fa-xmark" />
        }
    }
    <StackButton Label="@Localizer["AssignRole"]" Color="Color.Primary" EndIcon="fa-solid fa-plus" OnClick="@(() => OpenAssignRoleDialogAsync(userRole))" />
</Stack>
