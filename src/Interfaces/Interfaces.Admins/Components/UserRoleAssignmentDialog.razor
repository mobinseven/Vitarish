@inherits CommonBase

<MudDialog>
    <DialogContent>
        @if(isLoading)
        {
            <MudProgressLinear Indeterminate Color="Color.Default" />
        }
        else if(tenantRoles.Count == 0)
        {
            <Stack>
                <StackField Label="@Localizer["NoRolesAvailable"]" />
            </Stack>
        }
        else
        {
            @foreach(var tenant in tenantRoles.GroupBy(r => r.TenantId))
            {
                <Stack>
                    <StackField Label="@tenant.First().TenantName" HelperText="@tenant.First().OwnerName" />
                    @foreach(var role in tenant)
                    {
                        <StackButton Label="@Localizer[role.RoleName]" Disabled="assignedRoles.Contains(role.FullRoleName)" EndIcon="" OnClick="() => Assign(role)">
                            @if(assignedRoles.Contains(role.FullRoleName))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">@Localizer["Assigned"]</MudChip>
                            }
                        </StackButton>
                    }
                </Stack>
            }
        }
    </DialogContent>
</MudDialog>
