@using Vitarish.Parties.Domain.Dtos
@using Vitarish.Parties.Domain.Mappers

<Stack>

    <StackTextField @bind-Value=write.Name Label="@Localizer["Name"]" Required />
    <StackTextField @bind-Value=write.LogoUrl Label="@Localizer["LogoUrl"]" />
    <StackTextField @bind-Value=write.Description Label="@Localizer["Description"]" />
    <StackButton Label="@Localizer["Save"]" OnClick="Save" Color="Color.Primary" EndIcon="fa-solid fa-save" />
    @if(OnCancelled.HasDelegate)
    {
        <StackButton Label="@Localizer["Cancel"]" OnClick="OnCancelled" EndIcon="fa-solid fa-xmark" Color="Color.Secondary" />
    }
</Stack>

@code {
    Vitarish.Parties.Domain.Dtos.OwnerWriteDto write = new();
    [Parameter, EditorRequired] public Vitarish.Parties.Domain.Dtos.OwnerReadDto Owner { get; set; }
    [Parameter] public EventCallback<Vitarish.Parties.Domain.Dtos.OwnerReadDto> OwnerChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    protected override void OnInitialized()
    {
        write = Owner?.ToWrite() ?? new();
    }

    private async Task Save()
    {
        Vitarish.Parties.Domain.Dtos.OwnerReadDto? updated = await PartiesService.UpdateOwnerAsync(write);
        if(updated is null)
        {
            Snackbar.Add(Localizer["Error"], Severity.Error);
            return;
        }
        await OwnerChanged.InvokeAsync(updated);
        Owner = updated;
        write = updated.ToWrite();
        await InvokeAsync(StateHasChanged);
        await OnSaved.InvokeAsync();
        Snackbar.Add(Localizer["Saved"], Severity.Success);
    }
}
