<Stack>
    <StackButton Label="@Title" OnClick="RefreshAsync" Disabled="_isLoading" EndIcon="@(ShowRefreshButton ? "fa-regular fa-refresh" : "")" />

    @if(_error != null)
    {
        <StackField Label="@_error" Color="Color.Error" />
    }
    @if(_feedItems.Any())
    {
    }
    <Virtualize ItemsProvider="LoadFeedItemsAsync" Context="item" ItemSize="120">
        <ItemContent>
            <FeedItemComponent Item="item" OnClick="() => OnItemClick(item)" />
        </ItemContent>
        <Placeholder>
            <MudProgressLinear Indeterminate />
        </Placeholder>
    </Virtualize>
</Stack>

