@inherits CommonBase

@if(tenants.Count > 0)
{
    <Stack>
        <StackField Label="@Localizer["Workspaces"]" />

        @foreach(var entry in tenants)
        {
            <StackButton Size="Size.Large" Color="Color.Primary" Label="@entry.Value.Name" OnClick="@(() => NavigateToTenant(entry.Key))" StartIcon="fa-regular fa-building" />
        }
    </Stack>
}
