<Project>
  <PropertyGroup>
    <ModuleBuildProfile Condition="'$(ModuleBuildProfile)' == ''">All</ModuleBuildProfile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'All'">
    <EnableRequestsModule>true</EnableRequestsModule>
    <EnableUsersModule>true</EnableUsersModule>
    <EnablePartiesModule>true</EnablePartiesModule>
    <EnablePlatformModule>true</EnablePlatformModule>
    <EnableMedicalModule>true</EnableMedicalModule>
    <EnableAppointmentsModule>true</EnableAppointmentsModule>
    <EnableCommerceModule>true</EnableCommerceModule>
    <EnableSeaModule>true</EnableSeaModule>
    <EnableCommunicationsModule>true</EnableCommunicationsModule>
    <EnableFeedModule>true</EnableFeedModule>
    <EnableFilesModule>true</EnableFilesModule>
    <EnableFinancialModule>true</EnableFinancialModule>
    <EnableIntelligenceModule>true</EnableIntelligenceModule>
    <EnableKnowledgeModule>true</EnableKnowledgeModule>
    <EnableSearchModule>true</EnableSearchModule>
    <EnableContentsModule>true</EnableContentsModule>
    <EnableSocialModule>true</EnableSocialModule>
    <EnableLinksModule>true</EnableLinksModule>
  </PropertyGroup>

  <!-- Main host baseline modules are always enabled for all profiles to ensure the host compiles -->
  <PropertyGroup>
    <EnableRequestsModule>true</EnableRequestsModule>
    <EnableUsersModule>true</EnableUsersModule>
    <EnablePartiesModule>true</EnablePartiesModule>
    <EnablePlatformModule>true</EnablePlatformModule>
    <EnableFeedModule>true</EnableFeedModule>
    <EnableFilesModule>true</EnableFilesModule>
    <EnableSeaModule>true</EnableSeaModule>
    <EnableCommunicationsModule>true</EnableCommunicationsModule>
    <EnableAppointmentsModule>true</EnableAppointmentsModule>
    <EnableCommerceModule>true</EnableCommerceModule>
  </PropertyGroup>

  <!-- Profile-specific overrides for non-baseline modules -->
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Requests'" />
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Users'" />
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Parties'" />
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Platform'" />
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Medical'">
    <EnableMedicalModule>true</EnableMedicalModule>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Appointments'" />
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Commerce'" />
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Sea'" />
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Communications'" />
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Feed'" />
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Files'" />
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Financial'">
    <EnableFinancialModule>true</EnableFinancialModule>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Intelligence'">
    <EnableIntelligenceModule>true</EnableIntelligenceModule>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Knowledge'">
    <EnableKnowledgeModule>true</EnableKnowledgeModule>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Search'">
    <EnableSearchModule>true</EnableSearchModule>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Contents'">
    <EnableContentsModule>true</EnableContentsModule>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Social'">
    <EnableSocialModule>true</EnableSocialModule>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Links'">
    <EnableLinksModule>true</EnableLinksModule>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ModuleBuildProfile)' == 'Custom'" />

  <Target Name="ValidateModuleBuildProfile" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ModuleBuildProfile)' != 'All' And '$(ModuleBuildProfile)' != 'Custom' And '$(ModuleBuildProfile)' != 'Requests' And '$(ModuleBuildProfile)' != 'Users' And '$(ModuleBuildProfile)' != 'Parties' And '$(ModuleBuildProfile)' != 'Platform' And '$(ModuleBuildProfile)' != 'Medical' And '$(ModuleBuildProfile)' != 'Appointments' And '$(ModuleBuildProfile)' != 'Commerce' And '$(ModuleBuildProfile)' != 'Sea' And '$(ModuleBuildProfile)' != 'Communications' And '$(ModuleBuildProfile)' != 'Feed' And '$(ModuleBuildProfile)' != 'Files' And '$(ModuleBuildProfile)' != 'Financial' And '$(ModuleBuildProfile)' != 'Intelligence' And '$(ModuleBuildProfile)' != 'Knowledge' And '$(ModuleBuildProfile)' != 'Search' And '$(ModuleBuildProfile)' != 'Contents' And '$(ModuleBuildProfile)' != 'Social' And '$(ModuleBuildProfile)' != 'Links'"
           Text="Invalid ModuleBuildProfile '$(ModuleBuildProfile)'. Please choose a valid profile name (e.g., All, Custom, Users, Appointments, etc.)." />
  </Target>
</Project>
