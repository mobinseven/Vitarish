@if (owner is not null)
{
    <Stack>
        <StackField Label="@owner.Name" />
        <StackButton Size="Size.Small" Label="@Localizer["Dashboard"]" Href="@DashboardHref" EndIcon="fa-regular fa-grid" />
        <StackButton Size="Size.Small" Label="@Localizer["Owner"]" Href="@TenantsHref" EndIcon="fa-regular fa-building" />
    </Stack>
}

@code {
    [Parameter] public string DashboardHref { get; set; } = string.Empty;
    [Parameter] public string TenantsHref { get; set; } = string.Empty;

    private OwnerReadDto? owner;

    protected override async Task ReloadRequired()
    {
        Guid? ownerGuid = GetOwnerGuid();
        if (ownerGuid is null)
            return;

        owner = await PartiesService.GetOwnerAsync(ownerGuid.Value);
    }
}
