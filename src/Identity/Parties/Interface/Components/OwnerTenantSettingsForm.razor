@if (write is not null)
{
    <Stack>
        <StackField Label="@Localizer["TenantSettings"]" />
        <StackTextField @bind-Value="write.Name" Label="@Localizer["Name"]" Required />
        <StackTextField @bind-Value="write.LogoUrl" Label="@Localizer["LogoUrl"]" />
        <StackTextField @bind-Value="write.Description" Label="@Localizer["Description"]" />
        <StackTextField Value="@Tenant.AppId" Label="@Localizer["App"]" Disabled />
        <StackButton Label="@Localizer["Save"]" OnClick="Save"
                     Color="Color.Primary" EndIcon="fa-regular fa-save" />
    </Stack>
}
