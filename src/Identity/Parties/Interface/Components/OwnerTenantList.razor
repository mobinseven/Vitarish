@if (!Tenants.Any())
{
    <Stack>
        <StackField Label="@Localizer["NoItems", Localizer["Tenants"]]" />
    </Stack>
}
else
{
    <Stack>
        <StackField Label="@Localizer["Tenants"]" />
        @foreach (var tenant in Tenants)
        {
            <StackButton Label="@tenant.Name" Href="@TenantHref(tenant.Id)" StartIcon="fa-regular fa-building" />
        }
    </Stack>
}

@code {
    [Parameter, EditorRequired] public IEnumerable<TenantReadDto> Tenants { get; set; } = [];
    [Parameter, EditorRequired] public Func<Guid, string> TenantHref { get; set; } = _ => "#";
}
