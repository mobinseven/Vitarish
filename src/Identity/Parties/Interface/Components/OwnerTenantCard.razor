<Stack>
    <StackField Label="@Tenant.Name">
        <MudText Typo="Typo.caption" Color="Color.Secondary">@Tenant.AppId</MudText>
    </StackField>
    @if (modules.Count > 0)
    {
        <StackField>
            @foreach (var m in modules)
            {
                <Chip Label="@m" />
            }
        </StackField>
    }
    <StackButton Label="@Localizer["Open"]" Href="@Href" EndIcon="fa-regular fa-arrow-right" />
</Stack>

@code {
    [Parameter, EditorRequired] public TenantReadDto Tenant { get; set; } = default!;
    [Parameter] public string Href { get; set; } = "#";

    private IReadOnlyList<string> modules = [];

    protected override void OnParametersSet()
    {
        modules = TenantMetadata.GetActiveModules(Tenant?.Metadata);
    }
}
