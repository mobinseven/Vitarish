@inherits TenantCommonBase

<Stack>
    <StackTextField Value="@query"
                    ValueChanged="OnQueryChangedAsync"
                    Label="@Localizer["Search"]"
                    HelperText="@Localizer["User"]"
                    Adornment="Adornment.End"
                    AdornmentIcon="@(searching ? "fa-regular fa-circle-notch fa-spin" : "fa-regular fa-search")" />

    @if (ShowSearchScopeSelector)
    {
        <StackSelect T="UserSearchScope"
                     Value="@SearchScope"
                     ValueChanged="OnScopeChangedAsync"
                     Label="Scope">
            <MudSelectItem T="UserSearchScope" Value="@UserSearchScope.TenantUsers">Tenant users</MudSelectItem>
            <MudSelectItem T="UserSearchScope" Value="@UserSearchScope.AllPlatformUsers">All platform users</MudSelectItem>
        </StackSelect>
    }

    @if (results.Count == 0 && !string.IsNullOrWhiteSpace(query) && !searching)
    {
        <StackField Label="@Localizer["NoItems", Localizer["User"]]" />
    }
    else
    {
        @foreach (var user in results)
        {
            <StackButton Label="@GetDisplayName(user)"
                         HelperText="@GetHelperText(user)"
                         EndIcon="fa-regular fa-user-check"
                         OnClick="() => SelectUserAsync(user.Id)" />
        }
    }
</Stack>

@code {
    [Parameter] public UserSearchScope SearchScope { get; set; } = UserSearchScope.TenantUsers;
    [Parameter] public EventCallback<UserSearchScope> SearchScopeChanged { get; set; }
    [Parameter] public bool ShowSearchScopeSelector { get; set; } = true;
    [Parameter] public EventCallback<string> OnUserSelected { get; set; }

    [Inject] private IUsersService UsersService { get; set; } = default!;

    private const int MaxResults = 50;
    private string query = string.Empty;
    private bool searching;
    private IReadOnlyList<UserDto> results = [];
    private IReadOnlyList<UserDto>? allUsersCache;

    protected override Task OnInitializedAsync() => RefreshResultsAsync();

    private async Task OnScopeChangedAsync(UserSearchScope scope)
    {
        SearchScope = scope;
        await SearchScopeChanged.InvokeAsync(scope);
        await RefreshResultsAsync();
    }

    private async Task OnQueryChangedAsync(string? value)
    {
        query = value ?? string.Empty;
        await RefreshResultsAsync();
    }

    private async Task RefreshResultsAsync()
    {
        searching = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            IReadOnlyList<UserDto> source = await GetSourceAsync();
            results = [.. source.Where(MatchesQuery).Take(MaxResults)];
        }
        finally
        {
            searching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<IReadOnlyList<UserDto>> GetSourceAsync()
    {
        if (SearchScope == UserSearchScope.TenantUsers)
        {
            return [.. GetUsers()];
        }

        if (allUsersCache is not null)
        {
            return allUsersCache;
        }

        IEnumerable<User> users = await UsersService.GetUsersAsync(CancellationToken.None);
        allUsersCache = [.. users.Select(u => new UserDto(u))];
        return allUsersCache;
    }

    private bool MatchesQuery(UserDto user)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        string q = query.Trim();
        return Contains(user.FullName, q)
               || Contains(user.PhoneNumber, q)
               || Contains(user.Email, q)
               || Contains(user.UserName, q)
               || Contains(user.IdentificationCode, q)
               || Contains(user.Id, q);
    }

    private static bool Contains(string? value, string query)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(query, StringComparison.OrdinalIgnoreCase);

    private async Task SelectUserAsync(string userId) => await OnUserSelected.InvokeAsync(userId);

    private static string GetDisplayName(UserDto user)
        => string.IsNullOrWhiteSpace(user.FullName) ? user.UserName ?? user.Id : user.FullName;

    private static string GetHelperText(UserDto user)
    {
        List<string> parts = [];
        if (!string.IsNullOrWhiteSpace(user.PhoneNumber))
        {
            parts.Add(user.PhoneNumber!);
        }
        if (!string.IsNullOrWhiteSpace(user.Email))
        {
            parts.Add(user.Email!);
        }
        if (!string.IsNullOrWhiteSpace(user.IdentificationCode))
        {
            parts.Add(user.IdentificationCode!);
        }
        return string.Join(" · ", parts);
    }
}
