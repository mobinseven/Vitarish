@using System.Globalization
@using System.Linq
@inject UserProfileService ProfileService
@inject UserProfileCultureInfoProvider CultureProvider
@inject IStringLocalizer<CultureSelector> Localizer

<label class="culture-selector">
    <span>@Localizer["Language"]</span>
    <select value="@cultureName" @onchange="OnCultureChanged">
        @foreach (var culture in SupportedCultures)
        {
            <option value="@culture.Name">@culture.NativeName</option>
        }
    </select>
</label>

@code {
    private string cultureName = CultureInfo.CurrentUICulture.Name;
    private static readonly IReadOnlyList<CultureInfo> SupportedCultures =
    [
        new("fa-IR"),
        new("en-US"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var preferences = await ProfileService.GetProfileAsync();
        var existingCulture = preferences is null ? null : ProfileService.GetCulture(preferences);
        if (!string.IsNullOrWhiteSpace(existingCulture))
        {
            cultureName = existingCulture;
            if (await CultureProvider.TryApplyCultureAsync(existingCulture))
            {
                return;
            }
        }

        await CultureProvider.ApplyRequestedCultureAsync();
        var requestedCulture = await CultureProvider.GetRequestedCultureAsync();
        if (requestedCulture is not null)
        {
            cultureName = requestedCulture.Name;
        }
    }

    private async Task OnCultureChanged(ChangeEventArgs args)
    {
        var value = args.Value as string;
        if (string.IsNullOrWhiteSpace(value)) return;

        cultureName = value;
        await CultureProvider.SetCultureAsync(value);
        NavigationManager.Refresh(true);
    }
}
