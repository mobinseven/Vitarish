@if(Roles?.Any() == true)
{
    <table>
        <thead>
            <tr>
                <th>Role</th>
                <th>Read</th>
                <th>Write</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Roles)
            {
                <tr>
                    <td>@role</td>
                    <td>
                        <input type="checkbox"
                               checked="@readRoles.Contains(role)"
                               @onchange="e => ToggleRead(role, e.Value is bool v && v)" />
                    </td>
                    <td>
                        <input type="checkbox"
                               checked="@writeRoles.Contains(role)"
                               @onchange="e => ToggleWrite(role, e.Value is bool v && v)" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No roles</p>
}
