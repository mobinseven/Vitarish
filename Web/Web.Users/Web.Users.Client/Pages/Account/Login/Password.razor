@page "/account/login/password"

<PageTitle>Password login</PageTitle>

<MudStack Spacing="2">
    <MudText Typo="Typo.h5" Align="Align.Center">Sign in with password</MudText>
    <StatusMessage Message="@SuccessMessage" Severity="Severity.Warning" />
    <PasswordLoginForm />
</MudStack>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string SuccessMessage => string.IsNullOrWhiteSpace(ReturnUrl)
        ? "Use your account password to continue."
        : $"After signing in you will return to {ReturnUrl}.";
}
