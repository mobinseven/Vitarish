<div>
    <MudTextField @bind-Value="@Email"
                  Label="@Localizer["Email"]"
                  Placeholder="email@example.com"
                  Style="text-align: center"
                  UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "email" }, { "aria-required", "true" } } )"
                  Variant="Variant.Outlined"
                  Margin="Margin.Normal"
                  ShrinkLabel=true
                  AutoFocus=true
                  DebounceInterval="500"
                  Immediate />
    <MudButton Disabled="@(!isValid || submitting)"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               OnClick="ValidSubmit">
        @Localizer["Continue"]
    </MudButton>
</div>
