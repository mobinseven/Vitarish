<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<PackageId>Vorn.Files.Client.MudBlazor</PackageId>
		<Title>Vorn.Files.Client.MudBlazor</Title>
		<Description>
			This library is designed as part of web applications which are clients who get file hosting as a service from a Vorn.Files.Host. It contains visual components using MudBlazor library and includes a reference to that library.
		</Description>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MudBlazor" Version="8.*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Vorn.Files.Client\Vorn.Files.Client.csproj" />
	</ItemGroup>
</Project>