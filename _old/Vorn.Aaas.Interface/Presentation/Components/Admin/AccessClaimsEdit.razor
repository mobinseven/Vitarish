@using Vorn.Aaas.Users
@if(accessClaims is not null)
{
    <MudDataGrid T="AccessClaimModel"
                 @ref=dataGrid
                 EditTrigger="DataGridEditTrigger.Manual"
                 EditMode="DataGridEditMode.Cell"
                 ReadOnly=false
                 Items="accessClaims"
                 MultiSelection="true"
                 SelectOnRowClick=false
                 @bind-SelectedItems="selectedClaims"
                 Bordered="true"
                 Elevation="0"
                 Dense="true"
                 Filterable="true">

        <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer["AccessClaims"]</MudText>
            <MudSpacer />
            <MudFab Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="Add" />
            <MudFab Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="Delete" Disabled="@(!selectedClaims.Any())" />
        </ToolBarContent>

        <Columns>
            <SelectColumn/>
            <HierarchyColumn />
            <PropertyColumn Property="c => c.ClientId"
                            Title="@Localizer["ClientId"]"
                            Editable="true" />

            <PropertyColumn Property="c => c.Read"
                            Title="@Localizer["Read"]"
                            Required=false
                            Editable="true" />

            <PropertyColumn Property="c => c.Write"
                            Title="@Localizer["Write"]"
                            Required=false
                            Editable="true" />

            <PropertyColumn Property="c => c.Admin"
                            Title="@Localizer["Admin"]"
                            Editable="true">
                <CellTemplate>
                    <MudIcon Icon=@(context.Item.Admin? Icons.Material.Filled.Check : Icons.Material.Filled.Close) />
                </CellTemplate>
                <EditTemplate Context="context">
                    <MudCheckBox T="bool" @bind-Value="context.Item.Admin" />
                </EditTemplate>
            </PropertyColumn>
        </Columns>
        <ChildRowContent>
            @context.Item.Claim.Value
        </ChildRowContent>

    </MudDataGrid>
}
else
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
