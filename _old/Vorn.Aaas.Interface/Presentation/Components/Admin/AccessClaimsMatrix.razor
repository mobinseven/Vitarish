@using Vorn.Aaas.AuthenticationClients.Domain.Entities
@if(rows is not null)
{
    <MudDataGrid T="AccessClientModel"
                 EditTrigger="DataGridEditTrigger.Manual"
                 EditMode="DataGridEditMode.Cell"
                 ReadOnly=false
                 Items="rows"
                 Bordered="true"
                 Elevation="0"
                 Dense="true"
                 Filterable="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer["AccessClaims"]</MudText>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="c => c.Client.Id"
                            Title="@Localizer["Id"]"
                            Editable="false" />
            <PropertyColumn Property="c => c.Client.Title"
                            Title="@Localizer["Title"]"
                            Editable="false" />
            <PropertyColumn Property="c => c.Access"
                            Title="@Localizer["Access"]"
                            Editable="true"
                            Required=false>
                <EditTemplate Context="context">
                    <RoleEditor @bind-Read="context.Item.Read"
                                @bind-Write="context.Item.Write"
                                Roles="roles" />
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="c => c.Admin"
                            Title="@Localizer["Admin"]"
                            Editable="true">
                <CellTemplate>
                    <MudIcon Icon=@(context.Item.Admin ? Icons.Material.Filled.Check : Icons.Material.Filled.Close) />
                </CellTemplate>
                <EditTemplate Context="context">
                    <MudCheckBox T="bool" @bind-Value="context.Item.Admin" />
                </EditTemplate>
            </PropertyColumn>
        </Columns>
    </MudDataGrid>
}
else
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
