@using Microsoft.AspNetCore.Identity

@if(VerifyCodeInput is not null)
{
    <MudAlert Severity="Severity.Success">@Localizer["CodeSent", VerifyCodeInput.PhoneNumber]</MudAlert>
    <form method="post" action="@VerificationEndpoint">
        <AntiforgeryToken />
        <input type="hidden" name="Input.UserId" value="@User.Id" />
        <input type="hidden" name="Input.Provider" value="@TokenOptions.DefaultPhoneProvider" />
        <input type="hidden" name="Input.ReturnUrl" value="@ReturnUrl" />
        <input type="hidden" name="Input.FailureUrl" value="@FailureUrl" />
        <MudFocusTrap>
            <MudField Variant="Variant.Outlined" Style="direction: ltr;">
                <MudStack AlignItems="AlignItems.Center" Style="width: 100%;">
                    <input name="Input.Code"
                           @bind="VerifyCodeInput.Code"
                           @bind:event="oninput"
                           type="text"
                           autocomplete="one-time-code"
                           inputmode="numeric"
                           maxlength="6"
                           autofocus>
                </MudStack>
            </MudField>
        </MudFocusTrap>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   ButtonType="ButtonType.Submit">
            @Localizer["Continue"]
        </MudButton>
    </form>
}
