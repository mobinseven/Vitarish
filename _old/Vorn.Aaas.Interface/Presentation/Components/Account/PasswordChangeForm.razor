@inherits CommonBase
@if(User is null)
{
    <MudProgressLinear Indeterminate />
    return;
}
<EditForm Model="@ChangePasswordInput" FormName="set-password" OnValidSubmit="ChangePasswordValidSubmitAsync">
    <DataAnnotationsValidator />
    <MudTextField @bind-Value="User.UserName"
                  Label="@Localizer["UserName"]"
                  UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "username" }, { "aria-required", "true" } })"
                  Variant="Variant.Outlined" Disabled />
    @if(hasPass)
    {
        <MudFocusTrap>
            <MudTextField For="@(() => ChangePasswordInput.CurrentPassword)" @bind-Value="ChangePasswordInput.CurrentPassword"
                          InputType="InputType.Password"
                          Placeholder="@Localizer["CurrentPassword"]"
                          UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "current-password" }, { "aria-required", "true" }, { "id", "currentPassword" }, { "name", "current-password" } })"
                          Class="my-2"
                          Variant="Variant.Outlined" />
        </MudFocusTrap>
    }
    <MudTextField For="@(() => ChangePasswordInput.NewPassword)" @bind-Value="ChangePasswordInput.NewPassword"
                  InputType="InputType.Password"
                  Placeholder="@Localizer["NewPassword"]"
                  UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "new-password" }, { "aria-required", "true" }, { "id", "newPassword" }, { "name", "new-password" } })"
                  Class="my-2"
                  Variant="Variant.Outlined" />
    <MudTextField For="@(() => ChangePasswordInput.ConfirmPassword)" @bind-Value="ChangePasswordInput.ConfirmPassword"
                  InputType="InputType.Password"
                  Placeholder="@Localizer["ConfirmPassword"]"
                  UserAttributes="@(new() { { "dir", "ltr" }, { "autocomplete", "new-password" }, { "aria-required", "true" }, { "id", "confirmPassword" }, { "name", "confirm-new-password" } })"
                  Class="my-2"
                  Variant="Variant.Outlined" />
    <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" ButtonType="ButtonType.Submit">@Localizer["Ok"]</MudButton>
</EditForm>