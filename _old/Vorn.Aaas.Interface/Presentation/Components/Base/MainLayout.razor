@inherits LayoutComponentBase
@inject IStringLocalizer<Strings> Localizer
<PageTitle>Vitarish</PageTitle>

<MudRTLProvider RightToLeft="@System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft" Style="height: 100%">
    <MudLayout Style="height: 100%">
        <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" StretchItems="StretchItems.Middle" Row="true" Style="height: 100%">
            <MudItem lg="6" md="8" sm="10" xs="12" Style="height: 100%">
                <MudPaper Class="pa-3 mx-lg-7 mx-lg-5 mx-lg-3 mx-xs-1" Elevation="0" Style="height: 100%">
                    <MudStack Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="height: 100%">
                        <MudItem Class="my-md-7 my-3" Style="width: 100%">
                            <MudText Align="Align.Center" Typo="Typo.h4" Style="font-variant: small-caps;">Vitarish</MudText>
                        </MudItem>
                        <MudItem Class="my-md-7 my-3" Style="width: 100%">
                            <MudDivider Class="mt-md-7 mt-3" />
                            <MudPaper Class="pa-3" Elevation="0" Style="height: 100%">
                                @Body
                            </MudPaper>
                        </MudItem>
                        <MudItem Class="my-md-7 my-3" Style="width: 100%">
                            <MudDivider Class="mt-md-7 mt-3" />
                            <form method="get" action="/">
                                <MudButton FullWidth="true" ButtonType="ButtonType.Submit">@Localizer["Home"]</MudButton>
                            </form>
                            <form method="get" action="/Privacy">
                                <MudButton FullWidth="true" ButtonType="ButtonType.Submit">@Localizer["Privacy"]</MudButton>
                            </form>
                        </MudItem>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudStack>
    </MudLayout>
</MudRTLProvider>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />