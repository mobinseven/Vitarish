@page "/Account/Manage/Tokens"

@inherits IdentityBase

<MudText Typo="Typo.h4" GutterBottom="true">@Localizer["PersonalAccessTokens"]</MudText>

@if (!scopes.Any())
{
    <MudAlert Severity="Severity.Info">@Localizer["NoScopesAvailable"]</MudAlert>
}
else
{
    <MudPaper Class="pa-4">
        <MudForm @ref="form" Model="model">
            <MudNumericField @bind-Value="model.LifetimeDays"
                             Label="@Localizer["LifetimeDays"]"
                             Min="1"
                             Max="3650"
                             Variant="Variant.Outlined" />
            <MudSwitch T="bool" @bind-Value="model.IsReferenceToken"
                       Color="Color.Primary"
                       Class="mb-4">@Localizer["ReferenceToken"]</MudSwitch>
            <MudSelect T="string"
                       Label="@Localizer["Scopes"]"
                       MultiSelection="true"
                       SelectedValues="SelectedScopeValues"
                       SelectedValuesChanged="OnSelectedScopesChanged"
                       Variant="Variant.Outlined">
                @foreach (var scope in scopes)
                {
                    <MudSelectItem Value="@scope">@scope</MudSelectItem>
                }
            </MudSelect>
            <MudButton ButtonType="ButtonType.Button"
                       OnClick="GenerateTokenAsync"
                       Color="Color.Primary"
                       Disabled="@isGenerating"
                       Class="mt-4">@Localizer["GenerateToken"]</MudButton>
        </MudForm>
    </MudPaper>
}

@if (!string.IsNullOrWhiteSpace(token))
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@Localizer["Token"]</MudText>
        <MudTextField Value="@token"
                      Lines="6"
                      ReadOnly="true"
                      Variant="Variant.Outlined" />
    </MudPaper>
}
