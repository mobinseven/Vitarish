@page "/Admin/RequestIdentities"
@inherits AdminBase

<MudStack Spacing="2">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h5">@Localizer["RequestIdentities"]</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       OnClick="ReloadAsync"
                       Disabled="isLoading"
                       Color="Color.Primary" />
    </MudStack>

    <MudPaper Elevation="0" Class="pa-4">
        <MudStack Spacing="2">
            <MudTextField @bind-Value="search"
                          Variant="Variant.Outlined"
                          Label="@Localizer["Search"]"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="350"
                          OnDebounceIntervalElapsed="OnSearchChanged"
                          Disabled="isLoading" />

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="filters.RequestId"
                                  Variant="Variant.Outlined"
                                  Label="@Localizer["RequestId"]"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  OnDebounceIntervalElapsed="OnFilterChanged"
                                  Disabled="isLoading" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="filters.Authority"
                                  Variant="Variant.Outlined"
                                  Label="@Localizer["Authority"]"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  OnDebounceIntervalElapsed="OnFilterChanged"
                                  Disabled="isLoading" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="filters.ClientId"
                                  Variant="Variant.Outlined"
                                  Label="@Localizer["ClientId"]"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  OnDebounceIntervalElapsed="OnFilterChanged"
                                  Disabled="isLoading" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="filters.OwnerId"
                                  Variant="Variant.Outlined"
                                  Label="@Localizer["OwnerId"]"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  OnDebounceIntervalElapsed="OnFilterChanged"
                                  Disabled="isLoading" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="filters.TenantId"
                                  Variant="Variant.Outlined"
                                  Label="@Localizer["TenantId"]"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  OnDebounceIntervalElapsed="OnFilterChanged"
                                  Disabled="isLoading" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="filters.UserId"
                                  Variant="Variant.Outlined"
                                  Label="@Localizer["UserId"]"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  OnDebounceIntervalElapsed="OnFilterChanged"
                                  Disabled="isLoading" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="filters.ResourceId"
                                  Variant="Variant.Outlined"
                                  Label="@Localizer["ResourceId"]"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  OnDebounceIntervalElapsed="OnFilterChanged"
                                  Disabled="isLoading" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="filters.TraceId"
                                  Variant="Variant.Outlined"
                                  Label="@Localizer["TraceId"]"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  OnDebounceIntervalElapsed="OnFilterChanged"
                                  Disabled="isLoading" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="filters.AdditionalInfo"
                                  Variant="Variant.Outlined"
                                  Label="@Localizer["AdditionalInfo"]"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  OnDebounceIntervalElapsed="OnFilterChanged"
                                  Disabled="isLoading" />
                </MudItem>
            </MudGrid>

            <MudStack Row Justify="Justify.FlexEnd" Spacing="1">
                <MudButton Variant="Variant.Text"
                           OnClick="ClearFilters"
                           Disabled="!HasActiveFilters || isLoading">
                    @Localizer["ClearFilters"]
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudDataGrid T="RequestIdentity"
                 @ref="grid"
                 ServerData="LoadEntriesAsync"
                 Loading="isLoading"
                 Dense="true"
                 Hover="true"
                 Elevation="0">
        <Columns>
            <TemplateColumn Title="@Localizer["Created"]">
                <CellTemplate>
                    @context.Item.CreatedAt.ToLocalTime().ToString("u")
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="identity => identity.RequestId" Title="@Localizer["RequestId"]" />
            <PropertyColumn Property="identity => identity.Authority" Title="@Localizer["Authority"]" />
            <PropertyColumn Property="identity => identity.ClientId" Title="@Localizer["ClientId"]" />
            <PropertyColumn Property="identity => identity.OwnerId" Title="@Localizer["OwnerId"]" />
            <PropertyColumn Property="identity => identity.TenantId" Title="@Localizer["TenantId"]" />
            <PropertyColumn Property="identity => identity.UserId" Title="@Localizer["UserId"]" />
            <PropertyColumn Property="identity => identity.ResourceId" Title="@Localizer["ResourceId"]" />
            <PropertyColumn Property="identity => identity.TraceId" Title="@Localizer["TraceId"]" />
            <TemplateColumn Title="@Localizer["AdditionalInfo"]">
                <CellTemplate>
                    <MudText Class="text-truncate" Style="max-width: 20rem;">@context.Item.AdditionalInfo</MudText>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudStack>
