@page "/Admin/ApiClients"
@inherits AdminBase
<MudDataGrid T="ApiClient" Items="Clients" RowClick="RowClicked" Elevation="0">
    <Columns>
        <PropertyColumn Property="x => x.Id" />
        <PropertyColumn Property="x => x.Secret" />
        <PropertyColumn Property="x => x.HostUri" />
        <PropertyColumn Property="x => x.Scopes" />
        <TemplateColumn>
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="() => Remove(context.Item)" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>
<MudDivider Class="my-3" />
<MudStack Row>
    <MudTextField @bind-Value=newClientId Label="@Localizer["Id"]" Disabled="editingClient is not null" />
    <MudTextField @bind-Value=newClientSecret Label="@Localizer["Secret"]" />
    <MudTextField @bind-Value=newClientHostUri Label="@Localizer["HostUri"]" />
    <MudTextField @bind-Value=scopes Label="@Localizer["Scopes"]" />
    <MudFab StartIcon="@(editingClient is null ? Icons.Material.Filled.Add : Icons.Material.Filled.Save)"
            Size="Size.Small" OnClick="Save" DropShadow="false" />
    @if (editingClient is not null)
    {
        <MudFab StartIcon="@Icons.Material.Filled.Cancel"
                Size="Size.Small"
                OnClick="CancelEdit"
                Color="Color.Default"
                DropShadow="false" />
    }
</MudStack>
