@using System.Text
@using System.Threading
@using Vorn.Ai.Client.Abstractions
@using Vorn.Ai.Client.Models
@implements IAsyncDisposable
@inject IStreamTranscriber Transcriber
@inject IStreamRewriter Rewriter
@inject IStreamResponder Responder

<div class="ai-stream-workbench">
    <section class="ai-stream-section">
        <h3>Transcription</h3>
        <div class="ai-stream-controls">
            <button type="button"
                    @onclick="InitializeTranscriberAsync"
                    disabled="@_transcriberInitializing">
                @_transcriberInitializing ? "Initializing…" : "Initialize"
            </button>
            <button type="button"
                    @onclick="StartRecordingAsync"
                    disabled="@(!_supported || _recording || _transcribing || _transcriberInitializing)">
                Start Recording
            </button>
            <button type="button"
                    @onclick="StopRecordingAsync"
                    disabled="@(!_recording)">
                Stop Recording
            </button>
            <button type="button"
                    @onclick="ToggleRecordingAsync"
                    disabled="@(!_supported || _transcriberInitializing)">
                @_recording ? "Stop (Toggle)" : "Toggle Recording"
            </button>
        </div>
        <p class="ai-stream-status">@_transcriberStatus</p>
        <textarea class="ai-stream-text"
                  @bind="_transcription"
                  @bind:event="oninput"
                  placeholder="Live transcription output will appear here."></textarea>
        <div class="ai-stream-controls">
            <button type="button"
                    @onclick="UseTranscriptForPrompt"
                    disabled="@string.IsNullOrWhiteSpace(_transcription)">
                Use transcript as rewrite prompt
            </button>
        </div>
    </section>
    <section class="ai-stream-section">
        <h3>Rewrite</h3>
        <div class="ai-stream-controls">
            <button type="button"
                    @onclick="RewriteAsync"
                    disabled="@(!_rewriting && string.IsNullOrWhiteSpace(GetRewritePrompt()))">
                @_rewriting ? "Cancel Rewrite" : "Rewrite"
            </button>
        </div>
        <textarea class="ai-stream-text"
                  @bind="_rewritePrompt"
                  @bind:event="oninput"
                  placeholder="Enter the prompt to rewrite or load the transcript."></textarea>
        <div class="ai-stream-controls">
            <button type="button"
                    @onclick="UseTranscriptForPrompt"
                    disabled="@string.IsNullOrWhiteSpace(_transcription)">
                Load latest transcript into prompt
            </button>
        </div>
        <textarea class="ai-stream-text"
                  @bind="_rewriteValue"
                  @bind:event="oninput"
                  placeholder="Rewrite results appear here."></textarea>
        @if(!string.IsNullOrEmpty(_rewriteError))
        {
            <p class="ai-stream-error">@_rewriteError</p>
        }
    </section>
    <section class="ai-stream-section">
        <h3>Responder</h3>
        <div class="ai-stream-controls">
            <textarea class="ai-stream-text"
                      @bind="_responderInstructions"
                      @bind:event="oninput"
                      placeholder="Optional system instructions for the responder."></textarea>
            <select @bind="_responderFormat">
                <option value="@ResponseTextFormat.Text">Text</option>
                <option value="@ResponseTextFormat.JsonObject">JSON Object</option>
            </select>
        </div>
        <div class="ai-stream-controls">
            <input @bind="ResponderModel"
                   @bind:event="oninput"
                   list="ai-direct-responder-models"
                   placeholder="Optional model override" />
        </div>
        <datalist id="ai-direct-responder-models">
            @foreach(string model in _modelSuggestions)
            {
                <option value="@model"></option>
            }
        </datalist>
        <div class="ai-stream-controls">
            <button type="button"
                    @onclick="SubmitResponderAsync"
                    disabled="@(!_responderSubmitting && string.IsNullOrWhiteSpace(GetResponderPayload()))">
                @_responderSubmitting ? "Cancel Response" : "Send to Responder"
            </button>
        </div>
        @if(!string.IsNullOrEmpty(_responderError))
        {
            <p class="ai-stream-error">@_responderError</p>
        }
        <ul class="ai-stream-outputs">
            @if(_responderOutputs.Count == 0)
            {
                <li class="ai-stream-output-empty">No responses yet.</li>
            }
            else
            {
                foreach(var output in _responderOutputs)
                {
                    <li class="ai-stream-output">@FormatOutput(output)</li>
                }
            }
        </ul>
    </section>
</div>

@code {
    private readonly List<ResponderOutput> _responderOutputs = new();
    private readonly CancellationTokenSource _lifecycleCts = new();

    private CancellationTokenSource? _responderCts;

    private bool _transcriberInitializing;
    private string _transcription = string.Empty;
    private string _transcriberStatus = "Initializing microphone support…";
    private bool _supported;
    private bool _recording;
    private bool _transcribing;

    private string _rewritePrompt = string.Empty;
    private string _rewriteValue = string.Empty;
    private bool _rewriting;
    private string? _rewriteError;

    private bool _responderSubmitting;
    private string _responderInstructions = string.Empty;
    private ResponseTextFormat _responderFormat = ResponseTextFormat.Text;
    private string? _responderError;
    private static readonly string[] _modelSuggestions = ["gpt-5-nano", "gpt-4o", "gpt-4o-mini", "o3-mini"];
    private string _responderModel = string.Empty;
    private bool _disposed;

    private string ResponderModel
    {
        get => _responderModel;
        set
        {
            _responderModel = value;
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        _supported = Transcriber.Supported;
        _recording = Transcriber.Recording;
        _transcribing = Transcriber.Transcribing;
        _transcription = Transcriber.Value;
        _rewriteValue = Rewriter.Value;
        _rewritePrompt = _transcription;
        _responderOutputs.AddRange(Responder.Outputs);
        _responderSubmitting = Responder.Responding;
        UpdateTranscriberStatus();

        Transcriber.SupportStatusChanged += OnSupportStatusChanged;
        Transcriber.ValueChanged += OnTranscriptionValueChanged;
        Transcriber.RecordingStateChanged += OnRecordingStateChanged;
        Transcriber.TranscribingStateChanged += OnTranscribingStateChanged;
        Transcriber.TranscriptionCompleted += OnTranscriptionCompleted;

        Rewriter.RewriteStarted += OnRewriteStarted;
        Rewriter.ValueChanged += OnRewriteValueChanged;
        Rewriter.RewriteCompleted += OnRewriteCompleted;
        Rewriter.RewriteErrored += OnRewriteErrored;

        Responder.OutputReceived += OnResponderOutputReceived;
        Responder.OutputCompleted += OnResponderCompleted;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await InitializeTranscriberAsync();
        }
    }

    private async Task InitializeTranscriberAsync()
    {
        if(_transcriberInitializing)
        {
            return;
        }

        _transcriberInitializing = true;
        UpdateTranscriberStatus();
        StateHasChanged();

        try
        {
            await Transcriber.InitializeAsync(_lifecycleCts.Token);
        }
        catch(OperationCanceledException)
        {
            // ignored
        }
        finally
        {
            _transcriberInitializing = false;
            UpdateTranscriberStatus();
            StateHasChanged();
        }
    }

    private async Task StartRecordingAsync()
    {
        try
        {
            await Transcriber.StartRecordingAsync(_lifecycleCts.Token);
        }
        catch(OperationCanceledException)
        {
            // ignored
        }
    }

    private async Task StopRecordingAsync()
    {
        try
        {
            await Transcriber.StopRecordingAsync();
        }
        catch
        {
            // ignored
        }
    }

    private async Task ToggleRecordingAsync()
    {
        try
        {
            await Transcriber.ToggleRecordingAsync(_lifecycleCts.Token);
        }
        catch(OperationCanceledException)
        {
            // ignored
        }
    }

    private void UseTranscriptForPrompt()
    {
        if(!string.IsNullOrWhiteSpace(_transcription))
        {
            _rewritePrompt = _transcription;
        }
    }

    private string? GetRewritePrompt()
        => string.IsNullOrWhiteSpace(_rewritePrompt) ? _transcription : _rewritePrompt;

    private async Task RewriteAsync()
    {
        if(_rewriting)
        {
            Rewriter.CancelRewrite();
            _rewriting = false;
            StateHasChanged();
            return;
        }

        string? prompt = GetRewritePrompt();

        if(string.IsNullOrWhiteSpace(prompt))
        {
            return;
        }

        _rewriteError = null;
        _rewriting = true;
        StateHasChanged();

        try
        {
            await Rewriter.StartRewriteAsync(prompt, _lifecycleCts.Token);
        }
        catch(OperationCanceledException)
        {
            _rewriting = false;
        }
        catch(Exception ex)
        {
            _rewriteError = ex.Message;
            _rewriting = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task SubmitResponderAsync()
    {
        if(_responderSubmitting)
        {
            CancelResponder();
            _responderSubmitting = false;
            StateHasChanged();
            return;
        }

        string? payload = GetResponderPayload();

        if(string.IsNullOrWhiteSpace(payload))
        {
            return;
        }

        _responderError = null;
        _responderOutputs.Clear();
        _responderSubmitting = true;
        CancelResponder();
        _responderCts = CancellationTokenSource.CreateLinkedTokenSource(_lifecycleCts.Token);
        StateHasChanged();

        var inputs = new[] { ResponderInput.TextInput(payload) };
        ResponderOptions options = new()
        {
            Instructions = string.IsNullOrWhiteSpace(_responderInstructions) ? null : _responderInstructions,
            TextFormat = _responderFormat,
            Model = string.IsNullOrWhiteSpace(_responderModel) ? null : _responderModel.Trim(),
            Tools = Array.Empty<ResponderToolDefinition>()
        };

        try
        {
            await Responder.Submit(inputs, options, _responderCts.Token);
        }
        catch(OperationCanceledException)
        {
            _responderSubmitting = false;
        }
        catch(Exception ex)
        {
            _responderError = ex.Message;
            _responderSubmitting = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private string? GetResponderPayload()
    {
        if(!string.IsNullOrWhiteSpace(_rewriteValue))
        {
            return _rewriteValue;
        }

        if(!string.IsNullOrWhiteSpace(_rewritePrompt))
        {
            return _rewritePrompt;
        }

        return string.IsNullOrWhiteSpace(_transcription) ? null : _transcription;
    }

    private void CancelResponder()
    {
        if(_responderCts is null)
        {
            return;
        }

        try
        {
            _responderCts.Cancel();
        }
        catch
        {
            // ignored
        }
        finally
        {
            _responderCts.Dispose();
            _responderCts = null;
        }
    }

    private void UpdateTranscriberStatus()
    {
        if(_transcriberInitializing)
        {
            _transcriberStatus = "Initializing microphone support…";
            return;
        }

        if(!_supported)
        {
            _transcriberStatus = "Microphone recording is not supported.";
            return;
        }

        if(_recording)
        {
            _transcriberStatus = "Recording…";
            return;
        }

        if(_transcribing)
        {
            _transcriberStatus = "Transcribing…";
            return;
        }

        _transcriberStatus = "Ready to record.";
    }

    private async void OnSupportStatusChanged(object? sender, bool supported)
    {
        await InvokeAsync(() =>
        {
            _supported = supported;
            UpdateTranscriberStatus();
            StateHasChanged();
        });
    }

    private async void OnTranscriptionValueChanged(object? sender, string value)
    {
        await InvokeAsync(() =>
        {
            _transcription = value;

            if(string.IsNullOrWhiteSpace(_rewritePrompt))
            {
                _rewritePrompt = value;
            }

            StateHasChanged();
        });
    }

    private async void OnRecordingStateChanged(object? sender, bool recording)
    {
        await InvokeAsync(() =>
        {
            _recording = recording;
            UpdateTranscriberStatus();
            StateHasChanged();
        });
    }

    private async void OnTranscribingStateChanged(object? sender, bool transcribing)
    {
        await InvokeAsync(() =>
        {
            _transcribing = transcribing;
            UpdateTranscriberStatus();
            StateHasChanged();
        });
    }

    private async void OnTranscriptionCompleted(object? sender, EventArgs args)
    {
        await InvokeAsync(() =>
        {
            _transcribing = false;
            UpdateTranscriberStatus();
            StateHasChanged();
        });
    }

    private async void OnRewriteStarted(object? sender, EventArgs args)
    {
        await InvokeAsync(() =>
        {
            _rewriteError = null;
            _rewriting = true;
            StateHasChanged();
        });
    }

    private async void OnRewriteValueChanged(object? sender, string value)
    {
        await InvokeAsync(() =>
        {
            _rewriteValue = value;
            StateHasChanged();
        });
    }

    private async void OnRewriteCompleted(object? sender, EventArgs args)
    {
        await InvokeAsync(() =>
        {
            _rewriting = false;
            StateHasChanged();
        });
    }

    private async void OnRewriteErrored(object? sender, Exception exception)
    {
        await InvokeAsync(() =>
        {
            _rewriteError = exception.Message;
            _rewriting = false;
            StateHasChanged();
        });
    }

    private async void OnResponderOutputReceived(object? sender, ResponderOutput output)
    {
        await InvokeAsync(() =>
        {
            _responderOutputs.Add(output);
            StateHasChanged();
        });
    }

    private async void OnResponderCompleted(object? sender, IReadOnlyList<ResponderOutput> outputs)
    {
        await InvokeAsync(() =>
        {
            _responderOutputs.Clear();
            _responderOutputs.AddRange(outputs);
            _responderSubmitting = false;
            StateHasChanged();
        });
    }

    private string FormatOutput(ResponderOutput output)
        => output.Type switch
        {
            ResponderOutputType.Message => FormatMessage(output.Content),
            ResponderOutputType.Text => output.Text ?? string.Empty,
            ResponderOutputType.Reasoning => output.Text ?? string.Empty,
            _ => output.Text ?? output.Type.ToString()
        };

    private string FormatMessage(IReadOnlyList<ResponderOutput>? content)
    {
        if(content is null || content.Count == 0)
        {
            return string.Empty;
        }

        StringBuilder builder = new();
        for(int i = 0; i < content.Count; i++)
        {
            if(i > 0)
            {
                builder.AppendLine();
            }

            builder.Append(FormatOutput(content[i]));
        }

        return builder.ToString();
    }

    public async ValueTask DisposeAsync()
    {
        if(_disposed)
        {
            return;
        }

        _disposed = true;

        _lifecycleCts.Cancel();
        _lifecycleCts.Dispose();

        CancelResponder();

        Transcriber.SupportStatusChanged -= OnSupportStatusChanged;
        Transcriber.ValueChanged -= OnTranscriptionValueChanged;
        Transcriber.RecordingStateChanged -= OnRecordingStateChanged;
        Transcriber.TranscribingStateChanged -= OnTranscribingStateChanged;
        Transcriber.TranscriptionCompleted -= OnTranscriptionCompleted;

        Rewriter.RewriteStarted -= OnRewriteStarted;
        Rewriter.ValueChanged -= OnRewriteValueChanged;
        Rewriter.RewriteCompleted -= OnRewriteCompleted;
        Rewriter.RewriteErrored -= OnRewriteErrored;
        Rewriter.CancelRewrite();

        Responder.OutputReceived -= OnResponderOutputReceived;
        Responder.OutputCompleted -= OnResponderCompleted;

        try
        {
            await Transcriber.StopRecordingAsync();
        }
        catch
        {
            // ignored
        }

        GC.SuppressFinalize(this);
    }
}
