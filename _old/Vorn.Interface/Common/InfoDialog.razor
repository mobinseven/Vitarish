@inherits CommonBase
<MudDialog>
    <DialogContent>
        @Info
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="MudDialog.Cancel">@Localizer["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public RenderFragment? Info { get; set; }
}
