@* UrlChip.razor *@
@using MudBlazor
@inherits ComponentBase

@if(string.IsNullOrWhiteSpace(Href))
{
    <MudChip T="string" Text="@DisplayText"
             Size="@Size"
             Variant="@Variant" />
}
else
{
    <MudChip T="string" Text="@DisplayText"
             Rel="@RelValue"
             Href="@Href"
             Target="@(NewTab ? "_blank" : null)"
             Size="@Size"
             Variant="@Variant" />
}

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public bool NewTab { get; set; } = true;
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;

    // If no Text is supplied, show the host (e.g., example.com). Falls back to Href.
    private string DisplayText
        => !string.IsNullOrWhiteSpace(Text)
            ? Text!
            : TryHost(Href) ?? (Href ?? string.Empty);

    // With target="_blank", include rel to prevent reverse tabnabbing.
    // (noreferrer implies noopener; keeping both is fine.)
    private string? RelValue => NewTab ? "noopener noreferrer" : null;

    private static string? TryHost(string? href)
        => Uri.TryCreate(href, UriKind.Absolute, out var uri) ? uri.Host : null;
}
