@inherits LayoutComponentBase

@{
    var themeSurface = CurrentThemeSurface;
    var shimmer = themeSurface.Shimmer;
}

<style>
    :root {
@foreach(var variable in themeSurface.RootVariables)
{
@:        @(variable.Key): @(variable.Value);
}
    }

    .shimmer {
        display: inline-block;
        color: @shimmer.TextColor;
        background: @shimmer.Background;
        background-position: -4rem top;
        background-repeat: no-repeat;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        -webkit-animation-name: shimmer;
        -webkit-animation-duration: 2.2s;
        -webkit-animation-iteration-count: infinite;
        -webkit-background-size: 4rem 100%;
    }
</style>

<div style="height: 100%">
    <MudRTLProvider RightToLeft="@System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft" Style="height: 100%;">
        @if(BreakpointReceived)
        {
            <CascadingValue Value="@PageBreakpoint">
                @if(Initialized)
                {
                    @Body

                    <div style="position: fixed; bottom: 0; width: 100%;pointer-events: none;">
                        @if(PageBreakpoint >= Breakpoint.Md)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-5">
                                <MudPaper Class="pa-5" Elevation="20" Style="border-radius: 70px; pointer-events: auto;">
                                    <NavMenu Size="Size.Large" />
                                </MudPaper>
                            </MudStack>
                        }
                        else if(PageBreakpoint < Breakpoint.Md)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-1">
                                <MudPaper Class="pa-1" Elevation="20" Style="border-radius: 70px; pointer-events: auto;">
                                    <NavMenu />
                                </MudPaper>
                            </MudStack>
                        }
                    </div>
                    <AntiforgeryToken />
                }
            </CascadingValue>
        }
        <MudPopoverProvider />
        <MudDialogProvider FullWidth="true"
                           MaxWidth="MaxWidth.Small" />
        <MudSnackbarProvider />
        <MudThemeProvider Theme="Theme" IsDarkMode=darkmood />
    </MudRTLProvider>
</div>
