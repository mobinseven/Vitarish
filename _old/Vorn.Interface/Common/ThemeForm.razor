@inherits CommonBase

<MudPaper Class="theme-form" Style="padding: 1.5rem; border-radius: 20px;">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">@Localizer["Theme configuration"]</MudText>
        <MudStack Row Spacing="2">
            <MudSwitch T="bool"
                       @bind-Value="@model.DarkMode"
                       @bind-Value:after="ApplyAfterBindingAsync"
                       Color="Color.Primary"
                       Label="@Localizer["Dark mode"]" />
            @*             <MudSwitch T="bool"
                       @bind-Value="@model.BlazorReady"
                       @bind-Value:after="ApplyAfterBindingAsync"
                       Color="Color.Secondary"
                       Label="@Localizer["Blazor ready script"]" /> *@
        </MudStack>

        <MudDivider />

        <MudForm Model="model">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">@Localizer["Palette"]</MudText>

                @if(model.DarkMode)
                {

                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">@Localizer["Dark theme"]</MudText>
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.DarkPrimary"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Primary color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.DarkPrimary"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.DarkSecondary"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Secondary color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.DarkSecondary"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.DarkTertiary"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Tertiary color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.DarkTertiary"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.DarkInfo"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Info color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.DarkInfo"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.DarkTextPrimary"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Primary text"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.DarkTextPrimary"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.DarkSuccess"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Success color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.DarkSuccess"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.DarkWarning"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Warning color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.DarkWarning"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.DarkError"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Error color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.DarkError"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.DarkDarkColor"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Dark color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.DarkDarkColor"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.DarkSurface"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Surface color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.DarkSurface"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                    <MudDivider />

                    <MudText Typo="Typo.subtitle1">@Localizer["Dark surface"]</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption">@Localizer["Blur"]</MudText>
                                <MudSlider T="double"
                                           @bind-Value="@model.DarkBlur"
                                           @bind-Value:after="ApplyAfterBindingAsync"
                                           Min="0"
                                           Max="50"
                                           Step="1"
                                           Immediate="true"
                                           ValueLabel="true" />
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption">@Localizer["Brightness"]</MudText>
                                <MudSlider T="double"
                                           @bind-Value="@model.DarkBrightness"
                                           @bind-Value:after="ApplyAfterBindingAsync"
                                           Min="0"
                                           Max="200"
                                           Step="1"
                                           Immediate="true"
                                           ValueLabel="true" />
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="1">
                                <MudColorPicker @bind-Text="model.DarkBackground"
                                                @bind-Text:after="ApplyAfterBindingAsync"
                                                Label="@Localizer["Background"]"
                                                Variant="Variant.Outlined"
                                                PickerVariant="PickerVariant.Inline" />
                                <ColorValueChip Value="@model.DarkBackground"
                                                Placeholder="@Localizer["No color"]" />
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="1">
                                <MudTextField @bind-Value="@model.DarkBorder"
                                              @bind-Value:after="ApplyAfterBindingAsync"
                                              Label="@Localizer["Border"]"
                                              Variant="Variant.Outlined"
                                              Immediate="true" />
                                <ColorValueChip Value="@model.DarkBorder"
                                                Placeholder="@Localizer["No color"]" />
                            </MudStack>
                        </MudItem>
                    </MudGrid>

                }
                else
                {


                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">@Localizer["Light theme"]</MudText>
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.LightPrimary"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Primary color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.LightPrimary"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.LightSecondary"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Secondary color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.LightSecondary"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.LightTertiary"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Tertiary color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.LightTertiary"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.LightInfo"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Info color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.LightInfo"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.LightTextPrimary"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Primary text"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.LightTextPrimary"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.LightSuccess"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Success color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.LightSuccess"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.LightWarning"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Warning color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.LightWarning"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.LightError"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Error color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.LightError"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.LightDarkColor"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Dark color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.LightDarkColor"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudColorPicker @bind-Text="model.LightSurface"
                                                    @bind-Text:after="ApplyAfterBindingAsync"
                                                    Label="@Localizer["Surface color"]"
                                                    Variant="Variant.Outlined"
                                                    PickerVariant="PickerVariant.Inline" />
                                    <ColorValueChip Value="@model.LightSurface"
                                                    Placeholder="@Localizer["No color"]" />
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudStack>

                    <MudDivider />

                    <MudText Typo="Typo.subtitle1">@Localizer["Light surface"]</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption">@Localizer["Blur"]</MudText>
                                <MudSlider T="double"
                                           @bind-Value="@model.LightBlur"
                                           @bind-Value:after="ApplyAfterBindingAsync"
                                           Min="0"
                                           Max="50"
                                           Step="1"
                                           Immediate="true"
                                           ValueLabel="true" />
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption">@Localizer["Brightness"]</MudText>
                                <MudSlider T="double"
                                           @bind-Value="@model.LightBrightness"
                                           @bind-Value:after="ApplyAfterBindingAsync"
                                           Min="0"
                                           Max="200"
                                           Step="1"
                                           Immediate="true"
                                           ValueLabel="true" />
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="1">
                                <MudColorPicker @bind-Text="model.LightBackground"
                                                @bind-Text:after="ApplyAfterBindingAsync"
                                                Label="@Localizer["Background"]"
                                                Variant="Variant.Outlined"
                                                PickerVariant="PickerVariant.Inline" />
                                <ColorValueChip Value="@model.LightBackground"
                                                Placeholder="@Localizer["No color"]" />
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="1">
                                <MudTextField @bind-Value="@model.LightBorder"
                                              @bind-Value:after="ApplyAfterBindingAsync"
                                              Label="@Localizer["Border"]"
                                              Variant="Variant.Outlined"
                                              Immediate="true" />
                                <ColorValueChip Value="@model.LightBorder"
                                                Placeholder="@Localizer["No color"]" />
                            </MudStack>
                        </MudItem>
                    </MudGrid>


                }

                <MudDivider />

                <MudText Typo="Typo.subtitle1">@Localizer["Typography"]</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption">@Localizer["Font size"]</MudText>
                            <MudSlider T="double"
                                       @bind-Value="@model.FontSizeValue"
                                       @bind-Value:after="OnFontSizeSliderChanged"
                                       Min="0.5"
                                       Max="2"
                                       Step="0.05"
                                       Immediate="true"
                                       ValueLabel="true"
                                       ValueLabelFormat="{0:0.##} rem" />
                            <MudTextField @bind-Value="@model.FontSize"
                                          @bind-Value:after="ApplyAfterBindingAsync"
                                          Label="@Localizer["Font size"]"
                                          Variant="Variant.Outlined"
                                          Immediate="true" />
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption">@Localizer["Font weight"]</MudText>
                            <MudSlider T="double"
                                       @bind-Value="@model.FontWeightValue"
                                       @bind-Value:after="OnFontWeightSliderChanged"
                                       Min="100"
                                       Max="1000"
                                       Step="100"
                                       Immediate="true"
                                       ValueLabel="true"
                                       ValueLabelFormat="{0:0}" />
                            <MudTextField @bind-Value="@model.FontWeight"
                                          @bind-Value:after="ApplyAfterBindingAsync"
                                          Label="@Localizer["Font weight"]"
                                          Variant="Variant.Outlined"
                                          Immediate="true" />
                        </MudStack>
                    </MudItem>
                </MudGrid>

                <MudStack Row Justify="Justify.FlexEnd" Spacing="1" Class="mt-4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               OnClick="ResetToInitial">@Localizer["Reset"]</MudButton>
                </MudStack>
            </MudStack>
        </MudForm>

        @*         <MudDivider />

        <MudText Typo="Typo.subtitle1">@Localizer["Surface variables"]</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2">@Localizer["Light"]</MudText>
                <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                    @foreach(var variable in lightSurfaceVariables)
                    {
                        <ColorValueChip Value="variable.Value"
                                        DisplayText="@($"{variable.Key}: {variable.Value}")"
                                        Placeholder="@($"{variable.Key}: {Localizer["No color"]}")"
                                        Class="theme-variable-chip" />
                    }
                </MudStack>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2">@Localizer["Dark"]</MudText>
                <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                    @foreach(var variable in darkSurfaceVariables)
                    {
                        <ColorValueChip Value="@variable.Value"
                                        DisplayText="@($"{variable.Key}: {variable.Value}")"
                                        Placeholder="@($"{variable.Key}: {Localizer["No color"]}")"
                                        Class="theme-variable-chip" />
                    }
                </MudStack>
            </MudItem>
        </MudGrid> *@

        <MudDivider />

        <MudText Typo="Typo.subtitle1">@Localizer["Theme preview"]</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">@Localizer["Action elements"]</MudText>
                        <MudStack Row Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.Center">
                            <MudButtonGroup OverrideStyles="false" DropShadow="false">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary">@Localizer["Primary"]</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary">@Localizer["Secondary"]</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Tertiary">@Localizer["Tertiary"]</MudButton>
                            </MudButtonGroup>
                            <MudButtonGroup OverrideStyles="false">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary">@Localizer["Primary"]</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary">@Localizer["Secondary"]</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Tertiary">@Localizer["Tertiary"]</MudButton>
                            </MudButtonGroup>
                            <MudButtonGroup OverrideStyles="false">
                                <MudButton Variant="Variant.Text" Color="Color.Primary">@Localizer["Primary"]</MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Secondary">@Localizer["Secondary"]</MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Tertiary">@Localizer["Tertiary"]</MudButton>
                            </MudButtonGroup>
                        </MudStack>
                        <MudDivider />
                        <MudStack Row Spacing="1" Wrap="Wrap.Wrap">
                            <MudChip T="string" Color="Color.Warning">@Localizer["Warning"]</MudChip>
                            <MudChip T="string" Color="Color.Error">@Localizer["Error"]</MudChip>
                            <MudChip T="string" Color="Color.Success">@Localizer["Success"]</MudChip>
                            <MudChip T="string" Color="Color.Info">@Localizer["Info"]</MudChip>
                        </MudStack>
                        <MudAlert Severity="Severity.Info">@Localizer["Alerts adapt to the palette colors."]</MudAlert>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">@Localizer["Typography & surfaces"]</MudText>
                        <MudText Typo="Typo.subtitle1">@Localizer["Heading sample"]</MudText>
                        <MudText Typo="Typo.body1">@Localizer["Body text showcases the configured font size and weight."]</MudText>
                        <MudDivider />
                        <MudStack Row Spacing="2" Wrap="Wrap.Wrap">
                            @if(model.DarkMode)
                            {
                                <MudPaper Class="pa-4"
                                          Style="@DarkSurfaceStyle">
                                    <MudText Typo="Typo.caption">@Localizer["Dark caption preview"]</MudText>
                                </MudPaper>
                            }
                            else
                            {
                                <MudPaper Class="pa-4"
                                          Style="@LightSurfaceStyle">
                                    <MudText Typo="Typo.caption">@Localizer["Light caption preview"]</MudText>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudPaper>
