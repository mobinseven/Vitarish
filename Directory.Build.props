<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>

		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<ImplicitUsings>enable</ImplicitUsings>

		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)'=='true'">true</ContinuousIntegrationBuild>
		<!-- Suppress NuGet vulnerability warnings until packages are updated -->
		<NoWarn>$(NoWarn);NU1902;NU1903;NU1904</NoWarn>
	</PropertyGroup>
	<PropertyGroup>
		<Authors>Vorn</Authors>
		<Company>Vorn</Company>
		<Product Condition="'$(Product)'==''">$(MSBuildProjectName)</Product>

		<GitHubOrg>VORNIR</GitHubOrg>
		<RepositoryUrl Condition="'$(RepositoryUrl)'==''">
			https://github.com/$(GitHubOrg)/$(MSBuildProjectName)
		</RepositoryUrl>

		<RepositoryType>git</RepositoryType>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<ContinuousIntegrationBuild Condition="'$(CI)'=='true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>
	<PropertyGroup>
		<!-- Your “solution name / company name” prefix -->
		<SolutionRootNamespace>Vitarish</SolutionRootNamespace>

		<!-- Construct the default namespace for each project -->
		<!-- MSBuildProjectName = the project’s name (without path) -->
		<RootNamespace>$(SolutionRootNamespace).$(MSBuildProjectName)</RootNamespace>
	</PropertyGroup>

</Project>
